{
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "bootstrap@5.3.8",
      "destination": "wwwroot/lib/bootstrap/"
    },
    {
      "library": "flag-icons@7.5.0",
      "destination": "wwwroot/lib/flag-icons/"
    },
    {
      "library": "bootstrap-icons@1.13.1",
      "destination": "wwwroot/lib/bootstrap-icons/"
    },
    {
      "library": "select2@4.0.13",
      "destination": "wwwroot/lib/select2/"
    },
    {
      "library": "jquery@3.7.1",
      "destination": "wwwroot/lib/jquery/"
    },
    {
      "provider": "unpkg",
      "library": "@microsoft/signalr@9.0.6",
      "destination": "wwwroot/lib/microsoft/signalr/"
    },
    {
      "provider": "jsdelivr",
      "library": "fullcalendar@6.1.19",
      "destination": "wwwroot/lib/fullcalendar/"
    },
    {
      "provider": "jsdelivr",
      "library": "daterangepicker@3.1.0",
      "destination": "wwwroot/lib/daterangepicker/"
    },
    {
        "provider": "jsdelivr",
        "library": "moment@2.29.4",
        "destination": "wwwroot/lib/moment/"
    },
    {
        "provider": "cdnjs",
        "library": "toastr.js@2.1.4",
        "destination": "wwwroot/lib/toastr/"
    }

  ]
}