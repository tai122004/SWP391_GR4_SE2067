@model RWPM.Models.ViewModels.Store.StoreDetailsVM
@using System.Globalization
@using StoreModelResource = RWPM.Resources.Models.Store
@using StoreSharedResource = RWPM.Resources.Shared.Store
@using RWPM.Resources.Shared

@{
    ViewData["Title"] = $"{StoreSharedResource.Details_PageHeader} {Model.Store.StoreName}";
    var store = Model.Store;
    string Hm(TimeSpan t) => $"{t.Hours:D2}:{t.Minutes:D2}";
    string L(string label) => label.Trim().TrimEnd(':').Trim();
    var openStr = store.OpeningTime.HasValue ? Hm(store.OpeningTime.Value) : "";
    var closeStr = store.ClosingTime.HasValue ? Hm(store.ClosingTime.Value) : "";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
    /* Prevent Dark Mode browser extensions from darkening map tiles */
    .leaflet-tile {
        filter: none !important;
        -webkit-filter: none !important;
    }
    .leaflet-container {
        background-color: #e5e3df !important;
    }
</style>

<div class="container-fluid px-0">
    <div class="app-page-header">
        <div>
            <h4 class="mb-1">@store.StoreName <span class="text-muted fw-normal fs-6 font-monospace">@store.StoreCode</span></h4>
            <div class="text-muted small">
                <i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrWhiteSpace(store.Address) ? StoreSharedResource.Details_UnsetAddress : store.Address)
            </div>
        </div>
        <div class="app-page-actions">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i> @SharedResource.Button_GoBack
            </a>
            <a asp-action="Edit" asp-route-id="@store.StoreId" class="btn btn-primary btn-sm px-3">
                <i class="bi bi-pencil-square me-1"></i> @SharedResource.Button_Edit
            </a>
        </div>
    </div>

    <!-- KPI -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card p-3 h-100">
                <div class="text-muted" style="font-size: 13px;">@StoreSharedResource.KPI_Manager</div>
                <div class="fs-5 fw-semibold mt-1 text-truncate">@(store.Manager?.Account?.FullName ?? StoreSharedResource.Unassigned)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card p-3 h-100">
                <div class="text-muted" style="font-size: 13px;">@StoreSharedResource.KPI_TotalEmployees</div>
                <div class="fs-4 fw-semibold mt-1 tabular">@Model.TotalEmployees <span class="fs-6 fw-normal text-muted">@StoreSharedResource.Unit_People</span></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card p-3 h-100">
                <div class="text-muted" style="font-size: 13px;">@StoreSharedResource.KPI_TodayAttendance</div>
                <div class="fs-4 fw-semibold mt-1 tabular">@Model.TodayPresentCount <span class="fs-6 fw-normal text-muted">@StoreSharedResource.Unit_Records</span></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card p-3 h-100">
                <div class="text-muted" style="font-size: 13px;">@StoreSharedResource.KPI_OperatingHours</div>
                <div class="fs-5 fw-semibold mt-1 tabular">
                    @if (store.OpeningTime.HasValue && store.ClosingTime.HasValue)
                    {
                        <span>@openStr – @closeStr</span>
                    }
                    else
                    {
                        <span>@StoreSharedResource.AllDayOperating</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs modern-tabs mb-3" id="storeTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-item nav-link active" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab">
                @StoreSharedResource.Tab_InfoAndMap
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-item nav-link" id="employee-tab" data-bs-toggle="tab" data-bs-target="#employee" type="button" role="tab">
                @StoreSharedResource.Tab_Employees <span class="app-badge app-badge-neutral ms-1">@Model.TotalEmployees</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-item nav-link" id="shift-tab" data-bs-toggle="tab" data-bs-target="#shift" type="button" role="tab">
                @StoreSharedResource.Tab_Shifts <span class="app-badge app-badge-neutral ms-1">@Model.ActiveShiftsCount</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-item nav-link" id="attendance-tab" data-bs-toggle="tab" data-bs-target="#attendance" type="button" role="tab">
                @StoreSharedResource.Tab_TodayAttendance <span class="app-badge app-badge-neutral ms-1">@Model.TodayPresentCount</span>
            </button>
        </li>
    </ul>

    <div class="tab-content" id="storeTabContent">
        <!-- TAB 1: Thông tin & bản đồ -->
        <div class="tab-pane fade show active" id="info" role="tabpanel">
            <div class="row g-3">
                <div class="col-lg-6">
                    <div class="card h-100 p-3">
                        <h5 class="border-bottom pb-2 mb-3">@StoreSharedResource.Details_BranchConfig</h5>
                        <dl class="row mb-0">
                            <dt class="col-sm-5 text-muted fw-normal">@StoreModelResource.StoreCode</dt>
                            <dd class="col-sm-7 font-monospace">@store.StoreCode</dd>

                            <dt class="col-sm-5 text-muted fw-normal">@StoreModelResource.StoreName</dt>
                            <dd class="col-sm-7 fw-medium">@store.StoreName</dd>

                            <dt class="col-sm-5 text-muted fw-normal">@StoreSharedResource.KPI_OperatingHours</dt>
                            <dd class="col-sm-7 tabular">
                                @if (store.OpeningTime.HasValue && store.ClosingTime.HasValue)
                                {
                                    <span>@L(StoreSharedResource.Details_OpenTimeLabel) <strong>@openStr</strong> — @L(StoreSharedResource.Details_CloseTimeLabel) <strong>@closeStr</strong></span>
                                }
                                else
                                {
                                    <span>@StoreSharedResource.AllDayOperating</span>
                                }
                            </dd>

                            <dt class="col-sm-5 text-muted fw-normal">@StoreModelResource.Phone</dt>
                            <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(store.Phone) ? "-" : store.Phone)</dd>

                            <dt class="col-sm-5 text-muted fw-normal">@StoreSharedResource.KPI_Manager</dt>
                            <dd class="col-sm-7">
                                @if (store.Manager != null && store.Manager.Account != null)
                                {
                                    <span>@store.Manager.Account.FullName <span class="text-muted font-monospace small">@store.Manager.EmployeeCode</span></span>
                                }
                                else
                                {
                                    <span class="text-muted">@StoreSharedResource.Unassigned</span>
                                }
                            </dd>

                            <dt class="col-sm-5 text-muted fw-normal">@L(StoreSharedResource.Details_GPSRadius)</dt>
                            <dd class="col-sm-7">@string.Format(StoreSharedResource.Details_AllowedDistance, store.AllowedRadiusMeters)</dd>

                            <dt class="col-sm-5 text-muted fw-normal">@L(StoreSharedResource.Details_BranchStatus)</dt>
                            <dd class="col-sm-7">
                                @if (store.IsActive)
                                {
                                    <span class="app-badge app-badge-success">@SharedResource.ObjectStatus_IsActive</span>
                                }
                                else
                                {
                                    <span class="app-badge app-badge-neutral">@SharedResource.ObjectStatus_IsInactive</span>
                                }
                            </dd>

                            <dt class="col-sm-5 text-muted fw-normal">@L(StoreSharedResource.Details_CreatedDate)</dt>
                            <dd class="col-sm-7 small text-muted tabular">@store.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</dd>

                            @if (store.UpdatedDate.HasValue)
                            {
                                <dt class="col-sm-5 text-muted fw-normal">@L(StoreSharedResource.Details_UpdatedDate)</dt>
                                <dd class="col-sm-7 small text-muted tabular mb-0">@store.UpdatedDate.Value.ToString("dd/MM/yyyy HH:mm:ss")</dd>
                            }
                        </dl>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card h-100 p-3">
                        <h5 class="border-bottom pb-2 mb-3">@StoreSharedResource.Details_GPSMapHeader</h5>
                        @if (store.Latitude.HasValue && store.Longitude.HasValue)
                        {
                            <div id="detailsMap" style="height: 320px;" class="rounded border"></div>
                            <div class="small text-muted mt-2 d-flex justify-content-between align-items-center">
                                <span class="tabular">@StoreSharedResource.Details_Coordinates @store.Latitude.Value.ToString("F6", CultureInfo.InvariantCulture), @store.Longitude.Value.ToString("F6", CultureInfo.InvariantCulture)</span>
                                <span class="app-badge app-badge-neutral">@StoreSharedResource.Range @store.AllowedRadiusMeters m</span>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning text-center my-auto">
                                <i class="bi bi-exclamation-triangle d-block mb-2"></i>
                                @StoreSharedResource.Details_NoGPSAlert
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: Nhân viên -->
        <div class="tab-pane fade" id="employee" role="tabpanel">
            <div class="app-content-card">
                <div class="table-responsive">
                    <table class="table modern-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@StoreSharedResource.EmpTable_Code</th>
                                <th>@StoreSharedResource.EmpTable_FullName</th>
                                <th>@StoreSharedResource.EmpTable_Email</th>
                                <th>@StoreSharedResource.EmpTable_Phone</th>
                                <th>@StoreSharedResource.EmpTable_ContractType</th>
                                <th>@StoreSharedResource.EmpTable_Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Employees.Any())
                            {
                                foreach (var emp in Model.Employees)
                                {
                                    <tr>
                                        <td class="font-monospace small">@emp.EmployeeCode</td>
                                        <td class="fw-medium">@(emp.Account?.FullName ?? emp.Username)</td>
                                        <td>@(emp.Account?.Email ?? "-")</td>
                                        <td>@(emp.Account?.PhoneNumber ?? "-")</td>
                                        <td><span class="app-badge app-badge-neutral">@RWPM.Common.UIHelper.GetDisplayName(emp.EmploymentType)</span></td>
                                        <td>
                                            @if (emp.IsActive)
                                            {
                                                <span class="app-status"><span class="app-dot app-dot-success"></span>@StoreSharedResource.EmpTable_Working</span>
                                            }
                                            else
                                            {
                                                <span class="app-status"><span class="app-dot"></span>@StoreSharedResource.EmpTable_Resigned</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">@StoreSharedResource.EmpTable_Empty</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 3: Ca làm -->
        <div class="tab-pane fade" id="shift" role="tabpanel">
            <div class="app-content-card">
                <div class="table-responsive">
                    <table class="table modern-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@StoreSharedResource.ShiftTable_Name</th>
                                <th class="text-end">@StoreSharedResource.ShiftTable_TimeFrame</th>
                                <th class="text-end">@StoreSharedResource.ShiftTable_BreakMinutes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Shifts.Any())
                            {
                                foreach (var shift in Model.Shifts)
                                {
                                    <tr>
                                        <td>@shift.ShiftName</td>
                                        <td class="text-end">@Hm(shift.StartTime) – @Hm(shift.EndTime) @(shift.EndDayOffset == 1 ? "(+1)" : "")</td>
                                        <td class="text-end">@shift.BreakMinutes @StoreSharedResource.Unit_Minutes</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">@StoreSharedResource.ShiftTable_Empty</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 4: Chấm công hôm nay -->
        <div class="tab-pane fade" id="attendance" role="tabpanel">
            <div class="app-content-card">
                <div class="table-responsive">
                    <table class="table modern-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@StoreSharedResource.AttTable_Account</th>
                                <th class="text-end">@StoreSharedResource.AttTable_CheckIn</th>
                                <th class="text-end">@StoreSharedResource.AttTable_CheckOut</th>
                                <th class="text-end">@StoreSharedResource.AttTable_GPSDistance</th>
                                <th>@StoreSharedResource.AttTable_Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TodayAttendanceRecords.Any())
                            {
                                foreach (var rec in Model.TodayAttendanceRecords)
                                {
                                    <tr>
                                        <td class="fw-medium">@rec.Username</td>
                                        <td class="text-end">@(rec.CheckInTime.HasValue ? Hm(rec.CheckInTime.Value) : "-")</td>
                                        <td class="text-end">@(rec.CheckOutTime.HasValue ? Hm(rec.CheckOutTime.Value) : "-")</td>
                                        <td class="text-end">@(rec.DistanceMeters.HasValue ? $"{Math.Round(rec.DistanceMeters.Value, 1)}m" : "-")</td>
                                        <td><span class="app-status"><span class="app-dot app-dot-success"></span>@StoreSharedResource.AttStatus_Valid</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        <i class="bi bi-calendar-x fs-3 d-block mb-2"></i>
                                        @StoreSharedResource.AttTable_Empty
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (store.Latitude.HasValue && store.Longitude.HasValue)
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>
            window.RWPM = window.RWPM || {};
            RWPM.storeDetails = {
                lat: @store.Latitude.Value.ToString(CultureInfo.InvariantCulture),
                lng: @store.Longitude.Value.ToString(CultureInfo.InvariantCulture),
                radius: @(store.AllowedRadiusMeters > 0 ? store.AllowedRadiusMeters : 100),
                storeName: @Json.Serialize(store.StoreName),
                address: @Json.Serialize(store.Address ?? ""),
                i18n: {
                    mapGoogle: @Json.Serialize(SharedResource.Store_MapGoogle),
                    mapOsm: @Json.Serialize(SharedResource.Store_MapOSM)
                }
            };
        </script>
        <script src="~/js/store/details.js" asp-append-version="true"></script>
    }
}
