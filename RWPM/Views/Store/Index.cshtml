@model RWPM.Models.ViewModels.Store.StoreListVM

@using StoreModelResource = RWPM.Resources.Models.Store
@using StoreSharedResource = RWPM.Resources.Shared.Store
@using RWPM.Resources.Shared

@{
    ViewData["Title"] = StoreSharedResource.Index_PageTitle;
}

@Html.AntiForgeryToken()

<div class="container-fluid px-0">
    <div class="app-page-header">
        <div>
            <h4 class="mb-1">@StoreSharedResource.Index_PageHeader</h4>
            <div class="text-muted small">@StoreSharedResource.Index_Subtitle</div>
        </div>
        <div class="app-page-actions">
            <a asp-action="Create" class="btn btn-primary btn-sm px-3">
                <i class="bi bi-plus-lg me-1"></i> @SharedResource.Button_Create
            </a>
        </div>
    </div>

    <!-- Search form -->
    <div class="app-filter-panel">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-6 col-lg-5">
                <label class="form-label">@SharedResource.Button_Search</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" asp-for="Search" class="form-control border-start-0 ps-0" placeholder="@StoreSharedResource.Placeholder_Search" />
                </div>
            </div>

            <div class="col-md-4 col-lg-3">
                <label class="form-label">@SharedResource.ObjectStatus</label>
                <select asp-for="IsActive" class="form-select form-select-sm">
                    <option value="">-- @SharedResource.ObjectStatus_Default --</option>
                    <option value="true">@SharedResource.ObjectStatus_IsActive</option>
                    <option value="false">@SharedResource.ObjectStatus_IsInactive</option>
                </select>
            </div>

            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-funnel me-1"></i> @SharedResource.Button_Search
                </button>
                <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-muted" title="@SharedResource.Button_Reset">
                    <i class="bi bi-arrow-clockwise"></i> @SharedResource.Button_Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Table Container -->
    <div class="app-content-card management-table-card mb-3">
        <div class="table-responsive">
            <table class="table modern-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="text-nowrap">@StoreModelResource.StoreCode</th>
                        <th class="text-nowrap">@StoreModelResource.StoreName</th>
                        <th class="text-nowrap">@StoreSharedResource.Table_Manager</th>
                        <th class="text-nowrap">@StoreModelResource.Address</th>
                        <th class="text-nowrap">@StoreModelResource.Phone</th>
                        <th class="text-nowrap text-center">@StoreSharedResource.Table_GeoLocation</th>
                        <th class="text-nowrap text-center">@StoreModelResource.IsActive</th>
                        <th class="text-nowrap text-center">@SharedResource.Button_Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PanigationResponse.Data != null && Model.PanigationResponse.Data.Any())
                    {
                        foreach (var store in Model.PanigationResponse.Data)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@store.StoreId" class="text-decoration-none font-monospace small">
                                        @store.StoreCode
                                    </a>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@store.StoreId" class="text-decoration-none text-body fw-medium">
                                        @store.StoreName
                                    </a>
                                    @if (store.OpeningTime.HasValue && store.ClosingTime.HasValue)
                                    {
                                        var openStr = $"{store.OpeningTime.Value.Hours:D2}:{store.OpeningTime.Value.Minutes:D2}";
                                        var closeStr = $"{store.ClosingTime.Value.Hours:D2}:{store.ClosingTime.Value.Minutes:D2}";
                                        <div class="small text-muted">@openStr - @closeStr</div>
                                    }
                                </td>
                                <td>
                                    @if (store.Manager != null && store.Manager.Account != null)
                                    {
                                        <span>@store.Manager.Account.FullName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">@StoreSharedResource.Unassigned</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(store.Address) ? "-" : store.Address)</td>
                                <td>@(string.IsNullOrWhiteSpace(store.Phone) ? "-" : store.Phone)</td>
                                <td class="text-center small">
                                    @if (store.Latitude.HasValue && store.Longitude.HasValue)
                                    {
                                        <span class="app-status"><span class="app-dot app-dot-success"></span>@StoreSharedResource.Range &le; @(store.AllowedRadiusMeters > 0 ? store.AllowedRadiusMeters : 100)m</span>
                                    }
                                    else
                                    {
                                        <span class="app-status text-muted"><span class="app-dot app-dot-warning"></span>@StoreSharedResource.Badge_NoGPS</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <label class="status-choice">
                                        <input class="form-check-input active-toggle"
                                               type="checkbox"
                                               data-id="@store.StoreId"
                                               @(store.IsActive ? "checked" : "") />
                                        <span class="status-dot @(store.IsActive ? "is-active" : "is-inactive")"></span>
                                        <span class="status-choice-text">@(store.IsActive ? SharedResource.ObjectStatus_IsActive : SharedResource.ObjectStatus_IsInactive)</span>
                                    </label>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-action-group" role="group">
                                        <a asp-action="Details" asp-route-id="@store.StoreId" class="btn btn-sm btn-outline-secondary" title="@StoreSharedResource.Tooltip_ViewDetails" aria-label="@StoreSharedResource.Tooltip_ViewDetails">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@store.StoreId" class="btn btn-sm btn-outline-secondary" title="@SharedResource.Button_Edit" aria-label="@SharedResource.Button_Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button type="submit" form="deleteStoreForm_@store.StoreId" class="btn btn-sm btn-outline-danger" title="@SharedResource.Button_Delete" aria-label="@SharedResource.Button_Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                    <form id="deleteStoreForm_@store.StoreId" asp-action="DeleteConfirmed" method="post" class="d-none"
                                          data-confirm="@SharedResource.ConfirmDelete&#10;@store.StoreCode - @store.StoreName"
                                          data-confirm-title="@SharedResource.Button_Delete"
                                          data-confirm-ok="@SharedResource.Button_Delete"
                                          data-confirm-cancel="@SharedResource.Button_Cancel"
                                          data-confirm-type="danger">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="storeId" value="@store.StoreId" />
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-3 d-block mb-2 text-muted"></i>
                            @SharedResource.NoDataFound
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>

    <!-- Pagination -->
    @await Html.PartialAsync("_PaginationPartial", Model.PanigationResponse.ToPaginationRes(new Dictionary<string, string?>() {
        { "Search", Model.Search },
        { "IsActive", Model.IsActive.ToString() }
    }))
</div>

@section Scripts {
    <script>
        window.RWPM = window.RWPM || {};
        RWPM.storeIndex = {
            urls: { updateActiveStatus: '@Url.Action("UpdateActiveStatus", "Store")' },
            i18n: {
                active: @Json.Serialize(SharedResource.ObjectStatus_IsActive),
                inactive: @Json.Serialize(SharedResource.ObjectStatus_IsInactive),
                updated: @Json.Serialize(StoreSharedResource.StatusUpdateSuccess),
                failed: @Json.Serialize(StoreSharedResource.StatusUpdateFailed)
            }
        };
    </script>
    <script src="~/js/store/index.js" asp-append-version="true"></script>
}
