@model global::Store

@using StoreModelResource = RWPM.Resources.Models.Store
@using StoreSharedResource = RWPM.Resources.Shared.Store
@using RWPM.Resources.Shared

@{
    ViewData["Title"] = StoreSharedResource.Delete_PageTitle;
}

<div class="app-page-header">
    <div>
        <h4 class="mb-1">@StoreSharedResource.Delete_PageHeader</h4>
        <div class="text-muted small">@SharedResource.DataWillBeDeleted</div>
    </div>
    <nav class="d-none d-md-block" aria-label="@RWPM.Resources.Shared.Store.Aria_Breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-action="Index">@StoreSharedResource.Index_PageHeader</a></li>
            <li class="breadcrumb-item active" aria-current="page">@StoreSharedResource.Delete_PageHeader</li>
        </ol>
    </nav>
</div>

<div class="app-content-card p-4" style="max-width: 760px;">
    <div class="alert alert-warning py-2 px-3 small d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <div><strong>@StoreSharedResource.Delete_WarningLabel</strong> @StoreSharedResource.Delete_Warning</div>
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-3 text-muted fw-normal">@StoreModelResource.StoreCode</dt>
        <dd class="col-sm-9 font-monospace">@Model.StoreCode</dd>

        <dt class="col-sm-3 text-muted fw-normal">@StoreModelResource.StoreName</dt>
        <dd class="col-sm-9 fw-medium">@Model.StoreName</dd>

        <dt class="col-sm-3 text-muted fw-normal">@StoreModelResource.Address</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Address) ? "-" : Model.Address)</dd>

        <dt class="col-sm-3 text-muted fw-normal">@StoreModelResource.Phone</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Phone) ? "-" : Model.Phone)</dd>

        <dt class="col-sm-3 text-muted fw-normal">@StoreModelResource.IsActive</dt>
        <dd class="col-sm-9 mb-0">
            @if (Model.IsActive)
            {
                <span class="app-badge app-badge-success">@SharedResource.ObjectStatus_IsActive</span>
            }
            else
            {
                <span class="app-badge app-badge-neutral">@SharedResource.ObjectStatus_IsInactive</span>
            }
        </dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="storeId" value="@Model.StoreId" />

        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary">@SharedResource.Button_Cancel</a>
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash3 me-1"></i>@SharedResource.Button_Delete
            </button>
        </div>
    </form>
</div>
