@model RWPM.Models.ViewModels.ShiftDemand.CoverageWeekVM
@using RWPM.Models.ViewModels.ShiftDemand
@using R = RWPM.Resources.Shared.ShiftDemandResource

@{
    ViewData["Title"] = R.Coverage_Title;
    var dayLabels = new[] { R.Day_Mon, R.Day_Tue, R.Day_Wed, R.Day_Thu, R.Day_Fri, R.Day_Sat, R.Day_Sun };
    var weekEnd = Model.WeekStart.AddDays(6);
    var prevWeek = Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd");
    var nextWeek = Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd");
    int? routeStore = Model.IsStoreManager ? null : Model.StoreId;
    var isCurrentWeek = Model.Today >= Model.WeekStart && Model.Today <= weekEnd;
}

<form id="antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

<style>
    .cov-kpi-label { font-size: 13px; }
    .coverage-table td.cov-td { padding: .4rem !important; min-width: 108px; }
    .cov-cell { display: block; width: 100%; border-radius: var(--app-radius, 6px); border: 1px solid transparent; padding: .45rem .4rem; text-align: center; line-height: 1.15; background: #f6f8fa; color: #5b6b7c; }
    button.cov-cell { cursor: pointer; transition: border-color .15s ease; }
    button.cov-cell:hover { border-color: var(--app-border-strong, #D5DAE0); }
    button.cov-cell:focus-visible { outline: 2px solid var(--app-blue, #1554BB); outline-offset: 1px; }
    .cov-cell .cov-main { font-size: 1.05rem; font-weight: 700; }
    .cov-cell .cov-sub { font-size: .72rem; margin-top: .15rem; }
    .cov-cell .cov-pending { font-size: .7rem; margin-top: .25rem; }
    .cov-short { background: #fdecec; border-color: #f2c4c2; color: #a3302b; }
    .cov-ok { background: #e8f5ee; border-color: #bfe1cd; color: #23714f; }
    .cov-over { background: #fdf4e3; border-color: #f0d9a8; color: #8a5a00; }
    .cov-none { background: #f1f3f5; border-color: #dfe3e7; color: #6c757d; }
    .cov-zero { background: #fafbfc; border-color: #e9ecef; color: #8a96a3; }
    .cov-na { background: transparent; border: 1px dashed #e3e7eb; color: #b3bcc5; font-size: .75rem; padding: .9rem .4rem; }
    .cov-past { opacity: .72; }
    .coverage-table th.cov-today, .coverage-table td.cov-today { background: rgba(61,120,194,.06) !important; }
    .cov-legend .legend-swatch { display: inline-block; width: 12px; height: 12px; border-radius: 3px; border: 1px solid; vertical-align: -1px; margin-right: .3rem; }
    .cov-list-item { border: 1px solid var(--app-border, #E3E6EA); border-radius: var(--app-radius, 6px); padding: .5rem .65rem; }
    .cov-list-item.is-disabled { background: #f8f9fa; color: #8a96a3; }
    .cov-stat { border-radius: var(--app-radius, 6px); background: var(--app-surface-2, #F9FAFB); border: 1px solid var(--app-border, #E3E6EA); padding: .5rem .75rem; text-align: center; }
    .cov-stat .v { font-size: 1.25rem; font-weight: 600; font-variant-numeric: tabular-nums; }
</style>

<div class="container-fluid px-0 shift-coverage-page">
    <!-- Header -->
    <div class="app-page-header">
        <div>
            <h4 class="mb-1">@R.Coverage_Title</h4>
            <div class="text-muted small">
                @if (Model.IsStoreManager)
                {
                    <i class="bi bi-geo-alt me-1"></i>@R.Scope_Label <strong>@(Model.StoreName ?? "—")</strong>
                }
                else
                {
                    @R.Coverage_Subtitle
                }
            </div>
        </div>
        <div class="app-page-actions">
            <a class="btn btn-outline-secondary d-flex align-items-center" asp-action="Index" asp-route-storeId="@routeStore">
                <i class="bi bi-sliders me-1"></i> @R.Btn_ConfigureDemand
            </a>
        </div>
    </div>

    <!-- Summary cards -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card h-100"><div class="card-body p-3">
                <div class="text-muted cov-kpi-label">@R.Card_ShortShifts</div>
                <div class="fs-4 fw-semibold num mt-1 @(Model.Summary.ShortShifts > 0 ? "text-danger" : "")">@Model.Summary.ShortShifts</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100"><div class="card-body p-3">
                <div class="text-muted cov-kpi-label">@R.Card_MissingPeople</div>
                <div class="fs-4 fw-semibold num mt-1 @(Model.Summary.MissingPeople > 0 ? "text-danger" : "")">@Model.Summary.MissingPeople</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100"><div class="card-body p-3">
                <div class="text-muted cov-kpi-label">@R.Card_OverShifts</div>
                <div class="fs-4 fw-semibold num mt-1 @(Model.Summary.OverShifts > 0 ? "text-warning" : "")">@Model.Summary.OverShifts</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100"><div class="card-body p-3">
                <div class="text-muted cov-kpi-label">@R.Card_NotConfigured</div>
                <div class="fs-4 fw-semibold num mt-1">@Model.Summary.NotConfigured <span class="text-muted fs-6 fw-normal">/ @Model.Summary.TotalCells</span></div>
            </div></div>
        </div>
    </div>

    <!-- Filters / week navigation -->
    <div class="app-filter-panel">
        <form asp-action="Coverage" method="get" class="row g-2 align-items-center">
            <input type="hidden" name="weekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
            @if (!Model.IsStoreManager)
            {
                <div class="col-md-4">
                    <label class="form-label text-muted fw-semibold" for="filterStore">@R.Label_Store</label>
                    <select id="filterStore" name="storeId" class="form-select form-select-sm" onchange="this.form.submit()">
                        @foreach (var st in Model.Stores)
                        {
                            <option value="@st.StoreId" selected="@(st.StoreId == Model.StoreId)">@st.StoreName (@st.StoreCode)</option>
                        }
                    </select>
                </div>
            }
            <div class="col-auto">
                <label class="form-label text-muted fw-semibold d-block">@R.Label_Week</label>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="btn-group btn-group-sm" role="group">
                        <a class="btn btn-outline-secondary" asp-action="Coverage" asp-route-storeId="@routeStore" asp-route-weekStart="@prevWeek" title="@R.Nav_PrevWeek" aria-label="@R.Nav_PrevWeek"><i class="bi bi-chevron-left"></i></a>
                        <a class="btn btn-outline-secondary fw-semibold px-3 @(isCurrentWeek ? "active" : "")" asp-action="Coverage" asp-route-storeId="@routeStore" title="@R.Nav_ThisWeek">@R.Nav_ThisWeek</a>
                        <a class="btn btn-outline-secondary" asp-action="Coverage" asp-route-storeId="@routeStore" asp-route-weekStart="@nextWeek" title="@R.Nav_NextWeek" aria-label="@R.Nav_NextWeek"><i class="bi bi-chevron-right"></i></a>
                    </div>
                    <input type="date" class="form-control form-control-sm" style="width:auto" id="weekPicker" value="@Model.WeekStart.ToString("yyyy-MM-dd")" title="@R.Nav_PickWeek" aria-label="@R.Nav_PickWeek" />
                    <span class="fw-semibold small"><i class="bi bi-calendar3 me-1 text-muted"></i>@string.Format(R.Week_Label, Model.WeekStart.ToString("dd/MM"), weekEnd.ToString("dd/MM/yyyy"))</span>
                </div>
            </div>
            <div class="col-md-auto ms-md-auto">
                <div class="cov-legend d-flex flex-wrap gap-3 small text-muted">
                    <span><span class="legend-swatch cov-short"></span>@R.Legend_Short</span>
                    <span><span class="legend-swatch cov-ok"></span>@R.Legend_Enough</span>
                    <span><span class="legend-swatch cov-over"></span>@R.Legend_Over</span>
                    <span><span class="legend-swatch cov-none"></span>@R.Legend_NotConfigured</span>
                    <span><span class="legend-swatch cov-zero"></span>@R.Legend_NotNeeded</span>
                </div>
            </div>
        </form>
    </div>

    <!-- Coverage grid -->
    <div class="app-content-card management-table-card mb-3">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="fw-semibold">@(Model.StoreName ?? "—")</span>
            <span class="text-muted small"><i class="bi bi-info-circle me-1"></i>@R.Coverage_Hint</span>
        </div>
        @if (!Model.StoreId.HasValue)
        {
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-shop fs-3 d-block mb-2 text-muted"></i>@R.Store_None
            </div>
        }
        else if (!Model.Shifts.Any())
        {
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox fs-3 d-block mb-2 text-muted"></i>@R.Coverage_Empty
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table modern-table align-middle mb-0 coverage-table">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width:170px">@R.Col_Shift</th>
                            @for (var i = 0; i < Model.Days.Count; i++)
                            {
                                var day = Model.Days[i];
                                <th class="text-center @(day == Model.Today ? "cov-today" : "")">
                                    <div>@dayLabels[i]</div>
                                    <div class="small fw-normal @(day == Model.Today ? "text-primary fw-semibold" : "text-muted")">@day.ToString("dd/MM")</div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var shift in Model.Shifts)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold text-dark">@shift.ShiftName</div>
                                    <div class="small text-muted"><i class="bi bi-clock me-1"></i>@shift.TimeRange</div>
                                </td>
                                @foreach (var day in Model.Days)
                                {
                                    var row = Model.Get(shift.ShiftId, day);
                                    var isPast = day < Model.Today;
                                    <td class="cov-td @(day == Model.Today ? "cov-today" : "")">
                                        @if (row == null)
                                        {
                                            <div class="cov-cell cov-na" title="@R.Cell_NotApplicable">@R.Cell_NotApplicable</div>
                                        }
                                        else
                                        {
                                            string css, sub;
                                            if (!row.Required.HasValue) { css = "cov-none"; sub = R.Legend_NotConfigured; }
                                            else if (row.Shortage > 0) { css = "cov-short"; sub = string.Format(R.Cell_Short, row.Shortage); }
                                            else if (row.Over > 0) { css = "cov-over"; sub = string.Format(R.Cell_Over, row.Over); }
                                            else if (row.Required.Value == 0) { css = "cov-zero"; sub = R.Legend_NotNeeded; }
                                            else { css = "cov-ok"; sub = R.Legend_Enough; }
                                            <button type="button" class="cov-cell @css @(isPast ? "cov-past" : "")"
                                                    data-shift="@row.ShiftId" data-date="@day.ToString("yyyy-MM-dd")"
                                                    title="@($"{row.ShiftName} · {day:dd/MM/yyyy}")">
                                                <div class="cov-main">
                                                    @row.Approved<span class="fw-normal opacity-75">/@(row.Required?.ToString() ?? "?")</span>
                                                    @if (row.IsOverride)
                                                    {
                                                        <i class="bi bi-pin-angle-fill small ms-1" title="@R.Cell_Override"></i>
                                                    }
                                                </div>
                                                <div class="cov-sub">@sub</div>
                                                @if (row.Pending > 0)
                                                {
                                                    <div class="cov-pending"><span class="app-badge app-badge-warning">@string.Format(R.Cell_Pending, row.Pending)</span></div>
                                                }
                                            </button>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal: cell detail -->
<div class="modal fade" id="cellModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span id="cellTitle">@R.Detail_Title</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedResource.Button_Close"></button>
            </div>
            <div class="modal-body" id="cellBody">
                <div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span>@R.Common_Loading</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@SharedResource.Button_Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.RWPM = window.RWPM || {};
        RWPM.shiftDemandCoverage = {
            storeId: @Json.Serialize(Model.StoreId),
            routeStore: @Json.Serialize(routeStore),
            i18n: {
                loading: @Json.Serialize(R.Common_Loading),
                error: @Json.Serialize(R.Common_Error),
                required: @Json.Serialize(R.Detail_Required),
                approved: @Json.Serialize(R.Detail_Approved),
                pending: @Json.Serialize(R.Detail_PendingCount),
                shortage: @Json.Serialize(R.Detail_Shortage),
                notConfigured: @Json.Serialize(R.Detail_NotConfiguredNote),
                overrideNote: @Json.Serialize(R.Cell_Override),
                past: @Json.Serialize(R.Detail_PastNote),
                assignedList: @Json.Serialize(R.Detail_AssignedList),
                pendingList: @Json.Serialize(R.Detail_PendingList),
                suggestions: @Json.Serialize(R.Detail_Suggestions),
                suggestionsHint: @Json.Serialize(R.Detail_SuggestionsHint),
                noAssigned: @Json.Serialize(R.Detail_NoAssigned),
                noPending: @Json.Serialize(R.Detail_NoPending),
                noSuggestions: @Json.Serialize(R.Detail_NoSuggestions),
                approve: @Json.Serialize(R.Btn_Approve),
                assign: @Json.Serialize(R.Btn_Assign),
                available: @Json.Serialize(R.Suggest_Available),
                noDeclared: @Json.Serialize(R.Suggest_NoDeclared),
                approvedBy: @Json.Serialize(R.Detail_ApprovedBy),
                registeredAt: @Json.Serialize(R.Detail_RegisteredAt),
                approveConfirm: @Json.Serialize(R.Approve_Confirm),
                approveSuccess: @Json.Serialize(R.Approve_Success),
                assignConfirm: @Json.Serialize(R.Assign_Confirm),
                overTitle: @Json.Serialize(R.Warn_OverDemandTitle),
                overFormat: @Json.Serialize(R.Warn_OverDemand),
                shiftLabel: @Json.Serialize(R.Warn_ShiftLabel),
                shiftPrefix: @Json.Serialize(R.Warn_ShiftPrefixCheck),
                confirmContinue: @Json.Serialize(R.Warn_ConfirmContinue),
                availabilityTitle: @Json.Serialize(RWPM.Resources.Shared.ShiftRegistrationResource.Warn_ConfirmTitle)
            }
        };
    </script>
    <script src="~/js/shift-demand/coverage.js" asp-append-version="true"></script>
}
