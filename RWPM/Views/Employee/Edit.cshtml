@model RWPM.Models.ViewModels.Employee.EmployeeEditVM
@using RWPM.Resources.Shared
@using EmployeeModelResource = RWPM.Resources.Models.Employee;
@using EmployeeSharedResource = RWPM.Resources.Shared.Employee;

@{
    ViewData["Title"] = EmployeeSharedResource.Edit_PageHeader;
}

<div class="d-flex justify-content-between align-items-center mb-3 border-4 border-primary border-start rounded-start ps-2">
    <h4 class="mb-0">
        <i class="bi bi-pencil-square me-2"></i> @EmployeeSharedResource.Edit_PageTitle
    </h4>

    <nav class="d-none d-md-block ms-auto"
         style="--bs-breadcrumb-divider: url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%278%27 height=%278%27%3E%3Cpath d=%27M2.5 0L1 1.5 3.5 4 1 6.5 2.5 8l4-4-4-4z%27 fill=%276c757d%27/%3E%3C/svg%3E');"
         aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a asp-action="Index">@EmployeeSharedResource.Index_PageTitle</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@EmployeeSharedResource.Edit_PageTitle</li>
        </ol>
    </nav>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="EmployeeId" />

    <div class="form-group mb-3">
        <label class="form-label required" asp-for="EmployeeCode"></label>
        <input class="form-control" asp-for="EmployeeCode" placeholder="@EmployeeSharedResource.PlaceHolder_EmployeeCode" autocomplete="off" />
        <span asp-validation-for="EmployeeCode" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="form-label required" asp-for="Username"></label>
        <select class="form-select" asp-for="Username" asp-items="@(ViewBag.AccountList as SelectList)">
        </select>
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="form-label required" asp-for="StoreId"></label>
        <select class="form-select" asp-for="StoreId" asp-items="@(ViewBag.StoreList as SelectList)">
        </select>
        <span asp-validation-for="StoreId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="form-label required" asp-for="JoinDate"></label>
        <input class="form-control" type="date" asp-for="JoinDate" value="@Model.JoinDate.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="JoinDate" class="text-danger"></span>
    </div>

    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" asp-for="IsActive" />
        <label class="form-check-label" asp-for="IsActive">@EmployeeSharedResource.Status_Active</label>
    </div>

    <div class="form-group mt-3 text-end">
        <a asp-action="Index" class="btn btn-secondary me-2">
            <i class="bi bi-arrow-return-left me-2"></i>@SharedResource.Button_GoBack
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-floppy me-2"></i>@SharedResource.Button_Save
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
