@model RWPM.Models.ViewModels.Employee.EmployeeListVM
@using RWPM.Common.Helper
@using RWPM.Common.Enums
@using RWPM.Resources.Shared
@using EmployeeModelResource = RWPM.Resources.Models.Employee;
@using EmployeeSharedResource = RWPM.Resources.Shared.Employee;

@{
    ViewData["Title"] = @EmployeeSharedResource.Index_PageTitle;
    var stats = ViewBag.Statistics as RWPM.Models.ViewModels.Employee.EmployeeStatisticsDto;
    bool isStoreManager = ViewBag.IsStoreManager ?? false;
    bool canManage = User.IsChainManager();
}

@Html.AntiForgeryToken()

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="app-page-header">
        <div>
            <h4 class="mb-1">@EmployeeSharedResource.Index_PageHeader</h4>
            <div class="text-muted small">@EmployeeSharedResource.Index_SubTitle</div>
        </div>
        <div class="app-page-actions">
            <!-- Dropdown Excel -->
            <div class="dropdown">
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-file-earmark-excel me-1"></i> @EmployeeSharedResource.Excel_Action
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item d-flex align-items-center"
                           asp-action="ExportExcel"
                           asp-route-Search="@Model.Search"
                           asp-route-StoreId="@Model.StoreId"
                           asp-route-Status="@Model.Status">
                            <i class="bi bi-file-earmark-arrow-down text-muted me-2"></i> @EmployeeSharedResource.ExportExcel
                        </a>
                    </li>
                    @if (canManage)
                    {
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center" asp-action="DownloadTemplate">
                                <i class="bi bi-download text-muted me-2"></i> @EmployeeSharedResource.Excel_DownloadTemplate
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#importExcelModal">
                                <i class="bi bi-file-earmark-arrow-up text-muted me-2"></i> @EmployeeSharedResource.Excel_Import
                            </a>
                        </li>
                    }
                </ul>
            </div>
            @* Nhân sự mới được tạo tại Quản lý tài khoản (Acc/Create) — không đặt nút "Thêm nhân viên" ở màn hình này *@
        </div>
    </div>

    <!-- KPI -->
    @if (stats != null)
    {
        <div class="row g-3 mb-3">
            <div class="col-6 col-md-3">
                <div class="card p-3 h-100">
                    <div class="text-muted" style="font-size: 13px;">@EmployeeSharedResource.Stat_TotalEmployees</div>
                    <div class="fs-4 fw-semibold mt-1 tabular">@stats.TotalEmployees</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card p-3 h-100">
                    <div class="text-muted" style="font-size: 13px;">@EmployeeSharedResource.Stat_Active</div>
                    <div class="fs-4 fw-semibold mt-1 tabular">@stats.ActiveEmployees</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card p-3 h-100">
                    <div class="text-muted" style="font-size: 13px;">@EmployeeSharedResource.Stat_FullTime / @EmployeeSharedResource.Stat_PartTime</div>
                    <div class="fs-4 fw-semibold mt-1 tabular">@stats.FullTimeCount <span class="text-muted fs-6 fw-normal">/</span> @stats.PartTimeCount</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card p-3 h-100">
                    <div class="text-muted" style="font-size: 13px;">@EmployeeSharedResource.Stat_Probation</div>
                    <div class="fs-4 fw-semibold mt-1 tabular @(stats.ProbationCount > 0 ? "text-warning" : "")">@stats.ProbationCount</div>
                </div>
            </div>
        </div>
    }

    <!-- Search Toolbar -->
    <div class="app-filter-panel">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5 col-lg-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" asp-for="Search" class="form-control border-start-0 ps-0" placeholder="@EmployeeSharedResource.Placeholder_Search" aria-label="@SharedResource.Button_Search" />
                </div>
            </div>

            @if (!isStoreManager)
            {
                <div class="col-md-3 col-lg-3">
                    <select asp-for="StoreId" asp-items="Model.StoreSelectList" class="form-select form-select-sm" aria-label="@EmployeeModelResource.Store">
                    </select>
                </div>
            }

            <div class="col-md-2 col-lg-2">
                <select name="Status" class="form-select form-select-sm" aria-label="@EmployeeModelResource.Status">
                    <option value="all" selected="@(Model.Status == "all")">-- @EmployeeSharedResource.Status_All --</option>
                    <option value="active" selected="@(Model.Status == "active")">@EmployeeSharedResource.Status_Active</option>
                    <option value="inactive" selected="@(Model.Status == "inactive")">@EmployeeSharedResource.Status_Inactive</option>
                </select>
            </div>

            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-funnel me-1"></i> @SharedResource.Button_Search
                </button>
                <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-muted" title="@SharedResource.Button_Reset">
                    <i class="bi bi-arrow-clockwise"></i> @SharedResource.Button_Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Table Card -->
    <div class="app-content-card management-table-card mb-3">
        <div class="table-responsive">
            <table class="table modern-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>@EmployeeSharedResource.Th_EmployeeName</th>
                        <th>@EmployeeSharedResource.Th_EmployeeIdAccount</th>
                        <th>@EmployeeModelResource.EmployeeRole</th>
                        <th>@EmployeeModelResource.EmploymentType</th>
                        <th>@EmployeeModelResource.Store</th>
                        <th>@EmployeeModelResource.EmploymentStatus</th>
                        <th class="text-end">@EmployeeModelResource.StartDate</th>
                        <th class="text-center">@EmployeeModelResource.Active</th>
                        <th class="text-center">@SharedResource.Button_Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PanigationResponse.Data != null && Model.PanigationResponse.Data.Any())
                    {
                        foreach (var emp in Model.PanigationResponse.Data)
                        {
                            var fullName = emp.Account?.FullName ?? "-";
                            var email = emp.Account?.Email;
                            var phone = emp.Account?.PhoneNumber;
                            <tr id="row-emp-@emp.EmployeeId" class="@(emp.Status == EmploymentStatus.Resigned ? "text-muted" : "")">
                                <td>
                                    <div>
                                        <div class="fw-medium">@fullName</div>
                                        <div class="d-flex align-items-center gap-2 small text-muted">
                                                @if (!string.IsNullOrEmpty(phone))
                                                {
                                                    <span>@phone</span>
                                                }
                                                @if (!string.IsNullOrEmpty(email))
                                                {
                                                    <span>@email</span>
                                                }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="font-monospace small">@emp.EmployeeCode</div>
                                    <small class="text-muted">@emp.Username</small>
                                </td>
                                <td>
                                    @if (emp.Account != null)
                                    {
                                        <span>@UIHelper.GetDisplayName(emp.Account.Role)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    @if (emp.EmploymentType == EmploymentType.FullTime)
                                    {
                                        <span class="app-badge app-badge-neutral">@EmployeeSharedResource.Badge_FullTime</span>
                                    }
                                    else if (emp.EmploymentType == EmploymentType.PartTime)
                                    {
                                        <span class="app-badge app-badge-neutral">@EmployeeSharedResource.Badge_PartTime</span>
                                    }
                                    else
                                    {
                                        <span class="app-badge app-badge-neutral">@EmployeeSharedResource.Badge_Intern</span>
                                    }
                                </td>
                                <td>
                                    @if (emp.Store != null)
                                    {
                                        <div class="small">@emp.Store.StoreName</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">@EmployeeSharedResource.Unassigned</span>
                                    }
                                </td>
                                <td>
                                    @if (emp.Status == EmploymentStatus.Official)
                                    {
                                        <span class="app-status"><span class="app-dot app-dot-success"></span>@UIHelper.GetDisplayName(emp.Status)</span>
                                    }
                                    else if (emp.Status == EmploymentStatus.Probation)
                                    {
                                        <span class="app-status"><span class="app-dot app-dot-warning"></span>@UIHelper.GetDisplayName(emp.Status)</span>
                                    }
                                    else if (emp.Status == EmploymentStatus.Resigned)
                                    {
                                        <span class="app-status" title="@emp.ResignReason"><span class="app-dot app-dot-danger"></span>@EmployeeSharedResource.Badge_Resigned</span>
                                    }
                                    else
                                    {
                                        <span class="app-status"><span class="app-dot app-dot-info"></span>@UIHelper.GetDisplayName(emp.Status)</span>
                                    }
                                </td>
                                <td class="text-end small text-muted">
                                    @emp.JoinDate.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-center">
                                    <label class="status-choice">
                                        <input class="form-check-input active-toggle"
                                               type="checkbox"
                                               data-id="@emp.EmployeeId"
                                               data-name="@fullName"
                                               @(emp.IsActive ? "checked" : "")
                                               @(emp.Status == EmploymentStatus.Resigned ? "disabled" : "")
                                               title="@(emp.IsActive ? EmployeeSharedResource.Status_Active : EmployeeSharedResource.Status_Inactive)" />
                                        <span class="status-dot @(emp.IsActive ? "is-active" : "is-inactive")"></span>
                                        <span class="status-choice-text">@(emp.IsActive ? SharedResource.ObjectStatus_IsActive : SharedResource.ObjectStatus_IsInactive)</span>
                                    </label>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-action-group" role="group">
                                        <a asp-action="Edit"
                                           asp-route-id="@emp.EmployeeId"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="@EmployeeSharedResource.Button_Edit" aria-label="@EmployeeSharedResource.Button_Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        @if (emp.Status != EmploymentStatus.Resigned)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    data-id="@emp.EmployeeId" data-name="@fullName" data-code="@emp.EmployeeCode"
                                                    onclick="openResignEmployeeModal(this.dataset.id, this.dataset.name, this.dataset.code)"
                                                    title="@EmployeeSharedResource.Button_Resign" aria-label="@EmployeeSharedResource.Button_Resign">
                                                <i class="bi bi-box-arrow-right"></i>
                                            </button>
                                        }

                                        @if (canManage)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    data-id="@emp.EmployeeId" data-name="@fullName" data-code="@emp.EmployeeCode"
                                                    onclick="openDeleteEmployeeModal(this.dataset.id, this.dataset.name, this.dataset.code)"
                                                    title="@EmployeeSharedResource.Button_Delete" aria-label="@EmployeeSharedResource.Button_Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-2 text-muted"></i>
                                @EmployeeSharedResource.NoDataFound
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @await Html.PartialAsync("_PaginationPartial", Model.PanigationResponse.ToPaginationRes(new Dictionary<string, string?>() {
        { "Search", Model.Search },
        { "StoreId", Model.StoreId?.ToString() },
        { "Status", Model.Status }
    }))
</div>

<!-- Modal Xử lý thôi việc nhân viên (Offboarding) -->
<div class="modal fade" id="modalResignEmployee" tabindex="-1" aria-labelledby="modalResignEmployeeLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Resign" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="resignEmp_Id" name="employeeId" />
                <div class="modal-header py-3">
                    <h5 class="modal-title" id="modalResignEmployeeLabel">@EmployeeSharedResource.Modal_ResignTitle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedResource.Button_Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-warning py-2 px-3 small d-flex align-items-start mb-3">
                        <i class="bi bi-exclamation-triangle me-2 mt-1"></i>
                        <div>
                            @EmployeeSharedResource.Modal_ResignNotice
                            <div class="mt-1 fw-semibold"><span id="resignEmp_Name"></span> &nbsp;<span id="resignEmp_Code" class="font-monospace"></span></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required" for="resignEmp_Date">@EmployeeModelResource.ResignDate</label>
                        <input type="date" id="resignEmp_Date" name="resignDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="resignEmp_Reason">@EmployeeModelResource.ResignReason</label>
                        <textarea id="resignEmp_Reason" name="resignReason" class="form-control" rows="3" maxlength="255" placeholder="@EmployeeSharedResource.Placeholder_ResignReason"></textarea>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">@SharedResource.Button_Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-check2 me-1"></i> @EmployeeSharedResource.Button_Resign
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Xác Nhận Xóa Nhân Viên -->
<div class="modal fade" id="modalDeleteEmployee" tabindex="-1" aria-labelledby="modalDeleteEmployeeLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-3">
                <h5 class="modal-title" id="modalDeleteEmployeeLabel">@EmployeeSharedResource.Modal_DeleteTitle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedResource.Button_Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="deleteEmp_Id" />
                <div class="alert alert-danger py-2 px-3 small d-flex align-items-start mb-0">
                    <i class="bi bi-exclamation-triangle me-2 mt-1"></i>
                    <div>
                        @EmployeeSharedResource.Modal_DeleteWarning
                        <div class="mt-1 fw-semibold"><span id="deleteEmp_Name"></span> &nbsp;<span id="deleteEmp_Code" class="font-monospace"></span></div>
                        <div class="mt-1">@EmployeeSharedResource.Modal_DeleteCannotUndo</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">@SharedResource.Button_Cancel</button>
                <button type="button" id="deleteEmp_BtnConfirm" class="btn btn-sm btn-danger" onclick="confirmDeleteEmployee()">
                    <i class="bi bi-trash me-1"></i> @EmployeeSharedResource.Modal_DeleteConfirmBtn
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Import Excel (2 bước: Chọn file -> Xem trước & Kiểm tra -> Chấp thuận) -->
<div class="modal fade" id="importExcelModal" tabindex="-1" aria-labelledby="importExcelModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-3">
                <h5 class="modal-title" id="importExcelModalLabel">@EmployeeSharedResource.Excel_ImportTitle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedResource.Button_Close"></button>
            </div>
            
            <div class="modal-body p-4">
                <!-- BƯỚC 1: Chọn file Excel -->
                <div id="empImportStep1">
                    <div class="alert alert-info py-2 px-3 small mb-3 d-flex align-items-center">
                        <i class="bi bi-info-circle me-2 flex-shrink-0"></i>
                        <span>@EmployeeSharedResource.Excel_Step1_Note</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required" for="empImportFileInput">@EmployeeSharedResource.Excel_SelectFile</label>
                        <input type="file" id="empImportFileInput" class="form-control" accept=".xlsx" />
                        <div class="form-text">@EmployeeSharedResource.Excel_SupportedFormat</div>
                    </div>

                    <div id="empImportStep1Error" class="alert alert-danger py-2 px-3 small d-none"></div>
                </div>

                <!-- BƯỚC 2: Xem trước dữ liệu & Kiểm tra trùng lặp -->
                <div id="empImportStep2" class="d-none">
                    <!-- Thống kê kết quả kiểm tra -->
                    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <span class="app-badge app-badge-neutral">@EmployeeSharedResource.Excel_Summary_Total <strong id="empPreviewTotal">0</strong></span>
                            <span class="app-badge app-badge-success">@EmployeeSharedResource.Excel_Summary_Valid <strong id="empPreviewValid">0</strong></span>
                            <span class="app-badge app-badge-danger">@EmployeeSharedResource.Excel_Summary_Invalid <strong id="empPreviewInvalid">0</strong></span>
                        </div>
                        <div class="small text-muted">
                            <i class="bi bi-shield-check me-1"></i> @EmployeeSharedResource.Excel_AutoValidated
                        </div>
                    </div>

                    <!-- Cảnh báo nếu có dòng lỗi / trùng -->
                    <div id="empPreviewWarning" class="alert alert-warning py-2 px-3 small mb-3 d-none">
                        <i class="bi bi-exclamation-triangle me-1"></i> @EmployeeSharedResource.Excel_Preview_Warning_HasErrors
                    </div>
                    <div id="empPreviewSuccessNotice" class="alert alert-success py-2 px-3 small mb-3 d-none">
                        <i class="bi bi-check-circle me-1"></i> @EmployeeSharedResource.Excel_Preview_All_Valid
                    </div>
                    <div id="empPreviewDangerNotice" class="alert alert-danger py-2 px-3 small mb-3 d-none">
                        <i class="bi bi-x-circle me-1"></i> @EmployeeSharedResource.Excel_Preview_No_Valid
                    </div>

                    <!-- Bảng Preview dữ liệu -->
                    <div class="table-responsive border rounded" style="max-height: 420px; overflow-y: auto;">
                        <table class="table table-sm align-middle mb-0 text-nowrap">
                            <thead class="sticky-top">
                                <tr>
                                    <th class="text-end" style="width: 50px;">@EmployeeSharedResource.Excel_Col_Row</th>
                                    <th class="text-center" style="width: 120px;">@EmployeeSharedResource.Excel_Col_Status</th>
                                    <th>@EmployeeSharedResource.Excel_Col_Username</th>
                                    <th>@EmployeeSharedResource.Excel_Col_FullName</th>
                                    <th>@EmployeeSharedResource.Excel_Col_Email</th>
                                    <th>@EmployeeSharedResource.Excel_Col_Phone</th>
                                    <th>@EmployeeSharedResource.Excel_Col_Role</th>
                                    <th>@EmployeeSharedResource.Excel_Col_Store</th>
                                    <th>@EmployeeSharedResource.Excel_Col_EmpCode</th>
                                    <th style="min-width: 260px;">@EmployeeSharedResource.Excel_Col_Errors</th>
                                </tr>
                            </thead>
                            <tbody id="empPreviewTableBody">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="modal-footer py-2">
                <!-- Footer buttons cho Bước 1 -->
                <div id="empStep1Footer" class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">@SharedResource.Button_Close</button>
                    <button type="button" id="empBtnPreview" class="btn btn-sm btn-primary px-3" onclick="previewEmpImport()">
                        <i class="bi bi-search me-1"></i> @EmployeeSharedResource.Excel_Btn_Preview
                    </button>
                </div>

                <!-- Footer buttons cho Bước 2 -->
                <div id="empStep2Footer" class="d-flex gap-2 d-none">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="backToEmpStep1()">
                        <i class="bi bi-arrow-left me-1"></i> @EmployeeSharedResource.Excel_Btn_Back
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">@SharedResource.Button_Close</button>
                    <button type="button" id="empBtnConfirm" class="btn btn-sm btn-primary px-3" onclick="confirmEmpImport()">
                        <i class="bi bi-check2-circle me-1"></i> @EmployeeSharedResource.Excel_Btn_Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.RWPM = window.RWPM || {};
        RWPM.employeeIndex = {
            urls: {
                updateActiveStatus: '@Url.Action("UpdateActiveStatus", "Employee")',
                deleteConfirmed: '@Url.Action("DeleteConfirmed", "Employee")',
                previewImport: '@Url.Action("PreviewImportExcel", "Employee")',
                confirmImport: '@Url.Action("ConfirmImportExcel", "Employee")'
            },
            i18n: {
                active: @Json.Serialize(SharedResource.ObjectStatus_IsActive),
                inactive: @Json.Serialize(SharedResource.ObjectStatus_IsInactive),
                toastActive: @Json.Serialize(EmployeeSharedResource.Status_Active),
                toastInactive: @Json.Serialize(EmployeeSharedResource.Status_Inactive),
                failed: @Json.Serialize(SharedResource.OperationFailed),
                deleted: @Json.Serialize(SharedResource.Notification_DeletedSuccessfully),
                deleteBtn: @Json.Serialize(EmployeeSharedResource.Modal_DeleteConfirmBtn),
                processing: @Json.Serialize(SharedResource.Processing),
                selectFile: @Json.Serialize(EmployeeSharedResource.Excel_SelectFile),
                verifying: @Json.Serialize(EmployeeSharedResource.Excel_Btn_Verifying),
                preview: @Json.Serialize(EmployeeSharedResource.Excel_Btn_Preview),
                saving: @Json.Serialize(EmployeeSharedResource.Excel_Btn_Saving),
                confirm: @Json.Serialize(EmployeeSharedResource.Excel_Btn_Confirm),
                valid: @Json.Serialize(EmployeeSharedResource.Excel_Status_Valid),
                invalid: @Json.Serialize(EmployeeSharedResource.Excel_Status_Invalid),
                employeeNumber: @Json.Serialize(EmployeeSharedResource.Label_EmployeeNumber),
                serverConnectionError: @Json.Serialize(EmployeeSharedResource.Excel_ServerConnectionError),
                saveFailed: @Json.Serialize(EmployeeSharedResource.Toast_SaveFailed),
                saveError: @Json.Serialize(EmployeeSharedResource.Toast_SaveError)
            }
        };
    </script>
    <script src="~/js/employee/index.js" asp-append-version="true"></script>
}
