@model RWPM.Models.ViewModels.Employee.EmployeeListVM
@using RWPM.Common.Helper
@using RWPM.Resources.Shared
@using EmployeeModelResource = RWPM.Resources.Models.Employee;
@using EmployeeSharedResource = RWPM.Resources.Shared.Employee;
@{
    ViewData["Title"] = @EmployeeSharedResource.Index_PageTitle;
}

@Html.AntiForgeryToken()

<div>
    <div class="mb-3">
        <h4 class="fw-semibold text-dark d-flex align-items-center">
            <i class="bi bi-person-badge me-2"></i>
            @EmployeeSharedResource.Index_PageHeader
        </h4>
    </div>

    <!-- Search form -->
    <form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-4 col-lg-3">
            <label class="form-label small" asp-for="Search">@EmployeeSharedResource.Search</label>
            <input type="text" asp-for="Search" class="form-control form-control-sm" placeholder="@EmployeeSharedResource.Placeholder_Search" />
        </div>

        <div class="col-md-4 col-lg-3">
            <label class="form-label small" asp-for="StoreId">@EmployeeSharedResource.Store</label>
            <select asp-for="StoreId" asp-items="Model.StoreSelectList" class="form-select form-select-sm">
            </select>
        </div>

        <div class="col-md-4 col-lg-2">
            <label class="form-label small">@EmployeeSharedResource.Status</label>
            <select name="Status" class="form-select form-select-sm">
                <option value="all" selected="@(Model.Status == "all")">-- @EmployeeSharedResource.Status_All --</option>
                <option value="active" selected="@(Model.Status == "active")">@EmployeeSharedResource.Status_Active</option>
                <option value="inactive" selected="@(Model.Status == "inactive")">@EmployeeSharedResource.Status_Inactive</option>
            </select>
        </div>

        <div class="col-md-12 col-lg-4 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-search"></i>
                @SharedResource.Button_Search
            </button>
            <a asp-action="Index" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-x-lg"></i>
                @SharedResource.Button_Reset
            </a>
        </div>
    </form>

    <!-- Create Button -->
    <div class="text-end mb-2">
        <a asp-action="Create" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> @EmployeeSharedResource.Button_Create
        </a>
    </div>

    <!-- Table Container -->
    <div style="max-height: 550px; overflow-y: auto;" class="shadow-sm rounded border">
        <table class="table table-hover align-middle mb-0 table-bordered">
            <thead class="bg-light" style="position: sticky; top: 0; z-index: 10;">
                <tr>
                    <th class="text-nowrap">@EmployeeModelResource.EmployeeID</th>
                    <th class="text-nowrap">@EmployeeModelResource.EmployeeFullName</th>
                    <th class="text-nowrap">@EmployeeModelResource.EmployeeAcc</th>
                    <th class="text-nowrap">@EmployeeModelResource.EmployeeRole</th>
                    <th class="text-nowrap">@EmployeeModelResource.Store</th>
                    <th class="text-nowrap text-center">@EmployeeModelResource.StartDate</th>
                    <th class="text-nowrap text-center">@EmployeeModelResource.Status</th>
                    <th class="text-nowrap text-center">@SharedResource.Button_Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PanigationResponse.Data != null && Model.PanigationResponse.Data.Any())
                {
                    foreach (var emp in Model.PanigationResponse.Data)
                    {
                        <tr id="row-emp-@emp.EmployeeId">
                            <td class="fw-semibold text-primary">@emp.EmployeeCode</td>
                            <td class="fw-medium">@(emp.Account?.FullName ?? "-")</td>
                            <td><code>@emp.Username</code></td>
                            <td>
                                @if (emp.Account != null)
                                {
                                    <span class="badge bg-info text-dark">@UIHelper.GetDisplayName(emp.Account.Role)</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>
                                @if (emp.Store != null)
                                {
                                    <span>@emp.Store.StoreName <small class="text-muted">(@emp.Store.StoreCode)</small></span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td class="text-center">@emp.JoinDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    <input class="form-check-input active-toggle"
                                           type="checkbox"
                                           data-id="@emp.EmployeeId"
                                           @(emp.IsActive ? "checked" : "") />
                                </div>
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@emp.EmployeeId" class="btn btn-sm btn-outline-primary me-1" title="@EmployeeSharedResource.Button_Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@emp.EmployeeId" class="btn btn-sm btn-outline-danger" title="@EmployeeSharedResource.Button_Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            Không tìm thấy nhân viên nào
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @await Html.PartialAsync("_PaginationPartial", Model.PanigationResponse.ToPaginationRes(new Dictionary<string, string?>() {
        { "Search", Model.Search },
        { "StoreId", Model.StoreId?.ToString() },
        { "Status", Model.Status }
    }))
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.active-toggle').change(function () {
                var checkbox = $(this);
                var employeeId = checkbox.data('id');
                var isActive = checkbox.is(':checked');

                $.ajax({
                    url: '/Employee/UpdateActiveStatus/' + employeeId,
                    type: 'POST',
                    contentType: 'application/json',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify({
                        employeeId: employeeId,
                        isActive: isActive
                    }),
                    success: function () {
                        toastr.success('Cap nhat trang thai thanh cong!');
                    },
                    error: function (xhr) {
                        checkbox.prop('checked', !isActive);
                        toastr.error('Cap nhat that bai: ' + (xhr.responseText || 'Da co loi xay ra.'));
                    }
                });
            });
        });
    </script>
}

