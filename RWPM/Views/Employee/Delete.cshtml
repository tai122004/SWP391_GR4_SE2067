@model RWPM.Models.Entities.Employee
@using RWPM.Common.Helper
@using RWPM.Resources.Shared
@using EmployeeModelResource = RWPM.Resources.Models.Employee;
@using EmployeeSharedResource = RWPM.Resources.Shared.Employee;

@{
    ViewData["Title"] = EmployeeSharedResource.Delete_PageTitle;
}

<div class="app-page-header">
    <div>
        <h4 class="mb-1">@EmployeeSharedResource.Delete_PageHeader</h4>
        <div class="text-muted small">@EmployeeSharedResource.Delete_Confirm</div>
    </div>
    <nav class="d-none d-md-block" aria-label="@RWPM.Resources.Shared.Employee.Aria_Breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-action="Index">@EmployeeSharedResource.Index_PageHeader</a></li>
            <li class="breadcrumb-item active" aria-current="page">@EmployeeSharedResource.Delete_PageHeader</li>
        </ol>
    </nav>
</div>

<div class="app-content-card p-4" style="max-width: 760px;">
    <div class="alert alert-warning py-2 px-3 small d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <div><strong>@EmployeeSharedResource.Warning:</strong> @EmployeeSharedResource.Delete_Confirm</div>
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-3 text-muted fw-normal">@EmployeeModelResource.EmployeeID</dt>
        <dd class="col-sm-9 fw-medium font-monospace">@Model.EmployeeCode</dd>

        <dt class="col-sm-3 text-muted fw-normal">@EmployeeModelResource.EmployeeAcc</dt>
        <dd class="col-sm-9"><span class="font-monospace">@Model.Username</span> @(Model.Account != null ? $"({Model.Account.FullName})" : "")</dd>

        <dt class="col-sm-3 text-muted fw-normal">@EmployeeModelResource.Store</dt>
        <dd class="col-sm-9">@(Model.Store != null ? $"{Model.Store.StoreName} ({Model.Store.StoreCode})" : "-")</dd>

        <dt class="col-sm-3 text-muted fw-normal">@EmployeeModelResource.StartDate</dt>
        <dd class="col-sm-9">@Model.JoinDate.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3 text-muted fw-normal">@EmployeeModelResource.Status</dt>
        <dd class="col-sm-9 mb-0">
            @if (Model.IsActive)
            {
                <span class="app-badge app-badge-success">@EmployeeSharedResource.Status_Active</span>
            }
            else
            {
                <span class="app-badge app-badge-neutral">@EmployeeSharedResource.Status_Inactive</span>
            }
        </dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="employeeId" value="@Model.EmployeeId" />

        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary">@EmployeeSharedResource.Cancel</a>
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash3 me-1"></i>@EmployeeSharedResource.Confirm_Delete
            </button>
        </div>
    </form>
</div>
