@using Microsoft.AspNetCore.Mvc.Localization
@using RWPM.Resources.Shared
@using System.Globalization

@{
    ViewData["Title"] = ShiftRegistrationResource.ShiftRegistration;
    var currentStoreId = ViewBag.CurrentStoreId as int?;
    string? currentStoreName = null;
    if (ViewBag.AllStores != null && currentStoreId.HasValue)
    {
        foreach (var st in ViewBag.AllStores)
        {
            if (st.StoreId == currentStoreId)
            {
                currentStoreName = st.StoreName;
                break;
            }
        }
    }
    bool isManager = (ViewBag.IsManager == true);
}

<div class="container-fluid px-0 shift-registration-page">
    @Html.AntiForgeryToken()

    <!-- Page Header -->
    <div class="app-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold text-dark mb-0">@ShiftRegistrationResource.ShiftRegistration</h1>
                @if (!string.IsNullOrEmpty(currentStoreName))
                {
                    <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 fs-7 fw-semibold d-inline-flex align-items-center gap-1">
                        <i class="bi bi-shop"></i>
                        <span>@ShiftRegistrationResource.Header_Branch <strong>@currentStoreName</strong></span>
                    </span>
                }
            </div>
            <p class="text-muted small mb-0">@ShiftRegistrationResource.Header_Description</p>
        </div>

        <!-- Legend / Chú thích trạng thái -->
        <div class="status-legend-bar d-flex flex-wrap align-items-center gap-2 p-2 bg-white rounded-3 border shadow-xs small">
            <span class="legend-item"><span class="legend-dot dot-available"></span> @ShiftRegistrationResource.Status_NotRegistered</span>
            <span class="legend-item"><span class="legend-dot dot-selected"></span> @ShiftRegistrationResource.Status_NewlySelected</span>
            <span class="legend-item"><span class="legend-dot dot-pending"></span> @ShiftRegistrationResource.Status_Pending</span>
            <span class="legend-item"><span class="legend-dot dot-approved"></span> @ShiftRegistrationResource.Status_Approved</span>
            <span class="legend-item"><span class="legend-dot dot-past"></span> @ShiftRegistrationResource.Status_Overdue</span>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 shift-main-card">
        @if (isManager)
        {
            <div class="d-flex align-items-center justify-content-between px-3 pt-3 pb-2 border-bottom flex-wrap gap-2 bg-light bg-opacity-50">
                <div class="nav nav-pills gap-2" id="shiftModeTabs" role="tablist">
                    <button class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-semibold text-sm shadow-none" id="tabMyRegistration" type="button" onclick="switchViewMode('my')">
                        <i class="bi bi-person-badge me-1"></i> @ShiftRegistrationResource.Tab_MyRegistration
                    </button>
                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 fw-semibold text-sm shadow-none" id="tabManagerSchedule" type="button" onclick="switchViewMode('manager')">
                        <i class="bi bi-people-fill me-1"></i> @ShiftRegistrationResource.Tab_ManagerSchedule
                    </button>
                </div>
                @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("SuperAdmin"))
                {
                    @if (ViewBag.AllStores != null)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <span class="small text-muted fw-semibold"><i class="bi bi-shop me-1"></i>@ShiftRegistrationResource.Label_Store</span>
                            <select id="switchStoreSelect" class="form-select form-select-sm py-1" style="min-width: 180px;" onchange="changeStoreFilter(this.value)">
                                @foreach (var st in ViewBag.AllStores)
                                {
                                    <option value="@st.StoreId" selected="@(st.StoreId == ViewBag.CurrentStoreId ? "selected" : null)">@st.StoreName</option>
                                }
                            </select>
                        </div>
                    }
                }
            </div>
        }

        <!-- Navigation Toolbar -->
        <div class="card-header bg-white border-bottom py-3 px-3 px-md-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <!-- Left: Week Navigation Controls -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="btn-group btn-group-sm shadow-xs" role="group">
                        <button type="button" class="btn btn-outline-secondary" id="btnPrevWeek" title="@ShiftRegistrationResource.Nav_PrevWeek">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary fw-semibold px-2 px-md-3" id="btnTodayWeek" title="@ShiftRegistrationResource.Nav_GoToCurrentWeek">
                            @ShiftRegistrationResource.Nav_ThisWeek
                        </button>
                        <button type="button" class="btn btn-outline-secondary" id="btnNextWeek" title="@ShiftRegistrationResource.Nav_NextWeek">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>

                    <!-- Week Display Pill with Popover Picker -->
                    <div class="position-relative">
                        <button type="button" class="btn btn-sm btn-light border d-flex align-items-center gap-2 px-3 py-1 text-dark shadow-xs" id="btnToggleWeekPicker">
                            <i class="bi bi-calendar3 text-primary"></i>
                            <span id="currentWeekDisplay" class="fw-bold"></span>
                            <span id="currentWeekRangeDisplay" class="text-muted small"></span>
                            <i class="bi bi-chevron-down text-muted small ms-1"></i>
                        </button>

                        <!-- Custom Calendar Popover Dropdown -->
                        <div id="weekPickerDropdown" class="week-picker-dropdown shadow-lg rounded-3 border bg-white p-3" style="display: none;">
                            <div class="wp-header d-flex justify-content-between align-items-center pb-2 mb-2 border-bottom">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-light wp-prev-year px-2" title="@ShiftRegistrationResource.Picker_PrevYear"><i class="bi bi-chevron-double-left"></i></button>
                                    <button type="button" class="btn btn-light wp-prev-month px-2" title="@ShiftRegistrationResource.Picker_PrevMonth"><i class="bi bi-chevron-left"></i></button>
                                </div>
                                <strong id="wpMonthYearDisplay" class="text-dark fs-6"></strong>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-light wp-next-month px-2" title="@ShiftRegistrationResource.Picker_NextMonth"><i class="bi bi-chevron-right"></i></button>
                                    <button type="button" class="btn btn-light wp-next-year px-2" title="@ShiftRegistrationResource.Picker_NextYear"><i class="bi bi-chevron-double-right"></i></button>
                                </div>
                            </div>
                            <div class="wp-body">
                                <table class="table table-borderless table-sm text-center mb-0 wp-table">
                                    <thead>
                                        <tr class="text-muted small">
                                            <th style="width: 28px;">#</th>
                                            <th>@ShiftRegistrationResource.Picker_Mon</th><th>@ShiftRegistrationResource.Picker_Tue</th><th>@ShiftRegistrationResource.Picker_Wed</th><th>@ShiftRegistrationResource.Picker_Thu</th><th>@ShiftRegistrationResource.Picker_Fri</th><th>@ShiftRegistrationResource.Picker_Sat</th><th>@ShiftRegistrationResource.Picker_Sun</th>
                                        </tr>
                                    </thead>
                                    <tbody id="wpCalendarBody">
                                        <!-- Calendar rows generated by JS -->
                                    </tbody>
                                </table>
                            </div>
                            <div class="text-center pt-2 mt-2 border-top">
                                <small class="text-muted">@ShiftRegistrationResource.Picker_Hint</small>
                            </div>
                        </div>
                    </div>

                    @if (isManager)
                    {
                        <div id="managerFilterEmployeeContainer" style="display: none;">
                            <select id="filterEmployeeId" class="form-select form-select-sm" style="min-width: 170px;">
                                <option value="">@ShiftRegistrationResource.FilterByEmployee</option>
                                @if (ViewBag.Employees != null)
                                {
                                    foreach (var emp in ViewBag.Employees)
                                    {
                                        <option value="@emp.EmployeeId">@emp.EmployeeCode - @(emp.Account?.FullName ?? emp.Username)</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                </div>

                <!-- Right: Action Buttons -->
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 shadow-xs" onclick="fetchEvents()" title="@ShiftRegistrationResource.Toolbar_ReloadTitle">
                        <i class="bi bi-arrow-clockwise" id="iconRefresh"></i>
                        <span class="d-none d-sm-inline">@ShiftRegistrationResource.Toolbar_Refresh</span>
                    </button>

                    @if (isManager)
                    {
                        <div id="managerActionBtns" class="d-flex align-items-center gap-2" style="display: none;">
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="copyPreviousWeek()">
                                <i class="bi bi-copy me-1"></i> @ShiftRegistrationResource.Toolbar_CopyWeek
                            </button>
                            <button type="button" class="btn btn-sm btn-primary" onclick="openCreateModal(new Date())">
                                <i class="bi bi-plus-lg me-1"></i> @ShiftRegistrationResource.CreateShift
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Matrix Schedule Table Area -->
        <div class="card-body p-0 position-relative">
            <div class="table-responsive shift-table-container">
                <table class="table modern-shift-table align-middle mb-0" id="shiftGridTable">
                    <thead>
                        <tr id="gridHeaderRow">
                            <!-- Column headers generated by JS -->
                        </tr>
                    </thead>
                    <tbody id="gridBody">
                        <!-- Employee or Shift rows generated by JS -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Sticky Bottom Summary Bar -->
        <div class="weekly-summary-bar p-3 bg-white border-top d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small fw-bold text-uppercase">@ShiftRegistrationResource.Summary_Title</span>
                    <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                        <i class="bi bi-plus-circle me-1"></i><strong id="summaryNewCount">0</strong> @ShiftRegistrationResource.Summary_NewSelected
                    </span>
                    <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                        <i class="bi bi-hourglass-split me-1"></i><strong id="summaryPendingCount">0</strong> @ShiftRegistrationResource.Summary_Pending
                    </span>
                    <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2 py-1">
                        <i class="bi bi-check-circle-fill me-1"></i><strong id="summaryApprovedCount">0</strong> @ShiftRegistrationResource.Summary_Approved
                    </span>
                </div>
                <div class="vr text-secondary d-none d-md-block" style="height: 20px;"></div>
                <div class="d-flex align-items-center gap-1 small text-dark">
                    <i class="bi bi-clock-history text-primary"></i>
                    <span>@ShiftRegistrationResource.Summary_TotalHours <strong id="summaryTotalHours" class="text-primary">@string.Format(ShiftRegistrationResource.Summary_HoursFormat, "0.0")</strong></span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 ms-auto">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" onclick="fetchEvents()" title="@ShiftRegistrationResource.Summary_ResetTitle">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> @ShiftRegistrationResource.Summary_Reset
                </button>
                <button type="button" id="btnSubmitWeekly" class="btn btn-primary btn-sm px-4 fw-semibold shadow-xs" onclick="syncWeeklySchedule()">
                    <i class="bi bi-send-fill me-1"></i> @SharedResource.ResourceManager.GetString("Shift_RegisterWeek")
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Đăng ký ca đơn lẻ theo ngày (#shiftModal) -->
<div class="modal fade" id="shiftModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 460px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-light border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="modal-icon-badge bg-primary text-white rounded-3 p-2 d-flex align-items-center justify-content-center">
                        <i class="bi bi-calendar-plus fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0">@ShiftRegistrationResource.Modal_RegisterTitle</h5>
                        <small class="text-muted" id="modalDateDisplay"></small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@ShiftRegistrationResource.Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3 d-flex align-items-center justify-content-between p-2 rounded-3 bg-light border">
                    <span class="small text-muted">@ShiftRegistrationResource.Modal_EmployeeLabel</span>
                    <strong class="text-dark small" id="modalEmpName">@SharedResource.Shift_Me</strong>
                </div>

                <div class="mb-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" id="searchShiftInput" placeholder="@ShiftRegistrationResource.SearchBtn" onkeyup="filterShifts(this.value)">
                    </div>
                </div>

                <form id="shiftForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="EmployeeId" name="EmployeeId" />
                    <input type="hidden" id="WorkDate" name="WorkDate" />

                    <label class="form-label small fw-semibold text-muted mb-2">@ShiftRegistrationResource.Modal_SelectAvailableShift</label>
                    <div class="shift-list-container pe-1" style="max-height: 240px; overflow-y: auto;">
                        <!-- Shift options rendered via AJAX -->
                    </div>

                    @if (isManager)
                    {
                        <div class="mt-3 pt-2 border-top">
                            <a href="@Url.Action("Create", "Shift")" class="text-primary small text-decoration-none fw-semibold">
                                <i class="bi bi-plus-circle me-1"></i> @ShiftRegistrationResource.CreateNewShift
                            </a>
                        </div>
                    }

                    <div class="mt-4 d-flex justify-content-end gap-2" id="saveShiftBtnContainer" style="display: none;">
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">@SharedResource.Button_Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary px-4 fw-semibold">
                            <i class="bi bi-check-lg me-1"></i> @ShiftRegistrationResource.Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Xem chi tiết ca / Hủy ca / Đổi ca (#viewModal) -->
<div class="modal fade" id="viewModal" tabindex="-1" aria-labelledby="viewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-light border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="modal-icon-badge bg-primary text-white rounded-3 p-2 d-flex align-items-center justify-content-center">
                        <i class="bi bi-card-checklist fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0">@ShiftRegistrationResource.ShiftDetails</h5>
                        <small class="text-muted">@ShiftRegistrationResource.View_Subtitle</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@ShiftRegistrationResource.Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="detail-group mb-3 pb-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small"><i class="bi bi-person me-1"></i> @ShiftRegistrationResource.Employee:</span>
                        <strong class="text-dark" id="vEmployee"></strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small"><i class="bi bi-shop me-1"></i> @RWPM.Resources.Models.Employee.Store:</span>
                        <span class="text-dark fw-medium" id="vStore"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small"><i class="bi bi-clock-history me-1"></i> @ShiftRegistrationResource.Shift:</span>
                        <strong class="text-primary" id="vShift"></strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small"><i class="bi bi-calendar-event me-1"></i> @ShiftRegistrationResource.Time:</span>
                        <span class="text-dark fw-medium" id="vTime"></span>
                    </div>
                </div>

                <div class="detail-group mb-3 pb-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">@ShiftRegistrationResource.Status:</span>
                        <div id="vStatusBadge"></div>
                    </div>
                    <div class="d-none">
                        <span id="vStatus"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-muted small">@ShiftRegistrationResource.Note:</span>
                        <span class="text-dark text-end small" id="vNote">-</span>
                    </div>
                </div>

                <div id="vRejectionReasonRow" class="alert alert-danger py-2 px-3 mb-3 small" style="display: none;">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    <strong>@ShiftRegistrationResource.View_RejectionReason</strong>
                    <span id="vRejectionReason" class="ms-1"></span>
                </div>

                <div id="vApproverRow" class="p-2 bg-light rounded-3 small text-muted mb-0" style="display: none;">
                    <i class="bi bi-person-check me-1 text-success"></i>
                    <span>@ShiftRegistrationResource.View_Approver <strong id="vApprover" class="text-dark"></strong></span>
                    <span id="vApprovedAt" class="ms-1"></span>
                </div>
            </div>
            <div class="modal-footer bg-light border-top py-2 px-4 d-flex justify-content-between">
                <input type="hidden" id="vRegistrationId" />
                @if (isManager)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteRegistration()">@ShiftRegistrationResource.View_CancelShift</button>
                    <button type="button" class="btn btn-sm btn-secondary ms-auto" data-bs-dismiss="modal">@ShiftRegistrationResource.Close</button>
                }
                else
                {
                    <a href="/Request" class="btn btn-sm btn-outline-warning text-dark" id="btnGoToSwapShift" style="display: none;">
                        <i class="bi bi-arrow-left-right me-1"></i> @SharedResource.Req_ChangeShift
                    </a>
                    <button type="button" class="btn btn-sm btn-danger" id="btnCancelRegistration" onclick="deleteRegistration()">
                        <i class="bi bi-trash3 me-1"></i> @ShiftRegistrationResource.Cancel
                    </button>
                    <span id="txtApprovedNotice" class="text-muted small" style="display: none;">
                        <i class="bi bi-shield-lock me-1"></i> @ShiftRegistrationResource.View_ApprovedNotice
                    </span>
                    <button type="button" class="btn btn-sm btn-secondary ms-auto" data-bs-dismiss="modal">@ShiftRegistrationResource.Close</button>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Scoped Modern Styles for Shift Registration */
    .shift-registration-page {
        --slot-available-bg: #ffffff;
        --slot-available-border: #e2e8f0;
        --slot-selected-bg: #eff6ff;
        --slot-selected-border: #3b82f6;
        --slot-pending-bg: #fffbeb;
        --slot-pending-border: #fde68a;
        --slot-approved-bg: #f0fdf4;
        --slot-approved-border: #86efac;
        --slot-rejected-bg: #fef2f2;
        --slot-rejected-border: #fca5a5;
        --slot-past-bg: #f8fafc;
        --slot-past-border: #e2e8f0;
    }

    /* Status Legend */
    .status-legend-bar .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #475569;
        font-weight: 500;
    }
    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }
    .dot-available { background-color: #cbd5e1; border: 1px solid #94a3b8; }
    .dot-selected { background-color: #3b82f6; }
    .dot-pending { background-color: #f59e0b; }
    .dot-approved { background-color: #10b981; }
    .dot-past { background-color: #94a3b8; opacity: 0.5; }

    /* Modern Table Container */
    .shift-table-container {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        min-height: 380px;
    }
    .modern-shift-table {
        min-width: 980px;
        border-collapse: separate;
        border-spacing: 0;
    }
    .modern-shift-table th {
        background: #f8fafc;
        color: #334155;
        font-weight: 600;
        font-size: 0.84rem;
        padding: 12px 10px;
        border-bottom: 2px solid #e2e8f0;
        border-right: 1px solid #edf2f7;
        text-align: center;
        position: sticky;
        top: 0;
        z-index: 2;
    }
    .modern-shift-table th.th-today {
        background: #eff6ff !important;
        color: #1d4ed8 !important;
        border-bottom-color: #3b82f6 !important;
    }
    .modern-shift-table th.th-shift-col {
        width: 220px;
        min-width: 220px;
        left: 0;
        z-index: 5;
        text-align: left;
        padding-left: 16px;
        border-right: 2px solid #e2e8f0;
    }
    .modern-shift-table td.shift-name-col {
        position: sticky;
        left: 0;
        z-index: 4;
        background: #ffffff;
        width: 220px;
        min-width: 220px;
        padding: 12px 14px;
        border-right: 2px solid #e2e8f0;
        border-bottom: 1px solid #edf2f7;
        box-shadow: 2px 0 6px rgba(0,0,0,0.02);
    }
    .modern-shift-table td.shift-grid-cell {
        padding: 6px;
        border-right: 1px solid #edf2f7;
        border-bottom: 1px solid #edf2f7;
        vertical-align: stretch;
        height: 100%;
    }
    .modern-shift-table tr:hover td.shift-name-col {
        background: #fbfcfe;
    }

    /* Shift Master Column Card */
    .shift-info-card {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }
    .shift-color-bar {
        width: 4px;
        height: 14px;
        border-radius: 2px;
        background-color: #2563eb;
        display: inline-block;
    }
    .shift-name-text {
        font-size: 0.92rem;
        color: #0f172a;
    }
    .shift-time-text {
        font-size: 0.8rem;
        color: #475569;
        font-weight: 500;
    }
    .shift-hours-text {
        font-size: 0.75rem;
        color: #64748b;
    }

    /* Individual Slot Cards inside Grid */
    .shift-slot {
        min-height: 84px;
        height: 100%;
        border-radius: 10px;
        padding: 8px 10px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        cursor: pointer;
        transition: all 0.16s ease-in-out;
        position: relative;
        user-select: none;
    }
    .shift-slot .slot-time-text {
        font-size: 0.78rem;
        font-weight: 600;
        color: #334155;
        margin-top: 4px;
    }
    .shift-slot .slot-sub-text {
        font-size: 0.72rem;
        margin-top: 2px;
    }
    .shift-slot .btn-view-slot {
        cursor: pointer;
        padding: 2px 4px;
        border-radius: 4px;
        transition: background 0.15s;
    }
    .shift-slot .btn-view-slot:hover {
        background-color: rgba(0,0,0,0.06);
    }

    /* State: Available (Chưa đăng ký) */
    .shift-slot.is-available {
        background-color: var(--slot-available-bg);
        border: 1px dashed var(--slot-available-border);
    }
    .shift-slot.is-available:hover {
        border-color: #93c5fd;
        background-color: #f8fbff;
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(37,99,235,0.08);
    }

    /* State: Selected (Mới chọn) */
    .shift-slot.is-selected {
        background-color: var(--slot-selected-bg) !important;
        border: 1.5px solid var(--slot-selected-border) !important;
        box-shadow: 0 2px 6px rgba(37,99,235,0.12);
    }

    /* State: Pending (Chờ duyệt) */
    .shift-slot.is-pending {
        background-color: var(--slot-pending-bg);
        border: 1.5px solid var(--slot-pending-border);
    }
    .shift-slot.is-pending:hover {
        border-color: #f59e0b;
        box-shadow: 0 3px 8px rgba(245,158,11,0.12);
    }

    /* State: Pending but unchecked (Sắp hủy khi lưu) */
    .shift-slot.is-pending-cancelled {
        background-color: #f8fafc !important;
        border: 1px dashed #cbd5e1 !important;
        opacity: 0.75;
    }

    /* State: Approved (Đã duyệt) */
    .shift-slot.is-approved {
        background-color: var(--slot-approved-bg);
        border: 1.5px solid var(--slot-approved-border);
        cursor: pointer;
    }
    .shift-slot.is-approved:hover {
        box-shadow: 0 3px 8px rgba(16,185,129,0.14);
    }

    /* State: Rejected (Bị từ chối) */
    .shift-slot.is-rejected {
        background-color: var(--slot-rejected-bg);
        border: 1.5px solid var(--slot-rejected-border);
    }

    /* State: Past / Overdue (Quá hạn) */
    .shift-slot.is-past {
        background-color: var(--slot-past-bg);
        border: 1px solid var(--slot-past-border);
        opacity: 0.6;
        cursor: not-allowed;
    }

    /* State: Unavailable (Không áp dụng) */
    .shift-slot.is-unavailable {
        background-color: #f1f5f9;
        border: 1px dashed #cbd5e1;
        opacity: 0.45;
        cursor: not-allowed;
    }

    /* Badges */
    .badge-status {
        font-size: 0.72rem;
        font-weight: 600;
        padding: 3px 7px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        line-height: 1.2;
    }
    .status-available {
        color: #64748b;
        background-color: #f1f5f9;
    }
    .status-selected {
        color: #1d4ed8;
        background-color: #dbeafe;
    }
    .status-pending {
        color: #b45309;
        background-color: #fef3c7;
    }
    .status-approved {
        color: #047857;
        background-color: #d1fae5;
    }
    .status-rejected {
        color: #b91c1c;
        background-color: #fee2e2;
    }
    .status-past {
        color: #64748b;
        background-color: #e2e8f0;
    }
    .status-unavailable {
        color: #94a3b8;
        background-color: #e2e8f0;
    }

    /* Custom Checkbox within Matrix */
    .weekly-shift-cb {
        width: 17px;
        height: 17px;
        cursor: pointer;
        border-radius: 4px;
        border-color: #94a3b8;
    }
    .weekly-shift-cb:checked {
        background-color: #2563eb;
        border-color: #2563eb;
    }

    /* Sticky Bottom Summary Bar */
    .weekly-summary-bar {
        position: sticky;
        bottom: 0;
        z-index: 10;
        box-shadow: 0 -4px 14px rgba(18, 38, 61, 0.05);
    }

    /* Week Picker Popover */
    .week-picker-dropdown {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        z-index: 1050;
        width: 320px;
    }
    .wp-table th { padding: 4px; }
    .wp-table td {
        padding: 6px 4px;
        cursor: pointer;
        border-radius: 4px;
        font-size: 0.85rem;
    }
    .wp-week-row {
        transition: background-color 0.15s;
    }
    .wp-week-row:hover td {
        background-color: #eff6ff;
        color: #2563eb;
    }
    .wp-week-row.active td {
        background-color: #2563eb;
        color: #ffffff !important;
        font-weight: 600;
    }
    .wp-week-num {
        color: #94a3b8 !important;
        font-size: 0.72rem !important;
    }
    .wp-week-row.active .wp-week-num {
        color: #bfdbfe !important;
    }

    /* Shadow utility */
    .shadow-xs { box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04); }
    .cursor-pointer { cursor: pointer; }
</style>

@section Scripts {
    <script>
        let currentWeekStart = new Date();
        // Adjust to Monday
        let day = currentWeekStart.getDay();
        let diff = currentWeekStart.getDate() - day + (day === 0 ? -6 : 1); 
        currentWeekStart = new Date(currentWeekStart.setDate(diff));
        currentWeekStart.setHours(0, 0, 0, 0);

        let employeesList = [];
        let wpCurrentMonth = new Date();
        let isManager = @((isManager).ToString().ToLower());
        let activeMode = 'my'; // Default to my shift registration
        let shiftsList = [];
        let currentFetchedEvents = [];

        // Localized UI texts (HTML-escaped, safe inside generated markup and attributes)
        const escAttr = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        const T = {
            approved: escAttr(@Json.Serialize(ShiftRegistrationResource.Status_Approved)),
            rejected: escAttr(@Json.Serialize(ShiftRegistrationResource.Status_Rejected)),
            rejectedLong: escAttr(@Json.Serialize(ShiftRegistrationResource.Status_RejectedLong)),
            pending: escAttr(@Json.Serialize(ShiftRegistrationResource.Status_Pending)),
            overdue: escAttr(@Json.Serialize(ShiftRegistrationResource.Status_Overdue)),
            notApplicable: escAttr(@Json.Serialize(ShiftRegistrationResource.Status_NotApplicable)),
            notRegistered: escAttr(@Json.Serialize(ShiftRegistrationResource.Status_NotRegistered)),
            noShiftsTitle: escAttr(@Json.Serialize(ShiftRegistrationResource.Grid_NoShiftsTitle)),
            noShiftsDesc: escAttr(@Json.Serialize(ShiftRegistrationResource.Grid_NoShiftsDesc)),
            workHours: escAttr(@Json.Serialize(ShiftRegistrationResource.Grid_WorkHoursFormat)),
            slotApprovedTitle: escAttr(@Json.Serialize(ShiftRegistrationResource.Slot_ApprovedTitle)),
            slotRejectedTitle: escAttr(@Json.Serialize(ShiftRegistrationResource.Slot_RejectedTitle)),
            slotPendingTitle: escAttr(@Json.Serialize(ShiftRegistrationResource.Slot_PendingTitle)),
            slotPastTitle: escAttr(@Json.Serialize(ShiftRegistrationResource.Slot_PastTitle)),
            slotUnavailableTitle: escAttr(@Json.Serialize(ShiftRegistrationResource.Slot_UnavailableTitle)),
            slotAvailableTitle: escAttr(@Json.Serialize(ShiftRegistrationResource.Slot_AvailableTitle)),
            viewDetails: escAttr(@Json.Serialize(ShiftRegistrationResource.Slot_ViewDetails)),
            details: escAttr(@Json.Serialize(ShiftRegistrationResource.Slot_Details))
        };

        function switchViewMode(mode) {
            activeMode = mode;
            if (mode === 'my') {
                $('#tabMyRegistration').removeClass('btn-outline-secondary').addClass('btn-primary');
                $('#tabManagerSchedule').removeClass('btn-primary').addClass('btn-outline-secondary');
                $('#managerFilterEmployeeContainer').hide();
                $('#managerActionBtns').hide();
                $('.weekly-summary-bar').show();
            } else {
                $('#tabMyRegistration').removeClass('btn-primary').addClass('btn-outline-secondary');
                $('#tabManagerSchedule').removeClass('btn-outline-secondary').addClass('btn-primary');
                $('#managerFilterEmployeeContainer').show();
                $('#managerActionBtns').show();
                $('.weekly-summary-bar').hide();
            }
            renderHeader();
            fetchEvents();
        }

        function changeStoreFilter(storeId) {
            window.location.href = '/ShiftRegistration?storeId=' + storeId;
        }

        document.addEventListener('DOMContentLoaded', function() {
            @if (ViewBag.Shifts != null)
            {
                <text>
                shiftsList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((IEnumerable<RWPM.Models.Entities.Shift>)ViewBag.Shifts).Select(s => new {
                    id = s.ShiftId,
                    name = s.ShiftName,
                    from = s.EffectiveFrom.ToString("yyyy-MM-dd"),
                    to = s.EffectiveTo?.ToString("yyyy-MM-dd"),
                    start = s.StartTime.ToString(@"hh\:mm"),
                    end = s.EndTime.ToString(@"hh\:mm") + (s.EndDayOffset > 0 ? " (+1)" : ""),
                    hours = s.ScheduledWorkHours
                })));
                </text>
            }

            @if (ViewBag.Employees != null)
            {
                <text>
                employeesList = [
                    @foreach (var emp in ViewBag.Employees)
                    {
                        @:{ id: '@emp.EmployeeId', code: '@emp.EmployeeCode', name: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(emp.Account?.FullName ?? emp.Username))' },
                    }
                ];
                </text>
            }
            else
            {
                <text>
                employeesList = [{ id: 'me', name: @Json.Serialize(SharedResource.Shift_Me) }];
                </text>
            }

            if (isManager) {
                switchViewMode(activeMode);
            } else {
                updateWeekDisplay();
                fetchEvents();
            }

            // Week Navigation
            $('#btnPrevWeek').click(function() {
                currentWeekStart.setDate(currentWeekStart.getDate() - 7);
                updateWeekDisplay();
                fetchEvents();
            });

            $('#btnNextWeek').click(function() {
                currentWeekStart.setDate(currentWeekStart.getDate() + 7);
                updateWeekDisplay();
                fetchEvents();
            });

            $('#btnTodayWeek').click(function() {
                let now = new Date();
                let day = now.getDay();
                let diff = now.getDate() - day + (day === 0 ? -6 : 1);
                currentWeekStart = new Date(now.setDate(diff));
                currentWeekStart.setHours(0, 0, 0, 0);
                updateWeekDisplay();
                fetchEvents();
            });

            $('#filterEmployeeId').change(function() {
                fetchEvents();
            });

            // Single day shift registration form submission
            $('#shiftForm').submit(function(e) {
                e.preventDefault();
                var selectedShifts = [];
                $('.shift-checkbox:checked').each(function() {
                    selectedShifts.push($(this).val());
                });

                if (selectedShifts.length === 0) {
                    showAppToast('warning', @Json.Serialize(SharedResource.ResourceManager.GetString("Shift_ErrSelectOne")));
                    return;
                }

                var empId = $('#EmployeeId').val();
                var workDate = $('#WorkDate').val();
                var token = $('input[name="__RequestVerificationToken"]').val();

                var data = {
                    EmployeeId: empId,
                    ShiftId: selectedShifts[0],
                    ShiftIds: selectedShifts.map(id => parseInt(id)),
                    WorkDate: workDate,
                    Note: ""
                };

                $.ajax({
                    url: '/ShiftRegistration/Create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    headers: { 'RequestVerificationToken': token },
                    success: function(res) {
                        if (res.success) {
                            $('#shiftModal').modal('hide');
                            showAppToast('success', @Json.Serialize(ShiftRegistrationResource.Toast_RegisterSuccess));
                            fetchEvents();
                            $('#shiftForm')[0].reset();
                        } else {
                            showAppToast('error', res.message || '@Html.Raw(SharedResource.ResourceManager.GetString("Shift_ErrOccurred"))');
                        }
                    },
                    error: function(err) {
                        var msg = err.responseJSON?.message || err.responseText || '@Html.Raw(SharedResource.ResourceManager.GetString("Shift_SysError"))';
                        showAppToast('error', '@Html.Raw(ShiftRegistrationResource.ErrorPrefix)' + msg);
                    }
                });
            });

            // Toggle single day save button
            $(document).on('change', '.shift-checkbox', function() {
                if ($('.shift-checkbox:checked').length > 0) {
                    $('#saveShiftBtnContainer').fadeIn(150);
                } else {
                    $('#saveShiftBtnContainer').fadeOut(150);
                }
            });

            // Weekly Checkbox toggle & slot click handlers
            $(document).on('change', '.weekly-shift-cb', function(e) {
                updateSlotCardVisual($(this));
                updateWeeklySummary();
            });

            // Clicking available slot toggles checkbox
            $(document).on('click', '.shift-slot.is-available, .shift-slot.is-pending', function(e) {
                if ($(e.target).is('input[type="checkbox"]') || $(e.target).closest('.btn-view-slot').length > 0 || $(e.target).is('label')) {
                    return;
                }
                let cb = $(this).find('.weekly-shift-cb:not(:disabled)');
                if (cb.length > 0) {
                    cb.prop('checked', !cb.prop('checked')).trigger('change');
                }
            });

            // Week Picker Popover logic
            $('#btnToggleWeekPicker').click(function(e) {
                e.stopPropagation();
                $('#weekPickerDropdown').toggle();
                if ($('#weekPickerDropdown').is(':visible')) {
                    wpCurrentMonth = new Date(currentWeekStart);
                    wpCurrentMonth.setDate(1);
                    renderWeekPickerCalendar();
                }
            });

            $(document).click(function(e) {
                if (!$(e.target).closest('#btnToggleWeekPicker, #weekPickerDropdown').length) {
                    $('#weekPickerDropdown').hide();
                }
            });

            $('.wp-prev-month').click(function(e){ e.stopPropagation(); wpCurrentMonth.setMonth(wpCurrentMonth.getMonth() - 1); renderWeekPickerCalendar(); });
            $('.wp-next-month').click(function(e){ e.stopPropagation(); wpCurrentMonth.setMonth(wpCurrentMonth.getMonth() + 1); renderWeekPickerCalendar(); });
            $('.wp-prev-year').click(function(e){ e.stopPropagation(); wpCurrentMonth.setFullYear(wpCurrentMonth.getFullYear() - 1); renderWeekPickerCalendar(); });
            $('.wp-next-year').click(function(e){ e.stopPropagation(); wpCurrentMonth.setFullYear(wpCurrentMonth.getFullYear() + 1); renderWeekPickerCalendar(); });
        });

        function updateSlotCardVisual(cb) {
            let slot = cb.closest('.shift-slot');
            let isChecked = cb.is(':checked');

            if (slot.hasClass('was-pending')) {
                if (!isChecked) {
                    slot.addClass('is-pending-cancelled');
                    slot.find('.badge-status').removeClass('status-pending').addClass('status-unavailable').html('<i class="bi bi-x-circle"></i> ' + @Json.Serialize(ShiftRegistrationResource.Status_Unregister));
                } else {
                    slot.removeClass('is-pending-cancelled');
                    slot.find('.badge-status').removeClass('status-unavailable').addClass('status-pending').html('<i class="bi bi-hourglass-split"></i> ' + @Json.Serialize(ShiftRegistrationResource.Status_Pending));
                }
            } else if (!slot.hasClass('is-approved') && !slot.hasClass('is-past') && !slot.hasClass('is-unavailable')) {
                if (isChecked) {
                    slot.addClass('is-selected');
                    slot.find('.badge-status').removeClass('status-available').addClass('status-selected').html('<i class="bi bi-check-circle-fill"></i> ' + @Json.Serialize(ShiftRegistrationResource.Status_NewlySelected));
                } else {
                    slot.removeClass('is-selected');
                    slot.find('.badge-status').removeClass('status-selected').addClass('status-available').html('<i class="bi bi-circle"></i> ' + @Json.Serialize(ShiftRegistrationResource.Status_NotRegistered));
                }
            }
        }

        function updateWeeklySummary() {
            let newSelectedCount = 0;
            let pendingCount = 0;
            let approvedCount = 0;
            let totalHours = 0;

            let shiftMap = {};
            shiftsList.forEach(s => { shiftMap[s.id] = s; });

            $('.weekly-shift-cb:checked').each(function() {
                let slot = $(this).closest('.shift-slot');
                let val = $(this).val();
                let shiftId = parseInt(val.split('_')[0]);
                let sObj = shiftMap[shiftId];
                let hours = (sObj && sObj.hours) ? sObj.hours : 0;

                totalHours += hours;

                if (slot.hasClass('is-approved') || $(this).prop('disabled')) {
                    approvedCount++;
                } else if (slot.hasClass('was-pending')) {
                    pendingCount++;
                } else {
                    newSelectedCount++;
                }
            });

            $('#summaryNewCount').text(newSelectedCount);
            $('#summaryPendingCount').text(pendingCount);
            $('#summaryApprovedCount').text(approvedCount);
            $('#summaryTotalHours').text(@(Json.Serialize(ShiftRegistrationResource.Summary_HoursFormat)).replace('{0}', totalHours.toFixed(1)));
        }

        function renderWeekPickerCalendar() {
            $('#wpMonthYearDisplay').text(@(Json.Serialize(ShiftRegistrationResource.Picker_MonthYearFormat)).replace('{0}', wpCurrentMonth.getMonth() + 1).replace('{1}', wpCurrentMonth.getFullYear()));
            
            let firstDay = new Date(wpCurrentMonth.getFullYear(), wpCurrentMonth.getMonth(), 1);
            let dayOfWeek = firstDay.getDay();
            let diffToMonday = dayOfWeek === 0 ? -6 : 1 - dayOfWeek;
            let startDate = new Date(firstDay);
            startDate.setDate(firstDay.getDate() + diffToMonday);
            
            let tbody = '';
            
            for (let w = 0; w < 6; w++) {
                let rowMonday = new Date(startDate);
                let firstDayOfYear = new Date(rowMonday.getFullYear(), 0, 1);
                let pastDaysOfYear = (rowMonday - firstDayOfYear) / 86400000;
                let weekNum = Math.ceil((pastDaysOfYear + firstDayOfYear.getDay() + 1) / 7);
                let isActive = (rowMonday.getTime() === currentWeekStart.getTime()) ? 'active' : '';
                
                tbody += `<tr class="wp-week-row ${isActive}" data-monday="${rowMonday.toISOString()}">`;
                tbody += `<td class="wp-week-num">${weekNum}</td>`;
                
                for (let d = 0; d < 7; d++) {
                    let cellDate = new Date(startDate);
                    let isCurrentMonth = cellDate.getMonth() === wpCurrentMonth.getMonth();
                    let opacity = isCurrentMonth ? '1' : '0.35';
                    tbody += `<td style="opacity: ${opacity}">${cellDate.getDate()}</td>`;
                    startDate.setDate(startDate.getDate() + 1);
                }
                tbody += `</tr>`;
            }
            
            $('#wpCalendarBody').html(tbody);
            
            $('.wp-week-row').click(function(e) {
                e.stopPropagation();
                let monIso = $(this).data('monday');
                currentWeekStart = new Date(monIso);
                updateWeekDisplay();
                fetchEvents();
                $('#weekPickerDropdown').hide();
            });
        }

        function updateWeekDisplay() {
            let weekEnd = new Date(currentWeekStart);
            weekEnd.setDate(currentWeekStart.getDate() + 6);
            
            let firstDayOfYear = new Date(currentWeekStart.getFullYear(), 0, 1);
            let pastDaysOfYear = (currentWeekStart - firstDayOfYear) / 86400000;
            let weekNum = Math.ceil((pastDaysOfYear + firstDayOfYear.getDay() + 1) / 7);

            let startStr = currentWeekStart.getDate().toString().padStart(2, '0') + '/' + (currentWeekStart.getMonth() + 1).toString().padStart(2, '0');
            let endStr = weekEnd.getDate().toString().padStart(2, '0') + '/' + (weekEnd.getMonth() + 1).toString().padStart(2, '0') + '/' + weekEnd.getFullYear();

            $('#currentWeekDisplay').text(@(Json.Serialize(ShiftRegistrationResource.Week_Format)).replace('{0}', weekNum));
            $('#currentWeekRangeDisplay').text(`(${startStr} – ${endStr})`);

            renderHeader();
        }

        function renderHeader() {
            let tempDate = new Date(currentWeekStart);
            let today = new Date();
            let todayIso = getISODateString(today);
            let days = [@Json.Serialize(ShiftRegistrationResource.Day_Mon), @Json.Serialize(ShiftRegistrationResource.Day_Tue), @Json.Serialize(ShiftRegistrationResource.Day_Wed), @Json.Serialize(ShiftRegistrationResource.Day_Thu), @Json.Serialize(ShiftRegistrationResource.Day_Fri), @Json.Serialize(ShiftRegistrationResource.Day_Sat), @Json.Serialize(ShiftRegistrationResource.Day_Sun)];
            
            if (activeMode === 'manager') {
                let tr = '<th class="th-shift-col"><div class="input-group input-group-sm"><span class="input-group-text bg-transparent border-0"><i class="bi bi-search"></i></span><input type="text" class="form-control border-0 bg-transparent ps-1" placeholder="@Html.Raw(ShiftRegistrationResource.SearchBtn)" onkeyup="filterEmployeesLocally(this.value)"></div></th>';
                for (let i = 0; i < 7; i++) {
                    let cellDateIso = getISODateString(tempDate);
                    let isToday = (cellDateIso === todayIso);
                    let dateStr = tempDate.getDate().toString().padStart(2, '0') + '/' + (tempDate.getMonth() + 1).toString().padStart(2, '0');
                    tr += `<th class="${isToday ? 'th-today' : ''}"><div>${days[i]}</div><div class="small fw-normal text-muted">${dateStr}</div></th>`;
                    tempDate.setDate(tempDate.getDate() + 1);
                }
                $('#gridHeaderRow').html(tr);
            } else {
                let tr = '<th class="th-shift-col"><div class="d-flex align-items-center gap-1"><i class="bi bi-clock-history text-primary"></i><span>' + escapeHtml(@Json.Serialize(ShiftRegistrationResource.Grid_ShiftColumn)) + '</span></div></th>';
                for (let i = 0; i < 7; i++) {
                    let cellDateIso = getISODateString(tempDate);
                    let isToday = (cellDateIso === todayIso);
                    let dateStr = tempDate.getDate().toString().padStart(2, '0') + '/' + (tempDate.getMonth() + 1).toString().padStart(2, '0');
                    let todayBadge = isToday ? '<span class="badge bg-primary rounded-pill px-2 py-0 ms-1" style="font-size: 10px;">' + escapeHtml(@Json.Serialize(ShiftRegistrationResource.Grid_Today)) + '</span>' : '';
                    tr += `<th class="${isToday ? 'th-today' : ''}"><div>${days[i]} ${todayBadge}</div><div class="small fw-normal text-muted">${dateStr}</div></th>`;
                    tempDate.setDate(tempDate.getDate() + 1);
                }
                $('#gridHeaderRow').html(tr);
            }
        }

        function filterEmployeesLocally(text) {
            text = text.toLowerCase();
            $('#gridBody tr').each(function() {
                var empName = $(this).find('.shift-name-col').text().toLowerCase();
                if (empName.indexOf(text) > -1) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }

        function getISODateString(date) {
            var tzoffset = date.getTimezoneOffset() * 60000;
            return (new Date(date - tzoffset)).toISOString().split('T')[0];
        }

        function escapeHtml(str) {
            if (!str) return '';
            return $('<div>').text(str).html();
        }

        function fetchEvents() {
            let isMyMode = (activeMode === 'my');
            let empId = isMyMode ? '' : ($('#filterEmployeeId').val() || '');
            let startStr = getISODateString(currentWeekStart);
            let endStr = new Date(currentWeekStart);
            endStr.setDate(endStr.getDate() + 7);

            $('#iconRefresh').addClass('spin-animation');

            $.ajax({
                url: '/ShiftRegistration/GetEvents',
                type: 'GET',
                data: {
                    start: startStr,
                    end: getISODateString(endStr),
                    employeeId: empId,
                    myOnly: isMyMode
                },
                success: function(events) {
                    currentFetchedEvents = events;
                    renderGrid(events);
                    updateWeeklySummary();
                },
                error: function() {
                    showAppToast('error', '@Html.Raw(SharedResource.ResourceManager.GetString("Shift_ErrLoadShift"))');
                },
                complete: function() {
                    $('#iconRefresh').removeClass('spin-animation');
                }
            });
        }

        function renderGrid(events) {
            let tbody = '';
            let today = new Date();
            today.setHours(0, 0, 0, 0);

            if (activeMode === 'manager') {
                var selectedEmpId = $('#filterEmployeeId').val();
                var empsToRender = employeesList;

                if (employeesList.length === 1 && employeesList[0].id === 'me') {
                    let uniqueEmps = {};
                    events.forEach(e => {
                        if (!uniqueEmps[e.employeeId]) {
                            uniqueEmps[e.employeeId] = { id: e.employeeId, name: e.employeeName };
                        }
                    });
                    empsToRender = Object.values(uniqueEmps);
                    if (empsToRender.length === 0) empsToRender = [{ id: '', name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedResource.ResourceManager.GetString("Shift_NoShifts"))) }];
                } else if (selectedEmpId) {
                    empsToRender = employeesList.filter(e => e.id == selectedEmpId);
                }

                empsToRender.forEach(emp => {
                    tbody += `<tr>`;
                    tbody += `
                        <td class="shift-name-col">
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-sm bg-light text-primary rounded-circle d-flex align-items-center justify-content-center p-2" style="width: 32px; height: 32px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <h6 class="mb-0 text-dark small fw-bold">${escapeHtml(emp.name)}</h6>
                            </div>
                        </td>
                    `;

                    let tempDate = new Date(currentWeekStart);
                    for (let i = 0; i < 7; i++) {
                        let cellDateStr = getISODateString(tempDate);
                        let dayEvents = events.filter(e => {
                            let eDate = e.start.split('T')[0];
                            return (e.employeeId == emp.id || !emp.id) && eDate === cellDateStr;
                        });

                        if (dayEvents.length > 0) {
                            tbody += `<td class="shift-grid-cell" onclick="openCreateModal(new Date('${cellDateStr}'), '${emp.id}')">`;
                            tbody += `<div class="d-flex flex-column gap-1 h-100">`;
                            dayEvents.forEach(dayEvent => {
                                let eJson = JSON.stringify(dayEvent).replace(/'/g, "&#39;");
                                let timeDisplay = (dayEvent.startTime && dayEvent.endTime) ? `${dayEvent.startTime} - ${dayEvent.endTime}` : '';
                                let badgeHtml = dayEvent.statusId === 1 
                                    ? `<span class="badge-status status-approved"><i class="bi bi-check-circle-fill"></i> ${T.approved}</span>` 
                                    : (dayEvent.statusId === 2 
                                        ? `<span class="badge-status status-rejected"><i class="bi bi-x-circle-fill"></i> ${T.rejected}</span>` 
                                        : `<span class="badge-status status-pending"><i class="bi bi-hourglass-split"></i> ${T.pending}</span>`);
                                let slotCls = dayEvent.statusId === 1 ? 'is-approved' : (dayEvent.statusId === 2 ? 'is-rejected' : 'is-pending');
                                tbody += `
                                    <div class="shift-slot ${slotCls}" style="cursor:pointer" onclick='event.stopPropagation(); openViewModal(${eJson})'>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="slot-time-text">${escapeHtml(dayEvent.title)}</span>
                                            ${badgeHtml}
                                        </div>
                                        <div class="slot-sub-text text-muted">${timeDisplay}</div>
                                    </div>
                                `;
                            });
                            tbody += `</div></td>`;
                        } else {
                            tbody += `
                                <td class="shift-grid-cell" onclick="openCreateModal(new Date('${cellDateStr}'), '${emp.id}')">
                                    <div class="shift-slot is-available justify-content-center align-items-center text-muted">
                                        <i class="bi bi-plus-lg fs-5"></i>
                                    </div>
                                </td>
                            `;
                        }
                        tempDate.setDate(tempDate.getDate() + 1);
                    }
                    tbody += `</tr>`;
                });
            } else {
                // Employee Mode: Shifts List as Rows
                if (shiftsList.length === 0) {
                    tbody += `
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="text-muted mb-2"><i class="bi bi-calendar-x fs-1"></i></div>
                                <h6 class="text-dark">${T.noShiftsTitle}</h6>
                                <p class="text-muted small mb-0">${T.noShiftsDesc}</p>
                            </td>
                        </tr>
                    `;
                } else {
                    shiftsList.forEach(shift => {
                        tbody += `<tr>`;
                        
                        // Sticky Left Column: Shift Name & Working Hours
                        tbody += `
                            <td class="shift-name-col">
                                <div class="shift-info-card">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="shift-color-bar"></span>
                                        <strong class="shift-name-text text-truncate" title="${escapeHtml(shift.name)}">${escapeHtml(shift.name)}</strong>
                                    </div>
                                    <div class="shift-time-text">
                                        <i class="bi bi-clock me-1 text-primary"></i>${shift.start} – ${shift.end}
                                    </div>
                                    ${shift.hours ? `<div class="shift-hours-text"><i class="bi bi-hourglass-split me-1 text-muted"></i>${T.workHours.replace('{0}', shift.hours.toFixed(1))}</div>` : ''}
                                </div>
                            </td>
                        `;

                        // Day Columns
                        let tempDate = new Date(currentWeekStart);
                        for (let i = 0; i < 7; i++) {
                            let cellDateStr = getISODateString(tempDate);
                            let cellDateObj = new Date(tempDate);
                            cellDateObj.setHours(0, 0, 0, 0);

                            let dayEvent = events.find(e => {
                                let eDate = e.start.split('T')[0];
                                return e.shiftId == shift.id && eDate === cellDateStr;
                            });

                            let isPast = cellDateObj < today;
                            let isUnavailable = cellDateStr < shift.from || (shift.to && cellDateStr > shift.to);

                            if (dayEvent) {
                                let isApproved = (dayEvent.statusId === 1 || dayEvent.statusName === "Approved");
                                let isRejected = (dayEvent.statusId === 2 || dayEvent.statusName === "Rejected");
                                let eJson = JSON.stringify(dayEvent).replace(/'/g, "&#39;");

                                if (isApproved) {
                                    tbody += `
                                        <td class="shift-grid-cell">
                                            <div class="shift-slot is-approved" onclick='event.stopPropagation(); openViewModal(${eJson})' title="${T.slotApprovedTitle}">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="badge-status status-approved">
                                                        <i class="bi bi-check-circle-fill"></i> ${T.approved}
                                                    </span>
                                                    <i class="bi bi-info-circle text-success small btn-view-slot" title="${T.viewDetails}"></i>
                                                </div>
                                                <div class="slot-time-text">${shift.start} – ${shift.end}</div>
                                                <input type="checkbox" class="form-check-input weekly-shift-cb d-none" 
                                                    value="${shift.id}_${cellDateStr}" checked disabled>
                                            </div>
                                        </td>
                                    `;
                                } else if (isRejected) {
                                    tbody += `
                                        <td class="shift-grid-cell">
                                            <div class="shift-slot is-rejected" onclick='event.stopPropagation(); openViewModal(${eJson})' title="${T.slotRejectedTitle}">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="badge-status status-rejected">
                                                        <i class="bi bi-x-circle-fill"></i> ${T.rejected}
                                                    </span>
                                                    <i class="bi bi-info-circle text-danger small btn-view-slot" title="${T.viewDetails}"></i>
                                                </div>
                                                <div class="slot-time-text">${shift.start} – ${shift.end}</div>
                                                <input type="checkbox" class="form-check-input weekly-shift-cb d-none" 
                                                    value="${shift.id}_${cellDateStr}">
                                            </div>
                                        </td>
                                    `;
                                } else {
                                    // Pending
                                    tbody += `
                                        <td class="shift-grid-cell">
                                            <div class="shift-slot is-pending was-pending" title="${T.slotPendingTitle}">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <div class="form-check mb-0 p-0 d-flex align-items-center">
                                                        <input type="checkbox" class="form-check-input weekly-shift-cb m-0 me-2" 
                                                            id="cb_${shift.id}_${cellDateStr}"
                                                            value="${shift.id}_${cellDateStr}" checked>
                                                        <label class="form-check-label badge-status status-pending m-0 cursor-pointer" for="cb_${shift.id}_${cellDateStr}">
                                                            <i class="bi bi-hourglass-split"></i> ${T.pending}
                                                        </label>
                                                    </div>
                                                    <i class="bi bi-info-circle text-warning-emphasis small btn-view-slot" title="${T.details}" onclick='event.stopPropagation(); openViewModal(${eJson})'></i>
                                                </div>
                                                <div class="slot-time-text">${shift.start} – ${shift.end}</div>
                                            </div>
                                        </td>
                                    `;
                                }
                            } else if (isPast) {
                                tbody += `
                                    <td class="shift-grid-cell">
                                        <div class="shift-slot is-past" title="${T.slotPastTitle}">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="badge-status status-past">
                                                    <i class="bi bi-lock-fill"></i> ${T.overdue}
                                                </span>
                                            </div>
                                            <div class="slot-time-text text-muted">${shift.start} – ${shift.end}</div>
                                            <input type="checkbox" class="form-check-input weekly-shift-cb d-none" 
                                                value="${shift.id}_${cellDateStr}" disabled>
                                        </div>
                                    </td>
                                `;
                            } else if (isUnavailable) {
                                tbody += `
                                    <td class="shift-grid-cell">
                                        <div class="shift-slot is-unavailable" title="${T.slotUnavailableTitle}">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="badge-status status-unavailable">
                                                    <i class="bi bi-dash-circle"></i> ${T.notApplicable}
                                                </span>
                                            </div>
                                            <div class="slot-time-text text-muted">${shift.start} – ${shift.end}</div>
                                            <input type="checkbox" class="form-check-input weekly-shift-cb d-none" 
                                                value="${shift.id}_${cellDateStr}" disabled>
                                        </div>
                                    </td>
                                `;
                            } else {
                                // Available slot
                                tbody += `
                                    <td class="shift-grid-cell">
                                        <div class="shift-slot is-available" title="${T.slotAvailableTitle}">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <div class="form-check mb-0 p-0 d-flex align-items-center">
                                                    <input type="checkbox" class="form-check-input weekly-shift-cb m-0 me-2" 
                                                        id="cb_${shift.id}_${cellDateStr}"
                                                        value="${shift.id}_${cellDateStr}">
                                                    <label class="form-check-label badge-status status-available m-0 cursor-pointer" for="cb_${shift.id}_${cellDateStr}">
                                                        <i class="bi bi-circle"></i> ${T.notRegistered}
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="slot-time-text">${shift.start} – ${shift.end}</div>
                                        </div>
                                    </td>
                                `;
                            }
                            tempDate.setDate(tempDate.getDate() + 1);
                        }
                        tbody += `</tr>`;
                    });
                }
            }

            $('#gridBody').html(tbody);
        }

        function syncWeeklySchedule() {
            var token = $('input[name="__RequestVerificationToken"]').val();
            var registrations = [];
            
            $('.weekly-shift-cb:checked:not(:disabled)').each(function() {
                var parts = $(this).val().split('_');
                registrations.push({
                    EmployeeId: 0,
                    ShiftId: parseInt(parts[0]),
                    WorkDate: parts[1],
                    Note: ""
                });
            });

            // Retain approved shifts so they aren't removed by sync
            $('.weekly-shift-cb:checked:disabled').each(function() {
                var parts = $(this).val().split('_');
                registrations.push({
                    EmployeeId: 0,
                    ShiftId: parseInt(parts[0]),
                    WorkDate: parts[1],
                    Note: ""
                });
            });

            var data = {
                StartOfWeek: getISODateString(currentWeekStart),
                Registrations: registrations
            };

            var btn = $('#btnSubmitWeekly');
            var originalBtnHtml = btn.html();
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status"></span> ' + escapeHtml(@Json.Serialize(ShiftRegistrationResource.Btn_Sending)));

            $.ajax({
                url: '/ShiftRegistration/SyncWeekly',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                headers: { 'RequestVerificationToken': token },
                success: function(res) {
                    if (res.success) {
                        showAppToast('success', @Json.Serialize(SharedResource.ResourceManager.GetString("Shift_RegSuccess")));
                        fetchEvents();
                    } else {
                        showAppToast('error', res.message || '@Html.Raw(SharedResource.ResourceManager.GetString("Shift_ErrOccurred"))');
                    }
                },
                error: function(err) {
                    var msg = err.responseJSON?.message || err.responseText || '@Html.Raw(SharedResource.ResourceManager.GetString("Shift_SysError"))';
                    showAppToast('error', '@Html.Raw(SharedResource.ResourceManager.GetString("Shift_ErrPrefix"))' + msg);
                },
                complete: function() {
                    btn.prop('disabled', false).html(originalBtnHtml);
                }
            });
        }

        function copyPreviousWeek() {
            let prevWeekStart = new Date(currentWeekStart);
            prevWeekStart.setDate(prevWeekStart.getDate() - 7);
            
            let startStr = getISODateString(prevWeekStart);
            let endStr = new Date(prevWeekStart);
            endStr.setDate(endStr.getDate() + 7);
            
            $.ajax({
                url: '/ShiftRegistration/GetEvents',
                type: 'GET',
                data: {
                    start: startStr,
                    end: getISODateString(endStr),
                    employeeId: '',
                    myOnly: true
                },
                success: function(events) {
                    if (events.length === 0) {
                        showAppToast('warning', @Json.Serialize(SharedResource.ResourceManager.GetString("Shift_ErrNoPrevShifts")));
                        return;
                    }
                    
                    $('.weekly-shift-cb:not(:disabled)').prop('checked', false);
                    let today = new Date();
                    today.setHours(0,0,0,0);
                    let checkedCount = 0;

                    events.forEach(e => {
                        let eDate = new Date(e.start.split('T')[0]);
                        eDate.setDate(eDate.getDate() + 7);
                        let targetDateStr = getISODateString(eDate);
                        
                        if (eDate >= today) {
                            let cb = $(`.weekly-shift-cb[value="${e.shiftId}_${targetDateStr}"]`);
                            if (cb.length > 0 && !cb.prop('disabled')) {
                                cb.prop('checked', true).trigger('change');
                                checkedCount++;
                            }
                        }
                    });

                    showAppToast('success', @(Json.Serialize(ShiftRegistrationResource.Toast_CopiedFormat)).replace('{0}', checkedCount));
                },
                error: function() {
                    showAppToast('error', '@Html.Raw(SharedResource.ResourceManager.GetString("Shift_ErrLoadPrev"))');
                }
            });
        }

        function filterShifts(text) {
            text = text.toLowerCase();
            $('.shift-option').each(function() {
                var shiftName = $(this).data('shift-name').toLowerCase();
                if (shiftName.indexOf(text) > -1) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }

        function openCreateModal(dateObj, empId) {
            var today = new Date();
            today.setHours(0, 0, 0, 0);
            
            if (dateObj < today) {
                showAppToast('warning', '@Html.Raw(ShiftRegistrationResource.PastDateError)');
                return;
            }

            $('#WorkDate').val(getISODateString(dateObj));
            
            let displayDate = dateObj.getDate().toString().padStart(2, '0') + '/' + 
                              (dateObj.getMonth() + 1).toString().padStart(2, '0') + '/' + 
                              dateObj.getFullYear();
            $('#modalDateDisplay').text(@(Json.Serialize(ShiftRegistrationResource.Modal_DateFormat)).replace('{0}', displayDate));

            if (empId) {
                $('#EmployeeId').val(empId);
                let emp = employeesList.find(e => e.id == empId);
                if (emp) {
                    $('#modalEmpName').text(emp.name);
                }
            } else {
                if (employeesList.length > 0) {
                    let firstEmp = employeesList[0];
                    if (firstEmp.id === 'me') {
                        $('#EmployeeId').val(0);
                        $('#modalEmpName').text(@Json.Serialize(SharedResource.Shift_Me));
                    } else {
                        $('#EmployeeId').val(firstEmp.id);
                        $('#modalEmpName').text(firstEmp.name);
                    }
                }
            }
            
            $('.shift-checkbox').prop('checked', false);
            $('#saveShiftBtnContainer').hide();
            $('#searchShiftInput').val('');
            $('.shift-list-container').html('<div class="text-center py-3 text-muted small"><span class="spinner-border spinner-border-sm me-1"></span> ' + escapeHtml(@Json.Serialize(ShiftRegistrationResource.Modal_LoadingShifts)) + '</div>');

            $.get('@Url.Action("AvailableShifts", "ShiftRegistration")', { employeeId: $('#EmployeeId').val(), workDate: $('#WorkDate').val() })
                .done(function(shifts) {
                    const container = $('.shift-list-container').empty();
                    if (!shifts.length) {
                        container.html($('<div class="text-center py-3 text-muted small">').text(@Json.Serialize(ShiftRegistrationResource.Modal_NoShiftsForDay)));
                        return;
                    }
                    shifts.forEach(function(shift) {
                        const row = $('<div>').addClass('shift-item d-flex justify-content-between align-items-center py-2 px-2 border-bottom shift-option rounded-2').attr('data-shift-name', shift.name);
                        const label = $('<label>').attr('for', 'shift_' + shift.id).addClass('form-check-label small fw-medium text-dark cursor-pointer mb-0').text(shift.name + ' (' + shift.time + ')');
                        const input = $('<input>').attr({ type: 'checkbox', id: 'shift_' + shift.id, name: 'ShiftId', value: shift.id }).addClass('form-check-input shift-checkbox m-0');
                        row.append(label, input);
                        container.append(row);
                    });
                })
                .fail(function() {
                    $('.shift-list-container').html($('<div class="text-center py-3 text-danger small">').text(@Json.Serialize(ShiftRegistrationResource.Modal_LoadShiftsError)));
                });

            var modal = new bootstrap.Modal(document.getElementById('shiftModal'));
            modal.show();
        }

        function openViewModal(eventObj) {
            $('#vEmployee').text(eventObj.employeeName);
            $('#vStore').text(eventObj.storeName);
            $('#vShift').text(eventObj.title);
            let timeText = (eventObj.startTime && eventObj.endTime) ? `${eventObj.startTime} – ${eventObj.endTime}` : (eventObj.start.replace('T', ' ') + ' – ' + eventObj.end.replace('T', ' '));
            $('#vTime').text(timeText);
            
            let statusHtml = '';
            if (eventObj.statusId === 1 || eventObj.statusName === 'Approved') {
                statusHtml = `<span class="badge-status status-approved"><i class="bi bi-check-circle-fill"></i> ${T.approved}</span>`;
            } else if (eventObj.statusId === 2 || eventObj.statusName === 'Rejected') {
                statusHtml = `<span class="badge-status status-rejected"><i class="bi bi-x-circle-fill"></i> ${T.rejectedLong}</span>`;
            } else {
                statusHtml = `<span class="badge-status status-pending"><i class="bi bi-hourglass-split"></i> ${T.pending}</span>`;
            }
            $('#vStatusBadge').html(statusHtml);
            $('#vStatus').text(eventObj.statusName || '');
            $('#vNote').text(eventObj.note || '-');
            $('#vRegistrationId').val(eventObj.id);
            
            if (eventObj.rejectionReason) {
                $('#vRejectionReason').text(eventObj.rejectionReason);
                $('#vRejectionReasonRow').show();
            } else {
                $('#vRejectionReasonRow').hide();
            }

            if (eventObj.approvedBy) {
                $('#vApprover').text(eventObj.approvedBy);
                $('#vApprovedAt').text(eventObj.approvedAt ? `(${eventObj.approvedAt})` : '');
                $('#vApproverRow').show();
            } else {
                $('#vApproverRow').hide();
            }

            if (!isManager || activeMode === 'my') {
                if (eventObj.statusId === 1 || eventObj.statusName === 'Approved') {
                    $('#btnCancelRegistration').hide();
                    $('#txtApprovedNotice').show();
                    $('#btnGoToSwapShift').show();
                } else {
                    $('#btnCancelRegistration').show();
                    $('#txtApprovedNotice').hide();
                    $('#btnGoToSwapShift').hide();
                }
            }
            
            var modal = new bootstrap.Modal(document.getElementById('viewModal'));
            modal.show();
        }

        async function deleteRegistration() {
            if (!(await AppConfirm({ message: '@Html.Raw(ShiftRegistrationResource.ConfirmCancel)', type: 'danger', icon: 'bi-calendar-x' }))) return;
            var id = $('#vRegistrationId').val();
            $.ajax({
                url: '/ShiftRegistration/Delete',
                type: 'POST',
                data: { id: id },
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function(res) {
                    if (res.success) {
                        $('#viewModal').modal('hide');
                        showAppToast('success', @Json.Serialize(ShiftRegistrationResource.Toast_CancelSuccess));
                        fetchEvents();
                    } else {
                        showAppToast('error', res.message || @Json.Serialize(ShiftRegistrationResource.Toast_CancelFailed));
                    }
                },
                error: function(err) {
                    var msg = err.responseJSON?.message || err.responseText || @Json.Serialize(ShiftRegistrationResource.Toast_SystemError);
                    showAppToast('error', '@Html.Raw(SharedResource.ResourceManager.GetString("Shift_ErrPrefix"))' + msg);
                }
            });
        }

        function showAppToast(type, message) {
            if (typeof AppToast !== 'undefined') {
                if (type === 'success') AppToast.success(message);
                else if (type === 'warning') AppToast.warning(message);
                else AppToast.error(message);
            } else {
                AppToast.error(message);
            }
        }
    </script>
}
