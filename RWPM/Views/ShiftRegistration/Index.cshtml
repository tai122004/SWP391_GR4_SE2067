@using Microsoft.AspNetCore.Mvc.Localization
@using RWPM.Resources.Shared
@using System.Globalization

@{
    ViewData["Title"] = ShiftRegistrationResource.ShiftRegistration;
    var currentStoreId = ViewBag.CurrentStoreId as int?;
    string? currentStoreName = null;
    if (ViewBag.AllStores != null && currentStoreId.HasValue)
    {
        foreach (var st in ViewBag.AllStores)
        {
            if (st.StoreId == currentStoreId)
            {
                currentStoreName = st.StoreName;
                break;
            }
        }
    }
    bool isManager = (ViewBag.IsManager == true);

    // Dữ liệu cho js/shift-registration/* (null = máy chủ không gửi danh sách)
    object? shiftsData = null;
    if (ViewBag.Shifts != null)
    {
        shiftsData = ((IEnumerable<RWPM.Models.Entities.Shift>)ViewBag.Shifts).Select(s => new {
            id = s.ShiftId,
            name = s.ShiftName,
            from = s.EffectiveFrom.ToString("yyyy-MM-dd"),
            to = s.EffectiveTo?.ToString("yyyy-MM-dd"),
            start = s.StartTime.ToString(@"hh\:mm"),
            end = s.EndTime.ToString(@"hh\:mm") + (s.EndDayOffset > 0 ? " (+1)" : ""),
            hours = s.ScheduledWorkHours
        }).ToList();
    }
    object? employeesData = null;
    if (ViewBag.Employees != null)
    {
        employeesData = ((IEnumerable<RWPM.Models.Entities.Employee>)ViewBag.Employees).Select(emp => new {
            id = emp.EmployeeId.ToString(),
            code = emp.EmployeeCode,
            name = emp.Account?.FullName ?? emp.Username
        }).ToList();
    }
}

<div class="container-fluid px-0 shift-registration-page">
    @Html.AntiForgeryToken()

    <!-- Page Header -->
    <div class="app-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h4 class="mb-0">@ShiftRegistrationResource.ShiftRegistration</h4>
                @if (!string.IsNullOrEmpty(currentStoreName))
                {
                    <span class="app-badge app-badge-neutral">
                        <i class="bi bi-shop"></i>
                        <span>@ShiftRegistrationResource.Header_Branch <strong>@currentStoreName</strong></span>
                    </span>
                }
            </div>
            <p class="text-muted small mb-0">@ShiftRegistrationResource.Header_Description</p>
        </div>

        <!-- Legend / Chú thích trạng thái -->
        <div class="status-legend-bar d-flex flex-wrap align-items-center gap-3 px-3 py-2 bg-white border small">
            <span class="legend-item"><span class="legend-dot dot-available"></span> @ShiftRegistrationResource.Status_NotRegistered</span>
            <span class="legend-item"><span class="legend-dot dot-selected"></span> @ShiftRegistrationResource.Status_NewlySelected</span>
            <span class="legend-item"><span class="legend-dot dot-pending"></span> @ShiftRegistrationResource.Status_Pending</span>
            <span class="legend-item"><span class="legend-dot dot-approved"></span> @ShiftRegistrationResource.Status_Approved</span>
            <span class="legend-item"><span class="legend-dot dot-past"></span> @ShiftRegistrationResource.Status_Overdue</span>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="card overflow-hidden mb-4 shift-main-card">
        @if (isManager)
        {
            <div class="d-flex align-items-center justify-content-between px-3 pt-3 pb-2 border-bottom flex-wrap gap-2">
                <div class="d-flex gap-2 shift-mode-tabs" id="shiftModeTabs" role="tablist">
                    <button class="btn btn-sm btn-outline-secondary active px-3" id="tabMyRegistration" type="button" role="tab" aria-selected="true" onclick="switchViewMode('my')">
                        <i class="bi bi-person-badge me-1"></i> @ShiftRegistrationResource.Tab_MyRegistration
                    </button>
                    <button class="btn btn-sm btn-outline-secondary px-3" id="tabManagerSchedule" type="button" role="tab" aria-selected="false" onclick="switchViewMode('manager')">
                        <i class="bi bi-people-fill me-1"></i> @ShiftRegistrationResource.Tab_ManagerSchedule
                    </button>
                </div>
                @if (User.IsChainManager())
                {
                    @if (ViewBag.AllStores != null)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <span class="small text-muted fw-semibold"><i class="bi bi-shop me-1"></i>@ShiftRegistrationResource.Label_Store</span>
                            <select id="switchStoreSelect" class="form-select form-select-sm py-1" style="min-width: 180px;" aria-label="@ShiftRegistrationResource.Label_Store" onchange="changeStoreFilter(this.value)">
                                @foreach (var st in ViewBag.AllStores)
                                {
                                    <option value="@st.StoreId" selected="@(st.StoreId == ViewBag.CurrentStoreId ? "selected" : null)">@st.StoreName</option>
                                }
                            </select>
                        </div>
                    }
                }
            </div>
        }

        <!-- Navigation Toolbar -->
        <div class="card-header bg-white border-bottom py-3 px-3 px-md-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <!-- Left: Week Navigation Controls -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-secondary" id="btnPrevWeek" title="@ShiftRegistrationResource.Nav_PrevWeek" aria-label="@ShiftRegistrationResource.Nav_PrevWeek">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary fw-semibold px-2 px-md-3" id="btnTodayWeek" title="@ShiftRegistrationResource.Nav_GoToCurrentWeek">
                            @ShiftRegistrationResource.Nav_ThisWeek
                        </button>
                        <button type="button" class="btn btn-outline-secondary" id="btnNextWeek" title="@ShiftRegistrationResource.Nav_NextWeek" aria-label="@ShiftRegistrationResource.Nav_NextWeek">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>

                    <!-- Week Display Pill with Popover Picker -->
                    <div class="position-relative">
                        <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2 px-3 py-1" id="btnToggleWeekPicker" aria-haspopup="true" aria-controls="weekPickerDropdown">
                            <i class="bi bi-calendar3 text-muted"></i>
                            <span id="currentWeekDisplay" class="fw-semibold"></span>
                            <span id="currentWeekRangeDisplay" class="text-muted small"></span>
                            <i class="bi bi-chevron-down text-muted small ms-1"></i>
                        </button>

                        <!-- Custom Calendar Popover Dropdown -->
                        <div id="weekPickerDropdown" class="week-picker-dropdown border bg-white p-3" style="display: none;">
                            <div class="wp-header d-flex justify-content-between align-items-center pb-2 mb-2 border-bottom">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-light wp-prev-year px-2" title="@ShiftRegistrationResource.Picker_PrevYear" aria-label="@ShiftRegistrationResource.Picker_PrevYear"><i class="bi bi-chevron-double-left"></i></button>
                                    <button type="button" class="btn btn-light wp-prev-month px-2" title="@ShiftRegistrationResource.Picker_PrevMonth" aria-label="@ShiftRegistrationResource.Picker_PrevMonth"><i class="bi bi-chevron-left"></i></button>
                                </div>
                                <strong id="wpMonthYearDisplay" class="fs-6"></strong>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-light wp-next-month px-2" title="@ShiftRegistrationResource.Picker_NextMonth" aria-label="@ShiftRegistrationResource.Picker_NextMonth"><i class="bi bi-chevron-right"></i></button>
                                    <button type="button" class="btn btn-light wp-next-year px-2" title="@ShiftRegistrationResource.Picker_NextYear" aria-label="@ShiftRegistrationResource.Picker_NextYear"><i class="bi bi-chevron-double-right"></i></button>
                                </div>
                            </div>
                            <div class="wp-body">
                                <table class="table table-borderless table-sm text-center mb-0 wp-table">
                                    <thead>
                                        <tr class="text-muted small">
                                            <th style="width: 28px;">#</th>
                                            <th>@ShiftRegistrationResource.Picker_Mon</th><th>@ShiftRegistrationResource.Picker_Tue</th><th>@ShiftRegistrationResource.Picker_Wed</th><th>@ShiftRegistrationResource.Picker_Thu</th><th>@ShiftRegistrationResource.Picker_Fri</th><th>@ShiftRegistrationResource.Picker_Sat</th><th>@ShiftRegistrationResource.Picker_Sun</th>
                                        </tr>
                                    </thead>
                                    <tbody id="wpCalendarBody">
                                        <!-- Calendar rows generated by JS -->
                                    </tbody>
                                </table>
                            </div>
                            <div class="text-center pt-2 mt-2 border-top">
                                <small class="text-muted">@ShiftRegistrationResource.Picker_Hint</small>
                            </div>
                        </div>
                    </div>

                    @if (isManager)
                    {
                        <div id="managerFilterEmployeeContainer" style="display: none;">
                            <select id="filterEmployeeId" class="form-select form-select-sm" style="min-width: 170px;" aria-label="@ShiftRegistrationResource.FilterByEmployee">
                                <option value="">@ShiftRegistrationResource.FilterByEmployee</option>
                                @if (ViewBag.Employees != null)
                                {
                                    foreach (var emp in ViewBag.Employees)
                                    {
                                        <option value="@emp.EmployeeId">@emp.EmployeeCode - @(emp.Account?.FullName ?? emp.Username)</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                </div>

                <!-- Right: Action Buttons -->
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" onclick="fetchEvents()" title="@ShiftRegistrationResource.Toolbar_ReloadTitle">
                        <i class="bi bi-arrow-clockwise" id="iconRefresh"></i>
                        <span class="d-none d-sm-inline">@ShiftRegistrationResource.Toolbar_Refresh</span>
                    </button>

                    @if (isManager)
                    {
                        <div id="managerActionBtns" class="d-flex align-items-center gap-2" style="display: none;">
                            <a id="btnCoverageLink" href="#" class="btn btn-sm btn-outline-secondary" style="display: none;" title="@ShiftRegistrationResource.Coverage_Title">
                                <i class="bi bi-bar-chart-steps me-1"></i> @ShiftRegistrationResource.Coverage_Link
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="copyPreviousWeek()">
                                <i class="bi bi-copy me-1"></i> @ShiftRegistrationResource.Toolbar_CopyWeek
                            </button>
                            <button type="button" class="btn btn-sm btn-primary" onclick="openCreateModal(new Date())">
                                <i class="bi bi-plus-lg me-1"></i> @ShiftRegistrationResource.CreateShift
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Matrix Schedule Table Area -->
        <div class="card-body p-0 position-relative">
            <div class="table-responsive shift-table-container">
                <table class="table modern-shift-table align-middle mb-0" id="shiftGridTable">
                    <thead>
                        <tr id="gridHeaderRow">
                            <!-- Column headers generated by JS -->
                        </tr>
                    </thead>
                    <tbody id="coverageBody" class="coverage-tbody">
                        <!-- Coverage rows (manager schedule) generated by JS -->
                    </tbody>
                    <tbody id="gridBody">
                        <!-- Employee or Shift rows generated by JS -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Sticky Bottom Summary Bar -->
        <div class="weekly-summary-bar p-3 bg-white border-top d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small fw-semibold">@ShiftRegistrationResource.Summary_Title</span>
                    <span class="app-badge app-badge-info">
                        <strong id="summaryNewCount" class="num">0</strong> @ShiftRegistrationResource.Summary_NewSelected
                    </span>
                    <span class="app-badge app-badge-warning">
                        <strong id="summaryPendingCount" class="num">0</strong> @ShiftRegistrationResource.Summary_Pending
                    </span>
                    <span class="app-badge app-badge-success">
                        <strong id="summaryApprovedCount" class="num">0</strong> @ShiftRegistrationResource.Summary_Approved
                    </span>
                </div>
                <div class="vr text-secondary d-none d-md-block" style="height: 20px;"></div>
                <div class="d-flex align-items-center gap-1 small">
                    <i class="bi bi-clock-history text-muted"></i>
                    <span>@ShiftRegistrationResource.Summary_TotalHours <strong id="summaryTotalHours" class="num">@string.Format(ShiftRegistrationResource.Summary_HoursFormat, "0.0")</strong></span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 ms-auto">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" onclick="fetchEvents()" title="@ShiftRegistrationResource.Summary_ResetTitle">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> @ShiftRegistrationResource.Summary_Reset
                </button>
                <button type="button" id="btnSubmitWeekly" class="btn btn-primary btn-sm px-4" onclick="syncWeeklySchedule()">
                    <i class="bi bi-send-fill me-1"></i> @SharedResource.ResourceManager.GetString("Shift_RegisterWeek")
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Đăng ký ca đơn lẻ theo ngày (#shiftModal) -->
<div class="modal fade" id="shiftModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 460px;">
        <div class="modal-content overflow-hidden">
            <div class="modal-header py-3">
                <div class="d-flex align-items-center gap-2">
                    <div>
                        <h5 class="modal-title mb-0">@ShiftRegistrationResource.Modal_RegisterTitle</h5>
                        <small class="text-muted" id="modalDateDisplay"></small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@ShiftRegistrationResource.Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3 d-flex align-items-center justify-content-between p-2 bg-light border">
                    <span class="small text-muted">@ShiftRegistrationResource.Modal_EmployeeLabel</span>
                    <strong class="text-dark small" id="modalEmpName">@SharedResource.Shift_Me</strong>
                </div>

                <div class="mb-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" id="searchShiftInput" placeholder="@ShiftRegistrationResource.SearchBtn" aria-label="@ShiftRegistrationResource.SearchBtn" onkeyup="filterShifts(this.value)">
                    </div>
                </div>

                <form id="shiftForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="EmployeeId" name="EmployeeId" />
                    <input type="hidden" id="WorkDate" name="WorkDate" />

                    <label class="form-label small fw-semibold text-muted mb-2">@ShiftRegistrationResource.Modal_SelectAvailableShift</label>
                    <div class="shift-list-container pe-1" style="max-height: 240px; overflow-y: auto;">
                        <!-- Shift options rendered via AJAX -->
                    </div>

                    @if (isManager)
                    {
                        <div class="mt-3 pt-2 border-top">
                            <a href="@Url.Action("Create", "Shift")" class="small text-decoration-none fw-semibold">
                                <i class="bi bi-plus-circle me-1"></i> @ShiftRegistrationResource.CreateNewShift
                            </a>
                        </div>
                    }

                    <div class="mt-4 d-flex justify-content-end gap-2" id="saveShiftBtnContainer" style="display: none;">
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">@SharedResource.Button_Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> @ShiftRegistrationResource.Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Xem chi tiết ca / Hủy ca / Đổi ca (#viewModal) -->
<div class="modal fade" id="viewModal" tabindex="-1" aria-labelledby="viewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
        <div class="modal-content overflow-hidden">
            <div class="modal-header py-3">
                <div class="d-flex align-items-center gap-2">
                    <div>
                        <h5 class="modal-title mb-0">@ShiftRegistrationResource.ShiftDetails</h5>
                        <small class="text-muted">@ShiftRegistrationResource.View_Subtitle</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@ShiftRegistrationResource.Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="detail-group mb-3 pb-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small"><i class="bi bi-person me-1"></i> @ShiftRegistrationResource.Employee:</span>
                        <strong class="text-dark" id="vEmployee"></strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small"><i class="bi bi-shop me-1"></i> @RWPM.Resources.Models.Employee.Store:</span>
                        <span class="text-dark fw-medium" id="vStore"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small"><i class="bi bi-clock-history me-1"></i> @ShiftRegistrationResource.Shift:</span>
                        <strong id="vShift"></strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small"><i class="bi bi-calendar-event me-1"></i> @ShiftRegistrationResource.Time:</span>
                        <span class="text-dark fw-medium" id="vTime"></span>
                    </div>
                </div>

                <div class="detail-group mb-3 pb-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">@ShiftRegistrationResource.Status:</span>
                        <div id="vStatusBadge"></div>
                    </div>
                    <div class="d-none">
                        <span id="vStatus"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-muted small">@ShiftRegistrationResource.Note:</span>
                        <span class="text-dark text-end small" id="vNote">-</span>
                    </div>
                </div>

                <div id="vRejectionReasonRow" class="alert alert-danger py-2 px-3 mb-3 small" style="display: none;">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    <strong>@ShiftRegistrationResource.View_RejectionReason</strong>
                    <span id="vRejectionReason" class="ms-1"></span>
                </div>

                <div id="vApproverRow" class="p-2 bg-light border small text-muted mb-0" style="display: none;">
                    <i class="bi bi-person-check me-1"></i>
                    <span>@ShiftRegistrationResource.View_Approver <strong id="vApprover" class="text-dark"></strong></span>
                    <span id="vApprovedAt" class="ms-1"></span>
                </div>
            </div>
            <div class="modal-footer py-2 px-4 d-flex justify-content-between">
                <input type="hidden" id="vRegistrationId" />
                @if (isManager)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteRegistration()">@ShiftRegistrationResource.View_CancelShift</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" data-bs-dismiss="modal">@ShiftRegistrationResource.Close</button>
                }
                else
                {
                    <a href="/Request" class="btn btn-sm btn-outline-secondary" id="btnGoToSwapShift" style="display: none;">
                        <i class="bi bi-arrow-left-right me-1"></i> @SharedResource.Req_ChangeShift
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="btnCancelRegistration" onclick="deleteRegistration()">
                        <i class="bi bi-trash3 me-1"></i> @ShiftRegistrationResource.Cancel
                    </button>
                    <span id="txtApprovedNotice" class="text-muted small" style="display: none;">
                        <i class="bi bi-shield-lock me-1"></i> @ShiftRegistrationResource.View_ApprovedNotice
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" data-bs-dismiss="modal">@ShiftRegistrationResource.Close</button>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Scoped Modern Styles for Shift Registration */
    .shift-registration-page {
        --slot-available-bg: #ffffff;
        --slot-available-border: #e2e8f0;
        --slot-selected-bg: #eff6ff;
        --slot-selected-border: #3b82f6;
        --slot-pending-bg: #fffbeb;
        --slot-pending-border: #fde68a;
        --slot-approved-bg: #f0fdf4;
        --slot-approved-border: #86efac;
        --slot-rejected-bg: #fef2f2;
        --slot-rejected-border: #fca5a5;
        --slot-past-bg: #f8fafc;
        --slot-past-border: #e2e8f0;
    }

    /* Status Legend */
    .status-legend-bar .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #475569;
        font-weight: 500;
    }
    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }
    .dot-available { background-color: #cbd5e1; border: 1px solid #94a3b8; }
    .dot-selected { background-color: #3b82f6; }
    .dot-pending { background-color: #f59e0b; }
    .dot-approved { background-color: #10b981; }
    .dot-past { background-color: #94a3b8; opacity: 0.5; }

    /* Modern Table Container */
    .shift-table-container {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        min-height: 380px;
    }
    .modern-shift-table {
        min-width: 980px;
        border-collapse: separate;
        border-spacing: 0;
    }
    .modern-shift-table th {
        background: #f8fafc;
        color: #334155;
        font-weight: 600;
        font-size: 0.84rem;
        padding: 12px 10px;
        border-bottom: 2px solid #e2e8f0;
        border-right: 1px solid #edf2f7;
        text-align: center;
        position: sticky;
        top: 0;
        z-index: 2;
    }
    .modern-shift-table th.th-today {
        background: #eff6ff !important;
        color: #1d4ed8 !important;
        border-bottom-color: #3b82f6 !important;
    }
    .modern-shift-table th.th-shift-col {
        width: 220px;
        min-width: 220px;
        left: 0;
        z-index: 5;
        text-align: left;
        padding-left: 16px;
        border-right: 2px solid #e2e8f0;
    }
    .modern-shift-table td.shift-name-col {
        position: sticky;
        left: 0;
        z-index: 4;
        background: #ffffff;
        width: 220px;
        min-width: 220px;
        padding: 12px 14px;
        border-right: 2px solid #e2e8f0;
        border-bottom: 1px solid #edf2f7;
    }
    .modern-shift-table td.shift-grid-cell {
        padding: 6px;
        border-right: 1px solid #edf2f7;
        border-bottom: 1px solid #edf2f7;
        vertical-align: stretch;
        height: 100%;
    }
    .modern-shift-table tr:hover td.shift-name-col {
        background: #fbfcfe;
    }

    /* Shift Master Column Card */
    .shift-info-card {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }
    .shift-color-bar {
        width: 4px;
        height: 14px;
        border-radius: 2px;
        background-color: #2563eb;
        display: inline-block;
    }
    .shift-name-text {
        font-size: 0.92rem;
        color: #0f172a;
    }
    .shift-time-text {
        font-size: 0.8rem;
        color: #475569;
        font-weight: 500;
    }
    .shift-hours-text {
        font-size: 0.75rem;
        color: #64748b;
    }

    /* Individual Slot Cards inside Grid */
    .shift-slot {
        min-height: 84px;
        height: 100%;
        border-radius: var(--app-radius, 6px);
        padding: 8px 10px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        cursor: pointer;
        transition: all 0.16s ease-in-out;
        position: relative;
        user-select: none;
    }
    .shift-slot .slot-time-text {
        font-size: 0.78rem;
        font-weight: 600;
        color: #334155;
        margin-top: 4px;
    }
    .shift-slot .slot-sub-text {
        font-size: 0.72rem;
        margin-top: 2px;
    }
    .shift-slot .btn-view-slot {
        cursor: pointer;
        padding: 2px 4px;
        border-radius: 4px;
        transition: background 0.15s;
    }
    .shift-slot .btn-view-slot:hover {
        background-color: rgba(0,0,0,0.06);
    }

    /* State: Available (Chưa đăng ký) */
    .shift-slot.is-available {
        background-color: var(--slot-available-bg);
        border: 1px dashed var(--slot-available-border);
    }
    .shift-slot.is-available:hover {
        border-color: #93c5fd;
        background-color: #f8fbff;
    }

    /* State: Selected (Mới chọn) */
    .shift-slot.is-selected {
        background-color: var(--slot-selected-bg) !important;
        border: 1.5px solid var(--slot-selected-border) !important;
    }

    /* State: Pending (Chờ duyệt) */
    .shift-slot.is-pending {
        background-color: var(--slot-pending-bg);
        border: 1.5px solid var(--slot-pending-border);
    }
    .shift-slot.is-pending:hover {
        border-color: #f59e0b;
    }

    /* State: Pending but unchecked (Sắp hủy khi lưu) */
    .shift-slot.is-pending-cancelled {
        background-color: #f8fafc !important;
        border: 1px dashed #cbd5e1 !important;
        opacity: 0.75;
    }

    /* State: Approved (Đã duyệt) */
    .shift-slot.is-approved {
        background-color: var(--slot-approved-bg);
        border: 1.5px solid var(--slot-approved-border);
        cursor: pointer;
    }
    .shift-slot.is-approved:hover {
        border-color: #10b981;
    }

    /* State: Rejected (Bị từ chối) */
    .shift-slot.is-rejected {
        background-color: var(--slot-rejected-bg);
        border: 1.5px solid var(--slot-rejected-border);
    }

    /* State: Past / Overdue (Quá hạn) */
    .shift-slot.is-past {
        background-color: var(--slot-past-bg);
        border: 1px solid var(--slot-past-border);
        opacity: 0.6;
        cursor: not-allowed;
    }

    /* State: Unavailable (Không áp dụng) */
    .shift-slot.is-unavailable {
        background-color: #f1f5f9;
        border: 1px dashed #cbd5e1;
        opacity: 0.45;
        cursor: not-allowed;
    }

    /* Badges */
    .badge-status {
        font-size: 0.72rem;
        font-weight: 600;
        padding: 3px 7px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        line-height: 1.2;
    }
    .status-available {
        color: #64748b;
        background-color: #f1f5f9;
    }
    .status-selected {
        color: #1d4ed8;
        background-color: #dbeafe;
    }
    .status-pending {
        color: #b45309;
        background-color: #fef3c7;
    }
    .status-approved {
        color: #047857;
        background-color: #d1fae5;
    }
    .status-rejected {
        color: #b91c1c;
        background-color: #fee2e2;
    }
    .status-past {
        color: #64748b;
        background-color: #e2e8f0;
    }
    .status-unavailable {
        color: #94a3b8;
        background-color: #e2e8f0;
    }

    /* Custom Checkbox within Matrix */
    .weekly-shift-cb {
        width: 17px;
        height: 17px;
        cursor: pointer;
        border-radius: 4px;
        border-color: #94a3b8;
    }
    .weekly-shift-cb:checked {
        background-color: #2563eb;
        border-color: #2563eb;
    }

    /* Sticky Bottom Summary Bar */
    .weekly-summary-bar {
        position: sticky;
        bottom: 0;
        z-index: 10;
    }

    /* Week Picker Popover */
    .week-picker-dropdown {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        z-index: 1050;
        width: 320px;
        border-radius: var(--app-radius, 6px);
        box-shadow: var(--app-overlay-shadow, 0 8px 24px rgba(23,32,43,.12));
    }
    /* Tab chế độ xem: trạng thái chọn dạng nền nhạt, không dùng nút chính */
    .shift-mode-tabs .btn.active {
        background: var(--app-blue-soft, #EEF3FB);
        border-color: #D6E2F5;
        color: var(--app-blue, #1554BB);
    }
    .wp-table th { padding: 4px; }
    .wp-table td {
        padding: 6px 4px;
        cursor: pointer;
        border-radius: 4px;
        font-size: 0.85rem;
    }
    .wp-week-row {
        transition: background-color 0.15s;
    }
    .wp-week-row:hover td {
        background-color: #eff6ff;
        color: #2563eb;
    }
    .wp-week-row.active td {
        background-color: #2563eb;
        color: #ffffff !important;
        font-weight: 600;
    }
    .wp-week-num {
        color: #94a3b8 !important;
        font-size: 0.72rem !important;
    }
    .wp-week-row.active .wp-week-num {
        color: #bfdbfe !important;
    }

    /* Coverage badges (manager schedule) */
    .coverage-tbody tr td { background: #f8fafc; padding-top: .35rem; padding-bottom: .35rem; }
    .coverage-tbody .coverage-head td { font-size: 11px; text-transform: uppercase; letter-spacing: .03em; }
    .coverage-badge { font-size: 11px; font-weight: 600; min-width: 44px; height: 22px; font-variant-numeric: tabular-nums; }
    .shift-slot.is-blocked .badge-status { white-space: nowrap; }

    .cursor-pointer { cursor: pointer; }
</style>

