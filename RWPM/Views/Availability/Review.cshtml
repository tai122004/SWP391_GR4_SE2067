@model RWPM.Models.ViewModels.Availability.AvailabilityReviewVM
@using RWPM.Common.Validation
@using RWPM.Models.ViewModels.Availability
@using R = RWPM.Resources.Shared.AvailabilityResource

@{
    ViewData["Title"] = R.Review_Title;
    var statusOptions = new[]
    {
        ("Pending", R.Status_Pending),
        ("Approved", R.Status_Approved),
        ("Rejected", R.Status_Rejected),
        ("All", R.Filter_AllStatuses)
    };
    var anyPending = Model.Paged.Data.Any(r => r.Status == RegistrationStatus.Pending);
}

@await Html.PartialAsync("_Styles")

<div class="container-fluid px-0">
    <form id="antiForgeryForm" class="d-none">@Html.AntiForgeryToken()</form>

    <div class="app-page-header">
        <div>
            <h4 class="mb-1">@R.Review_Title</h4>
            <div class="text-muted small">
                @if (Model.IsStoreManager)
                {
                    <i class="bi bi-geo-alt me-1"></i>@R.Review_ScopeLabel <strong>@(Model.ScopeStoreName ?? R.Unassigned)</strong>
                }
                else
                {
                    @R.Review_Subtitle
                }
            </div>
        </div>
        <div class="app-page-actions">
            <a asp-action="My" class="btn btn-outline-secondary d-flex align-items-center">
                <i class="bi bi-person-check me-1"></i> @R.Action_MyAvailability
            </a>
        </div>
    </div>

    <!-- Summary cards -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card h-100"><div class="card-body p-3">
                <div class="text-muted avail-kpi-label">@R.Card_Pending</div>
                <div class="fs-4 fw-semibold num mt-1 @(Model.PendingCount > 0 ? "text-warning" : "")">@Model.PendingCount</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100"><div class="card-body p-3">
                <div class="text-muted avail-kpi-label">@R.Card_Approved</div>
                <div class="fs-4 fw-semibold num mt-1 ">@Model.ApprovedCount</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100"><div class="card-body p-3">
                <div class="text-muted avail-kpi-label">@R.Card_Rejected</div>
                <div class="fs-4 fw-semibold num mt-1 @(Model.RejectedCount > 0 ? "text-danger" : "")">@Model.RejectedCount</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100"><div class="card-body p-3">
                <div class="text-muted avail-kpi-label">@string.Format(R.Card_UpcomingDates, AvailabilityRules.SummaryDays)</div>
                <div class="fs-4 fw-semibold num mt-1 ">@Model.UpcomingUnavailableCount</div>
            </div></div>
        </div>
    </div>

    <!-- Filters -->
    <div class="app-filter-panel">
        <form asp-action="Review" method="get" class="row g-2 align-items-center">
            @if (!Model.IsStoreManager && Model.StoreSelectList != null)
            {
                <div class="col-md-3">
                    <label class="form-label" for="filterStore">@R.Filter_Store</label>
                    <select id="filterStore" name="StoreId" class="form-select form-select-sm">
                        @foreach (var item in Model.StoreSelectList)
                        {
                            <option value="@item.Value" selected="@(item.Value == (Model.StoreId ?? 0).ToString())">@item.Text</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-2">
                <label class="form-label" for="filterStatus">@R.Filter_Status</label>
                <select id="filterStatus" name="Status" class="form-select form-select-sm">
                    @foreach (var (key, text) in statusOptions)
                    {
                        <option value="@key" selected="@(key == Model.StatusKey)">@text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="filterSearch">@R.Filter_Search</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input id="filterSearch" type="text" name="Search" value="@Model.Search" maxlength="100" class="form-control border-start-0 ps-0" placeholder="@R.Filter_SearchPlaceholder" />
                </div>
            </div>
            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-funnel me-1"></i> @SharedResource.Button_Search</button>
                <a asp-action="Review" class="btn btn-sm btn-outline-secondary" title="@SharedResource.Button_Reset"><i class="bi bi-arrow-clockwise"></i> @SharedResource.Button_Reset</a>
            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="app-content-card management-table-card mb-3">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="fw-semibold">@R.Review_ListTitle</span>
            <div class="d-flex align-items-center gap-2" id="bulkBar" style="display:none !important">
                <span class="small text-muted">@R.Bulk_Selected <strong id="bulkCount" class="num">0</strong></span>
                <button type="button" class="btn btn-sm btn-primary" id="btnBulkApprove"><i class="bi bi-check-lg me-1"></i>@R.Action_ApproveSelected</button>
                <button type="button" class="btn btn-sm btn-outline-danger" id="btnBulkReject"><i class="bi bi-x-lg me-1"></i>@R.Action_RejectSelected</button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table modern-table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:36px">
                            @if (anyPending)
                            {
                                <input class="form-check-input" type="checkbox" id="selectAll" title="@R.Bulk_SelectAll" aria-label="@R.Bulk_SelectAll" />
                            }
                        </th>
                        <th>@R.Col_Employee</th>
                        <th>@R.Col_Store</th>
                        <th>@R.Col_Day</th>
                        <th>@R.Col_TimeRange</th>
                        <th>@R.Col_Note</th>
                        <th>@R.Col_Status</th>
                        <th>@R.Col_SubmittedAt</th>
                        <th class="text-end">@SharedResource.Button_Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Paged.Data.Any())
                    {
                        foreach (var row in Model.Paged.Data)
                        {
                            var isPending = row.Status == RegistrationStatus.Pending;
                            var label = row.FullName + " · " + AvailabilityRules.DayName(row.DayOfWeek) + " " + row.TimeRange;
                            <tr data-id="@row.Id">
                                <td>
                                    @if (isPending)
                                    {
                                        <input class="form-check-input row-check" type="checkbox" value="@row.Id" aria-label="@label" />
                                    }
                                </td>
                                <td>
                                    <a asp-action="Employee" asp-route-employeeId="@row.EmployeeId" class="text-decoration-none text-dark fw-semibold">@row.FullName</a>
                                    <div class="small text-muted">@row.EmployeeCode · @row.Username</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(row.StoreName)) { <span class="small text-dark">@row.StoreName</span> }
                                    else { <span class="text-muted small">@R.Unassigned</span> }
                                </td>
                                <td class="text-nowrap">@row.DayName</td>
                                <td class="text-nowrap">
                                    <i class="bi bi-clock me-1 text-muted"></i>@row.TimeRange
                                    @if (row.CrossesMidnight) { <i class="bi bi-moon-stars text-muted ms-1" title="@R.Hint_CrossesMidnight" aria-label="@R.Hint_CrossesMidnight"></i> }
                                </td>
                                <td class="small text-muted" style="max-width:240px">@(string.IsNullOrWhiteSpace(row.Note) ? "—" : row.Note)</td>
                                <td>@await Html.PartialAsync("_StatusBadge", (AvailabilityWindowVM)row)</td>
                                <td class="small text-muted text-nowrap">@row.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end text-nowrap">
                                    @if (isPending)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-approve" data-id="@row.Id" data-label="@label" title="@R.Action_Approve" aria-label="@R.Action_Approve"><i class="bi bi-check-lg"></i></button>
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-reject" data-id="@row.Id" data-label="@label" title="@R.Action_Reject" aria-label="@R.Action_Reject"><i class="bi bi-x-lg"></i></button>
                                    }
                                    <a asp-action="Employee" asp-route-employeeId="@row.EmployeeId" class="btn btn-sm btn-outline-secondary" title="@R.Action_ViewEmployee" aria-label="@R.Action_ViewEmployee"><i class="bi bi-calendar-week"></i></a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-2 text-muted"></i>
                                @R.Review_Empty
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @await Html.PartialAsync("_PaginationPartial", Model.Paged.ToPaginationRes(new Dictionary<string, string?>() {
        { "StoreId", Model.IsStoreManager ? null : Model.StoreId?.ToString() },
        { "Status", Model.StatusKey },
        { "Search", Model.Search }
    }))
</div>

<!-- Modal: lý do từ chối -->
<div class="modal fade" id="rejectReasonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 460px;">
        <div class="modal-content overflow-hidden">
            <div class="modal-header py-3">
                <h5 class="modal-title mb-0">@R.Reject_Title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedResource.Button_Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="small text-muted mb-2" id="rejectTarget"></div>
                <div class="mb-3">
                    <label class="form-label required small" for="rejectReason">@R.Reject_Prompt</label>
                    <textarea class="form-control" id="rejectReason" rows="3" maxlength="255" placeholder="@R.Reject_Placeholder"></textarea>
                    <div class="d-flex justify-content-between">
                        <div class="text-danger small mt-1 d-none" id="rejectReasonError">@R.Err_RejectReason</div>
                        <div class="text-muted small mt-1 ms-auto"><span id="rejectReasonLen">0</span>/255</div>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">@SharedResource.Button_Cancel</button>
                    <button type="button" class="btn btn-sm btn-danger px-4" id="btnConfirmReject"><i class="bi bi-x-lg me-1"></i>@R.Action_Reject</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.RWPM = window.RWPM || {};
        RWPM.availabilityReview = {
            urls: { decide: '@Url.Action("Decide", "Availability")' },
            i18n: {
                approveTitle: @Json.Serialize(R.Confirm_ApproveTitle),
                approveOne: @Json.Serialize(R.Confirm_ApproveOne),
                approveMany: @Json.Serialize(R.Confirm_ApproveMany),
                approveOk: @Json.Serialize(R.Action_Approve),
                rejectMany: @Json.Serialize(R.Reject_Many),
                failed: @Json.Serialize(R.Err_OperationFailed)
            }
        };
    </script>
    <script src="~/js/availability/review.js" asp-append-version="true"></script>
}
