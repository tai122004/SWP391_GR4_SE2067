@model RWPM.Models.ViewModels.Shift.ShiftEditVM

@using ShiftModelResource = RWPM.Resources.Models.Shift
@using ShiftSharedResource = RWPM.Resources.Shared.Shift
@using RWPM.Resources.Shared
@using RWPM.Common.Enums

@{
    ViewData["Title"] = ShiftSharedResource.Edit_PageTitle;
}

<div class="d-flex justify-content-between align-items-center mb-3 border-4 border-primary border-start rounded-start ps-2">
    <h4 class="mb-0">
        <i class="bi bi-pencil-square me-2"></i> @ShiftSharedResource.Edit_PageHeader
    </h4>

    <nav class="d-none d-md-block ms-auto"
         style="--bs-breadcrumb-divider: url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%278%27 height=%278%27%3E%3Cpath d=%27M2.5 0L1 1.5 3.5 4 1 6.5 2.5 8l4-4-4-4z%27 fill=%276c757d%27/%3E%3C/svg%3E');"
         aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a asp-action="Index">@ShiftSharedResource.Index_PageHeader</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@ShiftSharedResource.Edit_PageHeader</li>
        </ol>
    </nav>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ShiftId" />

    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label class="form-label required" asp-for="ShiftCode">@ShiftModelResource.ShiftCode</label>
                <input class="form-control" asp-for="ShiftCode" placeholder="@ShiftSharedResource.Placeholder_ShiftCode" autocomplete="off" />
                <span asp-validation-for="ShiftCode" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label class="form-label required" asp-for="ShiftName">@ShiftModelResource.ShiftName</label>
                <input class="form-control" asp-for="ShiftName" placeholder="@ShiftSharedResource.Placeholder_ShiftName" autocomplete="off" />
                <span asp-validation-for="ShiftName" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="form-group mb-3">
                <label class="form-label required" asp-for="Type">@ShiftModelResource.ShiftType</label>
                <select class="form-select" asp-for="Type" id="shiftTypeSelect">
                    <option value="">-- Chọn loại ca --</option>
                    @foreach (var type in Enum.GetValues<ShiftType>())
                    {
                        <option value="@((byte)type)">@type.GetDisplayName()</option>
                    }
                </select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group mb-3">
                <label class="form-label required" asp-for="StartTime">@ShiftModelResource.StartTime</label>
                <input class="form-control" asp-for="StartTime" type="time" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group mb-3">
                <label class="form-label required" asp-for="EndTime">@ShiftModelResource.EndTime</label>
                <input class="form-control" asp-for="EndTime" type="time" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- Split Shift Section (Ca Gãy) -->
    <div id="splitShiftSection" style="display: none;">
        <div class="alert alert-info py-2 mb-3">
            <i class="bi bi-info-circle me-1"></i> @ShiftSharedResource.SplitShiftSection
        </div>
        <div class="row">
            <div class="col-md-4 offset-md-4">
                <div class="form-group mb-3">
                    <label class="form-label" asp-for="StartTime2">@ShiftModelResource.StartTime2</label>
                    <input class="form-control" asp-for="StartTime2" type="time" />
                    <span asp-validation-for="StartTime2" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group mb-3">
                    <label class="form-label" asp-for="EndTime2">@ShiftModelResource.EndTime2</label>
                    <input class="form-control" asp-for="EndTime2" type="time" />
                    <span asp-validation-for="EndTime2" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label class="form-label" asp-for="BreakMinutes">@ShiftModelResource.BreakMinutes</label>
                <div class="input-group">
                    <input class="form-control" asp-for="BreakMinutes" type="number" min="0" max="60" />
                    <span class="input-group-text">phút</span>
                </div>
                <span asp-validation-for="BreakMinutes" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label class="form-label" asp-for="Description">@ShiftModelResource.Description</label>
                <input class="form-control" asp-for="Description" placeholder="@ShiftSharedResource.Placeholder_Description" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- Attendance Policy Section -->
    <div class="card mb-3 border-light-subtle shadow-sm">
        <div class="card-header bg-light py-2 d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <div class="fw-semibold text-dark d-flex align-items-center">
                    <i class="bi bi-shield-check text-primary me-2"></i>
                    @ShiftSharedResource.AttendancePolicy_Title
                </div>
                <div class="small text-muted">@ShiftSharedResource.AttendancePolicy_Description</div>
            </div>
            <div class="form-check form-switch ms-md-auto mt-2 mt-md-0">
                <input class="form-check-input" type="checkbox" asp-for="UseDefaultAttendancePolicy" id="useDefaultPolicySwitch" />
                <label class="form-check-label fw-semibold small text-primary" for="useDefaultPolicySwitch">
                    @ShiftSharedResource.AttendancePolicy_UseDefault
                </label>
            </div>
        </div>
        <div class="card-body py-3">
            <div id="defaultPolicyAlert" class="alert alert-info py-2 px-3 small mb-3 d-flex align-items-center">
                <i class="bi bi-info-circle-fill me-2 fs-5 text-primary"></i>
                <div>
                    @ShiftSharedResource.AttendancePolicy_InheritNotice (Quẹt sớm: <strong>@ShiftDefaults.EarlyCheckInMinutes'</strong>, Đi muộn: <strong>@ShiftDefaults.GracePeriodMinutes'</strong>, Ngưỡng bỏ ca: <strong>@ShiftDefaults.LateThresholdMinutes'</strong>).
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label small fw-semibold" asp-for="EarlyCheckInMinutes">
                            <i class="bi bi-box-arrow-in-right text-success me-1"></i>@ShiftModelResource.EarlyCheckInMinutes
                        </label>
                        <div class="input-group input-group-sm">
                            <input class="form-control" asp-for="EarlyCheckInMinutes" type="number" min="0" max="120" id="earlyCheckInInput" />
                            <span class="input-group-text">phút</span>
                        </div>
                        <span asp-validation-for="EarlyCheckInMinutes" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label small fw-semibold" asp-for="GracePeriodMinutes">
                            <i class="bi bi-hourglass-split text-warning me-1"></i>@ShiftModelResource.GracePeriodMinutes
                        </label>
                        <div class="input-group input-group-sm">
                            <input class="form-control" asp-for="GracePeriodMinutes" type="number" min="0" max="120" id="gracePeriodInput" />
                            <span class="input-group-text">phút</span>
                        </div>
                        <span asp-validation-for="GracePeriodMinutes" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label small fw-semibold" asp-for="LateThresholdMinutes">
                            <i class="bi bi-slash-circle text-danger me-1"></i>@ShiftModelResource.LateThresholdMinutes
                        </label>
                        <div class="input-group input-group-sm">
                            <input class="form-control" asp-for="LateThresholdMinutes" type="number" min="0" max="480" id="lateThresholdInput" />
                            <span class="input-group-text">phút</span>
                        </div>
                        <span asp-validation-for="LateThresholdMinutes" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Shift Classification & Status Card -->
    <div class="card mb-3 border-light-subtle shadow-sm">
        <div class="card-body py-2 px-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="form-check form-switch py-1">
                        <input class="form-check-input" type="checkbox" asp-for="IsTemplate" id="isTemplateSwitch" />
                        <label class="form-check-label fw-semibold" for="isTemplateSwitch" asp-for="IsTemplate">@ShiftModelResource.IsTemplate</label>
                        <div class="form-text small text-muted">@ShiftSharedResource.Shift_IsTemplate_Hint</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch py-1">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActiveSwitch" />
                        <label class="form-check-label fw-semibold" for="isActiveSwitch" asp-for="IsActive">@ShiftModelResource.IsActive</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="form-group mt-3 text-end">
        <a asp-action="Index" class="btn btn-secondary me-2">
            <i class="bi bi-arrow-return-left me-2"></i>@SharedResource.Button_GoBack
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-floppy me-2"></i>@SharedResource.Button_Edit
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            function toggleSplitSection() {
                var selectedType = $('#shiftTypeSelect').val();
                if (selectedType == '@((byte)ShiftType.Split)') {
                    $('#splitShiftSection').slideDown();
                } else {
                    $('#splitShiftSection').slideUp();
                }
            }

            $('#shiftTypeSelect').change(toggleSplitSection);
            toggleSplitSection();

            // Xử lý bật/tắt chính sách chấm công mặc định
            function updatePolicyState() {
                var isDefault = $('#useDefaultPolicySwitch').is(':checked');
                var $inputs = $('#earlyCheckInInput, #gracePeriodInput, #lateThresholdInput');

                if (isDefault) {
                    $('#defaultPolicyAlert').slideDown();
                    $inputs.prop('readonly', true).addClass('bg-light text-muted');
                    $('#earlyCheckInInput').val('@ShiftDefaults.EarlyCheckInMinutes');
                    $('#gracePeriodInput').val('@ShiftDefaults.GracePeriodMinutes');
                    $('#lateThresholdInput').val('@ShiftDefaults.LateThresholdMinutes');
                } else {
                    $('#defaultPolicyAlert').slideUp();
                    $inputs.prop('readonly', false).removeClass('bg-light text-muted');
                }
            }

            $('#useDefaultPolicySwitch').change(updatePolicyState);
            updatePolicyState();
        });
    </script>
}
