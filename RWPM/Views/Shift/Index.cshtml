@model RWPM.Models.ViewModels.Shift.ShiftListVM

@using ShiftModelResource = RWPM.Resources.Models.Shift
@using ShiftSharedResource = RWPM.Resources.Shared.Shift
@using RWPM.Resources.Shared
@using RWPM.Common.Enums
@using RWPM.Models.Entities

@{
    ViewData["Title"] = ShiftSharedResource.Index_PageTitle;
}

@Html.AntiForgeryToken()

<div>
    <div class="mb-3">
        <h4 class="fw-semibold text-dark d-flex align-items-center">
            <i class="bi bi-clock-history me-2"></i>
            @ShiftSharedResource.Index_PageHeader
        </h4>
    </div>

    <!-- Search form -->
    <form asp-action="Index" method="get" class="row g-2 align-items-end mb-2">
        <div class="col-md-4 col-lg-3">
            <label class="form-label small" asp-for="Search">@ShiftModelResource.Search</label>
            <input type="text" asp-for="Search" class="form-control form-control-sm" placeholder="🔍 @ShiftSharedResource.Placeholder_Search" />
        </div>

        <div class="col-md-4 col-lg-3">
            <label class="form-label small" asp-for="IsActive">@SharedResource.ObjectStatus</label>
            <select asp-for="IsActive" class="form-select form-select-sm">
                <option value="">@SharedResource.ObjectStatus_Default</option>
                <option value="true">@SharedResource.ObjectStatus_IsActive</option>
                <option value="false">@SharedResource.ObjectStatus_IsInactive</option>
            </select>
        </div>

        <div class="col-md-4 col-lg-3">
            <label class="form-label small" asp-for="IsTemplate">@ShiftModelResource.ShiftClassification</label>
            <select asp-for="IsTemplate" class="form-select form-select-sm">
                <option value="">@ShiftSharedResource.Filter_AllClassifications</option>
                <option value="true">@ShiftSharedResource.Badge_Template</option>
                <option value="false">@ShiftSharedResource.Badge_Custom</option>
            </select>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-search"></i>
                @SharedResource.Button_Search
            </button>
            <a asp-action="Index" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-x-lg"></i>
                @SharedResource.Button_Reset
            </a>
        </div>
    </form>

    <!-- Create Button -->
    <div class="text-end mb-2">
        <a asp-action="Create" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> @SharedResource.Button_Create
        </a>
    </div>

    <!-- Table Container -->
    <div style="max-height: 500px; overflow-y: auto;" class="shadow-sm rounded border">
        <table class="table table-hover align-middle mb-0 table-bordered">
            <thead class="bg-light" style="position: sticky; top: 0; z-index: 10;">
                <tr>
                    <th class="text-nowrap" style="width: 120px;">@ShiftModelResource.ShiftCode</th>
                    <th class="text-nowrap">@ShiftModelResource.ShiftName</th>
                    <th class="text-nowrap" style="width: 140px;">@ShiftModelResource.ShiftType</th>
                    <th class="text-nowrap text-center" style="width: 140px;">@ShiftModelResource.ShiftClassification</th>
                    <th class="text-nowrap text-center" style="width: 170px;">@ShiftModelResource.TimeDisplay</th>
                    <th class="text-nowrap text-center" style="width: 110px;">@ShiftModelResource.IsActive</th>
                    <th class="text-nowrap text-center" style="width: 130px;">@SharedResource.Button_Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PanigationResponse.Data != null && Model.PanigationResponse.Data.Any())
                {
                    foreach (var shift in Model.PanigationResponse.Data)
                    {
                        var timeDisplay = $"{shift.StartTime:hh\\:mm} - {shift.EndTime:hh\\:mm}";
                        if (shift.StartTime2.HasValue && shift.EndTime2.HasValue)
                        {
                            timeDisplay += $" | {shift.StartTime2.Value:hh\\:mm} - {shift.EndTime2.Value:hh\\:mm}";
                        }

                        <tr>
                            <td class="fw-semibold">
                                <a href="javascript:void(0);" 
                                   class="text-primary text-decoration-none shift-code-link" 
                                   title="Bấm để xem chi tiết ca">
                                    <i class="bi bi-clock me-1 text-secondary"></i>@shift.ShiftCode
                                </a>
                            </td>
                            <td class="fw-medium">@shift.GetLocalizedName()</td>
                            <td>@shift.Type.GetDisplayName()</td>
                            <td class="text-center">
                                @if (shift.IsTemplate)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-star-fill me-1"></i>@ShiftSharedResource.Badge_Template
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                        <i class="bi bi-gear-fill me-1"></i>@ShiftSharedResource.Badge_Custom
                                    </span>
                                }
                            </td>
                            <td class="text-center font-monospace">
                                <span class="badge bg-light text-dark border font-monospace px-2 py-1">@timeDisplay</span>
                            </td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    <input class="form-check-input active-toggle"
                                           type="checkbox"
                                           data-id="@shift.ShiftId"
                                           @(shift.IsActive ? "checked" : "") />
                                </div>
                            </td>
                            <td class="text-center">
                                <button type="button" 
                                        class="btn btn-sm btn-outline-info me-1 btn-view-detail" 
                                        title="Xem chi tiết ca làm việc"
                                        data-code="@shift.ShiftCode"
                                        data-name="@shift.GetLocalizedName()"
                                        data-type="@shift.Type.GetDisplayName()"
                                        data-istemplate="@shift.IsTemplate"
                                        data-time="@timeDisplay"
                                        data-break="@(shift.BreakMinutes > 0 ? $"{shift.BreakMinutes} phút" : "Không có")"
                                        data-early="@(shift.EarlyCheckInMinutes.HasValue ? $"{shift.EarlyCheckInMinutes} phút" : $"{ShiftDefaults.EarlyCheckInMinutes} phút (Mặc định)")"
                                        data-grace="@(shift.GracePeriodMinutes.HasValue ? $"{shift.GracePeriodMinutes} phút" : $"{ShiftDefaults.GracePeriodMinutes} phút (Mặc định)")"
                                        data-late="@(shift.LateThresholdMinutes.HasValue ? $"{shift.LateThresholdMinutes} phút" : $"{ShiftDefaults.LateThresholdMinutes} phút (Mặc định)")"
                                        data-description="@(string.IsNullOrWhiteSpace(shift.Description) ? "Không có mô tả" : shift.Description)"
                                        data-isactive="@shift.IsActive"
                                        data-created="@shift.CreatedDate.ToString("dd/MM/yyyy HH:mm")"
                                        data-createdby="@shift.CreatedBy"
                                        data-editurl="@Url.Action("Edit", "Shift", new { id = shift.ShiftId })">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <a asp-action="Edit" asp-route-id="@shift.ShiftId" class="btn btn-sm btn-outline-primary" title="@SharedResource.Button_Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            @SharedResource.NoDataFound
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @await Html.PartialAsync("_PaginationPartial", Model.PanigationResponse.ToPaginationRes(new Dictionary<string, string?>() {
        { "Search", Model.Search },
        { "IsActive", Model.IsActive.ToString() },
        { "IsTemplate", Model.IsTemplate?.ToString() }
    }))
</div>

<!-- Quick View Shift Detail Modal -->
<div class="modal fade" id="shiftDetailModal" tabindex="-1" aria-labelledby="shiftDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow">
            <div class="modal-header bg-light py-3 border-bottom">
                <div class="d-flex align-items-center">
                    <div class="bg-primary text-white rounded p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-clock-history fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0 fw-bold" id="shiftDetailModalLabel">
                            <span id="detailShiftCode" class="text-primary"></span> - <span id="detailShiftName"></span>
                        </h5>
                        <small class="text-muted" id="detailShiftType"></small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Row 1: Khung giờ & Phân loại -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100 bg-light-subtle">
                            <div class="small text-muted mb-1"><i class="bi bi-alarm me-1"></i>Khung giờ làm việc:</div>
                            <div class="fs-5 fw-bold font-monospace text-primary" id="detailShiftTime"></div>
                            <div class="small text-muted mt-2">
                                <span><i class="bi bi-cup-hot me-1"></i>Nghỉ giữa ca:</span>
                                <strong id="detailShiftBreak" class="text-dark"></strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100 bg-light-subtle">
                            <div class="small text-muted mb-1"><i class="bi bi-tag me-1"></i>Phân loại & Trạng thái:</div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span id="detailShiftTemplateBadge"></span>
                                <span id="detailShiftActiveBadge"></span>
                            </div>
                            <div class="small text-muted">
                                <span><i class="bi bi-card-text me-1"></i>Mô tả:</span>
                                <span id="detailShiftDescription" class="fst-italic text-dark"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Row 2: Attendance Policy Card (Chính sách Chấm công & Chuyên cần) -->
                <div class="card border-light-subtle mb-3">
                    <div class="card-header bg-light py-2">
                        <div class="fw-semibold small text-dark d-flex align-items-center">
                            <i class="bi bi-shield-check text-success me-2"></i>
                            @ShiftSharedResource.AttendancePolicy_Title
                        </div>
                    </div>
                    <div class="card-body p-3">
                        <div class="row text-center g-2">
                            <div class="col-md-4">
                                <div class="p-2 border rounded bg-success-subtle border-success-subtle h-100">
                                    <div class="small text-success fw-semibold mb-1">
                                        <i class="bi bi-box-arrow-in-right me-1"></i>Quẹt thẻ trước ca
                                    </div>
                                    <div class="fw-bold fs-6 text-dark" id="detailEarlyCheckIn"></div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-2 border rounded bg-warning-subtle border-warning-subtle h-100">
                                    <div class="small text-warning-emphasis fw-semibold mb-1">
                                        <i class="bi bi-hourglass-split me-1"></i>Cho phép đi muộn
                                    </div>
                                    <div class="fw-bold fs-6 text-dark" id="detailGracePeriod"></div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-2 border rounded bg-danger-subtle border-danger-subtle h-100">
                                    <div class="small text-danger fw-semibold mb-1">
                                        <i class="bi bi-slash-circle me-1"></i>Ngưỡng tính bỏ ca
                                    </div>
                                    <div class="fw-bold fs-6 text-dark" id="detailLateThreshold"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Row 3: Audit Info -->
                <div class="d-flex justify-content-between text-muted small border-top pt-2">
                    <div><i class="bi bi-calendar-event me-1"></i>Ngày tạo: <span id="detailCreatedDate"></span></div>
                    <div><i class="bi bi-person me-1"></i>Tạo bởi: <span id="detailCreatedBy"></span></div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Đóng
                </button>
                <a href="#" id="detailEditBtn" class="btn btn-primary">
                    <i class="bi bi-pencil-square me-1"></i>Chỉnh sửa ca này
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Xử lý bật Modal xem chi tiết ca
            function openDetailModal(data) {
                $('#detailShiftCode').text(data.code);
                $('#detailShiftName').text(data.name);
                $('#detailShiftType').text('Loại ca: ' + data.type);
                $('#detailShiftTime').text(data.time);
                $('#detailShiftBreak').text(data.break);
                $('#detailShiftDescription').text(data.description);
                $('#detailEarlyCheckIn').text(data.early);
                $('#detailGracePeriod').text(data.grace);
                $('#detailLateThreshold').text(data.late);
                $('#detailCreatedDate').text(data.created);
                $('#detailCreatedBy').text(data.createdby || 'Hệ thống');
                $('#detailEditBtn').attr('href', data.editurl);

                if (data.istemplate === 'True' || data.istemplate === true) {
                    $('#detailShiftTemplateBadge').html('<span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-star-fill me-1"></i>@ShiftSharedResource.Badge_Template</span>');
                } else {
                    $('#detailShiftTemplateBadge').html('<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="bi bi-gear-fill me-1"></i>@ShiftSharedResource.Badge_Custom</span>');
                }

                if (data.isactive === 'True' || data.isactive === true) {
                    $('#detailShiftActiveBadge').html('<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đang hoạt động</span>');
                } else {
                    $('#detailShiftActiveBadge').html('<span class="badge bg-secondary"><i class="bi bi-pause-circle me-1"></i>Ngừng hoạt động</span>');
                }

                $('#shiftDetailModal').modal('show');
            }

            $('.btn-view-detail').click(function () {
                var data = $(this).data();
                openDetailModal(data);
            });

            $('.shift-code-link').click(function () {
                var btn = $(this).closest('tr').find('.btn-view-detail');
                openDetailModal(btn.data());
            });

            // Xử lý bật/tắt công tắc Trạng thái
            $('.active-toggle').change(function () {
                var checkbox = $(this);
                var shiftId = checkbox.data('id');
                var isActive = checkbox.is(':checked');

                $.ajax({
                    url: '/Shift/UpdateActiveStatus/' + shiftId,
                    type: 'POST',
                    contentType: 'application/json',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify({
                        shiftId: shiftId,
                        isActive: isActive
                    }),
                    success: function () {
                        toastr.success('Cập nhật trạng thái thành công!');
                    },
                    error: function (xhr) {
                        checkbox.prop('checked', !isActive);
                        toastr.error('Cập nhật thất bại: ' + (xhr.responseText || 'Đã có lỗi xảy ra.'));
                    }
                });
            });
        });
    </script>
}
