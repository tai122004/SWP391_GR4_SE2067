@model RWPM.Models.Entities.Shift

@using ShiftModelResource = RWPM.Resources.Models.Shift
@using ShiftSharedResource = RWPM.Resources.Shared.Shift
@using RWPM.Resources.Shared
@using RWPM.Common.Enums
@using RWPM.Models.Entities

@{
    ViewData["Title"] = ShiftSharedResource.Delete_PageTitle;
    var timeDisplay = $"{Model.StartTime:hh\\:mm} - {Model.EndTime:hh\\:mm}";
    if (Model.StartTime2.HasValue && Model.EndTime2.HasValue)
    {
        timeDisplay += $" | {Model.StartTime2.Value:hh\\:mm} - {Model.EndTime2.Value:hh\\:mm}";
    }
}

<div class="d-flex justify-content-between align-items-center mb-3 border-4 border-danger border-start rounded-start ps-2">
    <h4 class="mb-0 text-danger">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ShiftSharedResource.Delete_PageHeader
    </h4>

    <nav class="d-none d-md-block ms-auto"
         style="--bs-breadcrumb-divider: url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%278%27 height=%278%27%3E%3Cpath d=%27M2.5 0L1 1.5 3.5 4 1 6.5 2.5 8l4-4-4-4z%27 fill=%276c757d%27/%3E%3C/svg%3E');"
         aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a asp-action="Index">@ShiftSharedResource.Index_PageHeader</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@ShiftSharedResource.Delete_PageHeader</li>
        </ol>
    </nav>
</div>

<div class="alert alert-warning border-warning d-flex align-items-center mb-4" role="alert">
    <i class="bi bi-exclamation-circle fs-4 me-3"></i>
    <div>
        <strong>Warning:</strong> @ShiftSharedResource.Delete_Warning
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@ShiftModelResource.ShiftCode</dt>
            <dd class="col-sm-9 fw-bold text-primary">@Model.ShiftCode</dd>

            <dt class="col-sm-3">@ShiftModelResource.ShiftName</dt>
            <dd class="col-sm-9">@Model.GetLocalizedName()</dd>

            <dt class="col-sm-3">@ShiftModelResource.ShiftType</dt>
            <dd class="col-sm-9">@Model.Type.GetDisplayName()</dd>

            <dt class="col-sm-3">@ShiftModelResource.TimeDisplay</dt>
            <dd class="col-sm-9 font-monospace">@timeDisplay</dd>

            <dt class="col-sm-3">@ShiftModelResource.BreakMinutes</dt>
            <dd class="col-sm-9">@(Model.BreakMinutes > 0 ? $"{Model.BreakMinutes}'" : "-")</dd>

            <dt class="col-sm-3">@ShiftModelResource.Description</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>

            <dt class="col-sm-3">@ShiftModelResource.IsActive</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">@SharedResource.ObjectStatus_IsActive</span>
                }
                else
                {
                    <span class="badge bg-secondary">@SharedResource.ObjectStatus_IsInactive</span>
                }
            </dd>
        </dl>
    </div>
</div>

<form asp-action="DeleteConfirmed" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="shiftId" value="@Model.ShiftId" />

    <div class="text-end">
        <a asp-action="Index" class="btn btn-secondary me-2">
            <i class="bi bi-arrow-return-left me-2"></i>@SharedResource.Button_Cancel
        </a>
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash me-2"></i>@SharedResource.Button_Delete
        </button>
    </div>
</form>
