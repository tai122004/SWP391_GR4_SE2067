@using RWPM.Common.Enums
@using RWPM.Models.ViewModels.Payroll
@using PayrollResource = RWPM.Resources.Shared.PayrollResource
@model RWPM.Models.ViewModels.Payroll.PayrollListVM

@{
    ViewData["Title"] = PayrollResource.Payroll_Title;
    bool isAdminOrHR = ViewBag.IsAdminOrHR ?? false;
    bool isStoreManager = ViewBag.IsStoreManager ?? false;
    var nextPeriod = Model.NextPeriod;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 font-weight-bold mb-1 text-primary">
                <i class="bi bi-cash-stack me-2"></i>@PayrollResource.Payroll_Title
            </h2>
            @if (isStoreManager)
            {
                <p class="text-muted mb-0"><i class="bi bi-geo-alt me-1 text-primary"></i>@PayrollResource.Index_ScopeLabel <strong>@PayrollResource.Index_ScopeAssignedStore</strong></p>
            }
            else
            {
                <p class="text-muted mb-0">@PayrollResource.Index_Subtitle</p>
            }
        </div>
        <div class="d-flex gap-2 align-items-center">
            <form method="get" asp-action="Index" class="d-flex align-items-center">
                <label class="me-2 text-nowrap fw-semibold text-secondary">@PayrollResource.Index_YearLabel</label>
                <select name="year" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var y in Model.AvailableYears)
                    {
                        if (y == Model.SelectedYear)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </form>

            @if (isAdminOrHR)
            {
                <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm" onclick="openCalculateModal()">
                    <i class="bi bi-calculator"></i>
                    <span>@PayrollResource.Index_CalculateNewButton</span>
                </button>
            }
        </div>
    </div>

    @if (isAdminOrHR && nextPeriod.Gaps.Count > 0)
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-3 mb-4">
            <div class="d-flex align-items-start">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
                <div class="flex-grow-1">
                    <strong>@string.Format(PayrollResource.Index_GapsTitle, nextPeriod.Gaps.Count)</strong>
                    <div class="small text-dark mb-2">@PayrollResource.Index_GapsDescription</div>
                    <ul class="list-unstyled mb-0">
                        @foreach (var gap in nextPeriod.Gaps)
                        {
                            <li class="d-flex align-items-center gap-2 py-1">
                                <i class="bi bi-calendar-x text-danger"></i>
                                <span class="fw-semibold">@gap.StartDate.ToString("dd/MM/yyyy") - @gap.EndDate.ToString("dd/MM/yyyy")</span>
                                <span class="badge bg-danger-subtle text-danger">@string.Format(PayrollResource.Common_Days, gap.Days)</span>
                                <button type="button" class="btn btn-sm btn-outline-dark py-0 ms-2"
                                        onclick="openCalculateModal('@gap.StartDate.ToString("yyyy-MM-dd")', '@gap.MaxEndDate.ToString("yyyy-MM-dd")', '@gap.MaxEndDate.ToString("yyyy-MM-dd")', true)">
                                    <i class="bi bi-calculator me-1"></i>@PayrollResource.Index_GapFillButton
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    <!-- Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted text-uppercase fw-semibold small">@PayrollResource.Index_CardTotalPayrolls</span>
                            <h3 class="fw-bold mb-0 mt-1 text-primary">@Model.TotalPayrolls</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-circle p-3 text-primary">
                            <i class="bi bi-calendar3 fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted text-uppercase fw-semibold small">@PayrollResource.Index_CardAnnualGross</span>
                            <h3 class="fw-bold mb-0 mt-1 text-success">@Model.TotalAnnualGrossSalary.ToString("#,##0") <small class="fs-6">@PayrollResource.Unit_Vnd</small></h3>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded-circle p-3 text-success">
                            <i class="bi bi-currency-dollar fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted text-uppercase fw-semibold small">@PayrollResource.Index_CardLocked</span>
                            <h3 class="fw-bold mb-0 mt-1 text-info">@Model.TotalLockedPayrolls</h3>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded-circle p-3 text-info">
                            <i class="bi bi-lock-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted text-uppercase fw-semibold small">@PayrollResource.Status_Draft</span>
                            <h3 class="fw-bold mb-0 mt-1 text-warning">@Model.TotalDraftPayrolls</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded-circle p-3 text-warning">
                            <i class="bi bi-pencil-square fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold text-dark">
                @string.Format(PayrollResource.Index_ListTitle, Model.SelectedYear)
            </h5>
            <span class="badge bg-secondary-subtle text-secondary">@string.Format(PayrollResource.Index_PeriodCount, Model.Payrolls.Count)</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">@PayrollResource.Col_Period</th>
                        <th>@PayrollResource.Col_DateRange</th>
                        <th class="text-center">@PayrollResource.Col_Status</th>
                        <th class="text-center">@PayrollResource.Col_EmployeeCount</th>
                        <th class="text-end">@PayrollResource.Col_TotalHours</th>
                        <th class="text-end">@PayrollResource.Col_TotalSalaryVnd</th>
                        <th>@PayrollResource.Col_CreatedLocked</th>
                        <th class="text-end pe-4">@PayrollResource.Col_Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Payrolls.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                @string.Format(PayrollResource.Index_Empty, Model.SelectedYear)
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Payrolls)
                        {
                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Detail" asp-route-id="@item.PayrollId" class="fw-bold text-primary text-decoration-none">
                                        @PayrollDisplayText.Title(item.Title)
                                    </a>
                                </td>
                                <td>
                                    <small class="text-muted">@item.StartDate.ToString("dd/MM/yyyy") - @item.EndDate.ToString("dd/MM/yyyy")</small>
                                </td>
                                <td class="text-center">
                                    @if (item.Status == PayrollStatus.Locked)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-lock-fill me-1"></i>@PayrollResource.Status_Locked
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                            <i class="bi bi-pencil me-1"></i>@PayrollResource.Status_Draft
                                        </span>
                                    }
                                </td>
                                <td class="text-center fw-semibold">
                                    @item.TotalEmployees
                                </td>
                                <td class="text-end fw-semibold">
                                    @item.TotalWorkHours.ToString("#,##0.00")
                                </td>
                                <td class="text-end fw-bold text-success">
                                    @item.TotalGrossSalary.ToString("#,##0")
                                </td>
                                <td>
                                    <small class="d-block text-muted">@PayrollResource.Index_CreatedLabel @item.CreatedBy (@item.CreatedDate.ToString("dd/MM"))</small>
                                    @if (item.Status == PayrollStatus.Locked && !string.IsNullOrEmpty(item.LockedBy))
                                    {
                                        <small class="d-block text-success">@PayrollResource.Index_LockedLabel @item.LockedBy (@item.LockedDate?.ToString("dd/MM"))</small>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                            @PayrollResource.Col_Actions
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <li>
                                                <a class="dropdown-item" asp-action="Detail" asp-route-id="@item.PayrollId">
                                                    <i class="bi bi-eye text-primary me-2"></i>@PayrollResource.Action_ViewDetail
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-action="ExportExcel" asp-route-id="@item.PayrollId">
                                                    <i class="bi bi-file-earmark-excel text-success me-2"></i>@PayrollResource.Action_ExportExcel
                                                </a>
                                            </li>
                                            @if (isAdminOrHR && item.Status == PayrollStatus.Draft)
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <form asp-action="Delete" asp-route-id="@item.PayrollId" method="post" data-confirm="@string.Format(PayrollResource.Confirm_DeleteDraft, item.StartDate.ToString("dd/MM/yyyy"), item.EndDate.ToString("dd/MM/yyyy"))" data-confirm-title="@PayrollResource.Confirm_DeleteDraftTitle" data-confirm-ok="@PayrollResource.Confirm_DeleteDraftOk" data-confirm-type="danger">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <i class="bi bi-trash me-2"></i>@PayrollResource.Action_DeleteDraft
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Tính lương kỳ mới -->
@if (isAdminOrHR)
{
    <div class="modal fade" id="calculateModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content shadow">
                <form asp-action="Calculate" method="post" id="calculateForm">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title"><i class="bi bi-calculator me-2"></i>@PayrollResource.Index_CalculateNewButton</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-3">@Html.Raw(PayrollResource.Calc_Intro)</p>

                        <div id="calcPeriodInfo" class="alert alert-info py-2 px-3 small mb-3 d-flex align-items-start">
                            <i class="bi bi-link-45deg fs-5 me-2"></i>
                            <div id="calcPeriodInfoText">
                                @if (nextPeriod.IsStartLocked)
                                {
                                    <span>@Html.Raw(string.Format(PayrollResource.Calc_LastPeriodInfo, nextPeriod.LastEndDate?.ToString("dd/MM/yyyy"), nextPeriod.SuggestedStartDate.ToString("dd/MM/yyyy")))</span>
                                }
                                else
                                {
                                    <span>@PayrollResource.Calc_FirstPeriodInfo</span>
                                }
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold">@PayrollResource.Calc_FromDate <span class="text-danger">*</span></label>
                                <input type="date" id="calcStartDate" name="startDate" class="form-control @(nextPeriod.IsStartLocked ? "bg-light" : "")"
                                       value="@nextPeriod.SuggestedStartDate.ToString("yyyy-MM-dd")"
                                       @(nextPeriod.IsStartLocked ? "readonly" : "") required />
                                @if (nextPeriod.IsStartLocked)
                                {
                                    <div class="form-text"><i class="bi bi-lock-fill me-1"></i>@PayrollResource.Calc_StartLockedHint</div>
                                }
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold">@PayrollResource.Calc_ToDate <span class="text-danger">*</span></label>
                                <input type="date" id="calcEndDate" name="endDate" class="form-control"
                                       value="@nextPeriod.SuggestedEndDate.ToString("yyyy-MM-dd")"
                                       max="@nextPeriod.MaxEndDate.ToString("yyyy-MM-dd")" required />
                                <div class="form-text" id="calcEndHint"></div>
                            </div>
                        </div>

                        <div id="calcSummary" class="mt-3 small"></div>
                        <div id="calcError" class="alert alert-danger py-2 px-3 small mt-3 mb-0 d-none"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@SharedResource.Button_Cancel</button>
                        <button type="submit" id="calcSubmitBtn" class="btn btn-primary">
                            <i class="bi bi-play-circle me-1"></i>@PayrollResource.Calc_SubmitButton
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (isAdminOrHR)
    {
        <script>
            (function () {
                // Thông tin kỳ tiếp theo do server tính (kỳ lương phải nối tiếp liên tục)
                var NEXT = {
                    start: '@nextPeriod.SuggestedStartDate.ToString("yyyy-MM-dd")',
                    end: '@nextPeriod.SuggestedEndDate.ToString("yyyy-MM-dd")',
                    maxEnd: '@nextPeriod.MaxEndDate.ToString("yyyy-MM-dd")',
                    startLocked: @(nextPeriod.IsStartLocked ? "true" : "false"),
                    lastEnd: '@(nextPeriod.LastEndDate?.ToString("dd/MM/yyyy") ?? "")',
                    today: '@DateTime.Today.ToString("yyyy-MM-dd")'
                };
                var T = {
                    selectBothDates: @Json.Serialize(PayrollResource.Err_SelectBothDates),
                    latestEnd: @Json.Serialize(PayrollResource.Js_LatestEnd),
                    alreadyCalculatedUntil: @Json.Serialize(PayrollResource.Js_AlreadyCalculatedUntil),
                    endBeforeStart: @Json.Serialize(PayrollResource.Js_EndBeforeStart),
                    endAfterToday: @Json.Serialize(PayrollResource.Js_EndAfterToday),
                    maxOneMonth: @Json.Serialize(PayrollResource.Js_MaxOneMonth),
                    summaryPeriodLabel: @Json.Serialize(PayrollResource.Js_SummaryPeriodLabel),
                    days: @Json.Serialize(PayrollResource.Common_Days),
                    nextPeriodStartsFrom: @Json.Serialize(PayrollResource.Js_NextPeriodStartsFrom),
                    gapFillInfo: @Json.Serialize(PayrollResource.Js_GapFillInfo),
                    calculating: @Json.Serialize(PayrollResource.Js_Calculating)
                };
                var infoHtml = document.getElementById('calcPeriodInfoText').innerHTML;
                var isGapFill = false;

                var startEl = document.getElementById('calcStartDate');
                var endEl = document.getElementById('calcEndDate');
                var hintEl = document.getElementById('calcEndHint');
                var summaryEl = document.getElementById('calcSummary');
                var errorEl = document.getElementById('calcError');
                var submitBtn = document.getElementById('calcSubmitBtn');

                function parse(v) { if (!v) return null; var p = v.split('-'); return new Date(+p[0], +p[1] - 1, +p[2]); }
                function iso(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
                function vn(d) { return String(d.getDate()).padStart(2, '0') + '/' + String(d.getMonth() + 1).padStart(2, '0') + '/' + d.getFullYear(); }
                function addMonthsMinusOneDay(d) {
                    // Giống C#: start.AddMonths(1).AddDays(-1) (kẹp về cuối tháng nếu tháng sau ngắn hơn)
                    var y = d.getFullYear(), m = d.getMonth() + 1, day = d.getDate();
                    var lastDay = new Date(y, m + 1, 0).getDate();
                    var r = new Date(y, m, Math.min(day, lastDay));
                    r.setDate(r.getDate() - 1);
                    return r;
                }
                function minDate(a, b) { return a < b ? a : b; }

                var gapMaxEnd = null;

                function validate() {
                    var s = parse(startEl.value), e = parse(endEl.value), today = parse(NEXT.today);
                    var errors = [];
                    if (!s || !e) {
                        errors.push(T.selectBothDates);
                    } else {
                        var maxEnd = minDate(addMonthsMinusOneDay(s), today);
                        if (gapMaxEnd) maxEnd = minDate(maxEnd, gapMaxEnd);
                        endEl.min = iso(s);
                        endEl.max = iso(maxEnd);
                        hintEl.textContent = T.latestEnd.replace('{0}', vn(maxEnd));

                        if (s > today) errors.push(T.alreadyCalculatedUntil.replace('{0}', NEXT.lastEnd).replace('{1}', vn(s)));
                        else if (e < s) errors.push(T.endBeforeStart.replace('{0}', vn(s)));
                        else if (e > today) errors.push(T.endAfterToday.replace('{0}', vn(today)));
                        else if (e > maxEnd) errors.push(T.maxOneMonth.replace('{0}', vn(maxEnd)));
                    }

                    if (errors.length) {
                        errorEl.innerHTML = '<i class="bi bi-x-circle me-1"></i>' + errors[0];
                        errorEl.classList.remove('d-none');
                        endEl.classList.add('is-invalid');
                        summaryEl.innerHTML = '';
                        submitBtn.disabled = true;
                        return false;
                    }

                    errorEl.classList.add('d-none');
                    endEl.classList.remove('is-invalid');
                    submitBtn.disabled = false;
                    var days = Math.round((e - s) / 86400000) + 1;
                    var next = new Date(e); next.setDate(next.getDate() + 1);
                    summaryEl.innerHTML =
                        '<div class="d-flex flex-wrap gap-3 text-secondary">' +
                        '<span><i class="bi bi-calendar-range me-1"></i>' + T.summaryPeriodLabel + ' <strong class="text-dark">' + T.days.replace('{0}', days) + '</strong></span>' +
                        (isGapFill ? '' : '<span><i class="bi bi-arrow-right-circle me-1"></i>' + T.nextPeriodStartsFrom + ' <strong class="text-dark">' + vn(next) + '</strong></span>') +
                        '</div>';
                    return true;
                }

                // start/end/maxEnd: dùng khi "Tính bù" một khoảng ngày bị hổng
                window.openCalculateModal = function (start, end, maxEnd, gapFill) {
                    isGapFill = !!gapFill;
                    gapMaxEnd = gapFill && maxEnd ? parse(maxEnd) : null;
                    startEl.value = start || NEXT.start;
                    endEl.value = end || NEXT.end;
                    var lockStart = isGapFill || NEXT.startLocked;
                    startEl.readOnly = lockStart;
                    startEl.classList.toggle('bg-light', lockStart);

                    var infoText = document.getElementById('calcPeriodInfoText');
                    if (isGapFill) {
                        infoText.innerHTML = T.gapFillInfo.replace('{0}', vn(parse(start)));
                    } else {
                        infoText.innerHTML = infoHtml;
                    }
                    validate();
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('calculateModal')).show();
                };

                startEl.addEventListener('change', function () {
                    // Kỳ đầu tiên: tự gợi ý ngày kết thúc tròn 1 tháng khi đổi ngày bắt đầu
                    var s = parse(startEl.value);
                    if (s && !startEl.readOnly) endEl.value = iso(minDate(addMonthsMinusOneDay(s), parse(NEXT.today)));
                    validate();
                });
                endEl.addEventListener('change', validate);
                endEl.addEventListener('input', validate);

                document.getElementById('calculateForm').addEventListener('submit', function (e) {
                    if (!validate()) {
                        e.preventDefault();
                        return;
                    }
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>' + T.calculating;
                });
            })();
        </script>
    }
}
