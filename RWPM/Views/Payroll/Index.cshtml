@using RWPM.Common.Enums
@using RWPM.Models.ViewModels.Payroll
@using PayrollResource = RWPM.Resources.Shared.PayrollResource
@model RWPM.Models.ViewModels.Payroll.PayrollListVM

@{
    ViewData["Title"] = PayrollResource.Payroll_Title;
    bool isAdminOrHR = ViewBag.IsAdminOrHR ?? false;
    bool isStoreManager = ViewBag.IsStoreManager ?? false;
    var nextPeriod = Model.NextPeriod;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="app-page-header">
        <div>
            <h4 class="mb-1">@PayrollResource.Payroll_Title</h4>
            @if (isStoreManager)
            {
                <p class="text-muted mb-0">@PayrollResource.Index_ScopeLabel <strong>@PayrollResource.Index_ScopeAssignedStore</strong></p>
            }
            else
            {
                <p class="text-muted mb-0">@PayrollResource.Index_Subtitle</p>
            }
        </div>
        <div class="app-page-actions">
            <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
                <label class="text-nowrap text-muted small mb-0" for="payrollYear">@PayrollResource.Index_YearLabel</label>
                <select id="payrollYear" name="year" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var y in Model.AvailableYears)
                    {
                        if (y == Model.SelectedYear)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </form>

            @if (isAdminOrHR)
            {
                <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1 text-nowrap" onclick="openCalculateModal()">
                    <i class="bi bi-calculator"></i>
                    <span>@PayrollResource.Index_CalculateNewButton</span>
                </button>
            }
        </div>
    </div>

    @if (isAdminOrHR && nextPeriod.Gaps.Count > 0)
    {
        <div class="alert alert-warning mb-3">
            <div class="d-flex align-items-start">
                <i class="bi bi-exclamation-triangle me-2 mt-1"></i>
                <div class="flex-grow-1">
                    <strong>@string.Format(PayrollResource.Index_GapsTitle, nextPeriod.Gaps.Count)</strong>
                    <div class="small mb-2">@PayrollResource.Index_GapsDescription</div>
                    <ul class="list-unstyled mb-0">
                        @foreach (var gap in nextPeriod.Gaps)
                        {
                            <li class="d-flex flex-wrap align-items-center gap-2 py-1">
                                <span class="fw-semibold">@gap.StartDate.ToString("dd/MM/yyyy") - @gap.EndDate.ToString("dd/MM/yyyy")</span>
                                <span class="app-badge app-badge-danger">@string.Format(PayrollResource.Common_Days, gap.Days)</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0"
                                        onclick="openCalculateModal('@gap.StartDate.ToString("yyyy-MM-dd")', '@gap.MaxEndDate.ToString("yyyy-MM-dd")', '@gap.MaxEndDate.ToString("yyyy-MM-dd")', true)">
                                    <i class="bi bi-calculator me-1"></i>@PayrollResource.Index_GapFillButton
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    <!-- KPI -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@PayrollResource.Index_CardTotalPayrolls</div>
                    <div class="fs-4 fw-semibold mt-1 tabular">@Model.TotalPayrolls</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@PayrollResource.Index_CardAnnualGross</div>
                    <div class="fs-4 fw-semibold mt-1 tabular">@Model.TotalAnnualGrossSalary.ToString("#,##0") <small class="fs-6 fw-normal text-muted">@PayrollResource.Unit_Vnd</small></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@PayrollResource.Index_CardLocked</div>
                    <div class="fs-4 fw-semibold mt-1 tabular">@Model.TotalLockedPayrolls</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@PayrollResource.Status_Draft</div>
                    <div class="fs-4 fw-semibold mt-1 tabular @(Model.TotalDraftPayrolls > 0 ? "text-warning" : "")">@Model.TotalDraftPayrolls</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="app-content-card management-table-card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>@string.Format(PayrollResource.Index_ListTitle, Model.SelectedYear)</span>
            <span class="app-badge app-badge-neutral">@string.Format(PayrollResource.Index_PeriodCount, Model.Payrolls.Count)</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>@PayrollResource.Col_Period</th>
                        <th>@PayrollResource.Col_DateRange</th>
                        <th>@PayrollResource.Col_Status</th>
                        <th class="text-end">@PayrollResource.Col_EmployeeCount</th>
                        <th class="text-end">@PayrollResource.Col_TotalHours</th>
                        <th class="text-end">@PayrollResource.Col_TotalSalaryVnd</th>
                        <th>@PayrollResource.Col_CreatedLocked</th>
                        <th class="text-end"><span class="visually-hidden">@PayrollResource.Col_Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Payrolls.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                @string.Format(PayrollResource.Index_Empty, Model.SelectedYear)
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Payrolls)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Detail" asp-route-id="@item.PayrollId" class="fw-semibold text-decoration-none">
                                        @PayrollDisplayText.Title(item.Title)
                                    </a>
                                </td>
                                <td class="text-muted text-nowrap">@item.StartDate.ToString("dd/MM/yyyy") - @item.EndDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.Status == PayrollStatus.Locked)
                                    {
                                        <span class="app-status"><span class="app-dot app-dot-success"></span>@PayrollResource.Status_Locked</span>
                                    }
                                    else
                                    {
                                        <span class="app-status"><span class="app-dot app-dot-warning"></span>@PayrollResource.Status_Draft</span>
                                    }
                                </td>
                                <td class="text-end">@item.TotalEmployees</td>
                                <td class="text-end">@item.TotalWorkHours.ToString("#,##0.00")</td>
                                <td class="text-end fw-semibold">@item.TotalGrossSalary.ToString("#,##0")</td>
                                <td>
                                    <small class="d-block text-muted">@PayrollResource.Index_CreatedLabel @item.CreatedBy (@item.CreatedDate.ToString("dd/MM"))</small>
                                    @if (item.Status == PayrollStatus.Locked && !string.IsNullOrEmpty(item.LockedBy))
                                    {
                                        <small class="d-block text-muted">@PayrollResource.Index_LockedLabel @item.LockedBy (@item.LockedDate?.ToString("dd/MM"))</small>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                                title="@PayrollResource.Col_Actions" aria-label="@PayrollResource.Col_Actions">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" asp-action="Detail" asp-route-id="@item.PayrollId">
                                                    <i class="bi bi-eye text-muted me-2"></i>@PayrollResource.Action_ViewDetail
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-action="ExportExcel" asp-route-id="@item.PayrollId">
                                                    <i class="bi bi-file-earmark-excel text-muted me-2"></i>@PayrollResource.Action_ExportExcel
                                                </a>
                                            </li>
                                            @if (isAdminOrHR && item.Status == PayrollStatus.Draft)
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <form asp-action="Delete" asp-route-id="@item.PayrollId" method="post" data-confirm="@string.Format(PayrollResource.Confirm_DeleteDraft, item.StartDate.ToString("dd/MM/yyyy"), item.EndDate.ToString("dd/MM/yyyy"))" data-confirm-title="@PayrollResource.Confirm_DeleteDraftTitle" data-confirm-ok="@PayrollResource.Confirm_DeleteDraftOk" data-confirm-type="danger">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <i class="bi bi-trash me-2"></i>@PayrollResource.Action_DeleteDraft
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Tính lương kỳ mới -->
@if (isAdminOrHR)
{
    <div class="modal fade" id="calculateModal" tabindex="-1" aria-labelledby="calculateModalTitle" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Calculate" method="post" id="calculateForm">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="calculateModalTitle">@PayrollResource.Index_CalculateNewButton</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedResource.Button_Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-3">@Html.Raw(PayrollResource.Calc_Intro)</p>

                        <div id="calcPeriodInfo" class="alert alert-info py-2 px-3 small mb-3 d-flex align-items-start">
                            <i class="bi bi-link-45deg fs-5 me-2"></i>
                            <div id="calcPeriodInfoText">
                                @if (nextPeriod.IsStartLocked)
                                {
                                    <span>@Html.Raw(string.Format(PayrollResource.Calc_LastPeriodInfo, nextPeriod.LastEndDate?.ToString("dd/MM/yyyy"), nextPeriod.SuggestedStartDate.ToString("dd/MM/yyyy")))</span>
                                }
                                else
                                {
                                    <span>@PayrollResource.Calc_FirstPeriodInfo</span>
                                }
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label required" for="calcStartDate">@PayrollResource.Calc_FromDate</label>
                                <input type="date" id="calcStartDate" name="startDate" class="form-control @(nextPeriod.IsStartLocked ? "bg-light" : "")"
                                       value="@nextPeriod.SuggestedStartDate.ToString("yyyy-MM-dd")"
                                       @(nextPeriod.IsStartLocked ? "readonly" : "") required />
                                @if (nextPeriod.IsStartLocked)
                                {
                                    <div class="form-text"><i class="bi bi-lock me-1"></i>@PayrollResource.Calc_StartLockedHint</div>
                                }
                            </div>
                            <div class="col-6">
                                <label class="form-label required" for="calcEndDate">@PayrollResource.Calc_ToDate</label>
                                <input type="date" id="calcEndDate" name="endDate" class="form-control"
                                       value="@nextPeriod.SuggestedEndDate.ToString("yyyy-MM-dd")"
                                       max="@nextPeriod.MaxEndDate.ToString("yyyy-MM-dd")" required />
                                <div class="form-text" id="calcEndHint"></div>
                            </div>
                        </div>

                        <div id="calcSummary" class="mt-3 small"></div>
                        <div id="calcError" class="alert alert-danger py-2 px-3 small mt-3 mb-0 d-none"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@SharedResource.Button_Cancel</button>
                        <button type="submit" id="calcSubmitBtn" class="btn btn-primary">
                            <i class="bi bi-play-circle me-1"></i>@PayrollResource.Calc_SubmitButton
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (isAdminOrHR)
    {
        <script>
            window.RWPM = window.RWPM || {};
            RWPM.payrollIndex = {
                // Thông tin kỳ tiếp theo do server tính (kỳ lương phải nối tiếp liên tục)
                next: {
                    start: @Json.Serialize(nextPeriod.SuggestedStartDate.ToString("yyyy-MM-dd")),
                    end: @Json.Serialize(nextPeriod.SuggestedEndDate.ToString("yyyy-MM-dd")),
                    maxEnd: @Json.Serialize(nextPeriod.MaxEndDate.ToString("yyyy-MM-dd")),
                    startLocked: @Json.Serialize(nextPeriod.IsStartLocked),
                    lastEnd: @Json.Serialize(nextPeriod.LastEndDate?.ToString("dd/MM/yyyy") ?? ""),
                    today: @Json.Serialize(DateTime.Today.ToString("yyyy-MM-dd"))
                },
                i18n: {
                    selectBothDates: @Json.Serialize(PayrollResource.Err_SelectBothDates),
                    latestEnd: @Json.Serialize(PayrollResource.Js_LatestEnd),
                    alreadyCalculatedUntil: @Json.Serialize(PayrollResource.Js_AlreadyCalculatedUntil),
                    endBeforeStart: @Json.Serialize(PayrollResource.Js_EndBeforeStart),
                    endAfterToday: @Json.Serialize(PayrollResource.Js_EndAfterToday),
                    maxOneMonth: @Json.Serialize(PayrollResource.Js_MaxOneMonth),
                    summaryPeriodLabel: @Json.Serialize(PayrollResource.Js_SummaryPeriodLabel),
                    days: @Json.Serialize(PayrollResource.Common_Days),
                    nextPeriodStartsFrom: @Json.Serialize(PayrollResource.Js_NextPeriodStartsFrom),
                    gapFillInfo: @Json.Serialize(PayrollResource.Js_GapFillInfo),
                    calculating: @Json.Serialize(PayrollResource.Js_Calculating)
                }
            };
        </script>
        <script src="~/js/payroll/index.js" asp-append-version="true"></script>
    }
}
