@model List<RWPM.Models.ViewModels.Payroll.EmployeePayslipSummaryVM>
@using RWPM.Models.ViewModels.Payroll
@using PayrollResource = RWPM.Resources.Shared.PayrollResource

@{
    ViewData["Title"] = PayrollResource.My_Title;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 font-weight-bold mb-1 text-primary">
                <i class="bi bi-receipt me-2"></i>@PayrollResource.My_Title
            </h2>
            <p class="text-muted mb-0">@PayrollResource.My_Subtitle</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">@PayrollResource.Col_Period</th>
                        <th class="text-end">@PayrollResource.Col_TotalHours</th>
                        <th class="text-end">@PayrollResource.Emp_CardRate</th>
                        <th class="text-end">@PayrollResource.Col_TotalSalary</th>
                        <th class="text-center">@PayrollResource.Col_LockedDate</th>
                        <th class="text-end pe-4">@PayrollResource.Col_Detail</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                @PayrollResource.My_Empty
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">
                                    <a asp-action="MyPayslipDetail" asp-route-payrollId="@item.PayrollId" class="text-decoration-none">
                                        @PayrollDisplayText.Title(item.Title)
                                    </a>
                                </td>
                                <td class="text-end fw-semibold">@item.TotalWorkHours.ToString("#,##0.00") h</td>
                                <td class="text-end">@item.HourlyRate.ToString("#,##0") @PayrollResource.Unit_Dong</td>
                                <td class="text-end fw-bold text-success fs-6">@item.TotalSalary.ToString("#,##0") @PayrollResource.Unit_Dong</td>
                                <td class="text-center text-muted small">@item.LockedDate?.ToString("dd/MM/yyyy")</td>
                                <td class="text-end pe-4">
                                    <a asp-action="MyPayslipDetail" asp-route-payrollId="@item.PayrollId" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i>@PayrollResource.My_ViewPayslip
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
