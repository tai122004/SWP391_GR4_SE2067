@model List<RWPM.Models.ViewModels.Payroll.EmployeePayslipSummaryVM>
@using RWPM.Models.ViewModels.Payroll
@using PayrollResource = RWPM.Resources.Shared.PayrollResource

@{
    ViewData["Title"] = PayrollResource.My_Title;
}

<div class="container-fluid px-0">
    <div class="app-page-header">
        <div>
            <h4 class="mb-1">@PayrollResource.My_Title</h4>
            <p class="text-muted mb-0">@PayrollResource.My_Subtitle</p>
        </div>
    </div>

    <div class="app-content-card management-table-card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>@PayrollResource.Col_Period</th>
                        <th class="text-end">@PayrollResource.Col_TotalHours</th>
                        <th class="text-end">@PayrollResource.Emp_CardRate</th>
                        <th class="text-end">@PayrollResource.Col_TotalSalary</th>
                        <th>@PayrollResource.Col_LockedDate</th>
                        <th class="text-end"><span class="visually-hidden">@PayrollResource.Col_Detail</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                @PayrollResource.My_Empty
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-action="MyPayslipDetail" asp-route-payrollId="@item.PayrollId" class="fw-semibold text-decoration-none">
                                        @PayrollDisplayText.Title(item.Title)
                                    </a>
                                </td>
                                <td class="text-end text-nowrap">@item.TotalWorkHours.ToString("#,##0.00") h</td>
                                <td class="text-end text-nowrap">@item.HourlyRate.ToString("#,##0") @PayrollResource.Unit_Dong</td>
                                <td class="text-end fw-semibold text-nowrap">@item.TotalSalary.ToString("#,##0") @PayrollResource.Unit_Dong</td>
                                <td class="text-muted text-nowrap">@item.LockedDate?.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="MyPayslipDetail" asp-route-payrollId="@item.PayrollId" class="btn btn-sm btn-outline-secondary text-nowrap">
                                        <i class="bi bi-eye me-1"></i>@PayrollResource.My_ViewPayslip
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
