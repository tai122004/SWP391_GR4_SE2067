@model List<RWPM.Models.ViewModels.Payroll.EmployeePayslipSummaryVM>

@{
    ViewData["Title"] = "Phiếu lương của tôi";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 font-weight-bold mb-1 text-primary">
                <i class="bi bi-receipt me-2"></i>Phiếu lương của tôi
            </h2>
            <p class="text-muted mb-0">Theo dõi thu nhập và chi tiết ngày công đã được chốt duyệt</p>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Kỳ lương</th>
                        <th class="text-end">Tổng giờ làm</th>
                        <th class="text-end">Mức lương / Giờ</th>
                        <th class="text-end">Tổng tiền lương</th>
                        <th class="text-center">Ngày chốt</th>
                        <th class="text-end pe-4">Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                Bạn chưa có phiếu lương nào đã được chốt.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">
                                    <a asp-action="MyPayslipDetail" asp-route-payrollId="@item.PayrollId" class="text-decoration-none">
                                        @item.Title
                                    </a>
                                </td>
                                <td class="text-end fw-semibold">@item.TotalWorkHours.ToString("#,##0.00") h</td>
                                <td class="text-end">@item.HourlyRate.ToString("#,##0") đ</td>
                                <td class="text-end fw-bold text-success fs-6">@item.TotalSalary.ToString("#,##0") đ</td>
                                <td class="text-center text-muted small">@item.LockedDate?.ToString("dd/MM/yyyy")</td>
                                <td class="text-end pe-4">
                                    <a asp-action="MyPayslipDetail" asp-route-payrollId="@item.PayrollId" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i>Xem phiếu lương
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
