@using RWPM.Common.Enums
@using RWPM.Models.ViewModels.Payroll
@using PayrollResource = RWPM.Resources.Shared.PayrollResource
@model RWPM.Models.ViewModels.Payroll.EmployeePayslipVM

@{
    ViewData["Title"] = string.Format(PayrollResource.Emp_PageTitle, Model.Detail.EmployeeName);
    var payrollTitle = PayrollDisplayText.Title(Model.Payroll.Title);
    bool isAdminOrHR = ViewBag.IsAdminOrHR ?? false;
    bool hasSnapshots = Model.ItemSnapshots != null && Model.ItemSnapshots.Count > 0;
    double totalPayableHours = Model.Detail.TotalWorkHours + Model.Detail.PaidLeaveHours;
}

<div class="container-fluid px-0">
    <!-- Breadcrumb -->
    <nav aria-label="@RWPM.Resources.Shared.Acc.Aria_Breadcrumb" class="mb-2">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">@PayrollResource.Payroll_Title</a></li>
            <li class="breadcrumb-item"><a asp-action="Detail" asp-route-id="@Model.Payroll.PayrollId" class="text-decoration-none">@payrollTitle</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Detail.EmployeeName</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="app-page-header">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <h4 class="mb-0">@string.Format(PayrollResource.Emp_Heading, Model.Detail.EmployeeName)</h4>
                @if (Model.Payroll.Status == PayrollStatus.Locked)
                {
                    <span class="app-badge app-badge-success"><i class="bi bi-shield-check"></i>@PayrollResource.Emp_LockedBadge</span>
                }
            </div>
            <p class="text-muted mb-0">
                @PayrollResource.Label_EmployeeCode <strong>@Model.Detail.EmployeeCode</strong> ·
                @PayrollResource.Label_Store <strong>@PayrollDisplayText.StoreName(Model.Detail.StoreName)</strong> ·
                @PayrollResource.Label_EmploymentType <strong>@UIHelper.GetDisplayName(Model.Detail.EmploymentType)</strong> ·
                @PayrollResource.Label_Period <strong>@payrollTitle</strong>
            </p>
        </div>
        <div class="app-page-actions">
            <a asp-action="Detail" asp-route-id="@Model.Payroll.PayrollId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>@PayrollResource.Emp_BackToPayroll
            </a>
        </div>
    </div>

    <!-- KPI -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-sm-6 col-xl">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@PayrollResource.Emp_CardRate</div>
                    <div class="fs-5 fw-semibold mt-1 tabular @(Model.Detail.HourlyRate > 0 ? "" : "text-danger")">
                        @(Model.Detail.HourlyRate > 0 ? Model.Detail.HourlyRate.ToString("#,##0") + " " + PayrollResource.Unit_Dong : PayrollResource.Emp_NoRate)
                    </div>
                    <div class="small text-muted">@PayrollResource.Emp_FixedRate</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@PayrollResource.Card_ActualHours</div>
                    <div class="fs-5 fw-semibold mt-1 tabular">@Model.Detail.TotalWorkHours.ToString("#,##0.00") <small class="fs-6 fw-normal text-muted">@PayrollResource.Unit_Hours</small></div>
                    <div class="small text-muted">@string.Format(PayrollResource.Card_ScheduledHours, Model.Detail.TotalStandardHours.ToString("#,##0.00"))</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@PayrollResource.Card_PaidLeave</div>
                    <div class="fs-5 fw-semibold mt-1 tabular">@Model.Detail.PaidLeaveHours.ToString("#,##0.00") <small class="fs-6 fw-normal text-muted">@PayrollResource.Unit_Hours</small></div>
                    <div class="small text-muted">@string.Format(PayrollResource.Emp_ApprovedLeave, Model.Detail.ApprovedLeaveDays, Model.Detail.UnpaidLeaveDays)</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@PayrollResource.Emp_CardTotalSalaryPeriod</div>
                    <div class="fs-5 fw-semibold mt-1 tabular">@Model.Detail.TotalSalary.ToString("#,##0") <small class="fs-6 fw-normal text-muted">@PayrollResource.Unit_Vnd</small></div>
                    <div class="small text-muted">@string.Format(PayrollResource.Emp_SalaryFormula, totalPayableHours.ToString("#,##0.00"), Model.Detail.HourlyRate.ToString("#,##0"))</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@PayrollResource.Emp_CardDataStatus</div>
                    <div class="mt-2">
                        @switch (Model.Detail.Status)
                        {
                            case PayrollDetailStatus.Valid:
                                <span class="app-badge app-badge-success">@PayrollResource.DetailStatus_Valid</span>
                                break;
                            case PayrollDetailStatus.MissingRate:
                                <span class="app-badge app-badge-danger">@PayrollResource.DetailStatus_NoHourlyRate</span>
                                break;
                            case PayrollDetailStatus.HasWarnings:
                                <span class="app-badge app-badge-warning">@PayrollResource.DetailStatus_HasMissingData</span>
                                break;
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Detail.WarningNotes))
                    {
                        <div class="small text-danger mt-1">@PayrollDisplayText.WarningNotes(Model.Detail.WarningNotes)</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Daily details (snapshot or fallback) -->
    <div class="app-content-card management-table-card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>@string.Format(PayrollResource.Emp_DailyTitle, hasSnapshots ? Model.ItemSnapshots!.Count : Model.AttendanceRecords.Count)</span>
            @if (hasSnapshots)
            {
                <span class="app-badge app-badge-info"><i class="bi bi-camera"></i>@PayrollResource.Emp_SnapshotBadge</span>
            }
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>@PayrollResource.Col_WorkDate</th>
                        <th>@PayrollResource.Col_Shift</th>
                        <th>@PayrollResource.Col_ShiftTime</th>
                        <th>@PayrollResource.Col_CheckIn</th>
                        <th>@PayrollResource.Col_CheckOut</th>
                        <th class="text-end">@PayrollResource.Card_ActualHours</th>
                        <th class="text-end">@PayrollResource.Col_PaidLeaveHours</th>
                        <th class="text-end">@PayrollResource.Col_PayableHoursShort</th>
                        <th>@PayrollResource.Col_SourceType</th>
                        <th>@PayrollResource.Col_Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (hasSnapshots)
                    {
                        @foreach (var item in Model.ItemSnapshots!)
                        {
                            <tr>
                                <td class="text-nowrap">@item.Date.ToString("dd/MM/yyyy") <span class="text-muted">(@item.Date.ToString("ddd"))</span></td>
                                <td>@(item.ShiftName != null ? PayrollDisplayText.ShiftName(item.ShiftName) : PayrollResource.Shift_Unknown)</td>
                                <td class="text-muted small text-nowrap">
                                    @if (item.StartTime.HasValue && item.EndTime.HasValue)
                                    {
                                        <span>@item.StartTime.Value.ToString(@"hh\:mm") - @item.EndTime.Value.ToString(@"hh\:mm")</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.CheckInTime.HasValue)
                                    {
                                        <span>@item.CheckInTime.Value.ToString(@"hh\:mm")</span>
                                    }
                                    else if (item.SourceType == "PaidLeave")
                                    {
                                        <span class="text-muted small">@PayrollResource.Cell_PaidLeave</span>
                                    }
                                    else if (item.SourceType == "UnpaidLeave")
                                    {
                                        <span class="text-muted small">@PayrollResource.Col_UnpaidLeave</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">@PayrollResource.Cell_Missing</span>
                                    }
                                </td>
                                <td>
                                    @if (item.CheckOutTime.HasValue)
                                    {
                                        <span>@item.CheckOutTime.Value.ToString(@"hh\:mm")</span>
                                    }
                                    else if (item.SourceType == "PaidLeave")
                                    {
                                        <span class="text-muted small">@PayrollResource.Cell_PaidLeave</span>
                                    }
                                    else if (item.SourceType == "UnpaidLeave")
                                    {
                                        <span class="text-muted small">@PayrollResource.Col_UnpaidLeave</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">@PayrollResource.Cell_Missing</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @if (item.ActualWorkHours > 0)
                                    {
                                        <span>@item.ActualWorkHours.ToString("#,##0.00") h</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @if (item.PaidLeaveHours > 0)
                                    {
                                        <span>@item.PaidLeaveHours.ToString("#,##0.00") h</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end fw-semibold text-nowrap">
                                    @if (item.TotalPayableHours > 0)
                                    {
                                        <span>@item.TotalPayableHours.ToString("#,##0.00") h</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">0.00 h</span>
                                    }
                                </td>
                                <td>
                                    @switch (item.SourceType)
                                    {
                                        case "Attendance":
                                            <span class="app-badge app-badge-neutral">@PayrollResource.Source_Attendance</span>
                                            break;
                                        case "PaidLeave":
                                            <span class="app-badge app-badge-info">@PayrollResource.Source_PaidLeave</span>
                                            break;
                                        case "UnpaidLeave":
                                            <span class="app-badge app-badge-neutral">@PayrollResource.Source_UnpaidLeave</span>
                                            break;
                                        case "MissingAttendance":
                                            <span class="app-badge app-badge-danger">@PayrollResource.Source_MissingAttendance</span>
                                            break;
                                        default:
                                            <span class="app-badge app-badge-neutral">@item.SourceType</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (item.Status == PayrollDisplayText.SnapValid || item.Status == PayrollDisplayText.SnapPaidLeave)
                                    {
                                        <span class="app-status"><span class="app-dot app-dot-success"></span>@PayrollDisplayText.SnapshotStatus(item.Status)</span>
                                    }
                                    else if (item.Status == PayrollDisplayText.SnapUnpaidLeave)
                                    {
                                        <span class="app-status"><span class="app-dot"></span>@PayrollDisplayText.SnapshotStatus(item.Status)</span>
                                    }
                                    else
                                    {
                                        <span class="app-status" title="@PayrollDisplayText.SnapshotNote(item.Note)"><span class="app-dot app-dot-danger"></span>@PayrollDisplayText.SnapshotStatus(item.Status)</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else if (Model.AttendanceRecords.Count > 0)
                    {
                        @foreach (var ar in Model.AttendanceRecords)
                        {
                            <tr>
                                <td class="text-nowrap">@ar.Date.ToString("dd/MM/yyyy") <span class="text-muted">(@ar.Date.ToString("ddd"))</span></td>
                                <td>@(ar.Shift?.ShiftName ?? PayrollResource.Shift_Unknown)</td>
                                <td class="text-muted small text-nowrap">
                                    @if (ar.Shift != null)
                                    {
                                        <span>@ar.Shift.StartTime.ToString(@"hh\:mm") - @ar.Shift.EndTime.ToString(@"hh\:mm")</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    @if (ar.CheckInTime.HasValue)
                                    {
                                        <span>@ar.CheckInTime.Value.ToString(@"hh\:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">@PayrollResource.Cell_Missing</span>
                                    }
                                </td>
                                <td>
                                    @if (ar.CheckOutTime.HasValue)
                                    {
                                        <span>@ar.CheckOutTime.Value.ToString(@"hh\:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">@PayrollResource.Cell_Missing</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @(ar.WorkHours.HasValue ? ar.WorkHours.Value.ToString("#,##0.00") + " h" : "0.00 h")
                                </td>
                                <td class="text-end text-muted">-</td>
                                <td class="text-end fw-semibold text-nowrap">
                                    @if (ar.WorkHours.HasValue)
                                    {
                                        <span>@ar.WorkHours.Value.ToString("#,##0.00") h</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">0.00 h</span>
                                    }
                                </td>
                                <td><span class="app-badge app-badge-neutral">@PayrollResource.Source_Attendance</span></td>
                                <td>
                                    @if (ar.WorkHours.HasValue)
                                    {
                                        <span class="app-status"><span class="app-dot app-dot-success"></span>@PayrollResource.DetailStatus_Valid</span>
                                    }
                                    else
                                    {
                                        <span class="app-status"><span class="app-dot app-dot-danger"></span>@PayrollResource.Status_Abnormal</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">
                                @PayrollResource.Emp_NoAttendanceInPeriod
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Leave requests -->
    @if (Model.LeaveRequests.Count > 0)
    {
        <div class="app-content-card mb-3">
            <div class="card-header">@string.Format(PayrollResource.Emp_LeaveTitle, Model.LeaveRequests.Count)</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@PayrollResource.Calc_FromDate</th>
                            <th>@PayrollResource.Calc_ToDate</th>
                            <th>@PayrollResource.Col_LeaveType</th>
                            <th>@PayrollResource.Col_Reason</th>
                            <th>@PayrollResource.Col_Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.LeaveRequests)
                        {
                            <tr>
                                <td class="text-nowrap">@l.StartDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-nowrap">@l.EndDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (l.LeaveType == LeaveType.Paid)
                                    {
                                        <span class="app-badge app-badge-info">@PayrollResource.Card_PaidLeave</span>
                                    }
                                    else
                                    {
                                        <span class="app-badge app-badge-neutral">@PayrollResource.Snap_UnpaidLeave</span>
                                    }
                                </td>
                                <td>@l.Reason</td>
                                <td><span class="app-status"><span class="app-dot app-dot-success"></span>@PayrollResource.Leave_Approved</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
