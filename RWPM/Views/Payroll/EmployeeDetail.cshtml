@using RWPM.Common.Enums
@model RWPM.Models.ViewModels.Payroll.EmployeePayslipVM

@{
    ViewData["Title"] = $"Chi tiết chấm công & lương: {Model.Detail.EmployeeName}";
    bool isAdminOrHR = ViewBag.IsAdminOrHR ?? false;
    bool hasSnapshots = Model.ItemSnapshots != null && Model.ItemSnapshots.Count > 0;
    double totalPayableHours = Model.Detail.TotalWorkHours + Model.Detail.PaidLeaveHours;
}

<div class="container-fluid py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Quản lý Bảng lương</a></li>
            <li class="breadcrumb-item"><a asp-action="Detail" asp-route-id="@Model.Payroll.PayrollId" class="text-decoration-none">@Model.Payroll.Title</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Detail.EmployeeName</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 font-weight-bold mb-1 text-dark">
                Chi tiết Bảng lương: @Model.Detail.EmployeeName
            </h2>
            <p class="text-muted mb-0">
                Mã NV: <strong>@Model.Detail.EmployeeCode</strong> | 
                Chi nhánh: <strong>@Model.Detail.StoreName</strong> | 
                Hình thức: <span class="badge bg-light text-secondary border">@Model.Detail.EmploymentType</span> | 
                Kỳ: <strong>@Model.Payroll.Title</strong>
                @if (Model.Payroll.Status == PayrollStatus.Locked)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle ms-2">
                        <i class="bi bi-shield-check me-1"></i>Dữ liệu đã khóa (Bất biến)
                    </span>
                }
            </p>
        </div>
        <div>
            <a asp-action="Detail" asp-route-id="@Model.Payroll.PayrollId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Quay lại bảng lương
            </a>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body">
                    <span class="text-muted text-uppercase fw-semibold small">Mức lương / Giờ</span>
                    <h4 class="fw-bold mb-0 mt-1 text-primary">
                        @(Model.Detail.HourlyRate > 0 ? Model.Detail.HourlyRate.ToString("#,##0") + " đ" : "Chưa có đơn giá")
                    </h4>
                    <small class="text-muted">Đơn giá giờ làm cố định</small>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body">
                    <span class="text-muted text-uppercase fw-semibold small">Giờ làm thực tế</span>
                    <h4 class="fw-bold mb-0 mt-1 text-dark">
                        @Model.Detail.TotalWorkHours.ToString("#,##0.00") <small class="fs-6">giờ</small>
                    </h4>
                    <small class="text-muted">Lịch phân ca: @Model.Detail.TotalStandardHours.ToString("#,##0.00") h</small>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-info">
                <div class="card-body">
                    <span class="text-muted text-uppercase fw-semibold small">Nghỉ phép hưởng lương</span>
                    <h4 class="fw-bold mb-0 mt-1 text-info">
                        @Model.Detail.PaidLeaveHours.ToString("#,##0.00") <small class="fs-6">giờ</small>
                    </h4>
                    <small class="text-muted">Đã duyệt: @Model.Detail.ApprovedLeaveDays ngày (@(Model.Detail.UnpaidLeaveDays > 0 ? $"{Model.Detail.UnpaidLeaveDays} ngày K.Lương" : "0 ngày K.Lương"))</small>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-success">
                <div class="card-body">
                    <span class="text-muted text-uppercase fw-semibold small">Tổng tiền lương kỳ</span>
                    <h4 class="fw-bold mb-0 mt-1 text-success">
                        @Model.Detail.TotalSalary.ToString("#,##0") <small class="fs-6">VNĐ</small>
                    </h4>
                    <small class="text-muted">@totalPayableHours.ToString("#,##0.00") h tính lương × @Model.Detail.HourlyRate.ToString("#,##0") đ</small>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body">
                    <span class="text-muted text-uppercase fw-semibold small">Trạng thái dữ liệu</span>
                    <div class="mt-2">
                        @switch (Model.Detail.Status)
                        {
                            case PayrollDetailStatus.Valid:
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                    <i class="bi bi-check-circle me-1"></i>Hợp lệ
                                </span>
                                break;
                            case PayrollDetailStatus.MissingRate:
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                    <i class="bi bi-exclamation-circle me-1"></i>Chưa có HourlyRate
                                </span>
                                break;
                            case PayrollDetailStatus.HasWarnings:
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                    <i class="bi bi-exclamation-triangle me-1"></i>Có ca thiếu dữ liệu
                                </span>
                                break;
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Detail.WarningNotes))
                    {
                        <small class="text-danger d-block mt-1">@Model.Detail.WarningNotes</small>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Daily Details Table (From Snapshot or Fallback) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold text-dark">
                <i class="bi bi-clock-history me-2 text-primary"></i>Chi tiết ca & ngày công trong kỳ (@(hasSnapshots ? Model.ItemSnapshots.Count : Model.AttendanceRecords.Count) mục)
            </h5>
            @if (hasSnapshots)
            {
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                    <i class="bi bi-camera me-1"></i>Dữ liệu Snapshot lưu vết
                </span>
            }
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Ngày làm</th>
                        <th>Ca làm việc</th>
                        <th>Khung giờ ca</th>
                        <th>Giờ vào</th>
                        <th>Giờ ra</th>
                        <th class="text-end">Giờ làm thực tế</th>
                        <th class="text-end">Giờ nghỉ phép</th>
                        <th class="text-end">Giờ tính lương</th>
                        <th class="text-center">Loại nguồn</th>
                        <th class="text-center pe-4">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (hasSnapshots)
                    {
                        @foreach (var item in Model.ItemSnapshots)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@item.Date.ToString("dd/MM/yyyy") (@item.Date.ToString("ddd"))</td>
                                <td>@(item.ShiftName ?? "Không xác định")</td>
                                <td class="text-muted small">
                                    @if (item.StartTime.HasValue && item.EndTime.HasValue)
                                    {
                                        <span>@item.StartTime.Value.ToString(@"hh\:mm") - @item.EndTime.Value.ToString(@"hh\:mm")</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.CheckInTime.HasValue)
                                    {
                                        <span>@item.CheckInTime.Value.ToString(@"hh\:mm")</span>
                                    }
                                    else if (item.SourceType == "PaidLeave")
                                    {
                                        <span class="text-info small">Nghỉ phép</span>
                                    }
                                    else if (item.SourceType == "UnpaidLeave")
                                    {
                                        <span class="text-muted small">Nghỉ K.Lương</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold">Thiếu</span>
                                    }
                                </td>
                                <td>
                                    @if (item.CheckOutTime.HasValue)
                                    {
                                        <span>@item.CheckOutTime.Value.ToString(@"hh\:mm")</span>
                                    }
                                    else if (item.SourceType == "PaidLeave")
                                    {
                                        <span class="text-info small">Nghỉ phép</span>
                                    }
                                    else if (item.SourceType == "UnpaidLeave")
                                    {
                                        <span class="text-muted small">Nghỉ K.Lương</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold">Thiếu</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (item.ActualWorkHours > 0)
                                    {
                                        <span class="text-dark fw-semibold">@item.ActualWorkHours.ToString("#,##0.00") h</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (item.PaidLeaveHours > 0)
                                    {
                                        <span class="text-info fw-semibold">@item.PaidLeaveHours.ToString("#,##0.00") h</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end fw-bold">
                                    @if (item.TotalPayableHours > 0)
                                    {
                                        <span class="text-success">@item.TotalPayableHours.ToString("#,##0.00") h</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">0.00 h</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @switch (item.SourceType)
                                    {
                                        case "Attendance":
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Chấm công</span>
                                            break;
                                        case "PaidLeave":
                                            <span class="badge bg-info-subtle text-info border border-info-subtle">Phép có lương</span>
                                            break;
                                        case "UnpaidLeave":
                                            <span class="badge bg-secondary-subtle text-secondary border">Phép không lương</span>
                                            break;
                                        case "MissingAttendance":
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Thiếu chấm công</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark">@item.SourceType</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    @if (item.Status == "Hợp lệ" || item.Status == "Nghỉ phép hưởng lương")
                                    {
                                        <span class="badge bg-success-subtle text-success">@item.Status</span>
                                    }
                                    else if (item.Status == "Nghỉ không lương")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger" title="@item.Note">@item.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else if (Model.AttendanceRecords.Count > 0)
                    {
                        @foreach (var ar in Model.AttendanceRecords)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@ar.Date.ToString("dd/MM/yyyy") (@ar.Date.ToString("ddd"))</td>
                                <td>@(ar.Shift?.ShiftName ?? "Không xác định")</td>
                                <td class="text-muted small">
                                    @if (ar.Shift != null)
                                    {
                                        <span>@ar.Shift.StartTime.ToString(@"hh\:mm") - @ar.Shift.EndTime.ToString(@"hh\:mm")</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    @if (ar.CheckInTime.HasValue)
                                    {
                                        <span>@ar.CheckInTime.Value.ToString(@"hh\:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold">Thiếu</span>
                                    }
                                </td>
                                <td>
                                    @if (ar.CheckOutTime.HasValue)
                                    {
                                        <span>@ar.CheckOutTime.Value.ToString(@"hh\:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold">Thiếu</span>
                                    }
                                </td>
                                <td class="text-end fw-bold text-dark">
                                    @(ar.WorkHours.HasValue ? ar.WorkHours.Value.ToString("#,##0.00") + " h" : "0.00 h")
                                </td>
                                <td class="text-end text-muted">-</td>
                                <td class="text-end fw-bold">
                                    @if (ar.WorkHours.HasValue)
                                    {
                                        <span class="text-success">@ar.WorkHours.Value.ToString("#,##0.00") h</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">0.00 h</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary-subtle text-primary">Chấm công</span>
                                </td>
                                <td class="text-center pe-4">
                                    @if (ar.WorkHours.HasValue)
                                    {
                                        <span class="badge bg-success-subtle text-success">Hợp lệ</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger">Bất thường</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">
                                Không có bản ghi chấm công nào trong kỳ này.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Leave Requests Table -->
    @if (Model.LeaveRequests.Count > 0)
    {
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-bold text-dark">
                    <i class="bi bi-calendar-check me-2 text-info"></i>Đơn nghỉ phép đã duyệt trong kỳ (@Model.LeaveRequests.Count đơn)
                </h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Từ ngày</th>
                            <th>Đến ngày</th>
                            <th>Loại nghỉ</th>
                            <th>Lý do</th>
                            <th class="text-center">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.LeaveRequests)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@l.StartDate.ToString("dd/MM/yyyy")</td>
                                <td class="fw-semibold">@l.EndDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (l.LeaveType == LeaveType.Paid)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">Nghỉ phép hưởng lương</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">Nghỉ không lương</span>
                                    }
                                </td>
                                <td>@l.Reason</td>
                                <td class="text-center">
                                    <span class="badge bg-success-subtle text-success">Đã phê duyệt</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
