@using RWPM.Common.Enums
@using RWPM.Models.ViewModels.Payroll
@using PayrollResource = RWPM.Resources.Shared.PayrollResource
@model RWPM.Models.ViewModels.Payroll.EmployeePayslipVM

@{
    var payrollTitle = PayrollDisplayText.Title(Model.Payroll.Title);
    ViewData["Title"] = string.Format(PayrollResource.My_DetailPageTitle, payrollTitle);
    bool hasSnapshots = Model.ItemSnapshots != null && Model.ItemSnapshots.Count > 0;
    double totalPayableHours = Model.Detail.TotalWorkHours + Model.Detail.PaidLeaveHours;
}

<div class="container-fluid px-0">
    <nav aria-label="@RWPM.Resources.Shared.Acc.Aria_Breadcrumb" class="mb-2">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a asp-action="MyPayslips" class="text-decoration-none">@PayrollResource.My_Title</a></li>
            <li class="breadcrumb-item active" aria-current="page">@payrollTitle</li>
        </ol>
    </nav>

    <div class="app-page-header">
        <div>
            <h4 class="mb-1">@string.Format(PayrollResource.My_DetailHeading, payrollTitle)</h4>
            <p class="text-muted mb-0">@PayrollResource.Label_FullName <strong>@Model.Detail.EmployeeName</strong> (@PayrollResource.Label_EmployeeCode <strong>@Model.Detail.EmployeeCode</strong>) · @PayrollResource.Label_Store <strong>@PayrollDisplayText.StoreName(Model.Detail.StoreName)</strong></p>
        </div>
        <div class="app-page-actions">
            <a asp-action="MyPayslips" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>@PayrollResource.My_BackToList
            </a>
        </div>
    </div>

    <!-- KPI -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@PayrollResource.Card_ActualHours</div>
                    <div class="fs-4 fw-semibold mt-1 tabular">@Model.Detail.TotalWorkHours.ToString("#,##0.00") <small class="fs-6 fw-normal text-muted">@PayrollResource.Unit_Hours</small></div>
                    <div class="small text-muted">@string.Format(PayrollResource.Card_ScheduledHours, Model.Detail.TotalStandardHours.ToString("#,##0.00"))</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@PayrollResource.Card_PaidLeave</div>
                    <div class="fs-4 fw-semibold mt-1 tabular">@Model.Detail.PaidLeaveHours.ToString("#,##0.00") <small class="fs-6 fw-normal text-muted">@PayrollResource.Unit_Hours</small></div>
                    <div class="small text-muted">@string.Format(PayrollResource.My_ApprovedDays, Model.Detail.ApprovedLeaveDays)</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@PayrollResource.My_CardHourlyRate</div>
                    <div class="fs-4 fw-semibold mt-1 tabular">@Model.Detail.HourlyRate.ToString("#,##0") <small class="fs-6 fw-normal text-muted">@SharedResource.Unit_VndPerHour</small></div>
                    <div class="small text-muted">@string.Format(PayrollResource.My_TotalPayableHours, totalPayableHours.ToString("#,##0.00"))</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@PayrollResource.Col_TotalSalary</div>
                    <div class="fs-4 fw-semibold mt-1 tabular">@Model.Detail.TotalSalary.ToString("#,##0") <small class="fs-6 fw-normal text-muted">@PayrollResource.Unit_Vnd</small></div>
                    <div class="small text-muted">@string.Format(PayrollResource.My_SalaryFormula, totalPayableHours.ToString("#,##0.00"), Model.Detail.HourlyRate.ToString("#,##0"))</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance / snapshot records -->
    <div class="app-content-card management-table-card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>@string.Format(PayrollResource.My_DailyTitle, hasSnapshots ? Model.ItemSnapshots!.Count : Model.AttendanceRecords.Count)</span>
            @if (hasSnapshots)
            {
                <span class="app-badge app-badge-success"><i class="bi bi-shield-check"></i>@PayrollResource.My_OfficialBadge</span>
            }
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>@PayrollResource.Col_WorkDate</th>
                        <th>@PayrollResource.Col_Shift</th>
                        <th>@PayrollResource.Col_ShiftTimeShort</th>
                        <th>@PayrollResource.Col_CheckIn</th>
                        <th>@PayrollResource.Col_CheckOut</th>
                        <th class="text-end">@PayrollResource.Col_PayableHoursCount</th>
                        <th>@PayrollResource.Col_SourceType</th>
                        <th>@PayrollResource.Col_Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (hasSnapshots)
                    {
                        @foreach (var item in Model.ItemSnapshots!)
                        {
                            <tr>
                                <td class="text-nowrap">@item.Date.ToString("dd/MM/yyyy")</td>
                                <td>@(item.ShiftName != null ? PayrollDisplayText.ShiftName(item.ShiftName) : PayrollResource.Shift_Flexible)</td>
                                <td class="text-muted small text-nowrap">
                                    @(item.StartTime.HasValue && item.EndTime.HasValue ? $"{item.StartTime:hh\\:mm} - {item.EndTime:hh\\:mm}" : "-")
                                </td>
                                <td>@(item.CheckInTime.HasValue ? item.CheckInTime.Value.ToString(@"hh\:mm") : "-")</td>
                                <td>@(item.CheckOutTime.HasValue ? item.CheckOutTime.Value.ToString(@"hh\:mm") : "-")</td>
                                <td class="text-end fw-semibold text-nowrap">
                                    @if (item.TotalPayableHours > 0)
                                    {
                                        <span>@item.TotalPayableHours.ToString("#,##0.00") h</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">0.00 h</span>
                                    }
                                </td>
                                <td>
                                    @switch (item.SourceType)
                                    {
                                        case "Attendance":
                                            <span class="app-badge app-badge-neutral">@PayrollResource.Source_Attendance</span>
                                            break;
                                        case "PaidLeave":
                                            <span class="app-badge app-badge-info">@PayrollResource.Cell_PaidLeave</span>
                                            break;
                                        case "UnpaidLeave":
                                            <span class="app-badge app-badge-neutral">@PayrollResource.Col_UnpaidLeave</span>
                                            break;
                                        case "MissingAttendance":
                                            <span class="app-badge app-badge-danger">@PayrollResource.Source_MissingAttendance</span>
                                            break;
                                        default:
                                            <span class="app-badge app-badge-neutral">@item.SourceType</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (item.Status == PayrollDisplayText.SnapValid || item.Status == PayrollDisplayText.SnapPaidLeave)
                                    {
                                        <span class="app-status"><span class="app-dot app-dot-success"></span>@PayrollDisplayText.SnapshotStatus(item.Status)</span>
                                    }
                                    else
                                    {
                                        <span class="app-status" title="@PayrollDisplayText.SnapshotNote(item.Note)"><span class="app-dot app-dot-warning"></span>@PayrollDisplayText.SnapshotStatus(item.Status)</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else if (Model.AttendanceRecords.Count > 0)
                    {
                        @foreach (var ar in Model.AttendanceRecords)
                        {
                            <tr>
                                <td class="text-nowrap">@ar.Date.ToString("dd/MM/yyyy")</td>
                                <td>@(ar.Shift?.ShiftName ?? PayrollResource.Shift_Flexible)</td>
                                <td class="text-muted small text-nowrap">
                                    @(ar.Shift != null ? $"{ar.Shift.StartTime:hh\\:mm} - {ar.Shift.EndTime:hh\\:mm}" : "-")
                                </td>
                                <td>@(ar.CheckInTime.HasValue ? ar.CheckInTime.Value.ToString(@"hh\:mm") : "-")</td>
                                <td>@(ar.CheckOutTime.HasValue ? ar.CheckOutTime.Value.ToString(@"hh\:mm") : "-")</td>
                                <td class="text-end fw-semibold text-nowrap">
                                    @if (ar.WorkHours.HasValue)
                                    {
                                        <span>@ar.WorkHours.Value.ToString("#,##0.00") h</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">0.00 h</span>
                                    }
                                </td>
                                <td><span class="app-badge app-badge-neutral">@PayrollResource.Source_Attendance</span></td>
                                <td>
                                    @if (ar.WorkHours.HasValue)
                                    {
                                        <span class="app-status"><span class="app-dot app-dot-success"></span>@PayrollResource.Status_FullWork</span>
                                    }
                                    else
                                    {
                                        <span class="app-status"><span class="app-dot app-dot-warning"></span>@PayrollResource.Snap_MissingInOut</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                @PayrollResource.My_NoAttendance
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
