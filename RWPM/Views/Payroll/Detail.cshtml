@using RWPM.Common.Enums
@using RWPM.Models.ViewModels.Payroll
@using PayrollResource = RWPM.Resources.Shared.PayrollResource
@model RWPM.Models.ViewModels.Payroll.PayrollDetailVM

@{
    var payrollTitle = PayrollDisplayText.Title(Model.Payroll.Title);
    ViewData["Title"] = payrollTitle;
    bool isAdminOrHR = ViewBag.IsAdminOrHR ?? false;
    bool isStoreManager = ViewBag.IsStoreManager ?? false;
    bool isLocked = Model.Payroll.Status == PayrollStatus.Locked;
    int issueCount = Model.WarningCount + Model.MissingRateCount;
}

<div class="container-fluid px-0">
    <!-- Breadcrumb -->
    <nav aria-label="@RWPM.Resources.Shared.Acc.Aria_Breadcrumb" class="mb-2">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">@PayrollResource.Payroll_Title</a></li>
            <li class="breadcrumb-item active" aria-current="page">@payrollTitle</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="app-page-header">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <h4 class="mb-0">@payrollTitle</h4>
                @if (isLocked)
                {
                    <span class="app-badge app-badge-success"><i class="bi bi-lock"></i>@PayrollResource.Status_LockedBadge</span>
                }
                else
                {
                    <span class="app-badge app-badge-warning"><i class="bi bi-pencil"></i>@PayrollResource.Status_DraftBadge</span>
                }
            </div>
            <p class="text-muted mb-0">
                @PayrollResource.Detail_PeriodLabel <strong>@Model.Payroll.StartDate.ToString("dd/MM/yyyy") - @Model.Payroll.EndDate.ToString("dd/MM/yyyy")</strong>
                @if (isLocked && !string.IsNullOrEmpty(Model.Payroll.LockedBy))
                {
                    <span> · @PayrollResource.Detail_LockedByLabel <strong>@Model.Payroll.LockedBy</strong> (@Model.Payroll.LockedDate?.ToString("dd/MM/yyyy HH:mm"))</span>
                }
            </p>
        </div>

        <div class="app-page-actions">
            <a asp-action="ExportExcel" asp-route-id="@Model.Payroll.PayrollId" asp-route-storeId="@Model.SelectedStoreId" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-file-earmark-excel"></i>
                <span>@PayrollResource.Action_ExportExcel</span>
            </a>

            @if (isAdminOrHR)
            {
                if (!isLocked)
                {
                    <form asp-action="Recalculate" asp-route-id="@Model.Payroll.PayrollId" method="post" class="d-inline" data-confirm="@PayrollResource.Confirm_Recalculate" data-confirm-title="@PayrollResource.Confirm_RecalculateTitle" data-confirm-ok="@PayrollResource.Action_Recalculate" data-confirm-type="warning">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                            <i class="bi bi-arrow-repeat"></i>
                            <span>@PayrollResource.Action_Recalculate</span>
                        </button>
                    </form>

                    <form asp-action="Lock" asp-route-id="@Model.Payroll.PayrollId" method="post" class="d-inline" data-confirm="@PayrollResource.Confirm_Lock" data-confirm-title="@PayrollResource.Action_Lock" data-confirm-ok="@PayrollResource.Action_Lock" data-confirm-type="warning" data-confirm-icon="bi-lock">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary btn-sm d-flex align-items-center gap-1">
                            <i class="bi bi-lock"></i>
                            <span>@PayrollResource.Action_Lock</span>
                        </button>
                    </form>
                }
                else
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#unlockModal">
                        <i class="bi bi-unlock"></i>
                        <span>@PayrollResource.Action_Unlock</span>
                    </button>
                }
            }
        </div>
    </div>

    @if (Model.MissingRateCount > 0 || Model.WarningCount > 0)
    {
        <div class="alert alert-warning mb-3">
            <div class="d-flex align-items-start">
                <i class="bi bi-exclamation-triangle me-2 mt-1"></i>
                <div>
                    <div class="fw-semibold mb-1">@PayrollResource.Detail_AlertTitle</div>
                    <ul class="mb-0 small ps-3">
                        @if (Model.MissingRateCount > 0)
                        {
                            <li>@Html.Raw(string.Format(PayrollResource.Detail_AlertMissingRate, Model.MissingRateCount))</li>
                        }
                        @if (Model.WarningCount > 0)
                        {
                            <li>@Html.Raw(string.Format(PayrollResource.Detail_AlertWarnings, Model.WarningCount))</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    <!-- KPI -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@PayrollResource.Detail_CardTotalEmployees</div>
                    <div class="fs-4 fw-semibold mt-1 tabular">@Model.TotalEmployeesCount</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@PayrollResource.Col_TotalHours</div>
                    <div class="fs-4 fw-semibold mt-1 tabular">@Model.TotalHours.ToString("#,##0.00") <small class="fs-6 fw-normal text-muted">@PayrollResource.Unit_Hours</small></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@PayrollResource.Detail_CardTotalFund</div>
                    <div class="fs-4 fw-semibold mt-1 tabular">@Model.TotalAmount.ToString("#,##0") <small class="fs-6 fw-normal text-muted">@PayrollResource.Unit_Vnd</small></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@PayrollResource.Detail_CardWarnings</div>
                    <div class="fs-4 fw-semibold mt-1 tabular @(issueCount > 0 ? "text-danger" : "")">@issueCount</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter bar + table -->
    <div class="app-content-card management-table-card mb-3">
        <div class="card-header">
            <form method="get" asp-action="Detail" class="row g-2 align-items-center">
                <input type="hidden" name="id" value="@Model.Payroll.PayrollId" />
                @if (!isStoreManager)
                {
                    <div class="col-12 col-md-3">
                        <select name="storeId" class="form-select form-select-sm" aria-label="@PayrollResource.Col_Store" onchange="this.form.submit()">
                            <option value="">@PayrollResource.Filter_AllStores</option>
                            @foreach (var store in Model.Stores)
                            {
                                if (store.StoreId == Model.SelectedStoreId)
                                {
                                    <option value="@store.StoreId" selected>@store.StoreName</option>
                                }
                                else
                                {
                                    <option value="@store.StoreId">@store.StoreName</option>
                                }
                            }
                        </select>
                    </div>
                }

                <div class="col-12 col-md-3">
                    <select name="status" class="form-select form-select-sm" aria-label="@PayrollResource.Col_Status" onchange="this.form.submit()">
                        <option value="">@PayrollResource.Filter_AllStatuses</option>
                        <option value="@PayrollDetailStatus.Valid" selected="@(Model.StatusFilter == PayrollDetailStatus.Valid)">@PayrollResource.DetailStatus_Valid</option>
                        <option value="@PayrollDetailStatus.MissingRate" selected="@(Model.StatusFilter == PayrollDetailStatus.MissingRate)">@PayrollResource.DetailStatus_MissingRate</option>
                        <option value="@PayrollDetailStatus.HasWarnings" selected="@(Model.StatusFilter == PayrollDetailStatus.HasWarnings)">@PayrollResource.DetailStatus_HasWarnings</option>
                    </select>
                </div>

                <div class="col-12 col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="@PayrollResource.Filter_SearchPlaceholder" aria-label="@PayrollResource.Filter_SearchPlaceholder" value="@Model.Search">
                    </div>
                </div>

                <div class="col-auto d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" type="submit">@SharedResource.Button_Search</button>
                    <a asp-action="Detail" asp-route-id="@Model.Payroll.PayrollId" class="btn btn-sm btn-outline-secondary" title="@PayrollResource.Filter_Reset">
                        <i class="bi bi-arrow-clockwise"></i> @PayrollResource.Filter_Reset
                    </a>
                </div>
            </form>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>@PayrollResource.Col_EmployeeCode</th>
                        <th>@PayrollResource.Col_FullName</th>
                        <th>@PayrollResource.Col_Store</th>
                        <th>@PayrollResource.Col_EmploymentType</th>
                        <th class="text-end">@PayrollResource.Col_RatePerHour</th>
                        <th class="text-end">@PayrollResource.Col_ActualHours</th>
                        <th class="text-end">@PayrollResource.Col_PaidLeaveHours</th>
                        <th class="text-end">@PayrollResource.Col_UnpaidLeave</th>
                        <th class="text-end">@PayrollResource.Col_PayableHours</th>
                        <th class="text-end">@PayrollResource.Col_TotalSalary</th>
                        <th>@PayrollResource.Col_Status</th>
                        <th class="text-end"><span class="visually-hidden">@PayrollResource.Col_Detail</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Details.Count == 0)
                    {
                        <tr>
                            <td colspan="12" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                @PayrollResource.Detail_Empty
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Details)
                        {
                            <tr>
                                <td class="text-muted">@item.EmployeeCode</td>
                                <td class="fw-semibold">@item.EmployeeName</td>
                                <td>@PayrollDisplayText.StoreName(item.StoreName)</td>
                                <td><span class="app-badge app-badge-neutral">@UIHelper.GetDisplayName(item.EmploymentType)</span></td>
                                <td class="text-end text-nowrap">
                                    @if (item.HourlyRate > 0)
                                    {
                                        <span>@item.HourlyRate.ToString("#,##0") @PayrollResource.Unit_Dong</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">@PayrollResource.Detail_NoRate</span>
                                    }
                                </td>
                                <td class="text-end">@item.TotalWorkHours.ToString("#,##0.00")</td>
                                <td class="text-end text-nowrap">
                                    @if (item.PaidLeaveHours > 0)
                                    {
                                        <span>@item.PaidLeaveHours.ToString("#,##0.00") h</span>
                                        <div class="small text-muted">@string.Format(PayrollResource.Common_Days, item.ApprovedLeaveDays)</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end text-muted text-nowrap">
                                    @(item.UnpaidLeaveDays > 0 ? string.Format(PayrollResource.Common_Days, item.UnpaidLeaveDays) : "-")
                                </td>
                                <td class="text-end text-nowrap">@((item.TotalWorkHours + item.PaidLeaveHours).ToString("#,##0.00")) h</td>
                                <td class="text-end fw-semibold text-nowrap">@item.TotalSalary.ToString("#,##0") @PayrollResource.Unit_Dong</td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case PayrollDetailStatus.Valid:
                                            <span class="app-status"><span class="app-dot app-dot-success"></span>@PayrollResource.DetailStatus_Valid</span>
                                            break;
                                        case PayrollDetailStatus.MissingRate:
                                            <span class="app-status" title="@PayrollDisplayText.WarningNotes(item.WarningNotes)"><span class="app-dot app-dot-danger"></span>@PayrollResource.DetailStatus_MissingRate</span>
                                            break;
                                        case PayrollDetailStatus.HasWarnings:
                                            <span class="app-status" title="@PayrollDisplayText.WarningNotes(item.WarningNotes)"><span class="app-dot app-dot-warning"></span>@PayrollResource.DetailStatus_HasMissingShifts</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="EmployeeDetail" asp-route-payrollId="@Model.Payroll.PayrollId" asp-route-employeeId="@item.EmployeeId" class="btn btn-sm btn-outline-secondary"
                                       title="@PayrollResource.Detail_ViewAttendanceTooltip" aria-label="@PayrollResource.Detail_ViewAttendanceTooltip">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                @if (Model.Details.Count > 0)
                {
                    <tfoot class="fw-semibold">
                        <tr>
                            <td colspan="5">@string.Format(PayrollResource.Detail_TotalRow, Model.Details.Count)</td>
                            <td class="text-end">@Model.Details.Sum(d => d.TotalWorkHours).ToString("#,##0.00")</td>
                            <td class="text-end">@Model.Details.Sum(d => d.PaidLeaveHours).ToString("#,##0.00")</td>
                            <td class="text-end text-nowrap">@string.Format(PayrollResource.Common_Days, Model.Details.Sum(d => d.UnpaidLeaveDays))</td>
                            <td class="text-end text-nowrap">@Model.Details.Sum(d => d.TotalWorkHours + d.PaidLeaveHours).ToString("#,##0.00") h</td>
                            <td class="text-end text-nowrap">@Model.Details.Sum(d => d.TotalSalary).ToString("#,##0") @PayrollResource.Unit_Dong</td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>

    <!-- Audit Logs -->
    @{
        var auditLogs = ViewBag.AuditLogs as List<RWPM.Models.Entities.PayrollAuditLog>;
    }
    @if (auditLogs != null && auditLogs.Count > 0)
    {
        <div class="app-content-card mb-3">
            <div class="card-header">@PayrollResource.Audit_Title</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead>
                        <tr>
                            <th>@PayrollResource.Audit_ColTime</th>
                            <th>@PayrollResource.Audit_ColAction</th>
                            <th>@PayrollResource.Audit_ColOperator</th>
                            <th>@PayrollResource.Col_Status</th>
                            <th>@PayrollResource.Audit_ColDetails</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in auditLogs)
                        {
                            var actionBadge = log.Action == "Lock" ? "app-badge-success" : log.Action == "Unlock" ? "app-badge-warning" : "app-badge-info";
                            <tr>
                                <td class="text-nowrap">@log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td><span class="app-badge @actionBadge">@PayrollDisplayText.AuditAction(log.Action)</span></td>
                                <td>@log.OperatorUsername</td>
                                <td class="text-nowrap">@(log.FromStatus.HasValue ? $"{PayrollDisplayText.PayrollStatusText(log.FromStatus)} → {PayrollDisplayText.PayrollStatusText(log.ToStatus)}" : PayrollDisplayText.PayrollStatusText(log.ToStatus))</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(log.Reason))
                                    {
                                        <div class="fw-semibold">@PayrollResource.Audit_ReasonLabel @PayrollDisplayText.AuditReason(log.Reason)</div>
                                    }
                                    <span class="text-muted">@PayrollDisplayText.AuditDetails(log.Details)</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal Mở khóa -->
@if (isAdminOrHR && isLocked)
{
    <div class="modal fade" id="unlockModal" tabindex="-1" aria-labelledby="unlockModalTitle" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Unlock" asp-route-id="@Model.Payroll.PayrollId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="unlockModalTitle">@PayrollResource.Unlock_ModalTitle</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedResource.Button_Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small">@Html.Raw(PayrollResource.Unlock_Intro)</p>
                        <div class="mb-3">
                            <label class="form-label required" for="unlockReason">@PayrollResource.Unlock_ReasonLabel</label>
                            <textarea id="unlockReason" name="reason" class="form-control" rows="3" maxlength="200" required placeholder="@PayrollResource.Unlock_ReasonPlaceholder"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@SharedResource.Button_Cancel</button>
                        <button type="submit" class="btn btn-primary">@PayrollResource.Unlock_Submit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
