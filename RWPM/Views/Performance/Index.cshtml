@model RWPM.Models.ViewModels.Performance.PerformanceIndexVM
@using RWPM.Models.ViewModels.Performance
@using R = RWPM.Resources.Shared.PerformanceResource

@{
    ViewData["Title"] = R.Index_Title;
    string? managerStoreName = ViewBag.StoreName as string;
    var monthLabel = string.Format(R.MonthLabel, Model.Month.ToString("D2"), Model.Year);
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="app-page-header">
        <div>
            <h4 class="mb-1">@R.Index_Title</h4>
            <div class="text-muted small">
                @if (Model.IsStoreManager)
                {
                    @R.Index_ScopeLabel <strong>@(managerStoreName ?? R.Index_ScopeAssignedStore)</strong>
                }
                else
                {
                    @R.Index_Subtitle
                }
            </div>
        </div>
        <div class="app-page-actions">
            <a class="btn btn-outline-secondary btn-sm d-flex align-items-center"
               asp-action="ExportExcel"
               asp-route-Year="@Model.Year"
               asp-route-Month="@Model.Month"
               asp-route-StoreId="@Model.StoreId"
               asp-route-Search="@Model.Search">
                <i class="bi bi-file-earmark-excel me-1"></i> @R.Action_ExportExcel
            </a>
        </div>
    </div>

    <!-- KPI -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@R.Card_AvgAttendanceRate</div>
                    <div class="fs-4 fw-semibold mt-1 tabular">@(Model.Summary.AverageAttendanceRate.HasValue ? Model.Summary.AverageAttendanceRate.Value.ToString("0.0") + "%" : "—")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@R.Card_TotalLates</div>
                    <div class="fs-4 fw-semibold mt-1 tabular @(Model.Summary.TotalLates > 0 ? "text-warning" : "")">@Model.Summary.TotalLates</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@R.Card_TotalAbsences</div>
                    <div class="fs-4 fw-semibold mt-1 tabular @(Model.Summary.TotalAbsences > 0 ? "text-danger" : "")">@Model.Summary.TotalAbsences</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">@R.Card_Reviewed</div>
                    <div class="fs-4 fw-semibold mt-1 tabular">@Model.Summary.ReviewedCount <span class="text-muted fs-6 fw-normal">/ @Model.Summary.TotalEmployees</span></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="app-filter-panel">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-6 col-md-2">
                <label class="form-label" for="filterMonth">@R.Filter_Month</label>
                <select id="filterMonth" name="Month" class="form-select form-select-sm">
                    @for (var mm = 1; mm <= 12; mm++)
                    {
                        <option value="@mm" selected="@(mm == Model.Month)">@string.Format(R.MonthOption, mm.ToString("D2"))</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label" for="filterYear">@R.Filter_Year</label>
                <select id="filterYear" name="Year" class="form-select form-select-sm">
                    @foreach (var yy in Model.AvailableYears)
                    {
                        <option value="@yy" selected="@(yy == Model.Year)">@yy</option>
                    }
                </select>
            </div>
            @if (!Model.IsStoreManager && Model.StoreSelectList != null)
            {
                <div class="col-md-3">
                    <label class="form-label" for="filterStore">@R.Filter_Store</label>
                    <select id="filterStore" name="StoreId" class="form-select form-select-sm">
                        @foreach (var item in Model.StoreSelectList)
                        {
                            <option value="@item.Value" selected="@(item.Value == (Model.StoreId ?? 0).ToString())">@item.Text</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-3">
                <label class="form-label" for="filterSearch">@R.Filter_Search</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input id="filterSearch" type="text" name="Search" value="@Model.Search" maxlength="100" class="form-control border-start-0 ps-0" placeholder="@R.Filter_SearchPlaceholder" />
                </div>
            </div>
            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary">
                    <i class="bi bi-funnel me-1"></i> @SharedResource.Button_Search
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="@SharedResource.Button_Reset">
                    <i class="bi bi-arrow-clockwise"></i> @SharedResource.Button_Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="app-content-card management-table-card mb-3">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>@monthLabel</span>
            <span class="text-muted small fw-normal" title="@R.Formula_Description"><i class="bi bi-info-circle me-1"></i>@R.Formula_Short</span>
        </div>
        <div class="table-responsive">
            <table class="table modern-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>@R.Col_Employee</th>
                        <th>@R.Col_Store</th>
                        <th class="text-end">@R.Col_Shifts</th>
                        <th class="text-end">@R.Col_AttendanceRate</th>
                        <th class="text-end">@R.Col_Absences</th>
                        <th class="text-end">@R.Col_Late</th>
                        <th class="text-end">@R.Col_Early</th>
                        <th class="text-end">@R.Col_MissingCheckOut</th>
                        <th class="text-end">@R.Col_WorkedHours</th>
                        <th class="text-end">@R.Col_SuggestedScore</th>
                        <th>@R.Col_ReviewScore</th>
                        <th class="text-end"><span class="visually-hidden">@SharedResource.Button_Action</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Paged.Data.Any())
                    {
                        foreach (var row in Model.Paged.Data)
                        {
                            var m = row.Metrics;
                            <tr>
                                <td>
                                    <div class="text-dark">@row.FullName</div>
                                    <div class="small text-muted">@row.EmployeeCode · @row.Username</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(row.StoreName))
                                    {
                                        <span class="small text-dark">@row.StoreName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">@R.Unassigned</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap" title="@R.Tooltip_Shifts">
                                    <span class="fw-semibold">@m.AttendedShifts</span><span class="text-muted">/@m.ApprovedShifts</span>
                                </td>
                                <td class="text-end">
                                    @if (m.AttendanceRate.HasValue)
                                    {
                                        var rateClass = m.AttendanceRate >= 95 ? "" : m.AttendanceRate >= 80 ? "text-warning" : "text-danger";
                                        <span class="fw-semibold @rateClass">@m.AttendanceRate.Value.ToString("0.0")%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end @(m.Absences > 0 ? "text-danger fw-semibold" : "text-muted")">@m.Absences</td>
                                <td class="text-end">
                                    @if (m.LateCount > 0)
                                    {
                                        <span class="text-warning fw-semibold">@m.LateCount</span>
                                        <div class="small text-muted">@string.Format(R.Minutes, m.LateMinutes)</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (m.EarlyLeaveCount > 0)
                                    {
                                        <span class="text-warning fw-semibold">@m.EarlyLeaveCount</span>
                                        <div class="small text-muted">@string.Format(R.Minutes, m.EarlyLeaveMinutes)</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="text-end @(m.MissingCheckOutCount > 0 ? "text-warning fw-semibold" : "text-muted")">@m.MissingCheckOutCount</td>
                                <td class="text-end">@m.WorkedHours.ToString("#,##0.00")</td>
                                <td class="text-end">
                                    @if (m.SuggestedScore.HasValue)
                                    {
                                        <span class="fw-semibold">@m.SuggestedScore.Value.ToString("0.0")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small" title="@R.NoData">—</span>
                                    }
                                </td>
                                <td>
                                    @if (row.Review != null)
                                    {
                                        <span class="app-badge app-badge-success" title="@(row.Review.ReviewerName ?? row.Review.ReviewedBy) · @row.Review.ReviewedAt.ToString("dd/MM/yyyy HH:mm")">
                                            <i class="bi bi-star-fill"></i>@row.Review.Score/5
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="app-badge app-badge-neutral">@R.NotReviewed</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Detail" asp-route-employeeId="@row.EmployeeId" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                                       class="btn btn-sm btn-outline-secondary text-nowrap" title="@R.Action_DetailReview">
                                        @R.Action_DetailReview
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                @R.Index_Empty
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @await Html.PartialAsync("_PaginationPartial", Model.Paged.ToPaginationRes(new Dictionary<string, string?>() {
        { "Year", Model.Year.ToString() },
        { "Month", Model.Month.ToString() },
        { "StoreId", Model.IsStoreManager ? null : Model.StoreId?.ToString() },
        { "Search", Model.Search }
    }))
</div>
