@using NR = RWPM.Resources.Shared.NotificationResource
@model RWPM.Models.ViewModels.Notification.NotificationListVM

@{
    ViewData["Title"] = NR.Index_Title;
    bool unreadOnly = Model.UnreadOnly;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="app-page-header">
        <div>
            <h4 class="fw-bold text-dark d-flex align-items-center mb-1">
                <i class="bi bi-bell-fill text-primary me-2"></i>
                @NR.Index_Title
                @if (Model.UnreadCount > 0)
                {
                    <span class="badge bg-danger rounded-pill ms-2 fs-6 fw-semibold">@string.Format(NR.Ui_UnreadCount, Model.UnreadCount)</span>
                }
            </h4>
            <div class="text-muted small">@NR.Index_Subtitle</div>
        </div>
        <div class="app-page-actions">
            @if (Model.UnreadCount > 0)
            {
                <form asp-action="MarkAllRead" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="unread" value="@(unreadOnly ? "true" : "false")" />
                    <button type="submit" class="btn btn-outline-primary btn-sm shadow-sm d-flex align-items-center">
                        <i class="bi bi-check2-all me-1"></i> @NR.Ui_MarkAllRead
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Filter -->
    <div class="app-filter-panel">
        <div class="btn-group btn-group-sm" role="group" aria-label="@NR.Index_Title">
            <a asp-action="Index" asp-route-unread="false" class="btn @(unreadOnly ? "btn-outline-primary" : "btn-primary")">
                <i class="bi bi-list-ul me-1"></i> @NR.Filter_All
            </a>
            <a asp-action="Index" asp-route-unread="true" class="btn @(unreadOnly ? "btn-primary" : "btn-outline-primary")">
                <i class="bi bi-envelope me-1"></i> @NR.Filter_Unread
                @if (Model.UnreadCount > 0)
                {
                    <span class="badge bg-danger ms-1">@Model.UnreadCount</span>
                }
            </a>
        </div>
    </div>

    <!-- Table Card -->
    <div class="app-content-card management-table-card mb-3">
        <div class="table-responsive">
            <table class="table modern-table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@NR.Th_Content</th>
                        <th class="text-nowrap" style="width: 180px;">@NR.Th_Time</th>
                        <th class="text-center text-nowrap" style="width: 130px;">@NR.Th_Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-5">
                                <i class="bi bi-bell-slash fs-2 d-block mb-2"></i>
                                @(unreadOnly ? NR.Ui_EmptyUnread : NR.Ui_Empty)
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr class="@(item.IsRead ? "" : "table-active")">
                            <td>
                                <a href="@(item.Url ?? "#")" class="d-flex align-items-start text-decoration-none text-reset"
                                   data-notif-open="@item.Id" data-notif-url="@item.Url">
                                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-@item.Color bg-opacity-10 text-@item.Color me-3 flex-shrink-0" style="width:38px;height:38px;">
                                        <i class="bi @item.Icon"></i>
                                    </span>
                                    <span>
                                        <span class="d-block @(item.IsRead ? "fw-semibold text-secondary" : "fw-bold text-dark")">@item.Title</span>
                                        <span class="d-block small @(item.IsRead ? "text-muted" : "text-dark")" style="white-space: pre-line;">@item.Message</span>
                                    </span>
                                </a>
                            </td>
                            <td class="text-nowrap">
                                <div class="small fw-semibold" data-notif-age="@item.AgeSeconds">@item.RelativeTime</div>
                                <div class="small text-muted">@item.CreatedDateStr</div>
                            </td>
                            <td class="text-center">
                                @if (item.IsRead)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">@NR.Status_Read</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary">@NR.Status_Unread</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @await Html.PartialAsync("_PaginationPartial", Model.Pagination.ToPaginationRes(new Dictionary<string, string?>() {
        { "unread", unreadOnly ? "true" : null }
    }))
</div>
