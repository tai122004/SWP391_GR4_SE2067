    .request-type-card.active-card-btn:hover, .request-type-card.active-card-btn:focus-visible { border-color: var(--app-blue); background: var(--app-blue-soft); }
    .request-type-card.active-card-btn:hover i { color: var(--app-blue); }
    .request-type-card.disabled-card { opacity: .55; cursor: not-allowed; background: var(--app-surface-2); }
</style>

@section Scripts {
    @{
        // Daterangepicker texts follow the current UI culture
        var dtf = System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat;
        var pickerLocale = new
        {
            format = "YYYY-MM-DD",
            separator = " ~ ",
            applyLabel = RequestResource.Filter_Apply,
            cancelLabel = SharedResource.Button_Cancel,
            daysOfWeek = dtf.ShortestDayNames,
            monthNames = dtf.MonthNames.Take(12).ToArray(),
            firstDay = 1
        };
    }
    <script>
        window.RWPM = window.RWPM || {};
        RWPM.requestIndex = {
            // Dữ liệu xuất file: toàn bộ danh sách đã lọc (không chỉ trang hiện tại)
            exportData: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((ViewBag.ExportItems as List<RequestItemVM>) ?? Model ?? new List<RequestItemVM>()).Select(x => new {
                code = x.Code,
                requestTypeName = x.RequestTypeName,
                employeeName = x.EmployeeName,
                storeName = x.StoreName,
                shiftName = x.ShiftName,
                workDateStr = x.WorkDateStr,
                createdDateStr = x.CreatedDateStr,
                status = (int)x.Status,
                approvedBy = x.ApprovedBy,
                rejectionReason = x.RejectionReason,
                note = x.Note
            }))),
            // Các đơn của trang hiện tại (khung chi tiết)
            requests: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model ?? new List<RequestItemVM>()).Select(x => new {
                id = x.Id,
                requestType = x.RequestType,
                requestTypeName = x.RequestTypeName,
                employeeName = x.EmployeeName,
                createdDateStr = x.CreatedDateStr,
                shiftName = x.ShiftName,
                workDateStr = x.WorkDateStr,
                status = (int)x.Status,
                code = x.Code,
                note = x.Note,
                rejectionReason = x.RejectionReason ?? "",
                approvedBy = x.ApprovedBy ?? "",
                approvedAt = x.ApprovedAtStr ?? "",
                swapSummary = x.SwapSummary ?? "",
                startDateStr = x.StartDateStr ?? "",
                endDateStr = x.EndDateStr ?? "",
                leaveType = (int?)x.LeaveType,
                leaveTypeName = x.LeaveTypeName ?? "",
                leaveDays = x.LeaveDays,
                annualLeaveBalance = x.AnnualLeaveBalance,
                actualCheckInTimeStr = x.ActualCheckInTimeStr ?? "",
                actualCheckOutTimeStr = x.ActualCheckOutTimeStr ?? "",
                requestedCheckInTimeStr = x.RequestedCheckInTimeStr ?? "",
                requestedCheckOutTimeStr = x.RequestedCheckOutTimeStr ?? "",
                adjustmentSummary = x.AdjustmentSummary ?? "",
                requesterUsername = x.RequesterUsername ?? "",
                requesterRole = (int?)x.RequesterRole,
                storeId = x.StoreId,
                storeName = x.StoreName ?? ""
            }))),
            currentUsername: @Json.Serialize(User.Identity?.Name ?? ""),
            isManager: @Json.Serialize(ViewBag.IsManager == true),
            isAdmin: @Json.Serialize(User.IsAdmin()),
            isHR: @Json.Serialize(User.IsHR()),
            isStoreManager: @Json.Serialize(User.IsStoreManager()),
            currentUserStoreId: @Json.Serialize((int)(ViewBag.CurrentUserStoreId ?? 0)),
            // Bộ lọc hiện tại (giữ khi đổi khoảng ngày / loại đơn)
            filter: {
                startDate: @Json.Serialize((string)ViewBag.StartDate),
                endDate: @Json.Serialize((string)ViewBag.EndDate),
                status: @Json.Serialize(currentStatus?.ToString() ?? ""),
                type: @Json.Serialize(currentType ?? ""),
                searchSuffix: @Json.Serialize(searchSuffix)
            },
            pickerLocale: @Json.Serialize(pickerLocale),
            urls: {
                createShiftReg: @Json.Serialize(Url.Action("Create", "ShiftRegistration")),
                createSwap: @Json.Serialize(Url.Action("CreateSwap", "Request")),
                createLeave: @Json.Serialize(Url.Action("CreateLeave", "Request")),
                createAttendance: @Json.Serialize(Url.Action("CreateAttendanceAdjustment", "Request")),
                swapFormData: @Json.Serialize(Url.Action("GetSwapFormData", "Request")),
                coworkerShifts: @Json.Serialize(Url.Action("GetCoworkerShifts", "Request")),
                leaveFormData: @Json.Serialize(Url.Action("GetLeaveFormData", "Request")),
                attendanceFormData: @Json.Serialize(Url.Action("GetAttendanceAdjustmentFormData", "Request")),
                approvalWarnings: @Json.Serialize(Url.Action("GetApprovalWarnings", "Request")),
                updateStatus: @Json.Serialize(Url.Action("UpdateStatus", "Request")),
                updateBulkStatus: @Json.Serialize(Url.Action("UpdateBulkStatus", "Request")),
                deleteRequest: @Json.Serialize(Url.Action("DeleteRequest", "Request"))
            },
            i18n: {
                pending: @Json.Serialize(SharedResource.Req_Pending),
                approved: @Json.Serialize(RequestResource.Status_Approved),
                rejected: @Json.Serialize(RequestResource.Status_Rejected),
                processedBy: @Json.Serialize(RequestResource.Banner_ProcessedBy),
                defaultManager: @Json.Serialize(RequestResource.Banner_DefaultManager),
                confirmApproveBtn: @Json.Serialize(RequestResource.Appr_ConfirmButton),
                pendingShort: @Json.Serialize(RequestResource.Tab_Pending),
                approvedShort: @Json.Serialize(RequestResource.Tab_Approved),
                rejectedShort: @Json.Serialize(RequestResource.Tab_Rejected),
                bannerApproved: @Json.Serialize(RequestResource.Banner_Approved),
                bannerRejected: @Json.Serialize(RequestResource.Banner_Rejected),
                processedAt: @Json.Serialize(RequestResource.Detail_ProcessedAt),
                rejectReason: @Json.Serialize(RequestResource.RejectReasonTitle),
                selectedCount: @Json.Serialize(RequestResource.Bulk_SelectedCount),
                leaveExceedsBalance: @Json.Serialize(RequestResource.Leave_ExceedsBalance),
                leaveEndBeforeStart: @Json.Serialize(RequestResource.Leave_EndBeforeStart),
                leaveDuration: @Json.Serialize(RequestResource.Leave_Duration),
                leaveSubmitSuccess: @Json.Serialize(RequestResource.Leave_SubmitSuccess),
                daysUnit: @Json.Serialize(RequestResource.Leave_DaysUnit),
                shift: @Json.Serialize(RequestResource.Shift),
                noticeAdminOnly: @Json.Serialize(RequestResource.Notice_AdminOnly),
                noticeStoreMismatch: @Json.Serialize(RequestResource.Notice_StoreMismatch),
