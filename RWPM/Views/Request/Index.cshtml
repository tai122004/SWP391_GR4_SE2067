<!-- Modal 2: Đăng Ký Ca Làm (Nested) -->
<div class="modal fade" id="createShiftRequestModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="modal-icon-badge bg-primary text-white rounded-3 p-2 d-flex align-items-center justify-content-center">
                        <i class="bi bi-calendar-plus fs-5"></i>
                    </div>
                    <h5 class="modal-title fw-bold text-dark fs-5 mb-0">@SharedResource.Req_ShiftReg</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedResource.Button_Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="shiftRequestForm">
                    @if (ViewBag.IsManager)
                    {
                        <div class="row align-items-center mb-3">
                            <div class="col-4 text-dark fw-bold small">@SharedResource.Req_Employee <span class="text-danger">*</span></div>
                            <div class="col-8">
                                <select class="form-select form-select-sm" id="reqEmployeeId" required>
                                    <option value="">@SharedResource.Req_SelectEmployee</option>
                                    @if (ViewBag.Employees != null)
                                    {
                                        foreach (var emp in ViewBag.Employees)
                                        {
                                            <option value="@emp.EmployeeId">@emp.EmployeeCode - @(emp.Account?.FullName ?? emp.Username)</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" id="reqEmployeeId" value="0" /> 
                    }

                    <div class="row align-items-center mb-3">
                        <div class="col-4 text-dark fw-bold small">@SharedResource.Req_Date <span class="text-danger">*</span></div>
                        <div class="col-8">
                            <input type="date" class="form-control form-control-sm" id="reqWorkDate" required>
                        </div>
                    </div>

                    <div class="row align-items-center mb-4">
                        <div class="col-4 text-dark fw-bold small">@SharedResource.Req_SelectShift <span class="text-danger">*</span></div>
                        <div class="col-8">
                            <select class="form-select form-select-sm" id="reqShiftId" required>
                                <option value="">@SharedResource.Req_SelectShift</option>
                                @if (ViewBag.Shifts != null)
                                {
                                    foreach (var shift in ViewBag.Shifts)
                                    {
                                        <option value="@shift.ShiftId">@shift.ShiftName (@shift.StartTime.ToString(@"hh\:mm") - @shift.EndTime.ToString(@"hh\:mm"))</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-dark fw-bold small">@SharedResource.Req_Note</label>
                        <textarea class="form-control form-control-sm" id="reqNote" rows="2" placeholder="@SharedResource.Req_Reason"></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">@SharedResource.Button_Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary px-4 fw-semibold">
                            <i class="bi bi-send me-1"></i> @SharedResource.Req_CreateNew
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal 3: Đổi Ca Làm (Nested) -->
<div class="modal fade" id="createSwapShiftModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="modal-icon-badge bg-purple text-white rounded-3 p-2 d-flex align-items-center justify-content-center">
                        <i class="bi bi-arrow-left-right fs-5"></i>
                    </div>
                    <h5 class="modal-title fw-bold text-dark fs-5 mb-0">@RequestResource.ShiftSwap</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedResource.Button_Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-warning py-2 small mb-3 d-none" id="swapNoShiftsAlert">
                    <i class="bi bi-exclamation-triangle me-1"></i> @RequestResource.Swap_NoEligibleShifts
                </div>

                <form id="swapShiftForm">
                    <!-- Chọn ca của tôi -->
                    <div class="mb-3">
                        <label class="form-label text-dark fw-bold small">@RequestResource.Swap_SourceShift <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" id="swapSourceRegistrationId" required>
