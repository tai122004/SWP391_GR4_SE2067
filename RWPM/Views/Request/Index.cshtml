</div>

<!-- Modal 4: Xin Nghỉ Phép (Nested) -->
<div class="modal fade" id="createLeaveRequestModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@RequestResource.LeaveRequest</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedResource.Button_Close"></button>
            </div>
            <form id="leaveRequestForm">
                <div class="modal-body p-4">
                    @if (ViewBag.IsManager)
                    {
                        <div class="mb-3">
                            <label class="form-label required" for="leaveEmployeeId">@SharedResource.Req_Employee</label>
                            <select class="form-select form-select-sm" id="leaveEmployeeId" required>
                                <option value="">@SharedResource.Req_SelectEmployee</option>
                                @if (ViewBag.Employees != null)
                                {
                                    foreach (var emp in ViewBag.Employees)
                                    {
                                        <option value="@emp.EmployeeId">@emp.EmployeeCode - @(emp.Account?.FullName ?? emp.Username)</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" id="leaveEmployeeId" value="0" />
                    }

                    <!-- Số ngày phép năm còn lại -->
                    <div class="d-flex justify-content-between align-items-center p-2 px-3 mb-3 border req-soft-row">
                        <span class="small text-muted">@RequestResource.Leave_AnnualLeaveBalance</span>
                        <strong class="tabular"><span id="leaveAnnualBalanceDisplay">0</span> @RequestResource.Leave_DaysUnit</strong>
                    </div>

                    <!-- Chọn loại nghỉ phép -->
                    <div class="mb-3">
                        <label class="form-label">@RequestResource.Leave_Type</label>
                        <div class="d-flex gap-4 flex-wrap">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="leaveType" id="leaveTypePaid" value="0" checked>
                                <label class="form-check-label" for="leaveTypePaid">@RequestResource.Leave_Paid</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="leaveType" id="leaveTypeUnpaid" value="1">
                                <label class="form-check-label" for="leaveTypeUnpaid">@RequestResource.Leave_Unpaid</label>
                            </div>
                        </div>
                    </div>

                    <!-- Chọn ngày bắt đầu và kết thúc -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label required" for="leaveStartDate">@RequestResource.Leave_StartDate</label>
                            <input type="date" class="form-control form-control-sm" id="leaveStartDate" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label required" for="leaveEndDate">@RequestResource.Leave_EndDate</label>
                            <input type="date" class="form-control form-control-sm" id="leaveEndDate" required>
                        </div>
                    </div>

                    <!-- Tổng số ngày xin nghỉ -->
                    <div class="d-flex justify-content-between align-items-center mb-3 p-2 px-3 border req-soft-row">
                        <span class="small text-muted">@RequestResource.Leave_Duration</span>
                        <strong class="tabular"><span id="leaveDaysCount">1</span> @RequestResource.Leave_DaysUnit</strong>
                    </div>

                    <!-- Cảnh báo nếu số ngày vượt quá phép năm -->
                    <div class="alert alert-danger py-2 small mb-3 d-none" id="leaveBalanceAlert">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        <span id="leaveBalanceAlertText"></span>
                    </div>

                    <!-- Lý do xin nghỉ -->
                    <div>
                        <label class="form-label required" for="leaveReason">@RequestResource.Leave_Reason</label>
                        <textarea class="form-control form-control-sm" id="leaveReason" rows="2" required placeholder="@RequestResource.Leave_ReasonPlaceholder"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">@SharedResource.Button_Cancel</button>
                    <button type="submit" id="btnSubmitLeave" class="btn btn-sm btn-primary">
                        <i class="bi bi-send me-1"></i> @SharedResource.Req_CreateNew
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

