    /* List */
    .req-list-header { display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding: .6rem 1rem; border-bottom: 1px solid var(--app-border); background: var(--app-surface-2); }
    .req-bulk-bar { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem; padding: .55rem 1rem; background: var(--app-blue-soft); border-bottom: 1px solid #D6E2F5; color: #1D3F73; font-size: .9rem; }
    .master-list-container { max-height: 640px; overflow-y: auto; -webkit-overflow-scrolling: touch; }
