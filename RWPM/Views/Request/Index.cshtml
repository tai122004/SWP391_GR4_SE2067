@using RWPM.Common.Enums
@using RWPM.Resources.Shared
@model List<RWPM.Models.ViewModels.ShiftRegistration.RequestItemVM>

@{
    ViewData["Title"] = RequestResource.RequestsAndApprovals;
    var currentStatus = ViewBag.CurrentStatus as int?;
    var currentType = ViewBag.CurrentType as string;
    int pendingCount = ViewBag.PendingCount ?? 0;
    int approvedCount = ViewBag.ApprovedCount ?? 0;
    int rejectedCount = ViewBag.RejectedCount ?? 0;
}

<div class="container-fluid px-0">
    <div class="app-page-header">
        <h4 class="mb-0 text-dark fw-bold">@RequestResource.RequestsAndApprovals</h4>
        <div class="app-page-actions">
            <button class="btn btn-outline-success mb-0 bg-white"><i class="fas fa-file-export"></i> @RequestResource.ExportFile</button>
            <button class="btn btn-primary mb-0" data-bs-toggle="modal" data-bs-target="#createRequestModal"><i class="fas fa-plus"></i> @RequestResource.CreateRequest</button>
        </div>
    </div>

    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3">
            <div class="d-flex gap-2 mb-3">
                <div class="dropdown w-100">
                    <button class="btn btn-light mb-0 dropdown-toggle text-dark w-100 text-start d-flex justify-content-between align-items-center" type="button" data-bs-toggle="dropdown">
                        <span>
                            <i class="fas fa-filter me-1 text-muted"></i>
                            @(currentType == "ShiftSwap" ? RequestResource.Filter_ShiftSwapOnly : (currentType == "ShiftReg" ? RequestResource.Filter_ShiftRegOnly : (currentType == "Leave" ? RequestResource.Filter_LeaveOnly : RequestResource.Filter_AllTypes)))
                        </span>
                    </button>
                    <ul class="dropdown-menu w-100 shadow-sm">
                        <li><a class="dropdown-item @(string.IsNullOrEmpty(currentType) ? "active" : "")" href="?status=@currentStatus&start=@ViewBag.StartDate&end=@ViewBag.EndDate">@RequestResource.Filter_AllTypes</a></li>
                        <li><a class="dropdown-item @(currentType == "ShiftReg" ? "active" : "")" href="?status=@currentStatus&type=ShiftReg&start=@ViewBag.StartDate&end=@ViewBag.EndDate">@RequestResource.Filter_ShiftRegOnly</a></li>
                        <li><a class="dropdown-item @(currentType == "ShiftSwap" ? "active" : "")" href="?status=@currentStatus&type=ShiftSwap&start=@ViewBag.StartDate&end=@ViewBag.EndDate">@RequestResource.Filter_ShiftSwapOnly</a></li>
                        <li><a class="dropdown-item @(currentType == "Leave" ? "active" : "")" href="?status=@currentStatus&type=Leave&start=@ViewBag.StartDate&end=@ViewBag.EndDate">@RequestResource.Filter_LeaveOnly</a></li>
                    </ul>
                </div>
            </div>

            <div class="mb-3 position-relative">
                <input type="text" class="form-control form-control-sm text-center bg-white" id="dateRangePicker" value="@ViewBag.StartDate ~ @ViewBag.EndDate" readonly style="cursor: pointer;">
                <i class="far fa-calendar-alt position-absolute text-muted" style="right: 10px; top: 8px;"></i>
            </div>
            
            <div class="mb-3 position-relative">
                <i class="fas fa-search position-absolute text-muted" style="left: 10px; top: 10px;"></i>
                <input type="text" id="requestSearchInput" class="form-control bg-white ps-4 border-0 shadow-sm" placeholder="@RequestResource.Search" style="border-radius: 8px;">
            </div>

            <div class="nav flex-column nav-pills request-tabs">
                <a class="nav-link @(currentStatus == 0 ? "active" : "") d-flex justify-content-between align-items-center" href="?status=0&type=@currentType&start=@ViewBag.StartDate&end=@ViewBag.EndDate">
                    <span><i class="fas fa-caret-right me-2 text-muted"></i> @RequestResource.Pending</span>
                    <span class="@(currentStatus == 0 ? "text-success fw-bold" : "text-muted")">@pendingCount</span>
                </a>
                <a class="nav-link @(currentStatus == 1 ? "active" : "") d-flex justify-content-between align-items-center" href="?status=1&type=@currentType&start=@ViewBag.StartDate&end=@ViewBag.EndDate">
                    <span><i class="fas fa-caret-right me-2 text-muted"></i> @RequestResource.Approved</span>
                    <span class="@(currentStatus == 1 ? "text-success fw-bold" : "text-success")">@approvedCount</span>
                </a>
                <a class="nav-link @(currentStatus == 2 ? "active" : "") d-flex justify-content-between align-items-center" href="?status=2&type=@currentType&start=@ViewBag.StartDate&end=@ViewBag.EndDate">
                    <span><i class="fas fa-caret-right me-2 text-muted"></i> @RequestResource.Rejected</span>
                    <span class="@(currentStatus == 2 ? "text-danger fw-bold" : "text-danger")">@rejectedCount</span>
                </a>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-md-9">
            <div class="row h-100">
                <!-- Master List (Left Column) -->
                <div class="col-md-5 border-end pe-0" style="height: 600px; overflow-y: auto;">
                    <div class="d-flex justify-content-between align-items-center mb-3 pe-2">
                        <div></div>
                        <div class="form-check text-muted small">
                            <input class="form-check-input" type="checkbox" id="selectAll">
                            <label class="form-check-label" for="selectAll">@RequestResource.SelectMultiple</label>
                        </div>
                    </div>

                    @if (Model == null || !Model.Any())
                    {
                        <div class="text-center text-muted mt-5">
                            <i class="fas fa-inbox fs-2 mb-2" style="color: #dee2e6;"></i>
                            <p>@RequestResource.NoData</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <!-- Item Card -->
                            <div class="modern-card mb-2 request-card me-2" style="cursor: pointer;" data-id="@item.Id" data-type="@item.RequestType">
                                <div class="card-body p-3 position-relative">
                                    @if (item.Status == RegistrationStatus.Pending)
                                    {
                                        <div class="form-check position-absolute" style="top: 15px; right: 15px;">
                                            <input class="form-check-input request-checkbox" type="checkbox" value="@item.Id" data-type="@item.RequestType">
                                        </div>
                                    }
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <h6 class="fw-bold mb-0 text-dark">@item.RequestTypeName</h6>
                                        @if (item.RequestType == "ShiftSwap")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning" style="font-size: 10px;">
                                                <i class="fas fa-exchange-alt me-1 text-warning"></i>@RequestResource.ShiftSwap
                                            </span>
                                        }
                                        else if (item.RequestType == "Leave")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success" style="font-size: 10px;">
                                                <i class="fas fa-bed me-1 text-success"></i>@RequestResource.LeaveRequest
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-primary border border-info" style="font-size: 10px;">
                                                <i class="far fa-calendar-plus me-1 text-primary"></i>@RequestResource.ShiftRegistration
                                            </span>
                                        }
                                    </div>

                                    @if (item.RequestType == "Leave")
                                    {
                                        <div class="small mb-1 text-dark"><span class="text-muted">@RequestResource.Leave_Duration:</span> @item.ShiftName (@item.WorkDateStr)</div>
                                    }
                                    else
                                    {
                                        <div class="small mb-1 text-dark"><span class="text-muted">@RequestResource.Shift:</span> @item.ShiftName (@item.WorkDateStr)</div>
                                    }
                                    
                                    @if (item.RequestType == "ShiftSwap" && !string.IsNullOrEmpty(item.SwapSummary))
                                    {
                                        <div class="small mb-1 text-primary text-truncate fw-semibold"><i class="fas fa-arrow-right me-1 small"></i> @item.SwapSummary</div>
                                    }

                                    <div class="small mb-2 text-dark"><span class="text-muted">@RequestResource.Approver:</span> <span class="text-primary">@(string.IsNullOrEmpty(item.ApprovedBy) ? (item.Status == RegistrationStatus.Pending ? RequestResource.NotApprovedYet : "-") : item.ApprovedBy)</span></div>
                                    
                                    <div class="d-flex justify-content-between align-items-end mt-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 12px;">
                                                @((item.EmployeeName ?? "U").Substring(0, 1).ToUpper())
                                            </div>
                                            <span class="text-primary fw-bold small">@item.EmployeeName</span>
                                        </div>
                                        <div class="text-muted" style="font-size: 11px;">
                                            @item.CreatedDateStr
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Detail View (Right Column) -->
                <div class="col-md-7 ps-4" id="requestDetailPane" style="display: none;">
                    
                    <div class="d-flex gap-2 mb-4">
                        @if (ViewBag.IsManager)
                        {
                            <button class="btn btn-success px-4 action-btn" id="btnApproveDetail" onclick="updateSelectedStatus(1)">@RequestResource.Approve</button>
                            <button class="btn btn-outline-danger px-4 action-btn" id="btnRejectDetail" onclick="updateSelectedStatus(2)">@RequestResource.Reject</button>
                        }
                        else
                        {
                            <button class="btn btn-outline-danger px-4 action-btn" id="btnDeleteDetail" onclick="deleteSelectedRequest()">@RequestResource.Delete</button>
                        }
                    </div>
                    
                    <h5 class="fw-bold text-dark mb-4" id="detailTypeName">@RequestResource.ShiftRegistration</h5>

                    <div class="bg-light p-4 rounded-3 mb-3">
                        <div class="row mb-3">
                            <div class="col-6">
                                <div class="text-muted small mb-1">@RequestResource.Creator:</div>
                                <div class="text-primary fw-bold" id="detailEmployeeName"></div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small mb-1">@RequestResource.Date:</div>
                                <div class="text-dark fw-bold" id="detailCreatedDate"></div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <div class="text-muted small mb-1">@RequestResource.Department:</div>
                                <div class="text-dark fw-bold">@SharedResource.Req_HR</div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-light p-4 rounded-3">
                        <div class="row mb-4">
                            <div class="col-4">
                                <div class="text-muted small mb-1">@RequestResource.Code</div>
                                <div class="text-dark fw-bold" id="detailCode"></div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted small mb-1">@RequestResource.Creator</div>
                                <div class="text-dark fw-bold" id="detailCreator"></div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted small mb-1" id="detailShiftLabel">@RequestResource.Shift</div>
                                <div class="text-dark fw-bold" id="detailShiftName"></div>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-4">
                                <div class="text-muted small mb-1">@RequestResource.Date</div>
                                <div class="text-dark fw-bold" id="detailWorkDate"></div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted small mb-1">@RequestResource.Reason</div>
                                <div class="text-dark fw-bold" id="detailNote">-</div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted small mb-1">@RequestResource.Status</div>
                                <div id="detailStatus"></div>
                            </div>
                        </div>

                        <!-- Thông tin đổi ca (chỉ hiện khi requestType == 'ShiftSwap') -->
                        <div class="row mt-3" id="detailSwapTargetRow" style="display: none;">
                            <div class="col-12">
                                <div class="p-3 bg-white rounded border border-warning">
                                    <div class="text-warning small fw-bold mb-1"><i class="fas fa-exchange-alt me-1"></i> @RequestResource.Swap_TargetShiftInfo</div>
                                    <div class="text-dark fw-bold" id="detailSwapSummary"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Thông tin xin nghỉ phép (chỉ hiện khi requestType == 'Leave') -->
                        <div class="row mt-3" id="detailLeaveInfoRow" style="display: none;">
                            <div class="col-12">
                                <div class="p-3 bg-white rounded border border-success">
                                    <div class="text-success small fw-bold mb-1"><i class="fas fa-bed me-1"></i> @RequestResource.LeaveRequest</div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="text-dark fw-bold" id="detailLeaveTypeDesc"></div>
                                        <div class="badge bg-success bg-opacity-10 text-success p-2" id="detailLeaveBalanceBadge"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-3" id="detailRejectionRow" style="display: none;">
                            <div class="col-12">
                                <div class="alert alert-danger mb-0 py-2">
                                    <strong>@RequestResource.RejectReasonTitle:</strong> <span id="detailRejectionReason"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3" id="detailApproverRow" style="display: none;">
                            <div class="col-12 text-muted small">
                                <strong>@RequestResource.Approver:</strong> <span id="detailApprover" class="text-dark fw-bold"></span> 
                                <span id="detailApprovedAt" class="ms-2"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bulk Action View (Right Column) -->
                <div class="col-md-7 ps-4" id="bulkActionPane" style="display: none;">
                    <div class="d-flex flex-column justify-content-center h-100 bg-light rounded-3 p-5 text-center" style="min-height: 500px;">
                        <div class="mb-4">
                            <i class="fas fa-layer-group text-primary" style="opacity: 0.8; font-size: 64px;"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">@RequestResource.CurrentlySelecting <span id="bulkSelectedCount" class="text-primary">0</span> @RequestResource.Requests</h4>
                        <p class="text-muted mb-4">@RequestResource.BulkActionDesc</p>
                        <div class="d-flex gap-3 justify-content-center">
                            @if (ViewBag.IsManager)
                            {
                                <button class="btn btn-success px-4" onclick="updateBulkStatus(1)"><i class="fas fa-check me-2"></i>@RequestResource.ApproveAll</button>
                                <button class="btn btn-outline-danger px-4" onclick="updateBulkStatus(2)"><i class="fas fa-times me-2"></i>@RequestResource.RejectAll</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Tạo Mới Yêu Cầu (Chọn loại) -->
<div class="modal fade" id="createRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 12px; border: none;">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark fs-5">@SharedResource.Req_CreateReq</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2 px-4 pb-4">
                <div class="mb-4">
                    <h6 class="text-primary fw-bold mb-3" style="font-size: 13px;">@SharedResource.Req_AttendanceRecord</h6>
                    <div class="row g-3">
                        <div class="col-md-4"><div class="request-type-btn disabled-btn"><i class="fas fa-briefcase text-success fs-5"></i><span>@SharedResource.Req_BusinessTrip</span></div></div>
                        <div class="col-md-4"><div class="request-type-btn disabled-btn"><i class="fas fa-user-clock text-success fs-5"></i><span>@SharedResource.Req_LateEarly</span></div></div>
                        <div class="col-md-4">
                            <div class="request-type-btn active-btn" onclick="openLeaveModal()">
                                <i class="fas fa-bed text-success fs-5"></i>
                                <span>@SharedResource.Req_Leave</span>
                            </div>
                        </div>
                        <div class="col-md-4"><div class="request-type-btn disabled-btn"><i class="fas fa-history text-success fs-5"></i><span>@SharedResource.Req_Overtime</span></div></div>
                    </div>
                </div>

                <div class="mb-4">
                    <h6 class="text-primary fw-bold mb-3" style="font-size: 13px;">@SharedResource.Req_Shift</h6>
                    <div class="row g-3">
                        <div class="col-md-4"><div class="request-type-btn disabled-btn"><i class="far fa-calendar-alt text-warning fs-5"></i><span>@SharedResource.Req_ChangeInOut</span></div></div>
                        <div class="col-md-4"><div class="request-type-btn disabled-btn"><i class="fas fa-hamburger text-warning fs-5"></i><span>@SharedResource.Req_Meal</span></div></div>
                        
                        <div class="col-md-4">
                            <!-- Nút mở modal Đăng ký ca -->
                            <div class="request-type-btn active-btn" onclick="openShiftModal()">
                                <i class="far fa-calendar-plus text-warning fs-5"></i>
                                <span>@SharedResource.Req_ShiftReg</span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <!-- Nút mở modal Đổi ca làm -->
                            <div class="request-type-btn active-btn" onclick="openSwapModal()">
                                <i class="fas fa-exchange-alt text-warning fs-5"></i>
                                <span>@SharedResource.Req_ChangeShift</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div>
                    <h6 class="text-primary fw-bold mb-3" style="font-size: 13px;">@SharedResource.Req_Finance</h6>
                    <div class="row g-3">
                        <div class="col-md-4"><div class="request-type-btn disabled-btn"><i class="fas fa-money-bill-wave text-primary fs-5"></i><span>@SharedResource.Req_SalaryAdv</span></div></div>
                        <div class="col-md-4"><div class="request-type-btn disabled-btn"><i class="fas fa-hand-holding-usd text-primary fs-5"></i><span>@SharedResource.Req_AdvanceRefund</span></div></div>
                        <div class="col-md-4"><div class="request-type-btn disabled-btn"><i class="fas fa-file-invoice-dollar text-primary fs-5"></i><span>@SharedResource.Req_Proposal</span></div></div>
                        <div class="col-md-4"><div class="request-type-btn disabled-btn"><i class="far fa-credit-card text-primary fs-5"></i><span>@SharedResource.Req_Payment</span></div></div>
                        <div class="col-md-4"><div class="request-type-btn disabled-btn"><i class="fas fa-receipt text-primary fs-5"></i><span>@SharedResource.Req_ExpensePay</span></div></div>
                        <div class="col-md-4"><div class="request-type-btn disabled-btn"><i class="fas fa-shopping-cart text-primary fs-5"></i><span>@SharedResource.Req_Purchase</span></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Đăng Ký Ca Làm (Nested) -->
<div class="modal fade" id="createShiftRequestModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark fs-5">@SharedResource.Req_ShiftReg</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="shiftRequestForm">
                    @if (ViewBag.IsManager)
                    {
                        <div class="row align-items-center mb-3">
                            <div class="col-3 text-dark fw-bold small">@SharedResource.Req_Employee <span class="text-danger">*</span></div>
                            <div class="col-9">
                                <select class="form-select border-success text-success" id="reqEmployeeId" required style="border-radius: 8px;">
                                    <option value="">@SharedResource.Req_SelectEmployee</option>
                                    @if (ViewBag.Employees != null)
                                    {
                                        foreach (var emp in ViewBag.Employees)
                                        {
                                            <option value="@emp.EmployeeId">@emp.EmployeeCode - @(emp.Account?.FullName ?? emp.Username)</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" id="reqEmployeeId" value="0" /> 
                    }

                    <div class="row align-items-center mb-3">
                        <div class="col-3 text-dark fw-bold small">@SharedResource.Req_Date <span class="text-danger">*</span></div>
                        <div class="col-9 position-relative">
                            <input type="date" class="form-control" id="reqWorkDate" required style="border-radius: 8px; color: #495057;">
                        </div>
                    </div>

                    <div class="row align-items-center mb-4">
                        <div class="col-3 text-dark fw-bold small">@SharedResource.Req_SelectShift <span class="text-danger">*</span></div>
                        <div class="col-9">
                            <select class="form-select" id="reqShiftId" required style="border-radius: 8px; color: #495057; background-color: #f8f9fa;">
                                <option value="">@SharedResource.Req_SelectShift</option>
                                @if (ViewBag.Shifts != null)
                                {
                                    foreach (var shift in ViewBag.Shifts)
                                    {
                                        <option value="@shift.ShiftId">@shift.ShiftName (@shift.StartTime.ToString(@"hh\:mm") - @shift.EndTime.ToString(@"hh\:mm"))</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row align-items-start mb-4">
                        <div class="col-3 text-dark fw-bold small mt-2">@SharedResource.Req_Note</div>
                        <div class="col-9">
                            <textarea class="form-control" id="reqNote" rows="2" placeholder="@SharedResource.Req_Reason" style="border-radius: 8px; background-color: #f8f9fa;"></textarea>
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-success px-4" style="border-radius: 8px;">@SharedResource.Req_CreateNew</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Đổi Ca Làm Việc (Shift Swap) -->
<div class="modal fade" id="createSwapShiftModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark fs-5">
                    <i class="fas fa-exchange-alt text-warning me-2"></i>@RequestResource.ShiftSwap
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="swapShiftForm">
                    <!-- Step 1: Chọn ca cần đổi -->
                    <div class="mb-3">
                        <label class="form-label text-dark fw-bold small">@RequestResource.Swap_SourceShift <span class="text-danger">*</span></label>
                        <select class="form-select" id="swapSourceRegistrationId" required style="border-radius: 8px;">
                            <option value="">@RequestResource.Swap_SelectSourcePrompt</option>
                        </select>
                        <div id="swapNoShiftsAlert" class="text-danger small mt-1 d-none">@RequestResource.Swap_NoEligibleShifts</div>
                    </div>

                    <!-- Step 2: Chọn hình thức đổi -->
                    <div class="mb-3">
                        <label class="form-label text-dark fw-bold small">@RequestResource.Swap_SwapType</label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="swapType" id="swapTypePeer" value="peer" checked>
                                <label class="form-check-label text-dark" for="swapTypePeer">
                                    <i class="fas fa-user-friends me-1 text-primary"></i> @RequestResource.Swap_WithCoworker
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="swapType" id="swapTypeDirect" value="direct">
                                <label class="form-check-label text-dark" for="swapTypeDirect">
                                    <i class="fas fa-calendar-alt me-1 text-success"></i> @RequestResource.Swap_DirectChange
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Trường hợp: Đổi với đồng nghiệp -->
                    <div id="swapPeerSection" class="p-3 bg-light rounded-3 mb-3 border">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-dark fw-bold small">@RequestResource.Swap_SelectCoworker <span class="text-danger">*</span></label>
                                <select class="form-select" id="swapTargetEmployeeId" style="border-radius: 8px;">
                                    <option value="">@RequestResource.Swap_SelectCoworkerPrompt</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-dark fw-bold small">@RequestResource.Swap_CoworkerShift <span class="text-danger">*</span></label>
                                <select class="form-select" id="swapTargetRegistrationId" style="border-radius: 8px;">
                                    <option value="">@RequestResource.Swap_SelectCoworkerShiftPrompt</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Trường hợp: Chuyển sang ca khác của mình -->
                    <div id="swapDirectSection" class="p-3 bg-light rounded-3 mb-3 border" style="display: none;">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-dark fw-bold small">@RequestResource.Swap_NewDate <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="swapTargetWorkDate" style="border-radius: 8px;">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-dark fw-bold small">@RequestResource.Swap_NewShift <span class="text-danger">*</span></label>
                                <select class="form-select" id="swapTargetShiftId" style="border-radius: 8px;">
                                    <option value="">@SharedResource.Req_SelectShift</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Lý do đổi ca -->
                    <div class="mb-4">
                        <label class="form-label text-dark fw-bold small">@RequestResource.Swap_Reason <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="swapReason" rows="3" required placeholder="@RequestResource.Swap_ReasonPlaceholder" style="border-radius: 8px;"></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal" style="border-radius: 8px;">@SharedResource.Button_Cancel</button>
                        <button type="submit" id="btnSubmitSwap" class="btn btn-warning text-dark fw-bold px-4" style="border-radius: 8px;">
                            <i class="fas fa-paper-plane me-1"></i> @SharedResource.Req_CreateNew
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xin Nghỉ Phép (Leave Request) -->
<div class="modal fade" id="createLeaveRequestModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark fs-5">
                    <i class="fas fa-bed text-success me-2"></i>@RequestResource.LeaveRequest
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="leaveRequestForm">
                    @if (ViewBag.IsManager)
                    {
                        <div class="mb-3">
                            <label class="form-label text-dark fw-bold small">@SharedResource.Req_Employee <span class="text-danger">*</span></label>
                            <select class="form-select border-success text-success" id="leaveEmployeeId" style="border-radius: 8px;">
                                <option value="">@SharedResource.Req_SelectEmployee</option>
                                @if (ViewBag.Employees != null)
                                {
                                    foreach (var emp in ViewBag.Employees)
                                    {
                                        <option value="@emp.EmployeeId">@emp.EmployeeCode - @(emp.Account?.FullName ?? emp.Username)</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" id="leaveEmployeeId" value="0" />
                    }

                    <!-- Thẻ hiển thị số ngày phép năm còn lại -->
                    <div class="p-3 mb-3 bg-light rounded-3 border d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                <i class="fas fa-calendar-check"></i>
                            </div>
                            <div>
                                <div class="text-muted small">@RequestResource.Leave_AnnualLeaveBalance</div>
                                <div class="text-success fw-bold fs-6">
                                    <span id="leaveAnnualBalanceDisplay">--</span> @RequestResource.Leave_DaysUnit
                                </div>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="badge bg-success bg-opacity-10 text-success p-2" id="leaveDurationBadge" style="font-size: 13px;">
                                <i class="fas fa-clock me-1"></i> @RequestResource.Leave_Duration: <span id="leaveDaysCount">1</span> @RequestResource.Leave_DaysUnit
                            </div>
                        </div>
                    </div>

                    <!-- Chọn khoảng thời gian nghỉ -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-dark fw-bold small">@RequestResource.Leave_StartDate <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="leaveStartDate" required style="border-radius: 8px;">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-dark fw-bold small">@RequestResource.Leave_EndDate <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="leaveEndDate" required style="border-radius: 8px;">
                        </div>
                    </div>

                    <!-- Chọn loại nghỉ -->
                    <div class="mb-3">
                        <label class="form-label text-dark fw-bold small">@RequestResource.Leave_Type <span class="text-danger">*</span></label>
                        <div class="d-flex flex-column gap-2 p-3 bg-light rounded-3 border">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="leaveType" id="leaveTypePaid" value="0" checked>
                                <label class="form-check-label text-dark fw-semibold" for="leaveTypePaid">
                                    <i class="fas fa-check-circle text-success me-1"></i> @RequestResource.Leave_Paid
                                    <span class="text-muted small fw-normal d-block">Trừ vào quỹ phép năm hiện tại và được hưởng nguyên lương theo quy định</span>
                                </label>
                            </div>
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="radio" name="leaveType" id="leaveTypeUnpaid" value="1">
                                <label class="form-check-label text-dark fw-semibold" for="leaveTypeUnpaid">
                                    <i class="fas fa-minus-circle text-secondary me-1"></i> @RequestResource.Leave_Unpaid
                                    <span class="text-muted small fw-normal d-block">Không trừ phép năm và không tính lương cho những ngày này</span>
                                </label>
                            </div>
                        </div>
                        <div id="leaveBalanceAlert" class="alert alert-warning py-2 px-3 small mt-2 d-none">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            <span id="leaveBalanceAlertText">@RequestResource.Leave_InsufficientBalance</span>
                        </div>
                    </div>

                    <!-- Lý do xin nghỉ -->
                    <div class="mb-4">
                        <label class="form-label text-dark fw-bold small">@RequestResource.Leave_Reason <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="leaveReason" rows="3" required placeholder="@RequestResource.Leave_ReasonPlaceholder" style="border-radius: 8px;"></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal" style="border-radius: 8px;">@SharedResource.Button_Cancel</button>
                        <button type="submit" id="btnSubmitLeave" class="btn btn-success fw-bold px-4" style="border-radius: 8px;">
                            <i class="fas fa-paper-plane me-1"></i> @SharedResource.Req_CreateNew
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nhập Lý Do Từ Chối -->
<div class="modal fade" id="rejectReasonModal" tabindex="-1" aria-hidden="true" style="z-index: 1070;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-danger fs-5"><i class="fas fa-exclamation-circle me-2"></i>@RequestResource.RejectReasonTitle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label text-dark small fw-bold">@RequestResource.RejectReasonPrompt <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="modalRejectionReason" rows="3" placeholder="@RequestResource.RejectReasonPlaceholder" style="border-radius: 8px;"></textarea>
                </div>
                <div class="text-end">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal" style="border-radius: 8px;">@SharedResource.Button_Cancel</button>
                    <button type="button" class="btn btn-danger px-4" onclick="submitRejection()" style="border-radius: 8px;">@RequestResource.ConfirmRejectBtn</button>
                </div>
