@using RWPM.Common.Enums
@using RWPM.Resources.Shared
@using RWPM.Models.ViewModels.ShiftRegistration
@model List<RequestItemVM>

@{
    ViewData["Title"] = RequestResource.RequestsAndApprovals;
    var currentStatus = ViewBag.CurrentStatus as int?;
    var currentType = ViewBag.CurrentType as string;
    int pendingCount = ViewBag.PendingCount ?? 0;
    int approvedCount = ViewBag.ApprovedCount ?? 0;
    int rejectedCount = ViewBag.RejectedCount ?? 0;
    int totalCount = pendingCount + approvedCount + rejectedCount;
    var searchQuery = ViewBag.SearchQuery as string;
    var searchSuffix = string.IsNullOrEmpty(searchQuery) ? "" : "&q=" + Uri.EscapeDataString(searchQuery);
    int totalFiltered = ViewBag.TotalFiltered ?? (Model?.Count ?? 0);
}

<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div class="container-fluid px-0 request-management-page">
    <!-- Header -->
    <div class="app-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <div class="header-icon-box bg-primary text-white rounded-3 p-2 d-flex align-items-center justify-content-center">
                    <i class="bi bi-inbox-fill fs-5"></i>
                </div>
                <h1 class="h3 fw-bold text-dark mb-0">@RequestResource.RequestsAndApprovals</h1>
            </div>
            <p class="text-muted small mb-0">@RequestResource.Page_Subtitle</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-success btn-sm shadow-xs d-flex align-items-center gap-2 bg-white" onclick="exportRequestsToCSV()">
                <i class="bi bi-file-earmark-excel-fill text-success"></i>
                <span>@RequestResource.ExportFile</span>
            </button>
            <button type="button" class="btn btn-primary btn-sm shadow-xs d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#createRequestModal">
                <i class="bi bi-plus-lg"></i>
                <span>@RequestResource.CreateRequest</span>
            </button>
        </div>
    </div>

    <!-- 3 Status Statistics Cards -->
    <div class="row g-3 mb-4">
        <!-- Chờ duyệt (Pending) -->
        <div class="col-md-4 col-sm-6">
            <a href="?status=0&type=@currentType&start=@ViewBag.StartDate&end=@ViewBag.EndDate@(searchSuffix)" 
               class="text-decoration-none text-dark stats-card stats-pending @(currentStatus == 0 ? "active-filter" : "")">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-3 position-relative overflow-hidden">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-uppercase small fw-bold text-warning-emphasis">@SharedResource.Req_Pending</span>
                        <div class="stats-icon-badge bg-warning-subtle text-warning rounded-3 p-2">
                            <i class="bi bi-hourglass-split fs-5"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <h2 class="fw-bold mb-0 text-dark">@pendingCount</h2>
                        <span class="text-muted small">@RequestResource.Requests</span>
                    </div>
                    @if (currentStatus == 0)
                    {
                        <div class="active-badge badge bg-warning text-dark position-absolute bottom-0 end-0 m-2">@RequestResource.Stats_Filtering</div>
                    }
                </div>
            </a>
        </div>

        <!-- Đã chấp thuận (Approved) -->
        <div class="col-md-4 col-sm-6">
            <a href="?status=1&type=@currentType&start=@ViewBag.StartDate&end=@ViewBag.EndDate@(searchSuffix)" 
               class="text-decoration-none text-dark stats-card stats-approved @(currentStatus == 1 ? "active-filter" : "")">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-3 position-relative overflow-hidden">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-uppercase small fw-bold text-success">@RequestResource.Status_Approved</span>
                        <div class="stats-icon-badge bg-success-subtle text-success rounded-3 p-2">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <h2 class="fw-bold mb-0 text-dark">@approvedCount</h2>
                        <span class="text-muted small">@RequestResource.Requests</span>
                    </div>
                    @if (currentStatus == 1)
                    {
                        <div class="active-badge badge bg-success text-white position-absolute bottom-0 end-0 m-2">@RequestResource.Stats_Filtering</div>
                    }
                </div>
            </a>
        </div>

        <!-- Đã từ chối (Rejected) -->
        <div class="col-md-4 col-sm-6">
            <a href="?status=2&type=@currentType&start=@ViewBag.StartDate&end=@ViewBag.EndDate@(searchSuffix)" 
               class="text-decoration-none text-dark stats-card stats-rejected @(currentStatus == 2 ? "active-filter" : "")">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-3 position-relative overflow-hidden">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-uppercase small fw-bold text-danger">@RequestResource.Status_Rejected</span>
                        <div class="stats-icon-badge bg-danger-subtle text-danger rounded-3 p-2">
                            <i class="bi bi-x-circle-fill fs-5"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <h2 class="fw-bold mb-0 text-dark">@rejectedCount</h2>
                        <span class="text-muted small">@RequestResource.Requests</span>
                    </div>
                    @if (currentStatus == 2)
                    {
                        <div class="active-badge badge bg-danger text-white position-absolute bottom-0 end-0 m-2">@RequestResource.Stats_Filtering</div>
                    }
                </div>
            </a>
        </div>
    </div>

    <!-- Unified Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 filter-panel-card bg-white p-3">
        <div class="row g-2 align-items-center">
            <!-- Search -->
            <div class="col-lg-4 col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="requestSearchInput" class="form-control bg-light border-start-0 ps-0" placeholder="@RequestResource.Filter_SearchPlaceholder" value="@searchQuery" title="@RequestResource.Filter_SearchEnterHint">
                </div>
            </div>

            <!-- Request Type -->
            <div class="col-lg-3 col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-funnel text-muted"></i></span>
                    <select id="filterTypeSelect" class="form-select bg-light border-start-0 ps-0" onchange="onTypeFilterChange(this.value)">
                        <option value="" selected="@(string.IsNullOrEmpty(currentType) ? "selected" : null)">@RequestResource.Filter_AllTypes</option>
                        <option value="ShiftReg" selected="@(currentType == "ShiftReg" ? "selected" : null)">@RequestResource.ShiftRegistration</option>
                        <option value="ShiftSwap" selected="@(currentType == "ShiftSwap" ? "selected" : null)">@RequestResource.Filter_ShiftSwapOnly</option>
                        <option value="Leave" selected="@(currentType == "Leave" ? "selected" : null)">@RequestResource.Filter_LeaveOnly</option>
                        <option value="Attendance" selected="@(currentType == "Attendance" ? "selected" : null)">@RequestResource.AttendanceAdjustment</option>
                    </select>
                </div>
            </div>

            <!-- Date Range -->
            <div class="col-lg-3 col-md-6">
                <div class="input-group input-group-sm position-relative">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar-range text-muted"></i></span>
                    <input type="text" class="form-control bg-light border-start-0 ps-0 cursor-pointer" id="dateRangePicker" value="@ViewBag.StartDate ~ @ViewBag.EndDate" readonly>
                </div>
            </div>

            <!-- Reset Filter Button -->
            <div class="col-lg-2 col-md-6 d-flex align-items-center justify-content-lg-end">
                @if (currentStatus.HasValue || !string.IsNullOrEmpty(currentType))
                {
                    <a href="?start=@ViewBag.StartDate&end=@ViewBag.EndDate" class="btn btn-outline-secondary btn-sm w-100 d-flex align-items-center justify-content-center gap-1 shadow-xs" title="@RequestResource.Filter_ResetTitle">
                        <i class="bi bi-arrow-counterclockwise"></i> @RequestResource.Filter_Reset
                    </a>
                }
                else
                {
                    <div class="text-muted small py-1 px-2 text-center w-100">
                        <i class="bi bi-check2-all text-primary me-1"></i> @RequestResource.Filter_AllStatuses
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Master-Detail Content Area -->
    <div class="row g-4">
        <!-- Master List (Left Column) -->
        <div class="col-lg-5 col-md-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white border-bottom py-3 px-3 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold text-dark fs-6">@RequestResource.List_Title</span>
                        <span class="badge bg-light text-muted border ms-2" id="filteredCountBadge">@totalFiltered</span>
                    </div>
                    <div class="form-check text-muted small mb-0">
                        <input class="form-check-input" type="checkbox" id="selectAll">
                        <label class="form-check-label cursor-pointer" for="selectAll">@RequestResource.SelectMultiple</label>
                    </div>
                </div>

                <div class="card-body p-3 master-list-container" id="requestCardsList">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="text-center text-muted py-5">
                            <div class="mb-3 text-secondary opacity-50"><i class="bi bi-inbox fs-1"></i></div>
                            <h6 class="text-dark">@RequestResource.NoData</h6>
                            <p class="small text-muted mb-0">@RequestResource.List_EmptyDesc</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <!-- Item Card -->
                            <div class="card request-card border rounded-3 mb-3 p-3 position-relative" data-id="@item.Id" data-type="@item.RequestType">
                                @if (item.Status == RegistrationStatus.Pending)
                                {
                                    bool isItemSelf = item.RequesterUsername == User.Identity?.Name;
                                    bool isItemManagement = item.RequesterRole == AccountRole.StoreManager || item.RequesterRole == AccountRole.HR;
                                    bool canUserBulkApprove = false;

                                    if (!isItemSelf)
                                    {
                                        if (item.RequestType == "Attendance")
                                        {
                                            if (isItemManagement)
                                            {
                                                canUserBulkApprove = (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"));
                                            }
                                            else
                                            {
                                                canUserBulkApprove = (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("HR") ||
                                                    (User.IsInRole("StoreManager") && item.StoreId == (ViewBag.CurrentUserStoreId ?? 0)));
                                            }
                                        }
                                        else
                                        {
                                            canUserBulkApprove = ViewBag.IsManager;
                                        }
                                    }

                                    if (canUserBulkApprove)
                                    {
                                        <div class="form-check position-absolute top-0 end-0 m-3 z-2">
                                            <input class="form-check-input request-checkbox" type="checkbox" value="@item.Id" data-type="@item.RequestType">
                                        </div>
                                    }
                                }

                                <!-- Card Header: Type Badge & Status Badge -->
                                <div class="d-flex align-items-center justify-content-between mb-2 pe-4">
                                    @if (item.RequestType == "ShiftSwap")
                                    {
                                        <span class="badge rounded-pill bg-purple-subtle text-purple border border-purple-subtle px-2 py-1 small">
                                            <i class="bi bi-arrow-left-right me-1"></i>@RequestResource.ShiftSwap
                                        </span>
                                    }
                                    else if (item.RequestType == "Leave")
                                    {
                                        <span class="badge rounded-pill bg-teal-subtle text-teal border border-teal-subtle px-2 py-1 small">
                                            <i class="bi bi-calendar2-minus me-1"></i>@RequestResource.LeaveRequest
                                        </span>
                                    }
                                    else if (item.RequestType == "Attendance")
                                    {
                                        <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 small">
                                            <i class="bi bi-clock-history me-1"></i>@RequestResource.AttendanceAdjustment
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small">
                                            <i class="bi bi-calendar-plus me-1"></i>@RequestResource.ShiftRegistration
                                        </span>
                                    }

                                    <!-- Status Badge -->
                                    @if (item.Status == RegistrationStatus.Pending)
                                    {
                                        <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 small">
                                            <i class="bi bi-hourglass-split me-1"></i>@SharedResource.Req_Pending
                                        </span>
                                    }
                                    else if (item.Status == RegistrationStatus.Approved)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                                            <i class="bi bi-check-circle-fill me-1"></i>@RequestResource.Status_Approved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 small">
                                            <i class="bi bi-x-circle-fill me-1"></i>@RequestResource.Status_Rejected
                                        </span>
                                    }
                                </div>

                                <!-- Card Title & Shift/Leave info -->
                                <div class="mb-2">
                                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.93rem;">
                                        @if (item.RequestType == "Leave")
                                        {
                                            <span>@item.ShiftName</span>
                                        }
                                        else
                                        {
                                            <span>@item.ShiftName</span>
                                        }
                                    </div>
                                    <div class="small text-muted mt-1">
                                        <i class="bi bi-calendar-event me-1"></i>@RequestResource.Date: <strong class="text-dark">@item.WorkDateStr</strong>
                                    </div>
                                </div>

                                @if (item.RequestType == "ShiftSwap" && !string.IsNullOrEmpty(item.SwapSummary))
                                {
                                    <div class="small p-2 bg-light rounded-2 text-primary text-truncate mb-2 border border-light-subtle">
                                        <i class="bi bi-arrow-right-circle me-1"></i>@item.SwapSummary
                                    </div>
                                }
                                else if (item.RequestType == "Attendance" && !string.IsNullOrEmpty(item.AdjustmentSummary))
                                {
                                    <div class="small p-2 bg-light rounded-2 text-warning-emphasis text-truncate mb-2 border border-light-subtle">
                                        <i class="bi bi-clock me-1"></i>@item.AdjustmentSummary
                                    </div>
                                }

                                <!-- Card Footer: Creator & Timestamp -->
                                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center">
                                            @((item.EmployeeName ?? "U").Substring(0, 1).ToUpper())
                                        </div>
                                        <span class="small fw-semibold text-dark text-truncate" style="max-width: 140px;">@item.EmployeeName</span>
                                    </div>
                                    <div class="text-muted small" style="font-size: 0.75rem;">
                                        <i class="bi bi-clock me-1"></i>@item.CreatedDateStr
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                @if (ViewBag.Pagination is RWPM.Common.Models.PaginationRes pagination)
                {
                    <div class="card-footer bg-white border-top px-3 pt-0 request-pagination">
                        @await Html.PartialAsync("_PaginationPartial", pagination)
                    </div>
                }
            </div>
        </div>

        <!-- Detail View & Bulk Actions (Right Column) -->
        <div class="col-lg-7 col-md-12">
            <!-- Single Request Detail Pane -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden detail-card" id="requestDetailPane" style="display: none;">
                <!-- Action Header -->
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">@RequestResource.Detail_RequestCode:</span>
                        <strong class="text-dark fs-6" id="detailCode"></strong>
                    </div>

                    <div class="d-flex align-items-center gap-2" id="detailActionButtonsContainer">
                        <button type="button" class="btn btn-success btn-sm px-4 py-2 fw-semibold shadow-xs action-btn-detail" id="btnApproveDetail" onclick="updateSelectedStatus(1)" style="display: none;">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>@RequestResource.Approve</span>
                        </button>
                        <button type="button" class="btn btn-danger btn-sm px-4 py-2 fw-semibold shadow-xs action-btn-detail" id="btnRejectDetail" onclick="updateSelectedStatus(2)" style="display: none;">
                            <i class="bi bi-x-circle-fill"></i>
                            <span>@RequestResource.Reject</span>
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-sm px-3 py-2 fw-semibold shadow-xs action-btn-detail" id="btnDeleteDetail" onclick="deleteSelectedRequest()" style="display: none;">
                            <i class="bi bi-trash3"></i>
                            <span>@RequestResource.Delete</span>
                        </button>
                    </div>
                </div>

                <div class="card-body p-4 detail-content-scroll">
                    <!-- Notice alert for permissions -->
                    <div id="requestApprovalNotice" class="alert alert-warning py-2 px-3 small mb-3 align-items-center rounded-3 border-warning-subtle" style="display: none;"></div>

                    <!-- Status Result Banner (Shown when Approved or Rejected) -->
                    <div id="detailResultBanner" class="mb-4" style="display: none;"></div>

                    <!-- Header Title & Type -->
                    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                        <div>
                            <h4 class="fw-bold text-dark mb-1" id="detailTypeName">@RequestResource.ShiftRegistration</h4>
                            <div class="text-muted small">@RequestResource.Detail_SentAt: <span id="detailCreatedDate" class="text-dark fw-medium"></span></div>
                        </div>
                        <div id="detailStatusBadgeContainer">
                            <div id="detailStatus"></div>
                        </div>
                    </div>

                    <!-- Creator Information Card -->
                    <div class="card bg-light border-0 rounded-3 p-3 mb-4">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <span class="text-muted small d-block mb-1"><i class="bi bi-person me-1"></i>@RequestResource.Creator:</span>
                                <strong class="text-dark fs-6" id="detailEmployeeName"></strong>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted small d-block mb-1"><i class="bi bi-building me-1"></i>@RequestResource.Department:</span>
                                <strong class="text-dark fs-6">@SharedResource.Req_HR</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Work / Shift Details Section -->
                    <div class="mb-4">
                        <h6 class="text-uppercase small fw-bold text-muted mb-3">@RequestResource.Detail_ContentTitle</h6>
                        <div class="row g-3 p-3 bg-white border rounded-3 mb-3">
                            <div class="col-sm-6">
                                <span class="text-muted small d-block mb-1" id="detailShiftLabel">@RequestResource.Shift:</span>
                                <strong class="text-dark" id="detailShiftName"></strong>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted small d-block mb-1"><i class="bi bi-calendar-event me-1"></i>@RequestResource.Date:</span>
                                <strong class="text-dark" id="detailWorkDate"></strong>
                            </div>
                        </div>

                        <!-- Specialized: Shift Swap Info -->
                        <div class="row mb-3" id="detailSwapTargetRow" style="display: none;">
                            <div class="col-12">
                                <div class="p-3 bg-purple-subtle rounded-3 border border-purple-subtle">
                                    <div class="text-purple small fw-bold mb-2">
                                        <i class="bi bi-arrow-left-right me-1"></i> @RequestResource.Swap_TargetShiftInfo
                                    </div>
                                    <div class="text-dark fw-bold" id="detailSwapSummary"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Specialized: Leave Request Info -->
                        <div class="row mb-3" id="detailLeaveInfoRow" style="display: none;">
                            <div class="col-12">
                                <div class="p-3 bg-teal-subtle rounded-3 border border-teal-subtle">
                                    <div class="text-teal small fw-bold mb-2">
                                        <i class="bi bi-calendar2-minus me-1"></i> @RequestResource.LeaveRequest
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div class="text-dark fw-bold" id="detailLeaveTypeDesc"></div>
                                        <div class="badge bg-white text-teal border border-teal-subtle p-2 fs-7" id="detailLeaveBalanceBadge"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Specialized: Attendance Adjustment Info -->
                        <div class="row mb-3" id="detailAttendanceRow" style="display: none;">
                            <div class="col-12">
                                <div class="p-3 bg-warning-subtle rounded-3 border border-warning-subtle">
                                    <div class="text-warning-emphasis small fw-bold mb-2">
                                        <i class="bi bi-clock-history me-1"></i> @RequestResource.Detail_AttendanceTitle
                                    </div>
                                    <div id="detailAttendanceSummary"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Employee Reason / Note -->
                        <div class="p-3 bg-light rounded-3 border mb-3">
                            <span class="text-muted small d-block mb-1"><i class="bi bi-chat-left-text me-1"></i>@RequestResource.Detail_EmployeeNote:</span>
                            <div class="text-dark" id="detailNote">-</div>
                        </div>
                    </div>

                    <!-- Rejection Reason if any -->
                    <div id="detailRejectionRow" class="alert alert-danger p-3 mb-4 rounded-3 border-danger-subtle" style="display: none;">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger mt-1"></i>
                            <div>
                                <strong class="d-block mb-1">@RequestResource.RejectReasonTitle:</strong>
                                <span id="detailRejectionReason" class="text-dark"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Approver Audit Trail -->
                    <div id="detailApproverRow" class="p-3 bg-light rounded-3 text-muted small d-flex align-items-center gap-2" style="display: none;">
                        <i class="bi bi-person-check fs-5 text-success"></i>
                        <span>@RequestResource.Detail_Reviewer: <strong id="detailApprover" class="text-dark"></strong></span>
                        <span id="detailApprovedAt" class="ms-1"></span>
                    </div>
                </div>
            </div>

            <!-- Bulk Action Pane -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden" id="bulkActionPane" style="display: none;">
                <div class="d-flex flex-column justify-content-center align-items-center h-100 bg-light p-5 text-center" style="min-height: 480px;">
                    <div class="mb-4">
                        <div class="avatar-lg bg-primary text-white rounded-circle d-flex align-items-center justify-content-center p-3 shadow-sm mx-auto" style="width: 72px; height: 72px;">
                            <i class="bi bi-layers-fill fs-2"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">@RequestResource.CurrentlySelecting <span id="bulkSelectedCount" class="text-primary">0</span> @RequestResource.Requests</h4>
                    <p class="text-muted mb-4" style="max-width: 420px;">@RequestResource.BulkActionDesc</p>
                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        @if (ViewBag.IsManager)
                        {
                            <button class="btn btn-success px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-xs" onclick="updateBulkStatus(1)">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>@RequestResource.ApproveAll</span>
                            </button>
                            <button class="btn btn-outline-danger px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-xs" onclick="updateBulkStatus(2)">
                                <i class="bi bi-x-circle-fill"></i>
                                <span>@RequestResource.RejectAll</span>
                            </button>
                        }
                    </div>
                </div>
            </div>

