        function exportRequestsToCSV() {
            if (!requestsExportData || requestsExportData.length === 0) {
                AppToast.warning(@Json.Serialize(RequestResource.Export_NoData));
                return;
            }

            var csvRows = [];
            var csvHeaders = [@Json.Serialize(RequestResource.Code), @Json.Serialize(RequestResource.Export_ColType), @Json.Serialize(RequestResource.Export_ColSender), @Json.Serialize(RequestResource.Export_ColBranch), @Json.Serialize(RequestResource.Export_ColShiftContent), @Json.Serialize(RequestResource.Appr_WorkDate), @Json.Serialize(RequestResource.Export_ColCreatedDate), @Json.Serialize(RequestResource.Status), @Json.Serialize(RequestResource.Export_ColApprover), @Json.Serialize(RequestResource.RejectReasonTitle), @Json.Serialize(SharedResource.Req_Note)];
            csvRows.push(csvHeaders.map(function(h) { return '"' + String(h).replace(/"/g, '""') + '"'; }).join(','));

            requestsExportData.forEach(function(r) {
                var statusStr = r.status === 1 ? reqI18n.approved : (r.status === 2 ? reqI18n.rejected : reqI18n.pending);
                var row = [
                    `"${(r.code || '').replace(/"/g, '""')}"`,
                    `"${(r.requestTypeName || '').replace(/"/g, '""')}"`,
                    `"${(r.employeeName || '').replace(/"/g, '""')}"`,
                    `"${(r.storeName || '').replace(/"/g, '""')}"`,
                    `"${(r.shiftName || '').replace(/"/g, '""')}"`,
                    `"${(r.workDateStr || '').replace(/"/g, '""')}"`,
                    `"${(r.createdDateStr || '').replace(/"/g, '""')}"`,
                    `"${statusStr.replace(/"/g, '""')}"`,
                    `"${(r.approvedBy || '').replace(/"/g, '""')}"`,
                    `"${(r.rejectionReason || '').replace(/"/g, '""')}"`,
                    `"${(r.note || '').replace(/"/g, '""')}"`
                ];
                csvRows.push(row.join(','));
            });

            var csvContent = '\uFEFF' + csvRows.join('\r\n');
            var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            var now = new Date();
            var dateStr = now.getFullYear() + (now.getMonth() + 1).toString().padStart(2, '0') + now.getDate().toString().padStart(2, '0');
            a.href = url;
            a.download = @Json.Serialize(RequestResource.Export_FileName) + '_' + dateStr + '.csv';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);

            AppToast.success(@Json.Serialize(RequestResource.Export_Success));
        }

        function escapeHtml(str) {
            if (!str) return '';
            return $('<div>').text(str).html();
        }
    </script>
