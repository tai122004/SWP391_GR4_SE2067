               color: var(--app-text-2); text-decoration: none; font-weight: 500; white-space: nowrap; }
    .req-tab:hover { color: var(--app-text); }
    .req-tab.active { color: var(--app-blue); border-bottom-color: var(--app-blue); }
    .req-tab-count { display: inline-flex; align-items: center; justify-content: center; min-width: 22px; height: 20px; padding: 0 6px;
