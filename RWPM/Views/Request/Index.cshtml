                    <!-- Chọn hình thức đổi ca -->
                    <div class="mb-3">
                        <label class="form-label text-dark fw-bold small">@RequestResource.Swap_SwapType</label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="swapType" id="swapTypePeer" value="peer" checked>
                                <label class="form-check-label small" for="swapTypePeer">@RequestResource.Swap_WithCoworker</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="swapType" id="swapTypeDirect" value="direct">
                                <label class="form-check-label small" for="swapTypeDirect">@RequestResource.Swap_DirectChange</label>
                            </div>
                        </div>
                    </div>

                    <!-- Nhánh 1: Đổi với đồng nghiệp -->
                    <div id="swapPeerSection">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label text-dark fw-bold small">@RequestResource.Swap_SelectCoworker <span class="text-danger">*</span></label>
                                <select class="form-select form-select-sm" id="swapTargetEmployeeId">
                                    <option value="">@RequestResource.Swap_SelectCoworkerPrompt</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-dark fw-bold small">@RequestResource.Swap_CoworkerShift <span class="text-danger">*</span></label>
                                <select class="form-select form-select-sm" id="swapTargetRegistrationId">
                                    <option value="">@RequestResource.Swap_SelectCoworkerShiftPrompt</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Nhánh 2: Đổi sang ngày / ca khác của chính mình -->
                    <div id="swapDirectSection" style="display: none;">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label text-dark fw-bold small">@RequestResource.Swap_NewDate <span class="text-danger">*</span></label>
                                <input type="date" class="form-control form-control-sm" id="swapTargetWorkDate">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-dark fw-bold small">@RequestResource.Swap_NewShift <span class="text-danger">*</span></label>
                                <select class="form-select form-select-sm" id="swapTargetShiftId">
                                    <option value="">@SharedResource.Req_SelectShift</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Lý do đổi ca -->
                    <div class="mb-4">
                        <label class="form-label text-dark fw-bold small">@RequestResource.Swap_Reason <span class="text-danger">*</span></label>
                        <textarea class="form-control form-control-sm" id="swapReason" rows="2" required placeholder="@RequestResource.Swap_ReasonPlaceholder"></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">@SharedResource.Button_Cancel</button>
                        <button type="submit" id="btnSubmitSwap" class="btn btn-sm btn-primary px-4 fw-semibold">
                            <i class="bi bi-send me-1"></i> @SharedResource.Req_CreateNew
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

