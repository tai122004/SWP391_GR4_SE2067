@using RWPM.Common.Enums
@using RWPM.Resources.Shared
@using RWPM.Models.ViewModels.ShiftRegistration
@model List<RequestItemVM>

@{
    ViewData["Title"] = RequestResource.RequestsAndApprovals;
    var currentStatus = ViewBag.CurrentStatus as int?;
    var currentType = ViewBag.CurrentType as string;
    int pendingCount = ViewBag.PendingCount ?? 0;
    int approvedCount = ViewBag.ApprovedCount ?? 0;
    int rejectedCount = ViewBag.RejectedCount ?? 0;
    int totalCount = pendingCount + approvedCount + rejectedCount;
    var searchQuery = ViewBag.SearchQuery as string;
    var searchSuffix = string.IsNullOrEmpty(searchQuery) ? "" : "&q=" + Uri.EscapeDataString(searchQuery);
    int totalFiltered = ViewBag.TotalFiltered ?? (Model?.Count ?? 0);
    bool hasActiveFilter = currentStatus.HasValue || !string.IsNullOrEmpty(currentType);

    string TabUrl(int? s) => "?" + (s.HasValue ? "status=" + s.Value + "&" : "") + "type=" + Uri.EscapeDataString(currentType ?? "")
        + "&start=" + ViewBag.StartDate + "&end=" + ViewBag.EndDate + searchSuffix;

    string Initials(string? name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        var first = parts[0].Substring(0, 1);
        var last = parts.Length > 1 ? parts[^1].Substring(0, 1) : "";
        return (first + last).ToUpperInvariant();
    }
}

<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div class="container-fluid px-0 request-management-page">
    <!-- Header -->
    <div class="app-page-header">
        <div>
            <h4>@RequestResource.RequestsAndApprovals</h4>
            <p class="text-muted">@RequestResource.Page_Subtitle</p>
        </div>
        <div class="app-page-actions">
            <button type="button" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-2" onclick="exportRequestsToCSV()">
                <i class="bi bi-download"></i>
                <span>@RequestResource.ExportFile</span>
            </button>
            <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#createRequestModal">
                <i class="bi bi-plus-lg"></i>
                <span>@RequestResource.CreateRequest</span>
            </button>
        </div>
    </div>

    <!-- Status tabs (underline) with counts -->
    <nav class="req-tabs" aria-label="@RequestResource.Status">
        <a href="@TabUrl(null)" class="req-tab @(!currentStatus.HasValue ? "active" : "")" aria-current="@(!currentStatus.HasValue ? "page" : null)">
            @RequestResource.All <span class="req-tab-count">@totalCount</span>
        </a>
        <a href="@TabUrl(0)" class="req-tab @(currentStatus == 0 ? "active" : "")" aria-current="@(currentStatus == 0 ? "page" : null)">
            @RequestResource.Tab_Pending <span class="req-tab-count">@pendingCount</span>
        </a>
        <a href="@TabUrl(1)" class="req-tab @(currentStatus == 1 ? "active" : "")" aria-current="@(currentStatus == 1 ? "page" : null)">
            @RequestResource.Tab_Approved <span class="req-tab-count">@approvedCount</span>
        </a>
        <a href="@TabUrl(2)" class="req-tab @(currentStatus == 2 ? "active" : "")" aria-current="@(currentStatus == 2 ? "page" : null)">
            @RequestResource.Tab_Rejected <span class="req-tab-count">@rejectedCount</span>
        </a>
    </nav>

    <!-- One-row filter bar -->
    <div class="app-filter-panel req-filter-bar">
        <div class="req-filter-search">
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" id="requestSearchInput" class="form-control" placeholder="@RequestResource.Filter_SearchPlaceholder" value="@searchQuery" title="@RequestResource.Filter_SearchEnterHint" aria-label="@RequestResource.Filter_SearchPlaceholder">
            </div>
        </div>
        <div class="req-filter-type">
            <select id="filterTypeSelect" class="form-select form-select-sm" onchange="onTypeFilterChange(this.value)" aria-label="@RequestResource.Export_ColType">
                <option value="" selected="@(string.IsNullOrEmpty(currentType) ? "selected" : null)">@RequestResource.Filter_AllTypes</option>
                <option value="ShiftReg" selected="@(currentType == "ShiftReg" ? "selected" : null)">@RequestResource.ShiftRegistration</option>
                <option value="ShiftSwap" selected="@(currentType == "ShiftSwap" ? "selected" : null)">@RequestResource.Filter_ShiftSwapOnly</option>
                <option value="Leave" selected="@(currentType == "Leave" ? "selected" : null)">@RequestResource.Filter_LeaveOnly</option>
                <option value="Attendance" selected="@(currentType == "Attendance" ? "selected" : null)">@RequestResource.AttendanceAdjustment</option>
            </select>
        </div>
        <div class="req-filter-date">
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-calendar-range"></i></span>
                <input type="text" class="form-control cursor-pointer" id="dateRangePicker" value="@ViewBag.StartDate ~ @ViewBag.EndDate" readonly aria-label="@RequestResource.ByDateSent">
            </div>
        </div>
        @if (hasActiveFilter)
        {
            <a href="?start=@ViewBag.StartDate&end=@ViewBag.EndDate" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 ms-lg-auto" title="@RequestResource.Filter_ResetTitle">
                <i class="bi bi-arrow-counterclockwise"></i> @RequestResource.Filter_Reset
            </a>
        }
    </div>

    <!-- Two columns: list + detail -->
    <div class="row g-3 align-items-start">
        <!-- Left: compact request list -->
        <div class="col-lg-5 col-md-12">
            <div class="app-content-card">
                <div class="req-list-header">
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" id="selectAll">
                        <label class="form-check-label cursor-pointer" for="selectAll">@RequestResource.SelectMultiple</label>
                    </div>
                    <div class="text-muted small">@RequestResource.List_Title <span class="app-badge app-badge-neutral ms-1" id="filteredCountBadge">@totalFiltered</span></div>
                </div>

                <!-- Bulk action bar: shown when at least one row is checked -->
                <div class="req-bulk-bar" id="bulkActionBar" style="display: none;">
                    <span class="fw-medium" id="bulkSelectedText">@string.Format(RequestResource.Bulk_SelectedCount, 0)</span>
                    <span class="d-none" id="bulkSelectedCount">0</span>
                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="clearBulkSelection()">@RequestResource.Bulk_Clear</button>
                    @if (ViewBag.IsManager)
                    {
                        <div class="ms-auto d-flex gap-2">
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="updateBulkStatus(2)">@RequestResource.RejectAll</button>
                            <button type="button" class="btn btn-primary btn-sm" onclick="updateBulkStatus(1)">@RequestResource.ApproveAll</button>
                        </div>
                    }
                </div>

                <div class="master-list-container" id="requestCardsList">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="text-center text-muted py-5 px-3">
                            <div class="mb-2"><i class="bi bi-inbox fs-2"></i></div>
                            <div class="fw-medium text-dark">@RequestResource.NoData</div>
                            <p class="small mb-0">@RequestResource.List_EmptyDesc</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            bool canUserBulkApprove = false;
                            if (item.Status == RegistrationStatus.Pending)
                            {
                                bool isItemSelf = item.RequesterUsername == User.Identity?.Name;
                                bool isItemManagement = item.RequesterRole == AccountRole.StoreManager || item.RequesterRole == AccountRole.HR;

                                if (!isItemSelf)
                                {
                                    if (item.RequestType == "Attendance")
                                    {
                                        if (isItemManagement)
                                        {
                                            canUserBulkApprove = User.IsAdmin();
                                        }
                                        else
                                        {
                                            canUserBulkApprove = User.IsChainManager() ||
                                                (User.IsStoreManager() && item.StoreId == (ViewBag.CurrentUserStoreId ?? 0));
                                        }
                                    }
                                    else
                                    {
                                        canUserBulkApprove = ViewBag.IsManager;
                                    }
                                }
                            }

                            string summary = item.RequestType switch
                            {
                                "Attendance" => item.WorkDateStr + (string.IsNullOrEmpty(item.AdjustmentSummary) ? "" : " · " + item.AdjustmentSummary),
                                _ => (string.IsNullOrEmpty(item.ShiftName) ? "" : item.ShiftName + " · ") + item.WorkDateStr
                            };

                            <div class="request-card req-row" data-id="@item.Id" data-type="@item.RequestType" tabindex="0">
                                <span class="req-row-check">
                                    @if (canUserBulkApprove)
                                    {
                                        <input class="form-check-input request-checkbox" type="checkbox" value="@item.Id" data-type="@item.RequestType" aria-label="@RequestResource.SelectMultiple">
                                    }
                                </span>
                                <span class="avatar-initials req-avatar" aria-hidden="true">@Initials(item.EmployeeName)</span>
                                <div class="req-row-main">
                                    <div class="req-row-top">
                                        <span class="req-row-name text-truncate">@item.EmployeeName</span>
                                        <span class="req-row-time">@item.CreatedDateStr</span>
                                    </div>
                                    <div class="req-row-sub text-truncate">
                                        <span class="text-dark">@item.RequestTypeName</span> · @summary
                                    </div>
                                </div>
                                @if (item.Status == RegistrationStatus.Pending)
                                {
                                    <span class="app-badge app-badge-warning">@RequestResource.Tab_Pending</span>
                                }
                                else if (item.Status == RegistrationStatus.Approved)
                                {
                                    <span class="app-badge app-badge-success">@RequestResource.Tab_Approved</span>
                                }
                                else
                                {
                                    <span class="app-badge app-badge-danger">@RequestResource.Tab_Rejected</span>
                                }
                            </div>
                        }
                    }
                </div>
                @if (ViewBag.Pagination is RWPM.Common.Models.PaginationRes pagination)
                {
                    <div class="border-top px-3 request-pagination">
                        @await Html.PartialAsync("_PaginationPartial", pagination)
                    </div>
                }
            </div>
        </div>

        <!-- Right: detail panel -->
        <div class="col-lg-7 col-md-12 req-detail-col">
            <div class="app-content-card detail-card" id="requestDetailPane" style="display: none;">
                <div class="req-detail-header">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="text-muted small">@RequestResource.Detail_RequestCode</span>
                        <strong class="text-dark" id="detailCode"></strong>
                        <span id="detailStatusBadgeContainer"><span id="detailStatus"></span></span>
                    </div>
                    <div class="text-muted small">@RequestResource.Detail_SentAt: <span id="detailCreatedDate" class="text-dark"></span></div>
                </div>

                <div class="req-detail-body detail-content-scroll">
                    <h5 class="mb-3" id="detailTypeName">@RequestResource.ShiftRegistration</h5>

                    <!-- Notice for permissions -->
                    <div id="requestApprovalNotice" class="alert alert-warning py-2 px-3 small mb-3" style="display: none;"></div>

                    <dl class="req-dl">
                        <div class="req-dl-row">
                            <dt>@SharedResource.Req_Employee</dt>
                            <dd id="detailEmployeeName"></dd>
                        </div>
                        <div class="req-dl-row">
                            <dt>@RequestResource.Export_ColBranch</dt>
                            <dd id="detailStoreName"></dd>
                        </div>
                        <div class="req-dl-row">
                            <dt id="detailShiftLabel">@RequestResource.Shift</dt>
                            <dd id="detailShiftName"></dd>
                        </div>
                        <div class="req-dl-row">
                            <dt>@RequestResource.Date</dt>
                            <dd id="detailWorkDate"></dd>
                        </div>
                        <div class="req-dl-row" id="detailSwapTargetRow" style="display: none;">
                            <dt>@RequestResource.Detail_SwapTo</dt>
                            <dd id="detailSwapSummary"></dd>
                        </div>
                        <div class="req-dl-row detail-leave-row" style="display: none;">
                            <dt>@RequestResource.Leave_Type</dt>
                            <dd id="detailLeaveTypeDesc"></dd>
                        </div>
                        <div class="req-dl-row detail-leave-row" style="display: none;">
                            <dt>@RequestResource.Leave_AnnualLeaveBalance</dt>
                            <dd id="detailLeaveBalanceBadge"></dd>
                        </div>
                        <div class="req-dl-row detail-att-row" style="display: none;">
                            <dt>@RequestResource.Appr_OriginalTime</dt>
                            <dd class="tabular" id="detailAttOriginal"></dd>
                        </div>
                        <div class="req-dl-row detail-att-row" style="display: none;">
                            <dt>@RequestResource.Detail_ProposedTime</dt>
                            <dd class="tabular fw-medium" id="detailAttProposed"></dd>
                        </div>
                        <div class="req-dl-row">
                            <dt>@RequestResource.Detail_EmployeeNote</dt>
                            <dd id="detailNote">-</dd>
                        </div>
                    </dl>

                    <!-- Warnings before approval (from the same checks the approve endpoint uses) -->
                    <div class="req-warn-box" id="detailWarningsBox" style="display: none;">
                        <div class="req-warn-title"><i class="bi bi-exclamation-triangle me-1"></i>@RequestResource.Detail_WarningsTitle</div>
                        <ul class="mb-0 ps-3" id="detailWarningsList"></ul>
                    </div>

                    <!-- Decision (pending + allowed to approve) -->
                    <div id="detailDecisionArea" style="display: none;">
                        <label for="detailApproverNote" class="form-label">@RequestResource.Detail_ApproverNote</label>
                        <textarea class="form-control" id="detailApproverNote" rows="2" placeholder="@RequestResource.Detail_ApproverNotePlaceholder"></textarea>
                        <div class="form-text">@RequestResource.Detail_ApproverNoteHint</div>
                    </div>

                    <!-- Result (processed requests): who / when / reason -->
                    <div id="detailResultBanner" style="display: none;"></div>
                </div>

                <div class="req-detail-footer" id="detailActionButtonsContainer" style="display: none;">
                    <button type="button" class="btn btn-outline-danger btn-sm action-btn-detail me-auto" id="btnDeleteDetail" onclick="deleteSelectedRequest()" style="display: none;">
                        <i class="bi bi-trash3"></i>
                        <span>@RequestResource.Delete</span>
                    </button>
                    <button type="button" class="btn btn-outline-danger action-btn-detail" id="btnRejectDetail" onclick="updateSelectedStatus(2)" style="display: none;">
                        <span>@RequestResource.Reject</span>
                    </button>
                    <button type="button" class="btn btn-primary action-btn-detail" id="btnApproveDetail" onclick="updateSelectedStatus(1)" style="display: none;">
                        <i class="bi bi-check2"></i>
                        <span>@RequestResource.Approve</span>
                    </button>
                </div>
            </div>

            <!-- Empty detail state (no request selected yet) -->
            <div class="app-content-card" id="emptyDetailPane">
                <div class="d-flex flex-column justify-content-center align-items-center p-5 text-center" style="min-height: 360px;">
                    <div class="text-muted mb-2"><i class="bi bi-card-text fs-2"></i></div>
                    <div class="fw-medium text-dark">@RequestResource.Empty_Title</div>
                    <p class="text-muted small mb-0">@RequestResource.Empty_Desc</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- All Required Modals -->

<!-- Modal 1: Tạo Mới Yêu Cầu (Chọn loại) -->
<div class="modal fade" id="createRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@SharedResource.Req_CreateReq</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedResource.Button_Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-4">
                    <div class="req-modal-group">@SharedResource.Req_AttendanceRecord</div>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <div class="request-type-card disabled-card">
                                <i class="bi bi-briefcase"></i>
                                <span>@SharedResource.Req_BusinessTrip</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="request-type-card disabled-card">
                                <i class="bi bi-person-clock"></i>
                                <span>@SharedResource.Req_LateEarly</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="request-type-card active-card-btn" role="button" tabindex="0" onclick="openLeaveModal()">
                                <i class="bi bi-calendar2-minus"></i>
                                <span>@SharedResource.Req_Leave</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="request-type-card disabled-card">
                                <i class="bi bi-stopwatch"></i>
                                <span>@SharedResource.Req_Overtime</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="req-modal-group">@SharedResource.Req_Shift</div>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <div class="request-type-card active-card-btn" role="button" tabindex="0" onclick="openAttendanceModal()">
                                <i class="bi bi-clock-history"></i>
                                <span>@SharedResource.Req_ChangeInOut</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="request-type-card disabled-card">
                                <i class="bi bi-cup-hot"></i>
                                <span>@SharedResource.Req_Meal</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="request-type-card active-card-btn" role="button" tabindex="0" onclick="openShiftModal()">
                                <i class="bi bi-calendar-plus"></i>
                                <span>@SharedResource.Req_ShiftReg</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="request-type-card active-card-btn" role="button" tabindex="0" onclick="openSwapModal()">
                                <i class="bi bi-arrow-left-right"></i>
                                <span>@SharedResource.Req_ChangeShift</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div>
                    <div class="req-modal-group">@SharedResource.Req_Finance</div>
                    <div class="row g-2">
                        <div class="col-md-4"><div class="request-type-card disabled-card"><i class="bi bi-cash-stack"></i><span>@SharedResource.Req_SalaryAdv</span></div></div>
                        <div class="col-md-4"><div class="request-type-card disabled-card"><i class="bi bi-receipt"></i><span>@SharedResource.Req_ExpensePay</span></div></div>
                        <div class="col-md-4"><div class="request-type-card disabled-card"><i class="bi bi-cart"></i><span>@SharedResource.Req_Purchase</span></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal 2: Đăng Ký Ca Làm (Nested) -->
<div class="modal fade" id="createShiftRequestModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@SharedResource.Req_ShiftReg</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedResource.Button_Close"></button>
            </div>
            <form id="shiftRequestForm">
                <div class="modal-body p-4">
                    @if (ViewBag.IsManager)
                    {
                        <div class="mb-3">
                            <label class="form-label required" for="reqEmployeeId">@SharedResource.Req_Employee</label>
                            <select class="form-select form-select-sm" id="reqEmployeeId" required>
                                <option value="">@SharedResource.Req_SelectEmployee</option>
                                @if (ViewBag.Employees != null)
                                {
                                    foreach (var emp in ViewBag.Employees)
                                    {
                                        <option value="@emp.EmployeeId">@emp.EmployeeCode - @(emp.Account?.FullName ?? emp.Username)</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" id="reqEmployeeId" value="0" />
                    }

                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label required" for="reqWorkDate">@SharedResource.Req_Date</label>
                            <input type="date" class="form-control form-control-sm" id="reqWorkDate" required>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label required" for="reqShiftId">@SharedResource.Req_SelectShift</label>
                            <select class="form-select form-select-sm" id="reqShiftId" required>
                                <option value="">@SharedResource.Req_SelectShift</option>
                                @if (ViewBag.Shifts != null)
                                {
                                    foreach (var shift in ViewBag.Shifts)
                                    {
                                        <option value="@shift.ShiftId">@shift.ShiftName (@shift.StartTime.ToString(@"hh\:mm") - @shift.EndTime.ToString(@"hh\:mm"))</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="form-label" for="reqNote">@SharedResource.Req_Note</label>
                        <textarea class="form-control form-control-sm" id="reqNote" rows="2" placeholder="@SharedResource.Req_Reason"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">@SharedResource.Button_Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-send me-1"></i> @SharedResource.Req_CreateNew
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 3: Đổi Ca Làm (Nested) -->
<div class="modal fade" id="createSwapShiftModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@RequestResource.ShiftSwap</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedResource.Button_Close"></button>
            </div>
            <form id="swapShiftForm">
                <div class="modal-body p-4">
                    <div class="alert alert-warning py-2 small mb-3 d-none" id="swapNoShiftsAlert">
                        <i class="bi bi-exclamation-triangle me-1"></i> @RequestResource.Swap_NoEligibleShifts
                    </div>

                    <!-- Chọn ca của tôi -->
                    <div class="mb-3">
                        <label class="form-label required" for="swapSourceRegistrationId">@RequestResource.Swap_SourceShift</label>
                        <select class="form-select form-select-sm" id="swapSourceRegistrationId" required>
                            <option value="">@RequestResource.Swap_SelectSourcePrompt</option>
                        </select>
                    </div>

                    <!-- Chọn hình thức đổi ca -->
                    <div class="mb-3">
                        <label class="form-label">@RequestResource.Swap_SwapType</label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="swapType" id="swapTypePeer" value="peer" checked>
                                <label class="form-check-label" for="swapTypePeer">@RequestResource.Swap_WithCoworker</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="swapType" id="swapTypeDirect" value="direct">
                                <label class="form-check-label" for="swapTypeDirect">@RequestResource.Swap_DirectChange</label>
                            </div>
                        </div>
                    </div>

                    <!-- Nhánh 1: Đổi với đồng nghiệp -->
                    <div id="swapPeerSection">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label required" for="swapTargetEmployeeId">@RequestResource.Swap_SelectCoworker</label>
                                <select class="form-select form-select-sm" id="swapTargetEmployeeId">
                                    <option value="">@RequestResource.Swap_SelectCoworkerPrompt</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label required" for="swapTargetRegistrationId">@RequestResource.Swap_CoworkerShift</label>
                                <select class="form-select form-select-sm" id="swapTargetRegistrationId">
                                    <option value="">@RequestResource.Swap_SelectCoworkerShiftPrompt</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Nhánh 2: Đổi sang ngày / ca khác của chính mình -->
                    <div id="swapDirectSection" style="display: none;">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label required" for="swapTargetWorkDate">@RequestResource.Swap_NewDate</label>
                                <input type="date" class="form-control form-control-sm" id="swapTargetWorkDate">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label required" for="swapTargetShiftId">@RequestResource.Swap_NewShift</label>
                                <select class="form-select form-select-sm" id="swapTargetShiftId">
                                    <option value="">@SharedResource.Req_SelectShift</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Lý do đổi ca -->
                    <div>
                        <label class="form-label required" for="swapReason">@RequestResource.Swap_Reason</label>
                        <textarea class="form-control form-control-sm" id="swapReason" rows="2" required placeholder="@RequestResource.Swap_ReasonPlaceholder"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">@SharedResource.Button_Cancel</button>
                    <button type="submit" id="btnSubmitSwap" class="btn btn-sm btn-primary">
                        <i class="bi bi-send me-1"></i> @SharedResource.Req_CreateNew
                    </button>
                </div>
            </form>
        </div>
