<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<style>
    .request-tabs .nav-link {
        color: #495057;
        border-radius: 8px;
        margin-bottom: 4px;
        padding: 10px 16px;
    }
    .request-tabs .nav-link.active {
        background-color: #d1e7dd;
        color: #00b14f;
    }
    .request-type-btn {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px;
        border: 1px solid #e9ecef;
        border-radius: 10px;
        background-color: #fff;
        transition: all 0.2s;
        height: 100%;
        color: #343a40;
    }
    .active-btn {
        cursor: pointer;
    }
    .active-btn:hover {
        border-color: #00b14f;
        box-shadow: 0 4px 12px rgba(0, 177, 79, 0.1);
        background-color: #f8fffb;
    }
    .disabled-btn {
        opacity: 0.6;
        cursor: not-allowed;
        background-color: #f8f9fa;
    }
    .request-card:hover {
        border-color: #00b14f !important;
        box-shadow: 0 2px 8px rgba(0, 177, 79, 0.15) !important;
    }
    .request-card.active-card {
        border-color: #00b14f !important;
        background-color: #f8fffb !important;
    }
</style>

@section Scripts {
    <script>
        // Data populated from model
        var requestsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(x => new {
            id = x.Id,
            requestType = x.RequestType,
            requestTypeName = x.RequestTypeName,
            employeeName = x.EmployeeName,
            createdDateStr = x.CreatedDateStr,
            shiftName = x.ShiftName,
            workDateStr = x.WorkDateStr,
            status = (int)x.Status,
            code = x.Code,
            note = x.Note,
            rejectionReason = x.RejectionReason ?? "",
            approvedBy = x.ApprovedBy ?? "",
            approvedAt = x.ApprovedAtStr ?? "",
            swapSummary = x.SwapSummary ?? "",
            startDateStr = x.StartDateStr ?? "",
            endDateStr = x.EndDateStr ?? "",
            leaveType = (int?)x.LeaveType,
            leaveTypeName = x.LeaveTypeName ?? "",
            leaveDays = x.LeaveDays,
            annualLeaveBalance = x.AnnualLeaveBalance
        })));

        let currentSelectedId = 0;
        let currentSelectedType = 'ShiftReg';

        $(document).ready(function() {
            // Date Picker setup
            if ($.fn.daterangepicker) {
                $('#dateRangePicker').daterangepicker({
                    locale: { format: 'YYYY-MM-DD' },
                    startDate: '@ViewBag.StartDate',
                    endDate: '@ViewBag.EndDate'
                }, function(start, end, label) {
                    window.location.href = `?start=${start.format('YYYY-MM-DD')}&end=${end.format('YYYY-MM-DD')}&status=@ViewBag.CurrentStatus&type=@ViewBag.CurrentType`;
                });
            }

            // Quick Client search filter
            $('#requestSearchInput').on('input', function() {
                var query = $(this).val().toLowerCase().trim();
                $('.request-card').each(function() {
                    var text = $(this).text().toLowerCase();
                    if (text.indexOf(query) !== -1) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            });

            // Card click logic
            $(document).on('click', '.request-card', function(e) {
                // If checkbox was clicked, don't trigger card selection
                if($(e.target).is('input[type="checkbox"]')) {
                    return;
                }
                $('.request-card').removeClass('active-card');
                $(this).addClass('active-card');

                var id = $(this).data('id');
                var type = $(this).data('type');
                showDetail(id, type);
            });

            // Select first card by default if any
            if(requestsData.length > 0) {
                $('.request-card').first().click();
            }

            // Checkbox logic
            $('#selectAll').change(function() {
                $('.request-checkbox').prop('checked', $(this).prop('checked'));
                checkBulkAction();
            });

            $('.request-checkbox').change(function(e) {
                if ($('.request-checkbox:checked').length === $('.request-checkbox').length) {
                    $('#selectAll').prop('checked', true);
                } else {
                    $('#selectAll').prop('checked', false);
                }
                checkBulkAction();
            });

            // Form Submit for new Shift Request
            $('#shiftRequestForm').submit(function(e) {
                e.preventDefault();
                var empId = $('#reqEmployeeId').val();
                if(!empId) empId = "0";

                var data = {
                    EmployeeId: empId,
                    ShiftId: $('#reqShiftId').val(),
                    WorkDate: $('#reqWorkDate').val(),
                    Note: $('#reqNote').val()
                };

                $.ajax({
                    url: '/ShiftRegistration/Create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    headers: {
                        'RequestVerificationToken': $('#antiForgeryForm input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(res) {
                        if (res.success) {
                            $('#createShiftRequestModal').modal('hide');
                            toastr.success('@Html.Raw(SharedResource.Req_CreateSuccess)');
                            setTimeout(() => window.location.reload(), 1000);
                        }
                    },
                    error: function(err) {
                        toastr.error(err.responseJSON?.message || '@Html.Raw(SharedResource.OperationFailed)');
                    }
                });
            });

            // Form Submit for Shift Swap Request
            $('#swapShiftForm').submit(function(e) {
                e.preventDefault();
                var swapType = $('input[name="swapType"]:checked').val();
                var sourceId = $('#swapSourceRegistrationId').val();
                if (!sourceId) {
                    toastr.warning('@Html.Raw(RequestResource.Swap_SelectSourcePrompt)');
                    return;
                }

                var data = {
                    SourceRegistrationId: parseInt(sourceId),
                    SwapType: swapType,
                    Reason: $('#swapReason').val().trim()
                };

                if (swapType === 'peer') {
                    var targetEmp = $('#swapTargetEmployeeId').val();
                    var targetReg = $('#swapTargetRegistrationId').val();
                    if (!targetEmp || !targetReg) {
                        toastr.warning('@Html.Raw(RequestResource.Swap_SelectCoworkerShiftPrompt)');
                        return;
                    }
                    data.TargetEmployeeId = parseInt(targetEmp);
                    data.TargetRegistrationId = parseInt(targetReg);
                } else {
                    var targetDate = $('#swapTargetWorkDate').val();
                    var targetShift = $('#swapTargetShiftId').val();
                    if (!targetDate || !targetShift) {
                        toastr.warning('@Html.Raw(SharedResource.Req_SelectShift)');
                        return;
                    }
                    data.TargetWorkDate = targetDate;
                    data.TargetShiftId = parseInt(targetShift);
                }

                $('#btnSubmitSwap').prop('disabled', true);

                $.ajax({
                    url: '/Request/CreateSwap',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    headers: {
                        'RequestVerificationToken': $('#antiForgeryForm input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(res) {
                        if (res.success) {
                            $('#createSwapShiftModal').modal('hide');
                            toastr.success(res.message || '@Html.Raw(RequestResource.Swap_SubmitSuccess)');
                            setTimeout(() => window.location.reload(), 1000);
                        } else {
                            toastr.error(res.message || '@Html.Raw(SharedResource.OperationFailed)');
                            $('#btnSubmitSwap').prop('disabled', false);
                        }
                    },
                    error: function(err) {
                        toastr.error(err.responseJSON?.message || '@Html.Raw(SharedResource.OperationFailed)');
                        $('#btnSubmitSwap').prop('disabled', false);
                    }
                });
            });

            // Radio button toggle for swap types
            $('input[name="swapType"]').change(function() {
                if ($(this).val() === 'peer') {
                    $('#swapPeerSection').slideDown(150);
                    $('#swapDirectSection').slideUp(150);
                } else {
                    $('#swapPeerSection').slideUp(150);
                    $('#swapDirectSection').slideDown(150);
                }
            });

            // When coworker changes, fetch their shifts
            $('#swapTargetEmployeeId').change(function() {
                var coworkerId = $(this).val();
                var shiftSelect = $('#swapTargetRegistrationId');
                shiftSelect.empty().append('<option value="">@Html.Raw(RequestResource.Swap_SelectCoworkerShiftPrompt)</option>');

                if (!coworkerId) return;

                $.get(`/Request/GetCoworkerShifts?coworkerId=${coworkerId}`, function(res) {
                    if (res.success && res.shifts && res.shifts.length > 0) {
                        res.shifts.forEach(s => {
                            shiftSelect.append(`<option value="${s.shiftRegistrationId}">${s.dateStr} - ${s.shiftName} (${s.time})</option>`);
                        });
                    } else {
                        shiftSelect.append('<option value="" disabled>-- Không có ca nào khả dụng --</option>');
                    }
                });
            });

            // Form Submit for Leave Request
            $('#leaveRequestForm').submit(function(e) {
                e.preventDefault();
                var empId = $('#leaveEmployeeId').val();
                if(!empId) empId = "0";

                var data = {
                    EmployeeId: parseInt(empId),
                    StartDate: $('#leaveStartDate').val(),
                    EndDate: $('#leaveEndDate').val(),
                    LeaveType: parseInt($('input[name="leaveType"]:checked').val()),
                    Reason: $('#leaveReason').val().trim()
                };

                $('#btnSubmitLeave').prop('disabled', true);

                $.ajax({
                    url: '/Request/CreateLeave',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    headers: {
                        'RequestVerificationToken': $('#antiForgeryForm input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(res) {
                        if (res.success) {
                            $('#createLeaveRequestModal').modal('hide');
                            toastr.success(res.message || '@Html.Raw(RequestResource.Leave_SubmitSuccess)');
                            setTimeout(() => window.location.reload(), 1000);
                        } else {
                            toastr.error(res.message || '@Html.Raw(SharedResource.OperationFailed)');
                            $('#btnSubmitLeave').prop('disabled', false);
                        }
                    },
                    error: function(err) {
                        toastr.error(err.responseJSON?.message || '@Html.Raw(SharedResource.OperationFailed)');
                        $('#btnSubmitLeave').prop('disabled', false);
                    }
                });
            });

            // Date & LeaveType change event listeners for dynamic validation
            $('#leaveStartDate, #leaveEndDate').change(function() {
                var startVal = $('#leaveStartDate').val();
                var endVal = $('#leaveEndDate').val();
                if (startVal && !endVal) {
                    $('#leaveEndDate').val(startVal);
                }
                validateLeaveDays();
            });

            $('input[name="leaveType"]').change(function() {
                validateLeaveDays();
            });

            $('#leaveEmployeeId').change(function() {
                var empId = $(this).val();
                if (empId) {
                    fetchLeaveBalance(empId);
                }
            });
        });

        function showDetail(id, type) {
            var req = requestsData.find(x => x.id === id && x.requestType === type);
            if(req) {
                currentSelectedId = id;
                currentSelectedType = type;
                $('#detailTypeName').text(req.requestTypeName);
                $('#detailEmployeeName').text(req.employeeName);
                $('#detailCreatedDate').text(req.createdDateStr);
                $('#detailCode').text(req.code);
                $('#detailCreator').text(req.employeeName);
                $('#detailWorkDate').text(req.workDateStr);
                $('#detailNote').text(req.note || '-');

                if (req.requestType === 'Leave') {
                    $('#detailShiftLabel').text('@Html.Raw(RequestResource.Leave_Duration)');
                    $('#detailShiftName').text(req.shiftName);
                    $('#detailLeaveTypeDesc').html(`<strong>${req.leaveTypeName}</strong> (${req.leaveDays} @Html.Raw(RequestResource.Leave_DaysUnit))`);
                    $('#detailLeaveBalanceBadge').text(`@Html.Raw(RequestResource.Leave_AnnualLeaveBalance): ${req.annualLeaveBalance} @Html.Raw(RequestResource.Leave_DaysUnit)`);
                    $('#detailLeaveInfoRow').show();
                } else {
                    $('#detailShiftLabel').text('@Html.Raw(RequestResource.Shift)');
                    $('#detailShiftName').text(req.shiftName);
                    $('#detailLeaveInfoRow').hide();
                }

                var statusHtml = '';
                if(req.status === 0) statusHtml = '<span class="badge bg-warning text-dark">@Html.Raw(RequestResource.Pending)</span>';
                else if(req.status === 1) statusHtml = '<span class="badge bg-success">@Html.Raw(RequestResource.Approved)</span>';
                else statusHtml = '<span class="badge bg-danger">@Html.Raw(RequestResource.Rejected)</span>';
                $('#detailStatus').html(statusHtml);

                if (req.requestType === 'ShiftSwap' && req.swapSummary) {
                    $('#detailSwapSummary').text(req.swapSummary);
                    $('#detailSwapTargetRow').show();
                } else {
                    $('#detailSwapTargetRow').hide();
                }

                if (req.rejectionReason) {
                    $('#detailRejectionReason').text(req.rejectionReason);
                    $('#detailRejectionRow').show();
                } else {
                    $('#detailRejectionRow').hide();
                }

                if (req.approvedBy) {
                    $('#detailApprover').text(req.approvedBy);
                    $('#detailApprovedAt').text(req.approvedAt ? `(lúc ${req.approvedAt})` : '');
                    $('#detailApproverRow').show();
                } else {
                    $('#detailApproverRow').hide();
                }

                if(req.status === 0) {
                    $('.action-btn').show();
                } else {
                    $('.action-btn').hide();
                }

                $('#requestDetailPane').fadeIn(200);
            }
        }

        function openShiftModal() {
            $('#createRequestModal').modal('hide');
            $('#shiftRequestForm')[0].reset();
            setTimeout(() => {
                var modal = new bootstrap.Modal(document.getElementById('createShiftRequestModal'));
                modal.show();
            }, 300);
        }

        function openSwapModal() {
            $('#createRequestModal').modal('hide');
            $('#swapShiftForm')[0].reset();
            $('#btnSubmitSwap').prop('disabled', false);
            $('#swapPeerSection').show();
            $('#swapDirectSection').hide();
            $('#swapTypePeer').prop('checked', true);

            var sourceSelect = $('#swapSourceRegistrationId');
            var cowSelect = $('#swapTargetEmployeeId');
            var shiftSelect = $('#swapTargetShiftId');

            sourceSelect.empty().append('<option value="">@Html.Raw(RequestResource.Swap_SelectSourcePrompt)</option>');
            cowSelect.empty().append('<option value="">@Html.Raw(RequestResource.Swap_SelectCoworkerPrompt)</option>');
            shiftSelect.empty().append('<option value="">@Html.Raw(SharedResource.Req_SelectShift)</option>');

            $.get('/Request/GetSwapFormData', function(res) {
                if (res.success) {
                    if (res.myShifts && res.myShifts.length > 0) {
                        $('#swapNoShiftsAlert').addClass('d-none');
                        res.myShifts.forEach(s => {
                            sourceSelect.append(`<option value="${s.shiftRegistrationId}">${s.dateStr} - ${s.shiftName} (${s.time})</option>`);
                        });
                    } else {
                        $('#swapNoShiftsAlert').removeClass('d-none');
                    }

                    if (res.coworkers) {
                        res.coworkers.forEach(c => {
                            cowSelect.append(`<option value="${c.employeeId}">${c.employeeCode} - ${c.fullName}</option>`);
                        });
                    }

                    if (res.availableShifts) {
                        res.availableShifts.forEach(s => {
                            shiftSelect.append(`<option value="${s.shiftId}">${s.shiftName} (${s.time})</option>`);
                        });
                    }

                    var modal = new bootstrap.Modal(document.getElementById('createSwapShiftModal'));
                    modal.show();
                } else {
                    toastr.error(res.message || '@Html.Raw(SharedResource.OperationFailed)');
                }
            }).fail(function() {
                toastr.error('@Html.Raw(SharedResource.OperationFailed)');
            });
        }

        let currentAnnualBalance = 0;

        function openLeaveModal() {
            $('#createRequestModal').modal('hide');
            $('#leaveRequestForm')[0].reset();
            $('#btnSubmitLeave').prop('disabled', false);
            $('#leaveBalanceAlert').addClass('d-none');

            const today = new Date().toISOString().split('T')[0];
            $('#leaveStartDate').val(today);
            $('#leaveEndDate').val(today);
            $('#leaveStartDate').attr('min', today);
            $('#leaveEndDate').attr('min', today);

            const empId = $('#leaveEmployeeId').val() || 0;
            fetchLeaveBalance(empId);

            setTimeout(() => {
                var modal = new bootstrap.Modal(document.getElementById('createLeaveRequestModal'));
                modal.show();
            }, 300);
        }

        function fetchLeaveBalance(empId) {
            $.get(`/Request/GetLeaveFormData?employeeId=${empId}`, function(res) {
                if (res.success) {
                    currentAnnualBalance = res.annualLeaveBalance;
                    $('#leaveAnnualBalanceDisplay').text(currentAnnualBalance);
                    validateLeaveDays();
                }
            });
        }

        function calculateLeaveDays() {
            const startStr = $('#leaveStartDate').val();
            const endStr = $('#leaveEndDate').val();
            if (!startStr || !endStr) return 0;
            const start = new Date(startStr);
            const end = new Date(endStr);
            if (end < start) return 0;
            const diffTime = Math.abs(end - start);
            return Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
        }

        function validateLeaveDays() {
            const days = calculateLeaveDays();
            $('#leaveDaysCount').text(days);

            const leaveType = $('input[name="leaveType"]:checked').val();
            if (days <= 0) {
                $('#leaveBalanceAlertText').text('Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu.');
                $('#leaveBalanceAlert').removeClass('d-none');
                $('#btnSubmitLeave').prop('disabled', true);
                return;
            }

            if (leaveType === '0') { // Paid
                if (days > currentAnnualBalance) {
                    $('#leaveBalanceAlertText').text(`Số ngày nghỉ (${days} ngày) vượt quá số ngày phép năm còn lại (${currentAnnualBalance} ngày)!`);
                    $('#leaveBalanceAlert').removeClass('d-none');
                    $('#btnSubmitLeave').prop('disabled', true);
                    return;
                }
            }

            $('#leaveBalanceAlert').addClass('d-none');
            $('#btnSubmitLeave').prop('disabled', false);
        }

        let pendingRejectType = ''; // 'single' or 'bulk'

        function updateSelectedStatus(status) {
            if(currentSelectedId === 0) return;

            if (status === 2) {
                pendingRejectType = 'single';
                $('#modalRejectionReason').val('');
                var modal = new bootstrap.Modal(document.getElementById('rejectReasonModal'));
                modal.show();
                return;
            }

            if(!confirm('@Html.Raw(RequestResource.ConfirmApproveMsg)')) return;

            $.ajax({
                url: '/Request/UpdateStatus',
                type: 'POST',
                data: {
                    id: currentSelectedId,
                    status: status,
                    requestType: currentSelectedType
                },
                headers: {
                    'RequestVerificationToken': $('#antiForgeryForm input[name="__RequestVerificationToken"]').val()
                },
                success: function(res) {
                    if (res.success) {
                        toastr.success(res.message || '@Html.Raw(SharedResource.Req_UpdateStatusSuccess)');
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        toastr.error('@Html.Raw(SharedResource.Req_ErrorPrefix)' + res.message);
                    }
                },
                error: function(err) {
                    toastr.error('@Html.Raw(SharedResource.Req_SysError)');
                }
            });
        }

        function submitRejection() {
            var reason = $('#modalRejectionReason').val().trim();
            if (!reason) {
                toastr.warning('@Html.Raw(RequestResource.RejectReasonRequired)');
                return;
            }

            $('#rejectReasonModal').modal('hide');

            if (pendingRejectType === 'single') {
                if(currentSelectedId === 0) return;
                $.ajax({
                    url: '/Request/UpdateStatus',
                    type: 'POST',
                    data: {
                        id: currentSelectedId,
                        status: 2,
                        reason: reason,
                        requestType: currentSelectedType
                    },
                    headers: {
                        'RequestVerificationToken': $('#antiForgeryForm input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(res) {
                        if (res.success) {
                            toastr.success(res.message || '@Html.Raw(RequestResource.RejectSuccess)');
                            setTimeout(() => window.location.reload(), 1000);
                        } else {
                            toastr.error('@Html.Raw(SharedResource.Req_ErrorPrefix)' + res.message);
                        }
                    },
                    error: function(err) {
                        toastr.error('@Html.Raw(SharedResource.Req_SysError)');
                    }
                });
            } else if (pendingRejectType === 'bulk') {
                var selectedIds = [];
                $('.request-checkbox:checked').each(function() {
                    selectedIds.push(parseInt($(this).val()));
                });

                var firstChecked = $('.request-checkbox:checked').first();
                var reqType = firstChecked.data('type') || 'ShiftReg';

                var data = {
                    Ids: selectedIds,
                    Status: 2,
                    Reason: reason,
                    RequestType: reqType
                };

                $.ajax({
                    url: '/Request/UpdateBulkStatus',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    headers: {
                        'RequestVerificationToken': $('#antiForgeryForm input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(res) {
                        if (res.success) {
                            toastr.success('@Html.Raw(RequestResource.BulkRejectSuccess)');
                            setTimeout(() => window.location.reload(), 1000);
                        } else {
                            toastr.error('@Html.Raw(SharedResource.Req_ErrorPrefix)' + res.message);
                        }
                    },
                    error: function(err) {
                        toastr.error('@Html.Raw(SharedResource.Req_SysError)');
                    }
                });
            }
        }

        function deleteSelectedRequest() {
            if(currentSelectedId === 0) return;
            if(!confirm('@Html.Raw(RequestResource.ConfirmDeleteMsg)')) return;

            $.ajax({
                url: '/Request/DeleteRequest',
                type: 'POST',
                data: {
                    id: currentSelectedId,
                    requestType: currentSelectedType
                },
                headers: {
                    'RequestVerificationToken': $('#antiForgeryForm input[name="__RequestVerificationToken"]').val()
                },
                success: function(res) {
                    if (res.success) {
                        toastr.success(res.message || '@Html.Raw(SharedResource.Req_DeleteSuccess)');
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        toastr.error('@Html.Raw(SharedResource.Req_ErrorPrefix)' + res.message);
                    }
                },
                error: function(err) {
                    toastr.error('@Html.Raw(SharedResource.Req_SysError)');
                }
            });
        }

        function checkBulkAction() {
            var selectedCount = $('.request-checkbox:checked').length;
            if (selectedCount > 0) {
                $('#requestDetailPane').hide();
                $('#bulkSelectedCount').text(selectedCount);
                $('#bulkActionPane').fadeIn(200);
            } else {
                $('#bulkActionPane').hide();
                if (currentSelectedId !== 0) {
                    $('#requestDetailPane').fadeIn(200);
                }
            }
        }

        function updateBulkStatus(status) {
            var selectedIds = [];
            $('.request-checkbox:checked').each(function() {
                selectedIds.push(parseInt($(this).val()));
            });

            if (selectedIds.length === 0) return;

            if (status === 2) {
                pendingRejectType = 'bulk';
                $('#modalRejectionReason').val('');
                var modal = new bootstrap.Modal(document.getElementById('rejectReasonModal'));
                modal.show();
                return;
            }
            
            var confirmBulkMsg = '@Html.Raw(RequestResource.ConfirmBulkApproveMsg)'.replace('{0}', selectedIds.length);
            if(!confirm(confirmBulkMsg)) return;

            var firstChecked = $('.request-checkbox:checked').first();
            var reqType = firstChecked.data('type') || 'ShiftReg';

            var data = {
                Ids: selectedIds,
                Status: status,
                RequestType: reqType
            };

            $.ajax({
                url: '/Request/UpdateBulkStatus',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                headers: {
                    'RequestVerificationToken': $('#antiForgeryForm input[name="__RequestVerificationToken"]').val()
                },
                success: function(res) {
                    if (res.success) {
                        toastr.success('@Html.Raw(SharedResource.Req_BulkActionSuccess)');
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        toastr.error('@Html.Raw(SharedResource.Req_ErrorPrefix)' + res.message);
                    }
                },
                error: function(err) {
                    toastr.error('@Html.Raw(SharedResource.Req_SysError)');
                }
            });
        }
    </script>
}
