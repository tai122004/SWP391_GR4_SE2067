    .req-row:last-child { border-bottom: 0; }
    .req-row:hover { background: #F7F9FC; }
    .req-row:focus-visible { outline: 2px solid var(--app-blue); outline-offset: -2px; }
    .req-row.active-card, .req-row.is-checked { background: var(--app-blue-soft); }
    .req-row-check { flex: 0 0 16px; display: inline-flex; align-items: center; }
    .req-row-check .form-check-input { margin: 0; }
    .req-avatar { width: 32px; height: 32px; font-size: .75rem; background: var(--app-blue-soft); color: var(--app-blue); box-shadow: none; }
    .req-row.active-card .req-avatar { background: #fff; }
    .req-row-main { flex: 1 1 auto; min-width: 0; }
    .req-row-top { display: flex; align-items: baseline; justify-content: space-between; gap: .5rem; }
    .req-row-name { font-weight: 500; color: var(--app-text); }
    .req-row-time { flex: 0 0 auto; font-size: .78rem; color: var(--app-muted); font-variant-numeric: tabular-nums; }
    .req-row-sub { font-size: .84rem; color: var(--app-muted); margin-top: 2px; }

    /* Detail panel */
    @@media (min-width: 992px) { .req-detail-col { position: sticky; top: 72px; } }
    .req-detail-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem; padding: .8rem 1.15rem; border-bottom: 1px solid var(--app-border); }
    .req-detail-body { padding: 1.15rem; }
    .detail-content-scroll { max-height: 560px; overflow-y: auto; }
    .req-detail-footer { display: flex; align-items: center; justify-content: flex-end; gap: .5rem; padding: .75rem 1.15rem; border-top: 1px solid var(--app-border); background: var(--app-surface-2); }
    .action-btn-detail { display: inline-flex; align-items: center; gap: .4rem; }
    .req-dl { margin: 0 0 1rem; }
    .req-dl-row { display: grid; grid-template-columns: minmax(120px, 38%) 1fr; gap: .75rem; padding: .45rem 0; border-bottom: 1px solid #EEF0F3; }
    .req-dl-row:last-child { border-bottom: 0; }
