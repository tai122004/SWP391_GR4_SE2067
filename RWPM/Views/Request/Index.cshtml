                        <div class="d-flex justify-content-between mb-1 small">
                            <span class="text-muted">@SharedResource.Req_Employee:</span>
                            <strong class="text-dark" id="apprModal_EmpName">-</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1 small">
                            <span class="text-muted">@RequestResource.Appr_WorkDate:</span>
                            <strong class="text-dark" id="apprModal_WorkDate">-</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1 small">
                            <span class="text-muted">@RequestResource.Shift:</span>
                            <strong class="text-dark" id="apprModal_ShiftName">-</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1 small">
                            <span class="text-muted">@RequestResource.Appr_OriginalTime:</span>
                            <span class="text-danger fw-bold" id="apprModal_OldInOut">--:-- ~ --:--</span>
                        </div>
                        <div class="d-flex justify-content-between small">
                            <span class="text-muted">@RequestResource.Appr_RequestedTime:</span>
                            <span class="text-success fw-bold" id="apprModal_ReqInOut">--:-- ~ --:--</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-dark fw-bold small">@RequestResource.Appr_EmployeeReason:</label>
                        <div class="p-2 bg-light rounded small text-dark" id="apprModal_Reason">-</div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-dark fw-bold small">@RequestResource.Appr_ApprovedCheckIn</label>
                            <input type="time" class="form-control form-control-sm" id="apprModal_ApprovedCheckIn" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-dark fw-bold small">@RequestResource.Appr_ApprovedCheckOut</label>
                            <input type="time" class="form-control form-control-sm" id="apprModal_ApprovedCheckOut" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-dark fw-bold small">@RequestResource.Appr_ApproverNote</label>
                        <textarea class="form-control form-control-sm" id="apprModal_ApproverNote" rows="2" placeholder="@RequestResource.Appr_ApproverNotePlaceholder"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top py-2 px-4 d-flex justify-content-end gap-2 bg-light">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">@SharedResource.Button_Cancel</button>
                    <button type="submit" class="btn btn-sm btn-success px-4 fw-semibold" id="btnConfirmApproveAttendance">
                        <i class="bi bi-check-circle me-1"></i> @RequestResource.Appr_ConfirmButton
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Scoped Modern Styles for Request Management Page */
    .request-management-page {
        --color-pending: #f59e0b;
        --color-approved: #10b981;
        --color-rejected: #ef4444;
        --color-purple: #8b5cf6;
        --color-teal: #0d9488;
    }

    /* Stats Cards */
    .stats-card .card {
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
        border: 1.5px solid transparent !important;
    }
    .stats-card:hover .card {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(18, 38, 61, 0.08) !important;
    }
    .stats-pending .card { background-color: #fffdf5; border-color: #fef08a !important; }
    .stats-approved .card { background-color: #f7fee7; border-color: #bbf7d0 !important; }
    .stats-rejected .card { background-color: #fff5f5; border-color: #fecaca !important; }

    .stats-card.active-filter .card {
        box-shadow: 0 6px 20px rgba(18, 38, 61, 0.1) !important;
    }
    .stats-pending.active-filter .card { border-color: #f59e0b !important; }
    .stats-approved.active-filter .card { border-color: #10b981 !important; }
    .stats-rejected.active-filter .card { border-color: #ef4444 !important; }

    /* Filter Panel */
    .filter-panel-card {
        border: 1px solid #e2e8f0 !important;
    }

    /* Master List Container */
    .master-list-container {
        max-height: 680px;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    /* Request Cards */
    .request-card {
        background-color: #ffffff;
        border: 1px solid #e2e8f0 !important;
        cursor: pointer;
        transition: all 0.16s ease-in-out;
    }
    .request-card:hover {
        border-color: #93c5fd !important;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.07);
    }
    .request-card.active-card {
        border: 2px solid #2563eb !important;
        background-color: #f8faff !important;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.12);
    }

    /* Avatar circle */
    .avatar-circle-sm {
        width: 26px;
        height: 26px;
        font-size: 11px;
        font-weight: bold;
    }

    /* Badges */
    .bg-purple-subtle { background-color: #f3e8ff; }
    .text-purple { color: #7e22ce; }
    .border-purple-subtle { border-color: #e9d5ff; }

    .bg-teal-subtle { background-color: #ccfbf1; }
    .text-teal { color: #0f766e; }
    .border-teal-subtle { border-color: #99f6e4; }

    /* Detail Card */
    .detail-card {
        border: 1px solid #e2e8f0 !important;
    }
    .detail-content-scroll {
        max-height: 620px;
        overflow-y: auto;
    }

    /* Request Type selection cards in modal */
    .request-type-card {
        padding: 18px 12px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        text-align: center;
        font-size: 0.84rem;
        font-weight: 600;
        transition: all 0.15s ease;
    }
    .request-type-card.active-card-btn {
        cursor: pointer;
    }
    .request-type-card.active-card-btn:hover {
        border-color: #2563eb;
        background-color: #f8faff;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.1);
    }
    .request-type-card.disabled-card {
        opacity: 0.5;
        cursor: not-allowed;
        background-color: #f8fafc;
    }

    /* Action buttons in detail */
    .action-btn-detail {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        border-radius: 8px;
        transition: all 0.15s ease;
    }
    .action-btn-detail:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    /* Utilities */
    .cursor-pointer { cursor: pointer; }
    .shadow-xs { box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05); }
    .fs-7 { font-size: 0.75rem; }
</style>

@section Scripts {
    <script>
        // Dữ liệu xuất file: toàn bộ danh sách đã lọc (không chỉ trang hiện tại)
        var requestsExportData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((ViewBag.ExportItems as List<RequestItemVM>) ?? Model ?? new List<RequestItemVM>()).Select(x => new {
            code = x.Code,
            requestTypeName = x.RequestTypeName,
            employeeName = x.EmployeeName,
            storeName = x.StoreName,
            shiftName = x.ShiftName,
            workDateStr = x.WorkDateStr,
            createdDateStr = x.CreatedDateStr,
            status = (int)x.Status,
            approvedBy = x.ApprovedBy,
            rejectionReason = x.RejectionReason,
            note = x.Note
        })));

        // Data populated from model
        var requestsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model ?? new List<RequestItemVM>()).Select(x => new {
            id = x.Id,
            requestType = x.RequestType,
            requestTypeName = x.RequestTypeName,
            employeeName = x.EmployeeName,
            createdDateStr = x.CreatedDateStr,
            shiftName = x.ShiftName,
            workDateStr = x.WorkDateStr,
            status = (int)x.Status,
            code = x.Code,
            note = x.Note,
            rejectionReason = x.RejectionReason ?? "",
            approvedBy = x.ApprovedBy ?? "",
            approvedAt = x.ApprovedAtStr ?? "",
            swapSummary = x.SwapSummary ?? "",
            startDateStr = x.StartDateStr ?? "",
            endDateStr = x.EndDateStr ?? "",
            leaveType = (int?)x.LeaveType,
            leaveTypeName = x.LeaveTypeName ?? "",
            leaveDays = x.LeaveDays,
            annualLeaveBalance = x.AnnualLeaveBalance,
            actualCheckInTimeStr = x.ActualCheckInTimeStr ?? "",
            actualCheckOutTimeStr = x.ActualCheckOutTimeStr ?? "",
            requestedCheckInTimeStr = x.RequestedCheckInTimeStr ?? "",
            requestedCheckOutTimeStr = x.RequestedCheckOutTimeStr ?? "",
            adjustmentSummary = x.AdjustmentSummary ?? "",
            requesterUsername = x.RequesterUsername ?? "",
            requesterRole = (int?)x.RequesterRole,
            storeId = x.StoreId
        })));

        var currentUsername = '@(User.Identity?.Name ?? "")';
        var isManager = @(ViewBag.IsManager == true ? "true" : "false");
        var isCurrentUserAdmin = @((ViewBag.IsAdminOnly == true || User.IsInRole("Admin") || User.IsInRole("SuperAdmin")) ? "true" : "false");
        var isCurrentUserHR = @(User.IsInRole("HR") ? "true" : "false");
        var isCurrentUserStoreManager = @(User.IsInRole("StoreManager") ? "true" : "false");
        var currentUserStoreId = @(ViewBag.CurrentUserStoreId ?? 0);

        // Localized UI texts used by the scripts below
        var reqI18n = {
            pending: @Json.Serialize(SharedResource.Req_Pending),
            approved: @Json.Serialize(RequestResource.Status_Approved),
            rejected: @Json.Serialize(RequestResource.Status_Rejected),
            atTime: @Json.Serialize(RequestResource.Detail_AtTime),
            processedBy: @Json.Serialize(RequestResource.Banner_ProcessedBy),
            defaultManager: @Json.Serialize(RequestResource.Banner_DefaultManager),
            confirmApproveBtn: @Json.Serialize(RequestResource.Appr_ConfirmButton)
        };

        let currentSelectedId = 0;
        let currentSelectedType = 'ShiftReg';

        $(document).ready(function() {
            // Date Picker setup
            if ($.fn.daterangepicker) {
                $('#dateRangePicker').daterangepicker({
                    locale: { format: 'YYYY-MM-DD' },
                    startDate: '@ViewBag.StartDate',
                    endDate: '@ViewBag.EndDate'
                }, function(start, end, label) {
                    var statusParam = '@ViewBag.CurrentStatus';
                    var statusQuery = statusParam ? `&status=${statusParam}` : '';
                    var typeParam = '@ViewBag.CurrentType';
                    var typeQuery = typeParam ? `&type=${typeParam}` : '';
                    window.location.href = `?start=${start.format('YYYY-MM-DD')}&end=${end.format('YYYY-MM-DD')}${statusQuery}${typeQuery}@Html.Raw(searchSuffix)`;
                });
            }

            // Enter: tìm kiếm phía server trên toàn bộ danh sách (mọi trang); gõ phím: lọc nhanh trên trang hiện tại
            $('#requestSearchInput').on('keydown', function (e) {
                if (e.key !== 'Enter') return;
                e.preventDefault();
                var params = new URLSearchParams(window.location.search);
                var q = $(this).val().trim();
                if (q) params.set('q', q); else params.delete('q');
                params.delete('pageNumber');
                window.location.search = params.toString();
            });

            // Client-side quick filter
            $('#requestSearchInput').on('input', function() {
                var query = $(this).val().toLowerCase().trim();
                var visibleCount = 0;
                $('.request-card').each(function() {
                    var text = $(this).text().toLowerCase();
                    if (text.indexOf(query) !== -1) {
                        $(this).show();
                        visibleCount++;
                    } else {
                        $(this).hide();
                    }
                });
                $('#filteredCountBadge').text(visibleCount);
            });

            // Card click logic
            $(document).on('click', '.request-card', function(e) {
                if ($(e.target).is('input[type="checkbox"]')) {
                    return;
                }
                $('.request-card').removeClass('active-card');
                $(this).addClass('active-card');

                var id = $(this).data('id');
                var type = $(this).data('type');
                showDetail(id, type);
            });

            // Select first card by default if any
            if (requestsData.length > 0) {
                $('.request-card').first().click();
            }

            // Checkbox logic
            $('#selectAll').change(function() {
                $('.request-checkbox').prop('checked', $(this).prop('checked'));
                checkBulkAction();
            });

            $(document).on('change', '.request-checkbox', function() {
                if ($('.request-checkbox:checked').length === $('.request-checkbox').length) {
                    $('#selectAll').prop('checked', true);
                } else {
                    $('#selectAll').prop('checked', false);
                }
                checkBulkAction();
            });

            // Form Submit for new Shift Request
            $('#shiftRequestForm').submit(function(e) {
                e.preventDefault();
                var empId = $('#reqEmployeeId').val();
                if (!empId) empId = "0";

                var data = {
                    EmployeeId: empId,
                    ShiftId: $('#reqShiftId').val(),
                    WorkDate: $('#reqWorkDate').val(),
                    Note: $('#reqNote').val()
                };

                $.ajax({
                    url: '/ShiftRegistration/Create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    headers: {
                        'RequestVerificationToken': $('#antiForgeryForm input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(res) {
                        if (res.success) {
                            $('#createShiftRequestModal').modal('hide');
                            AppToast.success('@Html.Raw(SharedResource.Req_CreateSuccess)');
                            setTimeout(() => window.location.reload(), 1000);
                        }
                    },
                    error: function(err) {
                        AppToast.error(err.responseJSON?.message || '@Html.Raw(SharedResource.OperationFailed)');
                    }
                });
            });

            // Form Submit for Shift Swap Request
            $('#swapShiftForm').submit(function(e) {
                e.preventDefault();
                var swapType = $('input[name="swapType"]:checked').val();
                var sourceId = $('#swapSourceRegistrationId').val();
                if (!sourceId) {
                    AppToast.warning('@Html.Raw(RequestResource.Swap_SelectSourcePrompt)');
                    return;
                }

                var data = {
                    SourceRegistrationId: parseInt(sourceId),
                    SwapType: swapType,
                    Reason: $('#swapReason').val().trim()
                };

                if (swapType === 'peer') {
                    var targetEmp = $('#swapTargetEmployeeId').val();
                    var targetReg = $('#swapTargetRegistrationId').val();
                    if (!targetEmp || !targetReg) {
                        AppToast.warning('@Html.Raw(RequestResource.Swap_SelectCoworkerShiftPrompt)');
                        return;
                    }
                    data.TargetEmployeeId = parseInt(targetEmp);
                    data.TargetRegistrationId = parseInt(targetReg);
                } else {
                    var targetDate = $('#swapTargetWorkDate').val();
                    var targetShift = $('#swapTargetShiftId').val();
                    if (!targetDate || !targetShift) {
                        AppToast.warning('@Html.Raw(SharedResource.Req_SelectShift)');
                        return;
                    }
                    data.TargetWorkDate = targetDate;
                    data.TargetShiftId = parseInt(targetShift);
                }

                $('#btnSubmitSwap').prop('disabled', true);

                $.ajax({
                    url: '/Request/CreateSwap',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    headers: {
                        'RequestVerificationToken': $('#antiForgeryForm input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(res) {
                        if (res.success) {
                            $('#createSwapShiftModal').modal('hide');
                            AppToast.success(res.message || '@Html.Raw(RequestResource.Swap_SubmitSuccess)');
                            setTimeout(() => window.location.reload(), 1000);
                        } else {
                            AppToast.error(res.message || '@Html.Raw(SharedResource.OperationFailed)');
                            $('#btnSubmitSwap').prop('disabled', false);
                        }
                    },
                    error: function(err) {
                        AppToast.error(err.responseJSON?.message || '@Html.Raw(SharedResource.OperationFailed)');
                        $('#btnSubmitSwap').prop('disabled', false);
                    }
                });
            });

            // Radio button toggle for swap types
            $('input[name="swapType"]').change(function() {
                if ($(this).val() === 'peer') {
                    $('#swapPeerSection').slideDown(150);
                    $('#swapDirectSection').slideUp(150);
                } else {
                    $('#swapPeerSection').slideUp(150);
                    $('#swapDirectSection').slideDown(150);
                }
            });

            // When coworker changes, fetch their shifts
            $('#swapTargetEmployeeId').change(function() {
                var coworkerId = $(this).val();
                var shiftSelect = $('#swapTargetRegistrationId');
                shiftSelect.empty().append('<option value="">@Html.Raw(RequestResource.Swap_SelectCoworkerShiftPrompt)</option>');

                if (!coworkerId) return;

                $.get(`/Request/GetCoworkerShifts?coworkerId=${coworkerId}`, function(res) {
                    if (res.success && res.shifts && res.shifts.length > 0) {
                        res.shifts.forEach(s => {
                            shiftSelect.append(`<option value="${s.shiftRegistrationId}">${s.dateStr} - ${s.shiftName} (${s.time})</option>`);
                        });
                    } else {
                        shiftSelect.append($('<option value="" disabled></option>').text(@Json.Serialize(RequestResource.Swap_NoAvailableShifts)));
                    }
                });
            });

            // Form Submit for Leave Request
            $('#leaveRequestForm').submit(function(e) {
                e.preventDefault();
                var empId = $('#leaveEmployeeId').val();
                if (!empId) empId = "0";

                var data = {
                    EmployeeId: parseInt(empId),
                    StartDate: $('#leaveStartDate').val(),
                    EndDate: $('#leaveEndDate').val(),
                    LeaveType: parseInt($('input[name="leaveType"]:checked').val()),
                    Reason: $('#leaveReason').val().trim()
                };

                $('#btnSubmitLeave').prop('disabled', true);

                $.ajax({
                    url: '/Request/CreateLeave',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    headers: {
                        'RequestVerificationToken': $('#antiForgeryForm input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(res) {
                        if (res.success) {
                            $('#createLeaveRequestModal').modal('hide');
                            AppToast.success(res.message || '@Html.Raw(RequestResource.Leave_SubmitSuccess)');
                            setTimeout(() => window.location.reload(), 1000);
                        } else {
                            AppToast.error(res.message || '@Html.Raw(SharedResource.OperationFailed)');
                            $('#btnSubmitLeave').prop('disabled', false);
                        }
                    },
                    error: function(err) {
                        AppToast.error(err.responseJSON?.message || '@Html.Raw(SharedResource.OperationFailed)');
                        $('#btnSubmitLeave').prop('disabled', false);
                    }
                });
            });

            // Date & LeaveType change event listeners for dynamic validation
            $('#leaveStartDate, #leaveEndDate').change(function() {
                var startVal = $('#leaveStartDate').val();
                var endVal = $('#leaveEndDate').val();
                if (startVal && !endVal) {
                    $('#leaveEndDate').val(startVal);
                }
                validateLeaveDays();
            });

            $('input[name="leaveType"]').change(function() {
                validateLeaveDays();
            });

            $('#leaveEmployeeId').change(function() {
                var empId = $(this).val();
                if (empId) {
                    fetchLeaveBalance(empId);
                }
            });
        });

        function onTypeFilterChange(typeVal) {
            var statusParam = '@ViewBag.CurrentStatus';
            var statusQuery = statusParam ? `&status=${statusParam}` : '';
            var typeQuery = typeVal ? `&type=${typeVal}` : '';
            window.location.href = `?start=@ViewBag.StartDate&end=@ViewBag.EndDate${statusQuery}${typeQuery}@Html.Raw(searchSuffix)`;
        }

        function showDetail(id, type) {
            var req = requestsData.find(x => x.id === id && x.requestType === type);
            if (!req) return;

            currentSelectedId = id;
            currentSelectedType = type;

            $('#detailTypeName').text(req.requestTypeName);
            $('#detailEmployeeName').text(req.employeeName);
            $('#detailCreatedDate').text(req.createdDateStr);
            $('#detailCode').text(req.code);
            $('#detailWorkDate').text(req.workDateStr);
            $('#detailNote').text(req.note || '-');

            if (req.requestType === 'Leave') {
                $('#detailShiftLabel').text('@Html.Raw(RequestResource.Leave_Duration)');
                $('#detailShiftName').text(req.shiftName);
                $('#detailLeaveTypeDesc').html(`<strong>${req.leaveTypeName}</strong> (${req.leaveDays} @Html.Raw(RequestResource.Leave_DaysUnit))`);
                $('#detailLeaveBalanceBadge').text(`@Html.Raw(RequestResource.Leave_AnnualLeaveBalance): ${req.annualLeaveBalance} @Html.Raw(RequestResource.Leave_DaysUnit)`);
                $('#detailLeaveInfoRow').show();
                $('#detailAttendanceRow').hide();
            } else if (req.requestType === 'Attendance') {
                $('#detailShiftLabel').text('@Html.Raw(RequestResource.Shift)');
                $('#detailShiftName').text(req.shiftName);
                $('#detailLeaveInfoRow').hide();
                $('#detailAttendanceSummary').html(`
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="text-muted small">${escapeHtml(@Json.Serialize(RequestResource.Appr_OriginalTime))}:</div>
                            <div class="fw-bold text-danger">${req.actualCheckInTimeStr || '--:--'} ~ ${req.actualCheckOutTimeStr || '--:--'}</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted small">${escapeHtml(@Json.Serialize(RequestResource.Detail_ProposedTime))}:</div>
                            <div class="fw-bold text-success">${req.requestedCheckInTimeStr || '--:--'} ~ ${req.requestedCheckOutTimeStr || '--:--'}</div>
                        </div>
                    </div>
                `);
                $('#detailAttendanceRow').show();
            } else {
                $('#detailShiftLabel').text('@Html.Raw(RequestResource.Shift)');
                $('#detailShiftName').text(req.shiftName);
                $('#detailLeaveInfoRow').hide();
                $('#detailAttendanceRow').hide();
            }

            // Set Status Badge in metadata
            var statusHtml = '';
            if (req.status === 0) {
                statusHtml = '<span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1 fw-semibold"><i class="bi bi-hourglass-split me-1"></i>' + escapeHtml(reqI18n.pending) + '</span>';
            } else if (req.status === 1) {
                statusHtml = '<span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-1 fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>' + escapeHtml(reqI18n.approved) + '</span>';
            } else {
                statusHtml = '<span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 fw-semibold"><i class="bi bi-x-circle-fill me-1"></i>' + escapeHtml(reqI18n.rejected) + '</span>';
            }
            $('#detailStatus').html(statusHtml);

            // Shift Swap target card
            if (req.requestType === 'ShiftSwap' && req.swapSummary) {
                $('#detailSwapSummary').text(req.swapSummary);
                $('#detailSwapTargetRow').show();
            } else {
                $('#detailSwapTargetRow').hide();
            }

            // Rejection note
            if (req.rejectionReason) {
                $('#detailRejectionReason').text(req.rejectionReason);
                $('#detailRejectionRow').show();
            } else {
                $('#detailRejectionRow').hide();
            }

            // Approver trail
            if (req.approvedBy) {
                $('#detailApprover').text(req.approvedBy);
                $('#detailApprovedAt').text(req.approvedAt ? '(' + reqI18n.atTime.replace('{0}', req.approvedAt) + ')' : '');
                $('#detailApproverRow').show();
            } else {
                $('#detailApproverRow').hide();
            }

            // Reset buttons & Result Banner
            $('#btnApproveDetail').hide();
            $('#btnRejectDetail').hide();
            $('#btnDeleteDetail').hide();
            $('#requestApprovalNotice').hide();
            $('#detailResultBanner').hide();

            if (req.status === 0) { // Pending
                var isSelf = (req.requesterUsername && req.requesterUsername.toLowerCase() === currentUsername.toLowerCase());
                var canApprove = false;
                var cannotApproveReason = '';

                if (!isManager) {
                    canApprove = false;
                    cannotApproveReason = 'not_manager';
                } else if (isSelf) {
                    canApprove = false;
                    cannotApproveReason = 'self';
                } else if (req.requestType === 'Attendance') {
                    var isRequesterManagement = (req.requesterRole === 2 || req.requesterRole === 4); // HR = 2, StoreManager = 4
                    if (isRequesterManagement) {
                        if (isCurrentUserAdmin) {
                            canApprove = true;
                        } else {
                            canApprove = false;
                            cannotApproveReason = 'admin_only';
                        }
                    } else {
                        if (isCurrentUserAdmin || isCurrentUserHR) {
                            canApprove = true;
                        } else if (isCurrentUserStoreManager) {
                            if (currentUserStoreId > 0 && req.storeId === currentUserStoreId) {
                                canApprove = true;
                            } else {
                                canApprove = false;
                                cannotApproveReason = 'store_mismatch';
                            }
                        }
                    }
                } else {
                    if (isCurrentUserAdmin || isCurrentUserHR) {
                        canApprove = true;
                    } else if (isCurrentUserStoreManager) {
                        if (currentUserStoreId > 0 && req.storeId === currentUserStoreId) {
                            canApprove = true;
                        } else {
                            canApprove = false;
                            cannotApproveReason = 'store_mismatch';
                        }
                    }
                }

                if (canApprove) {
                    $('#btnApproveDetail').css('display', 'inline-flex');
                    $('#btnRejectDetail').css('display', 'inline-flex');
                } else {
                    if (isSelf || !isManager) {
                        $('#btnDeleteDetail').css('display', 'inline-flex');
                    } else if (cannotApproveReason === 'admin_only') {
                        $('#requestApprovalNotice').html('<i class="bi bi-shield-lock-fill me-2 fs-6"></i>' + escapeHtml(@Json.Serialize(RequestResource.Notice_AdminOnly))).show();
                    } else if (cannotApproveReason === 'store_mismatch') {
                        $('#requestApprovalNotice').html('<i class="bi bi-info-circle me-2 fs-6"></i>' + escapeHtml(@Json.Serialize(RequestResource.Notice_StoreMismatch))).show();
                    }
                }
            } else if (req.status === 1) { // Approved Banner
                $('#detailResultBanner').html(`
                    <div class="alert alert-success d-flex align-items-center gap-3 p-3 rounded-3 border-success-subtle mb-0">
                        <i class="bi bi-check-circle-fill fs-3 text-success"></i>
                        <div>
                            <div class="fw-bold">${escapeHtml(@Json.Serialize(RequestResource.Banner_Approved))}</div>
                            <div class="small text-success-emphasis">${escapeHtml(reqI18n.processedBy)}: <strong>${escapeHtml(req.approvedBy || reqI18n.defaultManager)}</strong> ${req.approvedAt ? escapeHtml(reqI18n.atTime.replace('{0}', req.approvedAt)) : ''}</div>
                        </div>
                    </div>
                `).show();
            } else if (req.status === 2) { // Rejected Banner
                var reasonHtml = req.rejectionReason ? `<div class="small mt-2 p-2 bg-white rounded border border-danger-subtle text-dark"><strong>${escapeHtml(@Json.Serialize(RequestResource.RejectReasonTitle))}:</strong> ${escapeHtml(req.rejectionReason)}</div>` : '';
                $('#detailResultBanner').html(`
                    <div class="alert alert-danger d-flex align-items-start gap-3 p-3 rounded-3 border-danger-subtle mb-0">
                        <i class="bi bi-x-circle-fill fs-3 text-danger mt-1"></i>
                        <div class="w-100">
                            <div class="fw-bold">${escapeHtml(@Json.Serialize(RequestResource.Banner_Rejected))}</div>
                            <div class="small text-danger-emphasis">${escapeHtml(reqI18n.processedBy)}: <strong>${escapeHtml(req.approvedBy || reqI18n.defaultManager)}</strong> ${req.approvedAt ? escapeHtml(reqI18n.atTime.replace('{0}', req.approvedAt)) : ''}</div>
                            ${reasonHtml}
                        </div>
                    </div>
                `).show();
            }

            $('#emptyDetailPane').hide();
            $('#bulkActionPane').hide();
            $('#requestDetailPane').fadeIn(150);
        }

        let pendingRejectType = ''; // 'single' or 'bulk'

        async function updateSelectedStatus(status) {
            if (currentSelectedId === 0) return;

            if (status === 2) {
                pendingRejectType = 'single';
                $('#modalRejectionReason').val('');
                var modal = new bootstrap.Modal(document.getElementById('rejectReasonModal'));
                modal.show();
                return;
            }

            if (currentSelectedType === 'Attendance' && status === 1) {
                openApproveAttendanceModal(currentSelectedId);
                return;
            }

            if (!(await AppConfirm({ message: '@Html.Raw(RequestResource.ConfirmApproveMsg)', type: 'success', icon: 'bi-check2-circle' }))) return;

            $.ajax({
                url: '/Request/UpdateStatus',
                type: 'POST',
                data: {
                    id: currentSelectedId,
                    status: status,
                    requestType: currentSelectedType
                },
                headers: {
                    'RequestVerificationToken': $('#antiForgeryForm input[name="__RequestVerificationToken"]').val()
                },
                success: function(res) {
                    if (res.success) {
                        AppToast.success(res.message || '@Html.Raw(SharedResource.Req_UpdateStatusSuccess)');
                        setTimeout(() => window.location.reload(), 800);
                    } else {
                        AppToast.error('@Html.Raw(SharedResource.Req_ErrorPrefix)' + res.message);
                    }
                },
                error: function() {
                    AppToast.error('@Html.Raw(SharedResource.Req_SysError)');
                }
            });
        }

        function submitRejection() {
            var reason = $('#modalRejectionReason').val().trim();
            if (!reason) {
                AppToast.warning('@Html.Raw(RequestResource.RejectReasonRequired)');
                return;
            }

            $('#rejectReasonModal').modal('hide');

            if (pendingRejectType === 'single') {
                if (currentSelectedId === 0) return;
                $.ajax({
                    url: '/Request/UpdateStatus',
                    type: 'POST',
                    data: {
                        id: currentSelectedId,
                        status: 2,
                        reason: reason,
                        requestType: currentSelectedType
                    },
                    headers: {
                        'RequestVerificationToken': $('#antiForgeryForm input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(res) {
                        if (res.success) {
                            AppToast.success(res.message || '@Html.Raw(RequestResource.RejectSuccess)');
                            setTimeout(() => window.location.reload(), 800);
                        } else {
                            AppToast.error('@Html.Raw(SharedResource.Req_ErrorPrefix)' + res.message);
                        }
                    },
                    error: function() {
                        AppToast.error('@Html.Raw(SharedResource.Req_SysError)');
                    }
                });
            } else if (pendingRejectType === 'bulk') {
                var selectedIds = [];
                $('.request-checkbox:checked').each(function() {
                    selectedIds.push(parseInt($(this).val()));
                });

                var firstChecked = $('.request-checkbox:checked').first();
                var reqType = firstChecked.data('type') || 'ShiftReg';

                var data = {
                    Ids: selectedIds,
                    Status: 2,
                    Reason: reason,
                    RequestType: reqType
                };

                $.ajax({
                    url: '/Request/UpdateBulkStatus',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    headers: {
                        'RequestVerificationToken': $('#antiForgeryForm input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(res) {
                        if (res.success) {
                            AppToast.success('@Html.Raw(RequestResource.BulkRejectSuccess)');
                            setTimeout(() => window.location.reload(), 800);
                        } else {
                            AppToast.error('@Html.Raw(SharedResource.Req_ErrorPrefix)' + res.message);
                        }
                    },
                    error: function() {
                        AppToast.error('@Html.Raw(SharedResource.Req_SysError)');
                    }
                });
            }
        }

