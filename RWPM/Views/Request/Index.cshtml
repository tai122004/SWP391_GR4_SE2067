    /* Request type picker in the create modal */
    .req-modal-group { font-size: .8rem; font-weight: 500; color: var(--app-muted); margin-bottom: .5rem; }
    .request-type-card { padding: .9rem .75rem; border: 1px solid var(--app-border); border-radius: var(--app-radius); background: var(--app-surface);
