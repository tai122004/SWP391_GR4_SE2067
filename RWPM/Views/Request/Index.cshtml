                        <label class="form-label text-dark fw-bold small">@RequestResource.Leave_Reason <span class="text-danger">*</span></label>
                        <textarea class="form-control form-control-sm" id="leaveReason" rows="2" required placeholder="@RequestResource.Leave_ReasonPlaceholder"></textarea>
