@model AccUpdateVM

@using AccountModelResource = RWPM.Resources.Models.Acc
@using AccountSharedResource = RWPM.Resources.Shared.Acc
@using EmployeeModelResource = RWPM.Resources.Models.Employee
@using EmployeeSharedResource = RWPM.Resources.Shared.Employee
@using RWPM.Common.Enums
@using RWPM.Models.ViewModels.Acc
@using RWPM.Resources.Shared

@{
    ViewData["Title"] = AccountSharedResource.Update_PageTitle;
}

<div class="container-fluid px-0">
    <!-- Header with Breadcrumb -->
    <div class="app-page-header">
        <div>
            <h4 class="fw-bold text-dark d-flex align-items-center mb-1">
                <i class="bi bi-person-gear text-primary me-2"></i> @AccountSharedResource.Update_PageHeader
            </h4>
            <div class="text-muted small">Cập nhật thông tin và vai trò của tài khoản <strong>@Model.Username</strong></div>
        </div>

        <nav aria-label="breadcrumb" class="d-none d-md-block">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="Index">@RWPM.Resources.Shared.Acc.Index_PageHeader</a></li>
                <li class="breadcrumb-item active" aria-current="page">@AccountSharedResource.Update_PageHeader</li>
            </ol>
        </nav>
    </div>

    <!-- Main Card -->
    <div class="modern-card p-4">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Username" />
            <input type="hidden" asp-for="HasExistingEmployee" />
            <input type="hidden" asp-for="EmployeeId" />

            <!-- Account identity badge -->
            <div class="d-flex align-items-center p-3 bg-light rounded border mb-4">
                <div class="avatar-initials avatar-color-0 me-3 fs-5" style="width: 46px; height: 46px;">
                    @(string.IsNullOrWhiteSpace(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                </div>
                <div>
                    <div class="fw-bold fs-6 text-dark">@Model.FullName</div>
                    <div class="small text-muted font-monospace"><i class="bi bi-at"></i>@Model.Username</div>
                </div>
                <div class="ms-auto">
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="openQuickResetPassword('@Model.Username', '@Model.FullName')">
                        <i class="bi bi-key me-1"></i> Cấp lại mật khẩu
                    </button>
                </div>
            </div>

            <div class="form-section-title">
                <i class="bi bi-person-badge text-primary"></i> Thông tin cá nhân
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold small required" asp-for="FullName">@AccountModelResource.Fullname</label>
                    <input class="form-control" asp-for="FullName" placeholder="@AccountSharedResource.Placeholder_FullName" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold small required" asp-for="Email">Email</label>
                    <input class="form-control" asp-for="Email" placeholder="@AccountSharedResource.Placeholder_Email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" asp-for="PhoneNumber">@AccountModelResource.PhoneNumber</label>
                    <input class="form-control" asp-for="PhoneNumber" placeholder="0901234567" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" asp-for="DateOfBirth">@AccountModelResource.DateOfBirth</label>
                    <input class="form-control" type="date" asp-for="DateOfBirth" value="@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("yyyy-MM-dd") : "")" />
                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" asp-for="Gender">@AccountModelResource.Gender</label>
                    <select class="form-select" asp-for="Gender" asp-items="Html.GetEnumSelectList<RWPM.Common.Enums.Gender>()">
                        <option value="">-- Chọn giới tính --</option>
                    </select>
                </div>
            </div>

            <div class="form-section-title mt-4">
                <i class="bi bi-shield-check text-primary"></i> Quyền hạn hệ thống
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold small required" asp-for="Role">@AccountModelResource.Role</label>
                    <select asp-for="Role" asp-items="Model.AccountRoleSelectList" class="form-select system-select2" id="accRoleSelect">
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>
            </div>

            <!-- KHỐI THÔNG TIN CỬA HÀNG & HỒ SƠ NHÂN VIÊN (TỰ ĐỘNG HIỂN THỊ KHI CHỌN VAI TRÒ NHÂN SỰ CỬA HÀNG) -->
            <div id="storeAssignmentSection">
                <div class="form-section-title mt-4 text-primary">
                    <i class="bi bi-shop"></i> @AccountSharedResource.Create_Section_StoreInfo
                </div>

                @if (Model.HasExistingEmployee)
                {
                    <div class="alert alert-success bg-success bg-opacity-10 border-0 py-2 px-3 small mb-3 text-dark d-flex align-items-center">
                        <i class="bi bi-check-circle-fill text-success me-2 fs-5 flex-shrink-0"></i>
                        <div>@AccountSharedResource.Edit_StoreInfoLinked</div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning bg-warning bg-opacity-10 border-0 py-2 px-3 small mb-3 text-dark d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-2 fs-5 flex-shrink-0"></i>
                        <div>@AccountSharedResource.Edit_StoreInfoNotLinked</div>
                    </div>
                }

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small required" asp-for="EmployeeCode">@EmployeeSharedResource.Column_EmployeeCode</label>
                        <input class="form-control font-monospace" asp-for="EmployeeCode" id="empCodeInput" placeholder="NV..." autocomplete="off" />
                        <span asp-validation-for="EmployeeCode" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small required" asp-for="StoreId">@EmployeeSharedResource.Column_Store</label>
                        <select class="form-select" asp-for="StoreId" asp-items="Model.StoreSelectList" id="storeSelectInput">
                            <option value="">-- @SharedResource.Dropdown_SelectStore --</option>
                        </select>
                        <span asp-validation-for="StoreId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small required" asp-for="JoinDate">@EmployeeSharedResource.Column_JoinDate</label>
                        <input class="form-control" type="date" asp-for="JoinDate" value="@(Model.JoinDate.HasValue ? Model.JoinDate.Value.ToString("yyyy-MM-dd") : "")" />
                        <span asp-validation-for="JoinDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small" asp-for="EmploymentType">@EmployeeModelResource.EmploymentType</label>
                        <select class="form-select" asp-for="EmploymentType" asp-items="Html.GetEnumSelectList<RWPM.Common.Enums.EmploymentType>()">
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small" asp-for="HourlyRate">@EmployeeModelResource.HourlyRate</label>
                        <div class="input-group">
                            <input class="form-control" asp-for="HourlyRate" type="number" step="1000" placeholder="25000" />
                            <span class="input-group-text small">VNĐ/h</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary px-3">
                    <i class="bi bi-arrow-left me-1"></i> @SharedResource.Button_GoBack
                </a>
                <button type="submit" class="btn btn-primary px-4 shadow-sm">
                    <i class="bi bi-floppy me-1"></i> @SharedResource.Button_SaveChanges
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Đổi Mật Khẩu Nhanh -->
<div class="modal fade" id="modalQuickResetPassword" tabindex="-1" aria-labelledby="modalQuickResetPasswordLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fs-6 d-flex align-items-center" id="modalQuickResetPasswordLabel">
                    <i class="bi bi-key-fill me-2 fs-5"></i> Cấp lại mật khẩu tài khoản
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="quickResetModal_Username" />
                
                <div class="alert alert-info py-2 px-3 small d-flex align-items-center mb-3">
                    <i class="bi bi-person-check fs-5 me-2"></i>
                    <div>Đang cấp lại mật khẩu cho: <strong id="quickResetModal_DisplayUser"></strong></div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Mật khẩu mới</label>
                    <div class="input-group">
                        <input type="text" id="quickResetModal_NewPassword" class="form-control" placeholder="Nhập mật khẩu mới..." autocomplete="off" />
                        <button class="btn btn-outline-secondary" type="button" onclick="const p = generateRandomPassword(8); $('#quickResetModal_NewPassword').val(p); $('#quickResetModal_ConfirmPassword').val(p); $('#quickResetModal_CopyText').text('Tài khoản: ' + $('#quickResetModal_Username').val() + ' | Mật khẩu: ' + p);" title="Sinh mật khẩu ngẫu nhiên">
                            <i class="bi bi-dice-5 me-1"></i> Sinh ngẫu nhiên
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Xác nhận mật khẩu</label>
                    <input type="text" id="quickResetModal_ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu..." autocomplete="off" />
                </div>

                <div class="p-3 bg-light rounded border d-flex justify-content-between align-items-center mb-1">
                    <div class="small text-truncate me-2">
                        <i class="bi bi-clipboard me-1 text-muted"></i>
                        <span id="quickResetModal_CopyText" class="text-secondary font-monospace"></span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-dark text-nowrap" onclick="copyToClipboard($('#quickResetModal_CopyText').text(), 'Đã sao chép tài khoản & mật khẩu!')">
                        <i class="bi bi-copy me-1"></i> Sao chép
                    </button>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" id="quickResetModal_BtnSubmit" class="btn btn-sm btn-primary" onclick="submitQuickResetPassword()">
                    <i class="bi bi-check2-circle me-1"></i> Lưu mật khẩu mới
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateStoreSectionVisibility() {
            const roleVal = $('#accRoleSelect').val();
            // StoreManager = 4, Employee = 6, PartTimeStaff = 7 (hoặc text tương ứng)
            const isStoreRole = (roleVal == '4' || roleVal == '6' || roleVal == '7' || 
                                 roleVal == 'StoreManager' || roleVal == 'Employee' || roleVal == 'PartTimeStaff');
            
            if (isStoreRole) {
                $('#storeAssignmentSection').slideDown(200);
            } else {
                $('#storeAssignmentSection').slideUp(200);
            }
        }

        $('#accRoleSelect').on('change', updateStoreSectionVisibility);

        $(document).ready(function () {
            updateStoreSectionVisibility();
        });
    </script>
}
