@model AccCreateVM

@using AccModelResource = RWPM.Resources.Models.Acc
@using AccSharedResource = RWPM.Resources.Shared.Acc
@using RWPM.Models.ViewModels.Acc
@using RWPM.Resources.Shared
@{
		ViewData["Title"] = AccSharedResource.Delete_PageTitle;
}

<div class="d-flex justify-content-between align-items-center mb-3 border-4 border-primary border-start rounded-start ps-2">
	<h4 class="mb-0 text-danger">
		<i class="bi bi-trash3-fill me-2"></i> @AccSharedResource.Delete_PageHeader
	</h4>

	<nav class="d-none d-md-block ms-auto"
		 style="--bs-breadcrumb-divider: url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%278%27 height=%278%27%3E%3Cpath d=%27M2.5 0L1 1.5 3.5 4 1 6.5 2.5 8l4-4-4-4z%27 fill=%276c757d%27/%3E%3C/svg%3E');"
		 aria-label="breadcrumb">
		<ol class="breadcrumb mb-0">
			<li class="breadcrumb-item">
				<a asp-action="Index">@RWPM.Resources.Shared.Acc.Index_PageHeader</a>
			</li>
			<li class="breadcrumb-item active" aria-current="page">@AccSharedResource.Delete_PageHeader</li>
		</ol>
	</nav>
</div>

<div>
	<div class="card">
		<div class="card-header bg-danger text-white">
			<h6>@SharedResource.DataWillBeDeleted</h6>
		</div>
		<div class="card-body">
			<dl class="row">
				<dt class="col-sm-2">@AccModelResource.Username:</dt>
				<dd class="col-sm-10">@Model.Username</dd>
				<dt class="col-sm-2">@AccModelResource.Fullname:</dt>
				<dd class="col-sm-10">@Model.FullName</dd>
				<dt class="col-sm-2">Email:</dt>
				<dd class="col-sm-10">@Model.Email</dd>
				<dt class="col-sm-2">@AccModelResource.Role:</dt>
				<dd class="col-sm-10">@Model.Role.GetDisplayName()</dd>
			</dl>
		</div>
		
	</div>
	
	<form asp-action="DeleteConfirmed" method="post" onsubmit="return confirm('@SharedResource.ConfirmDelete');">
		@Html.AntiForgeryToken()

		<input type="hidden" asp-for="Username" />

		<div class="form-group mt-3 text-end">
			<a asp-action="Index" class="btn btn-secondary me-2">
				<i class="bi bi-arrow-return-left me-2"></i>@SharedResource.Button_Cancel
			</a>
			<button type="submit" class="btn btn-danger">
				<i class="bi bi-trash3-fill me-2"></i>@SharedResource.Button_Delete
			</button>
		</div>
	</form>
</div>

