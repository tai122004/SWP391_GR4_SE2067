@model AccCreateVM

@using AccModelResource = RWPM.Resources.Models.Acc
@using AccSharedResource = RWPM.Resources.Shared.Acc
@using RWPM.Models.ViewModels.Acc
@using RWPM.Resources.Shared
@{
    ViewData["Title"] = AccSharedResource.Delete_PageTitle;
}

<div class="app-page-header">
    <div>
        <h4 class="mb-1">@AccSharedResource.Delete_PageHeader</h4>
        <div class="text-muted small">@SharedResource.DataWillBeDeleted</div>
    </div>
    <nav class="d-none d-md-block" aria-label="@RWPM.Resources.Shared.Acc.Aria_Breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-action="Index">@RWPM.Resources.Shared.Acc.Index_PageHeader</a></li>
            <li class="breadcrumb-item active" aria-current="page">@AccSharedResource.Delete_PageHeader</li>
        </ol>
    </nav>
</div>

<div class="app-content-card p-4" style="max-width: 760px;">
    <div class="alert alert-danger py-2 px-3 small mb-3">
        <i class="bi bi-exclamation-triangle me-1"></i> @SharedResource.ConfirmDelete
    </div>
    <dl class="row mb-0">
        <dt class="col-sm-3 text-muted fw-normal">@AccModelResource.Username</dt>
        <dd class="col-sm-9 font-monospace">@Model.Username</dd>
        <dt class="col-sm-3 text-muted fw-normal">@AccModelResource.Fullname</dt>
        <dd class="col-sm-9">@Model.FullName</dd>
        <dt class="col-sm-3 text-muted fw-normal">@AccModelResource.Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3 text-muted fw-normal">@AccModelResource.Role</dt>
        <dd class="col-sm-9 mb-0"><span class="app-badge app-badge-neutral">@Model.Role.GetDisplayName()</span></dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post" data-confirm="@SharedResource.ConfirmDelete" data-confirm-type="danger">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Username" />
        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary">@SharedResource.Button_Cancel</a>
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash3 me-1"></i>@SharedResource.Button_Delete
            </button>
        </div>
    </form>
</div>
