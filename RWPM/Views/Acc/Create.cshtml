@model AccCreateVM

@using AccountModelResource = RWPM.Resources.Models.Acc
@using AccountSharedResource = RWPM.Resources.Shared.Acc
@using EmployeeSharedResource = RWPM.Resources.Shared.Employee
@using EmployeeModelResource = RWPM.Resources.Models.Employee
@using RWPM.Common.Enums
@using RWPM.Models.ViewModels.Acc
@using RWPM.Resources.Shared

@{
    ViewData["Title"] = AccountSharedResource.Create_PageTitle;
}

<div class="container-fluid px-0">
    <!-- Header with Breadcrumb -->
    <div class="app-page-header">
        <div>
            <h4 class="mb-1">@AccountSharedResource.Create_PageHeader</h4>
            <div class="text-muted small">@AccountSharedResource.Create_SubTitle</div>
        </div>

        <nav aria-label="@RWPM.Resources.Shared.Acc.Aria_Breadcrumb" class="d-none d-md-block">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="Index">@RWPM.Resources.Shared.Acc.Index_PageHeader</a></li>
                <li class="breadcrumb-item active" aria-current="page">@AccountSharedResource.Create_PageHeader</li>
            </ol>
        </nav>
    </div>

    <!-- Main Card -->
    <div class="app-content-card p-4">
        <form asp-action="Create" method="post" id="accCreateForm">
            @Html.AntiForgeryToken()

            <div class="form-section-title">@AccountSharedResource.Create_Section_AccountInfo</div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label required" asp-for="FullName">@AccountModelResource.Fullname</label>
                    <input class="form-control" asp-for="FullName" id="accFullName" placeholder="@AccountSharedResource.Placeholder_FullName" autocomplete="off" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label required" asp-for="Email">@AccountSharedResource.Email</label>
                    <input class="form-control" asp-for="Email" placeholder="@AccountSharedResource.Placeholder_Email" autocomplete="off" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label" asp-for="PhoneNumber">@AccountModelResource.PhoneNumber</label>
                    <input class="form-control" asp-for="PhoneNumber" type="tel" inputmode="numeric" maxlength="10" data-phone-input autocomplete="off" placeholder="0901234567" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label required" asp-for="DateOfBirth">@AccountModelResource.DateOfBirth</label>
                    <input class="form-control" type="date" asp-for="DateOfBirth" />
                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="Gender">@AccountModelResource.Gender</label>
                    <select class="form-select" asp-for="Gender" asp-items="Html.GetEnumSelectList<RWPM.Common.Enums.Gender>()">
                        <option value="">@AccountSharedResource.Dropdown_SelectGender</option>
                    </select>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label required" asp-for="Username">@AccountModelResource.Username</label>
                    <div class="input-group">
                        <span class="input-group-text text-muted"><i class="bi bi-at"></i></span>
                        <input class="form-control font-monospace" asp-for="Username" id="accUsername" placeholder="@AccountSharedResource.Placeholder_Username" autocomplete="off" />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                    <div class="form-text">@AccountSharedResource.Create_UsernameHint</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label required" asp-for="Role">@AccountModelResource.Role</label>
                    <select asp-for="Role" asp-items="Model.AccountRoleSelectList" id="accRoleSelect" class="form-select">
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12">
                    <label class="form-label required" asp-for="Password">@AccountModelResource.Password</label>
                    <div class="input-group">
                        @* Ô mật khẩu mặc định không render lại giá trị khi form báo lỗi -> gán value tường minh để giữ nguyên mật khẩu đã tạo *@
                        <input type="password" class="form-control font-monospace" asp-for="Password" value="@Model?.Password" id="accPassword" placeholder="@AccountSharedResource.Placeholder_Password" autocomplete="new-password" />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePasswordVisibility('accPassword', 'toggleIcon')" title="@AccountSharedResource.Button_TogglePassword" aria-label="@AccountSharedResource.Button_TogglePassword">
                            <i class="bi bi-eye" id="toggleIcon"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="generateAndSetPassword()" title="@AccountSharedResource.Create_GeneratePassHint">
                            <i class="bi bi-dice-5 me-1"></i> @AccountSharedResource.Button_GenerateRandom
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>

                    <div id="passwordCopyAlert" class="border rounded mt-2 py-2 px-3 small d-none justify-content-between align-items-center" style="background: var(--app-surface-2);">
                        <span class="text-muted">@AccountModelResource.Password: <strong id="generatedPassText" class="font-monospace text-body"></strong></span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="copyToClipboard($('#generatedPassText').text(), RWPM.accForm.i18n.copiedPassword)">
                            <i class="bi bi-copy me-1"></i> @AccountSharedResource.Button_Copy
                        </button>
                    </div>
                </div>
            </div>

            <!-- KHỐI THÔNG TIN HỒ SƠ NHÂN VIÊN & CỬA HÀNG (TỰ ĐỘNG HIỂN THỊ KHI CHỌN VAI TRÒ CỬA HÀNG HOẶC HR) -->
            <div id="storeAssignmentSection">
                <div class="form-section-title mt-4">
                    <span id="employeeSectionTitleText">@AccountSharedResource.Create_Section_StoreInfo</span>
                </div>

                <div class="alert alert-info py-2 px-3 small mb-3">
                    <i class="bi bi-info-circle me-2"></i>
                    <span id="storeInfoHintText">@AccountSharedResource.Create_StoreInfoHint</span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4" id="empCodeCol">
                        <label class="form-label required" asp-for="EmployeeCode">@EmployeeSharedResource.Column_EmployeeCode</label>
                        <input class="form-control font-monospace" asp-for="EmployeeCode" id="empCodeInput" placeholder="NV..." autocomplete="off" />
                        <span asp-validation-for="EmployeeCode" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4" id="storeSelectCol">
                        <label class="form-label required" asp-for="StoreId">@EmployeeSharedResource.Column_Store</label>
                        <select class="form-select" asp-for="StoreId" asp-items="Model.StoreSelectList" id="storeSelectInput">
                        </select>
                        <span asp-validation-for="StoreId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4" id="joinDateCol">
                        <label class="form-label required" asp-for="JoinDate">@EmployeeSharedResource.Column_JoinDate</label>
                        <input class="form-control" type="date" asp-for="JoinDate" />
                        <span asp-validation-for="JoinDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4" id="citizenIdCol">
                        <label class="form-label required" asp-for="CitizenId">@EmployeeModelResource.CitizenId</label>
                        <input class="form-control font-monospace" asp-for="CitizenId" type="text" inputmode="numeric" maxlength="12" autocomplete="off"
                               data-citizen-id-input placeholder="@EmployeeModelResource.CitizenId"
                               data-val-regex="@RWPM.Common.Validation.InputRules.Text("Số CCCD/CMND phải gồm 12 chữ số (CCCD) hoặc 9 chữ số (CMND).", "Citizen ID must contain 12 digits (CCCD) or 9 digits (old ID card).")"
                               data-val-regex-pattern="^([0-9]{9}|[0-9]{12})$" />
                        <span asp-validation-for="CitizenId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4" id="employmentTypeCol">
                        <label class="form-label" asp-for="EmploymentType">@EmployeeModelResource.EmploymentType</label>
                        <select class="form-select" asp-for="EmploymentType" asp-items="Html.GetEnumSelectList<RWPM.Common.Enums.EmploymentType>()">
                        </select>
                    </div>
                    <div class="col-md-4" id="hourlyRateCol">
                        <label class="form-label required" asp-for="HourlyRate">@EmployeeModelResource.HourlyRate</label>
                        <div class="input-group">
                            <input class="form-control" asp-for="HourlyRate" asp-format="{0:0}" type="number" min="0" step="1000" placeholder="25000" />
                            <span class="input-group-text">@SharedResource.Unit_VndPerHour</span>
                        </div>
                        <span asp-validation-for="HourlyRate" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary px-3">@SharedResource.Button_Cancel</a>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check2 me-1"></i> @SharedResource.Button_Create
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/personnel-input.js" asp-append-version="true"></script>
    <script>
        window.RWPM = window.RWPM || {};
        RWPM.accForm = {
            isCreate: true,
            i18n: {
                copiedPassword: @Json.Serialize(AccountSharedResource.Toast_CopiedPassword),
                storeSectionTitle: @Json.Serialize(AccountSharedResource.Create_Section_StoreInfo),
                storeSectionHint: @Json.Serialize(AccountSharedResource.Create_StoreInfoHint),
                hrSectionTitle: @Json.Serialize(AccountSharedResource.Create_Section_HrInfo),
                hrSectionHint: @Json.Serialize(AccountSharedResource.Create_HrInfoHint)
            }
        };
    </script>
    <script src="~/js/acc/form.js" asp-append-version="true"></script>
}
