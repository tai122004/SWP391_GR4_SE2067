@model AccListVM

@using AccountModelResource = RWPM.Resources.Models.Acc
@using AccountSharedResource = RWPM.Resources.Shared.Acc
@using Microsoft.AspNetCore.Mvc.Localization
@using RWPM.Common.Enums
@using RWPM.Models.Common
@using RWPM.Models.ViewModels.Acc

@{
    ViewData["Title"] = AccountSharedResource.Index_PageTitle;
}

@Html.AntiForgeryToken()

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-dark d-flex align-items-center mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>
                @AccountSharedResource.Index_PageHeader
            </h4>
            <div class="text-muted small">@AccountSharedResource.Index_SubTitle</div>
        </div>
        <div class="d-flex gap-2">
            <!-- Dropdown Excel -->
            <div class="dropdown">
                <button class="btn btn-outline-success btn-sm dropdown-toggle shadow-sm px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-file-earmark-excel me-1"></i> @AccountSharedResource.Excel_Action
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                    <li>
                        <a class="dropdown-item d-flex align-items-center" asp-action="DownloadTemplate">
                            <i class="bi bi-file-earmark-arrow-down text-primary me-2 fs-6"></i> @AccountSharedResource.Excel_DownloadTemplate
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#importExcelModal">
                            <i class="bi bi-file-earmark-arrow-up text-success me-2 fs-6"></i> @AccountSharedResource.Excel_Import
                        </a>
                    </li>
                </ul>
            </div>

            <a asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> @SharedResource.Button_Create
            </a>
        </div>
    </div>

    <!-- Thông báo khi vừa tạo tài khoản/nhân viên mới -->
    @if (TempData["CreatedAccountNotice"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center justify-content-between p-3 mb-3 shadow-sm" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-4 text-success me-3"></i>
                <div>
            <strong>@AccountSharedResource.Notice_CreatedSuccess</strong>
                    <div class="small mt-1 text-secondary font-monospace">@TempData["CreatedAccountNotice"]</div>
                </div>
            </div>
            <div>
                <button type="button" class="btn btn-sm btn-outline-success me-2" onclick="copyToClipboard('@TempData["CreatedAccountNotice"]', 'Đã sao chép thông tin tài khoản!')">
                    <i class="bi bi-copy me-1"></i> Sao chép
                </button>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }



    <!-- Search Toolbar -->
    <div class="modern-card p-3 mb-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-6 col-lg-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" asp-for="Search" class="form-control border-start-0 ps-0" placeholder="@AccountSharedResource.Placeholder_Search" />
                </div>
            </div>

            <div class="col-md-4 col-lg-3">
                <select name="IsActive" class="form-select form-select-sm">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.IsActive))">-- @SharedResource.ObjectStatus --</option>
                    <option value="true" selected="@(Model.IsActive == "true")">@SharedResource.ObjectStatus_IsActive</option>
                    <option value="false" selected="@(Model.IsActive == "false")">@SharedResource.ObjectStatus_IsInactive</option>
                </select>
            </div>

            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary">
                    <i class="bi bi-funnel me-1"></i> @SharedResource.Button_Search
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="@SharedResource.Button_Reset">
                    <i class="bi bi-arrow-clockwise"></i> @SharedResource.Button_Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Modern Table Card -->
    <div class="modern-card overflow-hidden mb-3">
        <div class="table-responsive">
            <table class="table modern-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>@AccountModelResource.Fullname / Email</th>
                        <th>@AccountModelResource.Username</th>
                        <th class="text-center">@AccountModelResource.Role</th>
                        <th class="text-end">@SharedResource.CreatedDate</th>
                        <th class="text-end">@AccountModelResource.LastLogin</th>
                        <th class="text-center">@SharedResource.ObjectStatus</th>
                        <th class="text-center">@SharedResource.Button_Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PanigationResponse.Data != null && Model.PanigationResponse.Data.Any())
                    {
                        foreach (var category in Model.PanigationResponse.Data)
                        {
                            var roleBadgeClass = category.Role switch
                            {
                                AccountRole.Admin => "bg-danger text-white",
                                AccountRole.HR => "bg-warning text-dark",
                                AccountRole.StoreManager => "bg-success text-white",
                                AccountRole.SalesStaff => "bg-info text-dark",
                                _ => "bg-secondary text-white"
                            };

                            var initials = "U";
                            if (!string.IsNullOrWhiteSpace(category.FullName))
                            {
                                var parts = category.FullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                if (parts.Length > 1)
                                {
                                    initials = $"{parts[0][0]}{parts[^1][0]}".ToUpper();
                                }
                                else if (parts.Length == 1 && parts[0].Length > 0)
                                {
                                    initials = parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
                                }
                            }
                            var colorIndex = Math.Abs(category.Username.GetHashCode()) % 6;

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-initials avatar-color-@colorIndex me-2">@initials</div>
                                        <div>
                                            <div class="fw-semibold text-dark">@category.FullName</div>
                                            <small class="text-muted"><i class="bi bi-envelope me-1"></i>@(string.IsNullOrEmpty(category.Email) ? "-" : category.Email)</small>
                                        </div>
                                    </div>
                                </td>
                                <td><code>@category.Username</code></td>
                                <td class="text-center">
                                    <span class="badge @roleBadgeClass px-2 py-1 rounded-pill">@category.Role.GetDisplayName()</span>
                                </td>
                                <td class="text-end small text-muted">
                                    @category.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-end small text-muted">
                                    @(category.LastLogin?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                </td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input active-toggle"
                                               type="checkbox"
                                               id="isActiveSwitch_@category.Username"
                                               @(category.IsActive ? "checked" : "")
                                               onchange="onToggleAccountStatus('@category.Username', this.checked)"
                                               title="@(category.IsActive ? "Đang hoạt động" : "Đang khóa")" />
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-action-group" role="group">
                                        <a asp-action="Edit"
                                           asp-route-id="@category.Username"
                                           class="btn btn-sm btn-outline-primary"
                                           title="@SharedResource.Button_Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-warning"
                                                onclick="openQuickResetPassword('@category.Username', '@category.FullName')"
                                                title="@AccountSharedResource.Modal_QuickResetTitle">
                                            <i class="bi bi-key"></i>
                                        </button>

                                        <a asp-action="Delete"
                                           asp-route-id="@category.Username"
                                           class="btn btn-sm btn-outline-danger"
                                           title="@SharedResource.Button_Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                @SharedResource.NoDataFound
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @await Html.PartialAsync("_PaginationPartial", Model.PanigationResponse.ToPaginationRes(new Dictionary<string, string?>() {
        { "Search", Model.Search },
        { "IsActive", Model.IsActive },
    }))
</div>

<!-- Modal Đổi Mật Khẩu Nhanh -->
<div class="modal fade" id="modalQuickResetPassword"
     data-label-account="@AccountSharedResource.Label_Account"
     data-label-password="@AccountModelResource.Password"
     data-toast-copied="@AccountSharedResource.Toast_CopiedAccountPassword"
     data-err-minlen="@AccountSharedResource.Err_MinLengthPassword"
     data-err-match="@AccountSharedResource.Err_PasswordMismatch"
     data-text-saving="@AccountSharedResource.Saving"
     data-toast-success="@AccountSharedResource.Toast_ResetPasswordSuccess"
     tabindex="-1" aria-labelledby="modalQuickResetPasswordLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fs-6 d-flex align-items-center" id="modalQuickResetPasswordLabel">
                    <i class="bi bi-key-fill me-2 fs-5"></i> @AccountSharedResource.Modal_QuickResetTitle
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="quickResetModal_Username" />
                
                <div class="alert alert-info py-2 px-3 small d-flex align-items-center mb-3">
                    <i class="bi bi-person-check fs-5 me-2"></i>
                    <div>@AccountSharedResource.Modal_QuickResetFor <strong id="quickResetModal_DisplayUser"></strong></div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">@AccountSharedResource.Modal_QuickResetNewPass</label>
                    <div class="input-group">
                        <input type="text" id="quickResetModal_NewPassword" class="form-control" placeholder="@AccountSharedResource.Placeholder_Password" autocomplete="off" />
                        <button class="btn btn-outline-secondary" type="button" onclick="regenerateQuickResetPassword()" title="@AccountSharedResource.Create_GeneratePassHint">
                            <i class="bi bi-dice-5 me-1"></i> @AccountSharedResource.Button_GenerateRandom
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">@AccountSharedResource.Modal_QuickResetConfirmPass</label>
                    <input type="text" id="quickResetModal_ConfirmPassword" class="form-control" placeholder="@AccountSharedResource.Modal_QuickResetPlaceholderConfirmPass" autocomplete="off" />
                </div>

                <div class="p-3 bg-light rounded border d-flex justify-content-between align-items-center mb-1">
                    <div class="small text-truncate me-2">
                        <i class="bi bi-clipboard me-1 text-muted"></i>
                        <span id="quickResetModal_CopyText" class="text-secondary font-monospace"></span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-dark text-nowrap" onclick="copyToClipboard($('#quickResetModal_CopyText').text(), '@AccountSharedResource.Toast_CopiedAccountPassword')">
                        <i class="bi bi-copy me-1"></i> @AccountSharedResource.Button_Copy
                    </button>
                </div>
                <small class="text-muted d-block mt-1"><i class="bi bi-info-circle me-1"></i>@AccountSharedResource.Modal_QuickResetHint</small>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">@SharedResource.Button_Cancel</button>
                <button type="button" id="quickResetModal_BtnSubmit" class="btn btn-sm btn-primary" onclick="submitQuickResetPassword()">
                    <i class="bi bi-check2-circle me-1"></i> @AccountSharedResource.Modal_QuickResetSaveBtn
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Import Excel (2 bước: Chọn file -> Xem trước & Kiểm tra -> Chấp thuận) -->
<div class="modal fade" id="importExcelModal" tabindex="-1" aria-labelledby="importExcelModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light py-3 border-bottom">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center" id="importExcelModalLabel">
                    <i class="bi bi-file-earmark-excel-fill text-success me-2 fs-5"></i> @AccountSharedResource.Excel_ImportTitle
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4">
                <!-- BƯỚC 1: Chọn file Excel -->
                <div id="accImportStep1">
                    <div class="alert alert-info py-2 px-3 small mb-3 d-flex align-items-center">
                        <i class="bi bi-info-circle-fill me-2 fs-5 flex-shrink-0"></i>
                        <span>@AccountSharedResource.Excel_Step1_Note</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small required">@AccountSharedResource.Excel_SelectFile</label>
                        <input type="file" id="accImportFileInput" class="form-control form-control-lg" accept=".xlsx" />
                        <div class="form-text small mt-1">Định dạng hỗ trợ: .xlsx (Microsoft Excel)</div>
                    </div>

                    <div id="accImportStep1Error" class="alert alert-danger py-2 px-3 small d-none"></div>
                </div>

                <!-- BƯỚC 2: Xem trước dữ liệu & Kiểm tra trùng lặp -->
                <div id="accImportStep2" class="d-none">
                    <!-- Thống kê kết quả kiểm tra -->
                    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between p-3 bg-light rounded border mb-3">
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <span class="badge bg-secondary px-3 py-2 fs-6">
                                <i class="bi bi-list-ol me-1"></i> @AccountSharedResource.Excel_Summary_Total <strong id="accPreviewTotal" class="ms-1">0</strong>
                            </span>
                            <span class="badge bg-success px-3 py-2 fs-6">
                                <i class="bi bi-check-circle me-1"></i> @AccountSharedResource.Excel_Summary_Valid <strong id="accPreviewValid" class="ms-1">0</strong>
                            </span>
                            <span class="badge bg-danger px-3 py-2 fs-6">
                                <i class="bi bi-exclamation-octagon me-1"></i> @AccountSharedResource.Excel_Summary_Invalid <strong id="accPreviewInvalid" class="ms-1">0</strong>
                            </span>
                        </div>
                        <div class="small text-muted">
                            <i class="bi bi-shield-check text-primary me-1"></i> Dữ liệu được kiểm tra tự động trước khi lưu
                        </div>
                    </div>

                    <!-- Cảnh báo nếu có dòng lỗi / trùng -->
                    <div id="accPreviewWarning" class="alert alert-warning py-2 px-3 small mb-3 d-none">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @AccountSharedResource.Excel_Preview_Warning_HasErrors
                    </div>
                    <div id="accPreviewSuccessNotice" class="alert alert-success py-2 px-3 small mb-3 d-none">
                        <i class="bi bi-check-circle-fill me-1"></i> @AccountSharedResource.Excel_Preview_All_Valid
                    </div>
                    <div id="accPreviewDangerNotice" class="alert alert-danger py-2 px-3 small mb-3 d-none">
                        <i class="bi bi-x-circle-fill me-1"></i> @AccountSharedResource.Excel_Preview_No_Valid
                    </div>

                    <!-- Bảng Preview dữ liệu -->
                    <div class="table-responsive border rounded" style="max-height: 420px; overflow-y: auto;">
                        <table class="table table-sm table-hover table-bordered align-middle mb-0 text-nowrap">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th class="text-center" style="width: 50px;">@AccountSharedResource.Excel_Col_Row</th>
                                    <th class="text-center" style="width: 120px;">@AccountSharedResource.Excel_Col_Status</th>
                                    <th>@AccountSharedResource.Excel_Col_Username</th>
                                    <th>@AccountSharedResource.Excel_Col_FullName</th>
                                    <th>Email</th>
                                    <th>Số ĐT</th>
                                    <th>@AccountSharedResource.Excel_Col_Role</th>
                                    <th>@AccountSharedResource.Excel_Col_Store</th>
                                    <th>@AccountSharedResource.Excel_Col_EmpCode</th>
                                    <th style="min-width: 260px;">@AccountSharedResource.Excel_Col_Errors</th>
                                </tr>
                            </thead>
                            <tbody id="accPreviewTableBody">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light py-2 border-top">
                <!-- Footer buttons cho Bước 1 -->
                <div id="accStep1Footer" class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">@AccountSharedResource.Excel_Close</button>
                    <button type="button" id="accBtnPreview" class="btn btn-sm btn-primary px-3" onclick="previewAccImport()">
                        <i class="bi bi-search me-1"></i> @AccountSharedResource.Excel_Btn_Preview
                    </button>
                </div>

                <!-- Footer buttons cho Bước 2 -->
                <div id="accStep2Footer" class="d-flex gap-2 d-none">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="backToAccStep1()">
                        <i class="bi bi-arrow-left me-1"></i> @AccountSharedResource.Excel_Btn_Back
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">@AccountSharedResource.Excel_Close</button>
                    <button type="button" id="accBtnConfirm" class="btn btn-sm btn-success px-3 fw-bold" onclick="confirmAccImport()">
                        <i class="bi bi-check2-circle me-1"></i> @AccountSharedResource.Excel_Btn_Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        let currentAccImportToken = '';

        function escapeHtml(text) {
            if (!text) return '';
            return text.toString()
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function previewAccImport() {
            const fileInput = document.getElementById('accImportFileInput');
            const errBox = $('#accImportStep1Error');
            errBox.addClass('d-none').text('');

            if (!fileInput.files || fileInput.files.length === 0) {
                errBox.removeClass('d-none').text('Vui lòng chọn một file Excel (.xlsx).');
                return;
            }

            const file = fileInput.files[0];
            if (!file.name.toLowerCase().endsWith('.xlsx')) {
                errBox.removeClass('d-none').text('Chỉ chấp nhận file định dạng Excel (.xlsx).');
                return;
            }

            const btn = $('#accBtnPreview');
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> @AccountSharedResource.Excel_Btn_Verifying');

            const formData = new FormData();
            formData.append('file', file);

            const token = $('input[name="__RequestVerificationToken"]').first().val();

            fetch('/Acc/PreviewImportExcel', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                },
                body: formData
            })
            .then(r => r.json())
            .then(res => {
                if (!res.success) {
                    errBox.removeClass('d-none').text(res.message || 'Lỗi khi kiểm tra file Excel.');
                    return;
                }

                const data = res.data;
                currentAccImportToken = data.importToken;

                $('#accPreviewTotal').text(data.totalRows);
                $('#accPreviewValid').text(data.validCount);
                $('#accPreviewInvalid').text(data.invalidCount);

                $('#accPreviewWarning').addClass('d-none');
                $('#accPreviewSuccessNotice').addClass('d-none');
                $('#accPreviewDangerNotice').addClass('d-none');

                if (data.validCount === 0) {
                    $('#accPreviewDangerNotice').removeClass('d-none');
                    $('#accBtnConfirm').prop('disabled', true);
                } else if (data.invalidCount > 0) {
                    $('#accPreviewWarning').removeClass('d-none');
                    $('#accBtnConfirm').prop('disabled', false);
                } else {
                    $('#accPreviewSuccessNotice').removeClass('d-none');
                    $('#accBtnConfirm').prop('disabled', false);
                }

                const tbody = $('#accPreviewTableBody');
                tbody.empty();

                (data.rows || []).forEach(row => {
                    const tr = $('<tr>');
                    if (row.isValid) {
                        tr.addClass('table-success bg-opacity-10');
                    } else {
                        tr.addClass('table-danger bg-opacity-10');
                    }

                    const statusBadge = row.isValid
                        ? `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>@AccountSharedResource.Excel_Status_Valid</span>`
                        : `<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>@AccountSharedResource.Excel_Status_Invalid</span>`;

                    const errHtml = row.isValid
                        ? `<span class="text-success small"><i class="bi bi-check2 me-1"></i>Sẵn sàng nhập</span>`
                        : `<span class="text-danger small fw-semibold"><i class="bi bi-exclamation-circle me-1"></i>${escapeHtml(row.errorMessage || '')}</span>`;

                    tr.html(`
                        <td class="text-center fw-bold text-muted">${row.rowNum}</td>
                        <td class="text-center">${statusBadge}</td>
                        <td class="fw-semibold text-dark">${escapeHtml(row.username)}</td>
                        <td>${escapeHtml(row.fullName)}</td>
                        <td class="small text-muted">${escapeHtml(row.email)}</td>
                        <td class="small text-muted">${escapeHtml(row.phone || '')}</td>
                        <td><span class="badge bg-primary bg-opacity-75">${escapeHtml(row.roleDisplay)}</span></td>
                        <td><span class="badge bg-secondary bg-opacity-75">${escapeHtml(row.storeDisplay)}</span></td>
                        <td class="small fw-semibold text-secondary">${escapeHtml(row.empCode)}</td>
                        <td>${errHtml}</td>
                    `);

                    tbody.append(tr);
                });

                $('#accImportStep1').addClass('d-none');
                $('#accImportStep2').removeClass('d-none');
                $('#accStep1Footer').addClass('d-none');
                $('#accStep2Footer').removeClass('d-none');
            })
            .catch(err => {
                errBox.removeClass('d-none').text('Lỗi kết nối máy chủ: ' + err.message);
            })
            .finally(() => {
                btn.prop('disabled', false).html('<i class="bi bi-search me-1"></i> @AccountSharedResource.Excel_Btn_Preview');
            });
        }

        function backToAccStep1() {
            $('#accImportStep2').addClass('d-none');
            $('#accImportStep1').removeClass('d-none');
            $('#accStep2Footer').addClass('d-none');
            $('#accStep1Footer').removeClass('d-none');
        }

        function confirmAccImport() {
            if (!currentAccImportToken) return;

            const btn = $('#accBtnConfirm');
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> @AccountSharedResource.Excel_Btn_Saving');

            const token = $('input[name="__RequestVerificationToken"]').first().val();

            fetch('/Acc/ConfirmImportExcel', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ importToken: currentAccImportToken })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    if (typeof toastr !== 'undefined') {
                        toastr.success(res.message);
                    }
                    const modalEl = document.getElementById('importExcelModal');
                    if (modalEl) {
                        bootstrap.Modal.getInstance(modalEl)?.hide();
                    }
                    setTimeout(() => {
                        window.location.reload();
                    }, 800);
                } else {
                    if (typeof toastr !== 'undefined') {
                        toastr.error(res.message || 'Lưu dữ liệu thất bại.');
                    } else {
                        alert(res.message || 'Lưu dữ liệu thất bại.');
                    }
                    btn.prop('disabled', false).html('<i class="bi bi-check2-circle me-1"></i> @AccountSharedResource.Excel_Btn_Confirm');
                }
            })
            .catch(err => {
                if (typeof toastr !== 'undefined') {
                    toastr.error('Lỗi khi lưu: ' + err.message);
                } else {
                    alert('Lỗi khi lưu: ' + err.message);
                }
                btn.prop('disabled', false).html('<i class="bi bi-check2-circle me-1"></i> @AccountSharedResource.Excel_Btn_Confirm');
            });
        }

        $('#importExcelModal').on('hidden.bs.modal', function () {
            backToAccStep1();
            $('#accImportFileInput').val('');
            $('#accImportStep1Error').addClass('d-none').text('');
        });

        function onToggleAccountStatus(username, isActive) {
            const token = $('input[name="__RequestVerificationToken"]').val();
            const checkbox = document.getElementById("isActiveSwitch_" + username);

            fetch('/Acc/UpdateActiveStatus/' + username, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    username: username,
                    isActive: isActive
                })
            })
            .then(response => {
                if (!response.ok) {
                    return response.text().then(text => { throw new Error(text); });
                }
                if (typeof toastr !== 'undefined') {
                    toastr.success(isActive ? `Đã kích hoạt tài khoản ${username}!` : `Đã tạm khóa tài khoản ${username}!`);
                }
            })
            .catch(error => {
                if (typeof toastr !== 'undefined') {
                    toastr.error("Lỗi cập nhật trạng thái: " + error.message);
                } else {
                    alert("Lỗi cập nhật trạng thái: " + error.message);
                }
                if (checkbox) checkbox.checked = !isActive;
            });
        }
    </script>
}
