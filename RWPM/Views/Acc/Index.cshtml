@model AccListVM

@using AccountModelResource = RWPM.Resources.Models.Acc
@using AccountSharedResource = RWPM.Resources.Shared.Acc
@using Microsoft.AspNetCore.Mvc.Localization
@using RWPM.Common.Enums
@using RWPM.Models.Common
@using RWPM.Models.ViewModels.Acc

@{
    ViewData["Title"] = AccountSharedResource.Index_PageTitle;
}

@Html.AntiForgeryToken()

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="app-page-header">
        <div>
            <h4 class="mb-1">@AccountSharedResource.Index_PageHeader</h4>
            <div class="text-muted small">@AccountSharedResource.Index_SubTitle</div>
        </div>
        <div class="app-page-actions">
            <!-- Dropdown Excel -->
            <div class="dropdown">
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-file-earmark-excel me-1"></i> @AccountSharedResource.Excel_Action
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item d-flex align-items-center" asp-action="DownloadTemplate">
                            <i class="bi bi-file-earmark-arrow-down text-muted me-2"></i> @AccountSharedResource.Excel_DownloadTemplate
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#importExcelModal">
                            <i class="bi bi-file-earmark-arrow-up text-muted me-2"></i> @AccountSharedResource.Excel_Import
                        </a>
                    </li>
                </ul>
            </div>

            <a asp-action="Create" class="btn btn-primary btn-sm px-3">
                <i class="bi bi-person-plus-fill me-1"></i> @SharedResource.Button_Create
            </a>
        </div>
    </div>

    <!-- Thông báo khi vừa tạo tài khoản/nhân viên mới -->
    @if (TempData["CreatedAccountNotice"] != null)
    {
        <div class="alert alert-success fade show d-flex align-items-center justify-content-between gap-3 p-3 mb-3" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-5 text-success me-3"></i>
                <div>
                    <strong>@AccountSharedResource.Notice_CreatedSuccess</strong>
                    <div class="small mt-1 text-secondary font-monospace">@TempData["CreatedAccountNotice"]</div>
                </div>
            </div>
            <div class="d-flex align-items-center flex-shrink-0">
                <button type="button" class="btn btn-sm btn-outline-secondary me-3" data-copy="@TempData["CreatedAccountNotice"]" onclick="copyToClipboard(this.dataset.copy, RWPM.accIndex.i18n.copied)">
                    <i class="bi bi-copy me-1"></i> @AccountSharedResource.Button_Copy
                </button>
                <button type="button" class="btn-close position-static p-2" data-bs-dismiss="alert" aria-label="@SharedResource.Button_Close"></button>
            </div>
        </div>
    }



    <!-- Search Toolbar -->
    <div class="app-filter-panel">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-6 col-lg-5">
                <label class="form-label">@SharedResource.Button_Search</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" asp-for="Search" class="form-control border-start-0 ps-0" placeholder="@AccountSharedResource.Placeholder_Search" />
                </div>
            </div>

            <div class="col-md-4 col-lg-3">
                <label class="form-label">@SharedResource.ObjectStatus</label>
                <select name="IsActive" class="form-select form-select-sm">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.IsActive))">-- @SharedResource.ObjectStatus_Default --</option>
                    <option value="true" selected="@(Model.IsActive == "true")">@SharedResource.ObjectStatus_IsActive</option>
                    <option value="false" selected="@(Model.IsActive == "false")">@SharedResource.ObjectStatus_IsInactive</option>
                </select>
            </div>

            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-funnel me-1"></i> @SharedResource.Button_Search
                </button>
                <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-muted" title="@SharedResource.Button_Reset">
                    <i class="bi bi-arrow-clockwise"></i> @SharedResource.Button_Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Modern Table Card -->
    <div class="app-content-card management-table-card mb-3">
        <div class="table-responsive">
            <table class="table modern-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>@AccountModelResource.Fullname / @AccountModelResource.Email</th>
                        <th>@AccountModelResource.Username</th>
                        <th class="text-center">@AccountModelResource.Role</th>
                        <th class="text-end">@SharedResource.CreatedDate</th>
                        <th class="text-end">@AccountModelResource.LastLogin</th>
                        <th class="text-center">@SharedResource.ObjectStatus</th>
                        <th class="text-center">@SharedResource.Button_Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PanigationResponse.Data != null && Model.PanigationResponse.Data.Any())
                    {
                        foreach (var category in Model.PanigationResponse.Data)
                        {
                            <tr>
                                <td>
                                    <div class="fw-medium">@category.FullName</div>
                                    <small class="text-muted">@(string.IsNullOrEmpty(category.Email) ? "-" : category.Email)</small>
                                </td>
                                <td><span class="font-monospace small">@category.Username</span></td>
                                <td class="text-center">
                                    <span class="app-badge app-badge-neutral">@category.Role.GetDisplayName()</span>
                                </td>
                                <td class="text-end small text-muted">
                                    @category.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-end small text-muted">
                                    @(category.LastLogin?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                </td>
                                <td class="text-center">
                                    <label class="status-choice">
                                        <input class="form-check-input active-toggle"
                                               type="checkbox"
                                               id="isActiveSwitch_@category.Username"
                                               @(category.IsActive ? "checked" : "")
                                               onchange="onToggleAccountStatus('@category.Username', this.checked)"
                                               title="@(category.IsActive ? SharedResource.ObjectStatus_IsActive : SharedResource.ObjectStatus_IsInactive)" />
                                        <span class="status-dot @(category.IsActive ? "is-active" : "is-inactive")"></span>
                                        <span class="status-choice-text">@(category.IsActive ? SharedResource.ObjectStatus_IsActive : SharedResource.ObjectStatus_IsInactive)</span>
                                    </label>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-action-group" role="group">
                                        <a asp-action="Edit"
                                           asp-route-id="@category.Username"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="@SharedResource.Button_Edit" aria-label="@SharedResource.Button_Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                data-username="@category.Username" data-fullname="@category.FullName" onclick="openQuickResetPassword(this.dataset.username, this.dataset.fullname)"
                                                title="@AccountSharedResource.Modal_QuickResetTitle" aria-label="@AccountSharedResource.Modal_QuickResetTitle">
                                            <i class="bi bi-key"></i>
                                        </button>

                                        <button type="submit"
                                                form="deleteAccForm_@category.Username"
                                                class="btn btn-sm btn-outline-danger"
                                                title="@SharedResource.Button_Delete" aria-label="@SharedResource.Button_Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                    <form id="deleteAccForm_@category.Username" asp-action="DeleteConfirmed" method="post" class="d-none"
                                          data-confirm="@SharedResource.ConfirmDelete&#10;@category.FullName (@category.Username)"
                                          data-confirm-title="@SharedResource.Button_Delete"
                                          data-confirm-ok="@SharedResource.Button_Delete"
                                          data-confirm-cancel="@SharedResource.Button_Cancel"
                                          data-confirm-type="danger">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="username" value="@category.Username" />
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-2 text-muted"></i>
                                @SharedResource.NoDataFound
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @await Html.PartialAsync("_PaginationPartial", Model.PanigationResponse.ToPaginationRes(new Dictionary<string, string?>() {
        { "Search", Model.Search },
        { "IsActive", Model.IsActive },
    }))
</div>

<!-- Modal Đổi Mật Khẩu Nhanh -->
<div class="modal fade" id="modalQuickResetPassword"
     data-label-account="@AccountSharedResource.Label_Account"
     data-label-password="@AccountModelResource.Password"
     data-toast-copied="@AccountSharedResource.Toast_CopiedAccountPassword"
     data-err-minlen="@AccountSharedResource.Err_MinLengthPassword"
     data-err-match="@AccountSharedResource.Err_PasswordMismatch"
     data-text-saving="@AccountSharedResource.Saving"
     data-toast-success="@AccountSharedResource.Toast_ResetPasswordSuccess"
     tabindex="-1" aria-labelledby="modalQuickResetPasswordLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-3">
                <h5 class="modal-title" id="modalQuickResetPasswordLabel">@AccountSharedResource.Modal_QuickResetTitle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedResource.Button_Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="quickResetModal_Username" />
                
                <div class="alert alert-info py-2 px-3 small d-flex align-items-center mb-3">
                    <i class="bi bi-person-check me-2"></i>
                    <div>@AccountSharedResource.Modal_QuickResetFor <strong id="quickResetModal_DisplayUser"></strong></div>
                </div>

                <div class="mb-3">
                    <label class="form-label required" for="quickResetModal_NewPassword">@AccountSharedResource.Modal_QuickResetNewPass</label>
                    <div class="input-group">
                        <input type="text" id="quickResetModal_NewPassword" class="form-control" placeholder="@AccountSharedResource.Placeholder_Password" autocomplete="off" />
                        <button class="btn btn-outline-secondary" type="button" onclick="regenerateQuickResetPassword()" title="@AccountSharedResource.Create_GeneratePassHint">
                            <i class="bi bi-dice-5 me-1"></i> @AccountSharedResource.Button_GenerateRandom
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label required" for="quickResetModal_ConfirmPassword">@AccountSharedResource.Modal_QuickResetConfirmPass</label>
                    <input type="text" id="quickResetModal_ConfirmPassword" class="form-control" placeholder="@AccountSharedResource.Modal_QuickResetPlaceholderConfirmPass" autocomplete="off" />
                </div>

                <div class="p-2 px-3 border rounded d-flex justify-content-between align-items-center mb-1" style="background: var(--app-surface-2);">
                    <div class="small text-truncate me-2">
                        <i class="bi bi-clipboard me-1 text-muted"></i>
                        <span id="quickResetModal_CopyText" class="text-secondary font-monospace"></span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" onclick="copyToClipboard($('#quickResetModal_CopyText').text(), RWPM.accIndex.i18n.copied)">
                        <i class="bi bi-copy me-1"></i> @AccountSharedResource.Button_Copy
                    </button>
                </div>
                <div class="form-text">@AccountSharedResource.Modal_QuickResetHint</div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">@SharedResource.Button_Cancel</button>
                <button type="button" id="quickResetModal_BtnSubmit" class="btn btn-sm btn-primary" onclick="submitQuickResetPassword()">
                    <i class="bi bi-check2-circle me-1"></i> @AccountSharedResource.Modal_QuickResetSaveBtn
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Import Excel (2 bước: Chọn file -> Xem trước & Kiểm tra -> Chấp thuận) -->
<div class="modal fade" id="importExcelModal" tabindex="-1" aria-labelledby="importExcelModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-3">
                <h5 class="modal-title" id="importExcelModalLabel">@AccountSharedResource.Excel_ImportTitle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedResource.Button_Close"></button>
            </div>
            
            <div class="modal-body p-4">
                <!-- BƯỚC 1: Chọn file Excel -->
                <div id="accImportStep1">
                    <div class="alert alert-info py-2 px-3 small mb-3 d-flex align-items-center">
                        <i class="bi bi-info-circle me-2 flex-shrink-0"></i>
                        <span>@AccountSharedResource.Excel_Step1_Note</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required" for="accImportFileInput">@AccountSharedResource.Excel_SelectFile</label>
                        <input type="file" id="accImportFileInput" class="form-control" accept=".xlsx" />
                        <div class="form-text">@AccountSharedResource.Excel_SupportedFormat</div>
                    </div>

                    <div id="accImportStep1Error" class="alert alert-danger py-2 px-3 small d-none"></div>
                </div>

                <!-- BƯỚC 2: Xem trước dữ liệu & Kiểm tra trùng lặp -->
                <div id="accImportStep2" class="d-none">
                    <!-- Thống kê kết quả kiểm tra -->
                    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <span class="app-badge app-badge-neutral">@AccountSharedResource.Excel_Summary_Total <strong id="accPreviewTotal">0</strong></span>
                            <span class="app-badge app-badge-success">@AccountSharedResource.Excel_Summary_Valid <strong id="accPreviewValid">0</strong></span>
                            <span class="app-badge app-badge-danger">@AccountSharedResource.Excel_Summary_Invalid <strong id="accPreviewInvalid">0</strong></span>
                        </div>
                        <div class="small text-muted">
                            <i class="bi bi-shield-check me-1"></i> @AccountSharedResource.Excel_AutoValidated
                        </div>
                    </div>

                    <!-- Cảnh báo nếu có dòng lỗi / trùng -->
                    <div id="accPreviewWarning" class="alert alert-warning py-2 px-3 small mb-3 d-none">
                        <i class="bi bi-exclamation-triangle me-1"></i> @AccountSharedResource.Excel_Preview_Warning_HasErrors
                    </div>
                    <div id="accPreviewSuccessNotice" class="alert alert-success py-2 px-3 small mb-3 d-none">
                        <i class="bi bi-check-circle me-1"></i> @AccountSharedResource.Excel_Preview_All_Valid
                    </div>
                    <div id="accPreviewDangerNotice" class="alert alert-danger py-2 px-3 small mb-3 d-none">
                        <i class="bi bi-x-circle me-1"></i> @AccountSharedResource.Excel_Preview_No_Valid
                    </div>

                    <!-- Bảng Preview dữ liệu -->
                    <div class="table-responsive border rounded" style="max-height: 420px; overflow-y: auto;">
                        <table class="table table-sm align-middle mb-0 text-nowrap">
                            <thead class="sticky-top">
                                <tr>
                                    <th class="text-end" style="width: 50px;">@AccountSharedResource.Excel_Col_Row</th>
                                    <th class="text-center" style="width: 120px;">@AccountSharedResource.Excel_Col_Status</th>
                                    <th>@AccountSharedResource.Excel_Col_Username</th>
                                    <th>@AccountSharedResource.Excel_Col_FullName</th>
                                    <th>@AccountSharedResource.Excel_Col_Email</th>
                                    <th>@AccountModelResource.PhoneNumber</th>
                                    <th>@AccountSharedResource.Excel_Col_Role</th>
                                    <th>@AccountSharedResource.Excel_Col_Store</th>
                                    <th>@AccountSharedResource.Excel_Col_EmpCode</th>
                                    <th style="min-width: 260px;">@AccountSharedResource.Excel_Col_Errors</th>
                                </tr>
                            </thead>
                            <tbody id="accPreviewTableBody">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="modal-footer py-2">
                <!-- Footer buttons cho Bước 1 -->
                <div id="accStep1Footer" class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">@SharedResource.Button_Close</button>
                    <button type="button" id="accBtnPreview" class="btn btn-sm btn-primary px-3" onclick="previewAccImport()">
                        <i class="bi bi-search me-1"></i> @AccountSharedResource.Excel_Btn_Preview
                    </button>
                </div>

                <!-- Footer buttons cho Bước 2 -->
                <div id="accStep2Footer" class="d-flex gap-2 d-none">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="backToAccStep1()">
                        <i class="bi bi-arrow-left me-1"></i> @AccountSharedResource.Excel_Btn_Back
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">@SharedResource.Button_Close</button>
                    <button type="button" id="accBtnConfirm" class="btn btn-sm btn-primary px-3" onclick="confirmAccImport()">
                        <i class="bi bi-check2-circle me-1"></i> @AccountSharedResource.Excel_Btn_Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        window.RWPM = window.RWPM || {};
        RWPM.accIndex = {
            urls: {
                previewImport: '@Url.Action("PreviewImportExcel", "Acc")',
                confirmImport: '@Url.Action("ConfirmImportExcel", "Acc")',
                updateActiveStatus: '@Url.Action("UpdateActiveStatus", "Acc")'
            },
            i18n: {
                copied: @Json.Serialize(AccountSharedResource.Toast_CopiedAccountPassword),
                selectFile: @Json.Serialize(AccountSharedResource.Excel_SelectFile),
                verifying: @Json.Serialize(AccountSharedResource.Excel_Btn_Verifying),
                preview: @Json.Serialize(AccountSharedResource.Excel_Btn_Preview),
                saving: @Json.Serialize(AccountSharedResource.Excel_Btn_Saving),
                confirm: @Json.Serialize(AccountSharedResource.Excel_Btn_Confirm),
                valid: @Json.Serialize(AccountSharedResource.Excel_Status_Valid),
                invalid: @Json.Serialize(AccountSharedResource.Excel_Status_Invalid),
                failed: @Json.Serialize(SharedResource.OperationFailed),
                active: @Json.Serialize(SharedResource.ObjectStatus_IsActive),
                inactive: @Json.Serialize(SharedResource.ObjectStatus_IsInactive)
            }
        };
    </script>
    <script src="~/js/acc/index.js" asp-append-version="true"></script>
}

