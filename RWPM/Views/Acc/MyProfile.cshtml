@model RWPM.Models.Entities.Acc
@using AccountModelResource = RWPM.Resources.Models.Acc
@using AccountSharedResource = RWPM.Resources.Shared.Acc
@using EmployeeModelResource = RWPM.Resources.Models.Employee
@using EmployeeSharedResource = RWPM.Resources.Shared.Employee
@using RWPM.Common.Enums
@using RWPM.Common.Helper

@{
    ViewData["Title"] = AccountSharedResource.Profile_PageTitle;
    var emp = ViewBag.Employee as RWPM.Models.Entities.Employee;
    var initials = "NV";
    if (!string.IsNullOrWhiteSpace(Model.FullName))
    {
        var parts = Model.FullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length > 1) { initials = $"{parts[0][0]}{parts[^1][0]}".ToUpper(); }
        else if (parts.Length == 1 && parts[0].Length > 0) { initials = parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper(); }
    }
    string StatusBadge(EmploymentStatus s) => s switch
    {
        EmploymentStatus.Official => "app-badge-success",
        EmploymentStatus.Probation => "app-badge-warning",
        EmploymentStatus.OnLeave => "app-badge-info",
        EmploymentStatus.Resigned => "app-badge-danger",
        _ => "app-badge-neutral"
    };
}

<div class="container-fluid px-0">
    <div class="app-page-header">
        <div>
            <h4 class="mb-1">@AccountSharedResource.Profile_PageTitle</h4>
            <div class="text-muted small">@AccountSharedResource.Profile_PageSubTitle</div>
        </div>
        <div class="app-page-actions">
            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i> @AccountSharedResource.Profile_Back
            </a>
            <a asp-action="ChangePassword" class="btn btn-primary btn-sm px-3">
                <i class="bi bi-key me-1"></i> @AccountSharedResource.Profile_ChangePassword
            </a>
        </div>
    </div>

    <!-- Thẻ tiêu đề hồ sơ -->
    <div class="app-content-card p-4 mb-3">
        <div class="d-flex align-items-center flex-wrap gap-3">
            <div class="avatar-initials avatar-color-1 fs-5" style="width: 56px; height: 56px; font-weight: 600;">
                @initials
            </div>
            <div class="flex-grow-1">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h5 class="mb-0">@Model.FullName</h5>
                    <span class="app-badge app-badge-info">@UIHelper.GetDisplayName(Model.Role)</span>
                    @if (emp != null)
                    {
                        <span class="app-badge app-badge-neutral font-monospace">@emp.EmployeeCode</span>
                    }
                </div>
                <div class="d-flex align-items-center gap-3 text-muted small mt-1 flex-wrap">
                    <span><i class="bi bi-person me-1"></i>@Model.Username</span>
                    <span><i class="bi bi-envelope me-1"></i>@Model.Email</span>
                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        <span><i class="bi bi-telephone me-1"></i>@Model.PhoneNumber</span>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (emp != null)
    {
        <div class="app-content-card p-4 mb-3">
            <h5 class="pb-2 border-bottom mb-3">@AccountSharedResource.Profile_Section_JobInfo</h5>

            <div class="row g-3">
                <div class="col-md-4 col-sm-6">
                    <div class="text-muted small">@AccountSharedResource.Profile_Store</div>
                    <div class="fw-medium mt-1">@(emp.Store?.StoreName ?? AccountSharedResource.Profile_StoreUnassigned)</div>
                </div>

                <div class="col-md-4 col-sm-6">
                    <div class="text-muted small">@AccountSharedResource.Profile_Role</div>
                    <div class="fw-medium mt-1">@UIHelper.GetDisplayName(Model.Role)</div>
                </div>

                <div class="col-md-4 col-sm-6">
                    <div class="text-muted small">@AccountSharedResource.Profile_EmploymentType</div>
                    <div class="mt-1"><span class="app-badge app-badge-neutral">@UIHelper.GetDisplayName(emp.EmploymentType)</span></div>
                </div>

                <div class="col-md-4 col-sm-6">
                    <div class="text-muted small">@EmployeeModelResource.EmploymentStatus</div>
                    <div class="mt-1"><span class="app-badge @StatusBadge(emp.Status)">@UIHelper.GetDisplayName(emp.Status)</span></div>
                </div>

                <div class="col-md-4 col-sm-6">
                    <div class="text-muted small">@AccountSharedResource.Profile_JoinDate</div>
                    <div class="fw-medium mt-1 tabular">@emp.JoinDate.ToString("dd/MM/yyyy")</div>
                </div>

                <div class="col-md-4 col-sm-6">
                    <div class="text-muted small">@AccountSharedResource.Profile_LeaveBalance</div>
                    <div class="fw-medium mt-1 tabular">@emp.AnnualLeaveBalance @AccountSharedResource.Profile_Days</div>
                </div>

                @if (emp.HourlyRate.HasValue)
                {
                    <div class="col-md-4 col-sm-6">
                        <div class="text-muted small">@AccountSharedResource.Profile_HourlyRate</div>
                        <div class="fw-medium mt-1 tabular">@emp.HourlyRate.Value.ToString("N0") @RWPM.Resources.Shared.SharedResource.Unit_VndPerHour</div>
                    </div>
                }

                @if (emp.BaseSalary.HasValue)
                {
                    <div class="col-md-4 col-sm-6">
                        <div class="text-muted small">@AccountSharedResource.Profile_BaseSalary</div>
                        <div class="fw-medium mt-1 tabular">@emp.BaseSalary.Value.ToString("N0") @AccountSharedResource.Unit_Vnd</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(emp.CitizenId))
                {
                    <div class="col-md-4 col-sm-6">
                        <div class="text-muted small">@AccountSharedResource.Profile_CitizenId</div>
                        <div class="fw-medium mt-1 font-monospace">@emp.CitizenId</div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="app-content-card p-4">
        <h5 class="pb-2 border-bottom mb-3">@AccountSharedResource.Profile_Section_SystemInfo</h5>

        <div class="row g-3">
            <div class="col-md-4 col-sm-6">
                <div class="text-muted small">@AccountSharedResource.Profile_DateOfBirth</div>
                <div class="fw-medium mt-1">@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd/MM/yyyy") : AccountSharedResource.Profile_NotUpdated)</div>
            </div>

            <div class="col-md-4 col-sm-6">
                <div class="text-muted small">@AccountSharedResource.Profile_Gender</div>
                <div class="fw-medium mt-1">@(Model.Gender.HasValue ? UIHelper.GetDisplayName(Model.Gender.Value) : AccountSharedResource.Profile_NotUpdated)</div>
            </div>

            <div class="col-md-4 col-sm-6">
                <div class="text-muted small">@AccountSharedResource.Profile_AccountStatus</div>
                <div class="mt-1">
                    @if (Model.IsActive)
                    {
                        <span class="app-badge app-badge-success">@AccountSharedResource.Profile_StatusActive</span>
                    }
                    else
                    {
                        <span class="app-badge app-badge-danger">@AccountSharedResource.Profile_StatusLocked</span>
                    }
                </div>
            </div>

            <div class="col-md-4 col-sm-6">
                <div class="text-muted small">@AccountSharedResource.Profile_LastLogin</div>
                <div class="fw-medium mt-1">@(Model.LastLogin.HasValue ? Model.LastLogin.Value.ToString("dd/MM/yyyy HH:mm") : AccountSharedResource.Profile_NoData)</div>
            </div>

            <div class="col-md-4 col-sm-6">
                <div class="text-muted small">@AccountSharedResource.Profile_CreatedDate</div>
                <div class="fw-medium mt-1">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>
    </div>
</div>
