@model ChangePasswordVM

@using ChangePasswordModelResource = RWPM.Resources.Models.ChangePassword
@using ChangePasswordSharedResource = RWPM.Resources.Shared.ChangePassword
@using RWPM.Common.Enums
@using RWPM.Models.ViewModels.Acc.ChangePassword
@using RWPM.Resources.Shared
@{
    ViewData["Title"] = ChangePasswordSharedResource.PageHeader;
}

<div class="app-page-header">
    <div>
        <h4 class="mb-1">@ChangePasswordSharedResource.PageHeader</h4>
        <div class="text-muted small">@ChangePasswordSharedResource.SubTitle</div>
    </div>
    <nav class="d-none d-md-block" aria-label="@RWPM.Resources.Shared.Acc.Aria_Breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-action="MyProfile">@RWPM.Resources.Shared.Acc.Profile_PageTitle</a></li>
            <li class="breadcrumb-item active" aria-current="page">@ChangePasswordSharedResource.PageHeader</li>
        </ol>
    </nav>
</div>

@if (RWPM.Common.Security.SessionSecurity.MustChangePassword(User))
{
    <div class="alert alert-warning d-flex align-items-center small" style="max-width: 640px;">
        <i class="bi bi-shield-lock me-2"></i>
        <span>@RWPM.Resources.Shared.Auth.ForcedChangePassword_Notice</span>
    </div>
}

<div class="app-content-card p-4" style="max-width: 640px;">
<form asp-action="ChangePassword" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label required" asp-for="OldPassword">@ChangePasswordModelResource.OldPassword</label>
        <div class="input-group">
            <input type="password" class="form-control" asp-for="OldPassword" placeholder="@ChangePasswordSharedResource.OldPassword_Placeholder" />
            <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('OldPassword', this)" title="@ChangePasswordSharedResource.TogglePassword" aria-label="@ChangePasswordSharedResource.TogglePassword"><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="OldPassword" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label class="form-label required" asp-for="NewPassword">@ChangePasswordModelResource.NewPassword</label>
        <div class="input-group">
            <input type="password" class="form-control" asp-for="NewPassword" placeholder="@ChangePasswordSharedResource.NewPassword_Placeholder" />
            <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('NewPassword', this)" title="@ChangePasswordSharedResource.TogglePassword" aria-label="@ChangePasswordSharedResource.TogglePassword"><i class="bi bi-eye"></i></button>
        </div>
        <div class="form-text">@ChangePasswordSharedResource.NewPassword_Hint</div>
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label class="form-label required" asp-for="ConfirmPassword">@ChangePasswordModelResource.ConfirmNewPassword</label>
        <div class="input-group">
            <input type="password" class="form-control" asp-for="ConfirmPassword" placeholder="@ChangePasswordSharedResource.ConfirmNewPassword_Placeholder" />
            <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('ConfirmPassword', this)" title="@ChangePasswordSharedResource.TogglePassword" aria-label="@ChangePasswordSharedResource.TogglePassword"><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
        <a asp-action="MyProfile" class="btn btn-outline-secondary">@SharedResource.Button_Cancel</a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check2 me-1"></i>@SharedResource.Button_SaveChanges
        </button>
    </div>
</form>
</div>

@section Scripts {
    <script src="~/js/acc/toggle-password.js" asp-append-version="true"></script>
}
