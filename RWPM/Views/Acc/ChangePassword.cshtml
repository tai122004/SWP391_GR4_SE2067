@model ChangePasswordVM

@using ChangePasswordModelResource = RWPM.Resources.Models.ChangePassword
@using ChangePasswordSharedResource = RWPM.Resources.Shared.ChangePassword
@using RWPM.Common.Enums
@using RWPM.Models.ViewModels.Acc.ChangePassword
@using RWPM.Resources.Shared
@{
    ViewData["Title"] = ChangePasswordSharedResource.PageHeader;

}

<div class="d-flex justify-content-between align-items-center mb-3 border-4 border-primary border-start rounded-start ps-2">
    <h4 class="mb-0">
        <i class="bi bi-lock-fill me-2"></i> @ChangePasswordSharedResource.PageHeader
    </h4>

    <nav class="d-none d-md-block ms-auto"
         style="--bs-breadcrumb-divider: url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%278%27 height=%278%27%3E%3Cpath d=%27M2.5 0L1 1.5 3.5 4 1 6.5 2.5 8l4-4-4-4z%27 fill=%276c757d%27/%3E%3C/svg%3E');"
         aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a asp-action="Index">@RWPM.Resources.Shared.Acc.Index_PageHeader</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@ChangePasswordSharedResource.PageHeader</li>
        </ol>
    </nav>
</div>

<form asp-action="ChangePassword" method="post">
    @Html.AntiForgeryToken()

    <div class="form-group mb-4">
        <label class="form-label required" asp-for="OldPassword">@ChangePasswordModelResource.OldPassword</label>
        <div class="input-group">
            <input type="password" class="form-control" asp-for="OldPassword" class="form-control" placeholder="@ChangePasswordSharedResource.OldPassword_Placeholder" />
            <div class="input-group-append">
                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('OldPassword')">👁️</button>
            </div>
        </div>
        <span asp-validation-for="OldPassword" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label class="form-label required" asp-for="NewPassword">@ChangePasswordModelResource.NewPassword</label>
        <div class="input-group">
            <input type="password" class="form-control" asp-for="NewPassword" class="form-control" placeholder="@ChangePasswordSharedResource.NewPassword_Placeholder" />
            <div class="input-group-append">
                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('NewPassword')">👁️</button>
            </div>
        </div>
        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label class="form-label required" asp-for="ConfirmPassword">@ChangePasswordModelResource.ConfirmNewPassword</label>
        <div class="input-group">
            <input type="password" class="form-control" asp-for="ConfirmPassword" class="form-control" placeholder="@ChangePasswordSharedResource.ConfirmNewPassword_Placeholder" />
            <div class="input-group-append">
                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('ConfirmPassword')">👁️</button>
            </div>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    <div class="form-group mt-3 text-end">
        <a asp-action="Index" class="btn btn-secondary me-2">
            <i class="bi bi-arrow-return-left me-2"></i>@SharedResource.Button_GoBack
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-floppy me-2"></i>@SharedResource.Button_SaveChanges
        </button>
    </div>
    
</form>

@section Scripts {
    <script>
        function togglePassword(id) {
            const input = document.getElementById(id);
            input.type = input.type === 'password' ? 'text' : 'password';
        }
    </script>
}