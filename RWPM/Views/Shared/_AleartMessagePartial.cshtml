@using System.Text.Json
@{
    // Mọi thông báo (TempData) đều hiển thị dạng toast ở góc dưới bên phải, thông qua AppToast (wwwroot/js/site.js)
    var now = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
    var flashMessages = new List<object>();
    void Add(string key, string type)
    {
        var msg = TempData[key]?.ToString();
        if (!string.IsNullOrWhiteSpace(msg))
        {
            flashMessages.Add(new { type, message = msg });
        }
    }
    Add("SuccessMessage", "success");
    Add("ErrorMessage", "error");
    Add("WarningMessage", "warning");
    Add("InfoMessage", "info");
}

<div id="appToastContainer" class="position-fixed bottom-0 end-0 p-3" style="z-index: 1090;"></div>

@if (flashMessages.Count > 0)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var items = @Html.Raw(JsonSerializer.Serialize(flashMessages));
            items.forEach(function (it) {
                if (window.AppToast) {
                    AppToast.show(it.type, it.message, { time: '@now' });
                }
            });
        });
    </script>
}
