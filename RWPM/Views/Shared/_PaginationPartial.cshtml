@using RWPM.Common.Models
@model PaginationRes

<!-- Total Records Info -->
<div class="d-flex justify-content-between align-items-center mt-3 mb-2">
    <div class="text-muted small">
        @string.Format(SharedResource.TotalRecordBar,
        Model.StartItem,
                Model.EndItem,
                Model.TotalRecords)
    </div>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav class="mb-5">
        <ul class="pagination justify-content-center">
            @{
                var currentPage = Model.PageNumber;
                var totalPages = Model.TotalPages;

                var maxDisplayPages = 10;
                var startPage = Math.Max(1, currentPage - 4);
                var endPage = Math.Min(totalPages, startPage + maxDisplayPages - 1);

                if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-all-route-data="Model.RouteData" asp-route-PageNumber="1">1</a>
                    </li>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-all-route-data="Model.RouteData" asp-route-PageNumber="@i">@i</a>
                    </li>
                }

                if (endPage < totalPages)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                    <li class="page-item">
                        <a class="page-link" asp-all-route-data="Model.RouteData" asp-route-PageNumber="@totalPages">@totalPages</a>
                    </li>
                }
            }

            <!-- Optional: Previous/Next buttons -->
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-all-route-data="Model.RouteData" asp-route-PageNumber="@(currentPage - 1)">Previous</a>
            </li>
            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-all-route-data="Model.RouteData" asp-route-PageNumber="@(currentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
}