@model ErrorViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = RWPM.Resources.Shared.ErrorPage.Title;
}

<div class="app-page-header">
    <div>
        <h4>@RWPM.Resources.Shared.ErrorPage.Header</h4>
        <p class="text-muted">@RWPM.Resources.Shared.ErrorPage.Header2</p>
    </div>
</div>

<div class="app-content-card" style="max-width: 720px;">
    <div class="card-body">
        <div class="d-flex align-items-start gap-3">
            <i class="bi bi-exclamation-octagon text-danger fs-4" aria-hidden="true"></i>
            <div class="flex-grow-1">
                <p class="mb-2">@RWPM.Resources.Shared.ErrorPage.Description</p>

                @if (Model?.ShowRequestId ?? false)
                {
                    <p class="text-muted small mb-2">
                        @RWPM.Resources.Shared.ErrorPage.RequestId <code>@Model!.RequestId</code>
                    </p>
                }
                @* Chỉ hiện chi tiết exception ở môi trường Development, tránh lộ lỗi SQL/đường dẫn cho người dùng *@
                @if (Env.IsDevelopment() && !string.IsNullOrEmpty(Model?.Message))
                {
                    <p class="small mb-0"><strong>@SharedResource.Detail:</strong> @Model!.Message</p>
                }
            </div>
        </div>
    </div>
    <div class="card-footer bg-transparent d-flex justify-content-end">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">@RWPM.Resources.Shared.ErrorPage.BackHome</a>
    </div>
</div>
