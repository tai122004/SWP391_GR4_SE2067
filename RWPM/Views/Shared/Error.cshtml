@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container">
    <h1 class="text-danger">@RWPM.Resources.Shared.ErrorPage.Header.</h1>
    <h2 class="text-danger">@RWPM.Resources.Shared.ErrorPage.Header2.</h2>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">
            <small>Request ID: <code>@Model.RequestId</code></small>
        </p>
    }
    <p><strong>@SharedResource.Detail: </strong>@Model.Message</p>
</div>



