<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RWPM</title>

    <!-- Font: Be Vietnam Pro (thiết kế cho tiếng Việt); không có mạng sẽ tự dùng font hệ thống -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600&display=swap" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />

    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RWPM.styles.css" asp-append-version="true" />

    <!-- Use for _LoginParital -->
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/flag-icons/css/flag-icons.min.css" />

    <!-- Select2 CSS -->
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />

    <!-- Daterange picker -->
    <link rel="stylesheet" href="~/lib/daterangepicker/daterangepicker.css" />
</head>
<body class="app-body app-page-@ViewContext.RouteData.Values["controller"]">
    <partial name="_NavigationBarPartial" />
    <div class="app-shell">
        <header class="app-topbar">
            <button class="app-menu-toggle" type="button" id="appMenuToggle" aria-label="@SharedResource.Layout_ToggleNavigation" aria-controls="appSidebar" aria-expanded="false"><i class="bi bi-list"></i></button>
            <div class="app-topbar-title">@ViewData["Title"]</div>
            <div class="app-topbar-actions">
                <partial name="_LanguageSelector" />
                <partial name="_LoginPartial" />
            </div>
        </header>
        <main role="main" class="app-main">
            @RenderBody()
        </main>
    </div>


    <partial name="_AleartMessagePartial" />

    <!-- Global Loading Overlay -->
    <div id="globalLoading" style="display:none; position:fixed; inset:0; background-color: rgba(18,38,61,.35); z-index:9999;">
        <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); display:flex; align-items:center; gap:12px; padding:16px 20px; background:#fff; border:1px solid var(--app-border); border-radius:var(--app-radius); box-shadow:var(--app-overlay-shadow); color:var(--app-text);">
            <div class="spinner-border text-primary" style="width: 1.5rem; height: 1.5rem;" role="status">
                <span class="visually-hidden">@SharedResource.Loading...</span>
            </div>
            <div>@SharedResource.LoadingPleaseWait...</div>
        </div>
    </div>

    <!-- Loading with progress (giữ nguyên id cho script tiến trình) -->
    <div id="loadingProgress" style="display:none; position:fixed; inset:0; background-color: rgba(18,38,61,.35); z-index:9999;">
        <div class="d-flex justify-content-center align-items-center h-100">
            <div style="background:#fff; padding:24px; border:1px solid var(--app-border); border-radius:var(--app-radius); box-shadow:var(--app-overlay-shadow); max-width:400px; width:100%; color:var(--app-text);">
                <div class="d-flex align-items-center gap-2">
                    <div class="spinner-border text-primary" style="width: 1.5rem; height: 1.5rem;" role="status">
                        <span class="visually-hidden">@SharedResource.Loading...</span>
                    </div>
                    <p class="mb-0 fw-semibold">@SharedResource.Loading_ProcessingRequest</p>
                </div>
                <div style="width:100%; background:#EEF0F3; height:8px; border-radius:4px; margin-top:16px; overflow:hidden;">
                    <div id="loadingProgress_progressBar" style="width:0%; height:100%; background:var(--app-blue);"></div>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <p id="loadingProgress_message" class="mb-0 small text-muted"></p>
                    <span id="loadingProgress_percentText" class="small text-muted" style="font-variant-numeric: tabular-nums;">0%</span>
                </div>
                <div class="text-end mt-3">
                    <button id="loadingProgress_cancelProgressBtn" type="button" class="btn btn-outline-danger btn-sm" style="display:none;" onclick="if (window.cancelProgress) window.cancelProgress()">
                        @SharedResource.Loading_CancelProgress
                    </button>
                </div>
            </div>
        </div>
    </div>


    <!-- Scripts -->
    <script type="text/javascript" src="~/lib/jquery/jquery.min.js"></script>
    <script type="text/javascript" src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- Select2 JS (comes after jQuery) -->
    <script type="text/javascript" src="~/lib/select2/js/select2.min.js"></script>

    <script type="text/javascript" src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>

    <partial name="_AppClientConfig" />
    <script type="text/javascript" src="~/js/site.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/notifications.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/time-picker.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/lib/moment/moment.min.js"></script>
    <script type="text/javascript" src="~/lib/daterangepicker/daterangepicker.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
