@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var user = HttpContextAccessor.HttpContext?.User;
}

<ul class="navbar-nav ms-auto align-items-center">
    @if (user?.Identity?.IsAuthenticated ?? false)
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-white d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle me-1 fs-4"></i>
                <span class="ms-1">Hello, <strong>@user.Identity?.Name</strong></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li>
                    <a class="dropdown-item" asp-controller="Acc" asp-action="MyProfile">
                        <i class="bi bi-person"></i>
                        @RWPM.Resources.Shared.NavigationBarResource.AccountProfile
                    </a>
                    <a class="dropdown-item" asp-controller="Acc" asp-action="ChangePassword">
                        <i class="bi bi-shield-lock"></i>
                        @RWPM.Resources.Shared.NavigationBarResource.ChangePassword
                    </a>
                </li>
                <li><a class="dropdown-item" href="#">...</a></li>

                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                {
                    <li>
                        <form asp-controller="Home" asp-action="InitData" method="post" class="m-0 p-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-success d-flex align-items-center">
                                <i class="bi bi-database-up me-2"></i> @SharedResource.InitData
                            </button>
                        </form>
                    </li>
                }
               
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item text-danger d-flex align-items-center">
                            <i class="bi bi-box-arrow-right me-2"></i> @SharedResource.Logout
                        </button>
                    </form>
                </li>
            </ul>
        </li>

    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-white" asp-controller="Auth" asp-action="Login">
                <i class="bi bi-box-arrow-in-right me-1"></i> Login
            </a>
        </li>
    }
</ul>
