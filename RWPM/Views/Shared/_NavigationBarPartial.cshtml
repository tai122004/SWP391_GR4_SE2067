@using NavigationBarResource = RWPM.Resources.Shared.NavigationBarResource

<style>
    .navbar .nav-link:hover,
    .navbar .dropdown-item:hover {
        color: black !important;
    }   
</style>

<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary shadow-sm mb-3">
    <div class="container-fluid">
        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
            RWPM
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
            <ul class="navbar-nav flex-grow-1">
              
                @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("AreaManager") || User.IsInRole("SuperAdmin"))
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white" href="#" id="catalogDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-folder2-open me-1"></i> @NavigationBarResource.Categories
                        </a>
                        <ul class="dropdown-menu shadow" aria-labelledby="catalogDropdown">
                            <li>
                                <a class="dropdown-item d-flex align-items-center" asp-area="" asp-controller="Acc" asp-action="Index">
                                    <i class="bi bi-people me-2 text-primary"></i> @NavigationBarResource.AccountManagement
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center" asp-area="" asp-controller="Employee" asp-action="Index">
                                    <i class="bi bi-person-badge me-2 text-warning"></i> @NavigationBarResource.EmployeeManagement
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center" asp-area="" asp-controller="Store" asp-action="Index">
                                    <i class="bi bi-shop me-2 text-success"></i> @NavigationBarResource.StoreList
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center" asp-area="" asp-controller="Shift" asp-action="Index">
                                    <i class="bi bi-clock-history me-2 text-info"></i> @NavigationBarResource.ShiftManagement
                                </a>
                            </li>
                        </ul>
                    </li>
                }
                
            </ul>

            @await Html.PartialAsync("_LanguageSelector")

        </div>
        <partial name="_LoginPartial" />
    </div>
</nav>