@using NavigationBarResource = RWPM.Resources.Shared.NavigationBarResource
@using RWPM.Resources.Shared
@using System.Globalization

<aside class="app-sidebar" id="appSidebar" aria-label="@NavigationBarResource.MainNavigation">
    <a class="app-brand" asp-controller="Home" asp-action="Index">
        <span class="app-brand-name">RWPM</span>
        <span class="app-brand-caption">@NavigationBarResource.BrandCaption</span>
    </a>
    <nav class="app-nav">
        <a class="app-nav-link" asp-controller="Home" asp-action="Index" data-nav-controller="Home"><i class="bi bi-grid-1x2"></i><span>@NavigationBarResource.Dashboard</span></a>
        @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("AreaManager") || User.IsInRole("SuperAdmin") || User.IsInRole("StoreManager"))
        {
            @if (!User.IsInRole("StoreManager") || User.IsInRole("Admin") || User.IsInRole("HR"))
            {
                <a class="app-nav-link" asp-controller="Acc" asp-action="Index" data-nav-controller="Acc"><i class="bi bi-person-vcard"></i><span>@NavigationBarResource.AccountManagement</span></a>
            }
            <a class="app-nav-link" asp-controller="Employee" asp-action="Index" data-nav-controller="Employee"><i class="bi bi-people"></i><span>@NavigationBarResource.EmployeeManagement</span></a>
            @if (!User.IsInRole("StoreManager") || User.IsInRole("Admin") || User.IsInRole("HR"))
            {
                <a class="app-nav-link" asp-controller="Store" asp-action="Index" data-nav-controller="Store"><i class="bi bi-shop"></i><span>@NavigationBarResource.StoreList</span></a>
            }
            <a class="app-nav-link" asp-controller="Shift" asp-action="Index" data-nav-controller="Shift"><i class="bi bi-clock-history"></i><span>@NavigationBarResource.ShiftManagement</span></a>
        }
        @if ((!User.IsInRole("Admin") && !User.IsInRole("SuperAdmin")) || User.IsInRole("HR") || User.IsInRole("StoreManager"))
        {
            <a class="app-nav-link" asp-controller="ShiftRegistration" asp-action="Index" data-nav-controller="ShiftRegistration"><i class="bi bi-calendar-week"></i><span>@ShiftRegistrationResource.ShiftRegistration</span></a>
            <a class="app-nav-link" asp-controller="Attendance" asp-action="Index" data-nav-controller="Attendance"><i class="bi bi-calendar-check"></i><span>@NavigationBarResource.Attendance</span></a>
        }
        <a class="app-nav-link" asp-controller="Request" asp-action="Index" data-nav-controller="Request"><i class="bi bi-inbox"></i><span>@RequestResource.RequestsAndApprovals</span></a>
        @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("AreaManager") || User.IsInRole("SuperAdmin") || User.IsInRole("StoreManager"))
        {
            <a class="app-nav-link" asp-controller="Payroll" asp-action="Index" data-nav-controller="Payroll" data-nav-exclude-actions="MyPayslips,MyPayslipDetail"><i class="bi bi-cash-stack"></i><span>@NavigationBarResource.Payroll</span></a>
        }
        @* HR và Quản lý cửa hàng cũng có hồ sơ nhân viên và được tính lương -> cũng cần xem phiếu lương của chính mình *@
        @if ((!User.IsInRole("Admin") && !User.IsInRole("SuperAdmin")) || User.IsInRole("HR") || User.IsInRole("StoreManager"))
        {
            <a class="app-nav-link" asp-controller="Payroll" asp-action="MyPayslips" data-nav-controller="Payroll" data-nav-actions="MyPayslips,MyPayslipDetail"><i class="bi bi-receipt"></i><span>@NavigationBarResource.MyPayslips</span></a>
        }
        @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("SuperAdmin") || User.IsInRole("StoreManager"))
        {
            <a class="app-nav-link" asp-controller="Performance" asp-action="Index" data-nav-controller="Performance" data-nav-exclude-actions="My,MyDetail"><i class="bi bi-graph-up-arrow"></i><span>@PerformanceResource.Nav_Performance</span></a>
        }
        @if ((!User.IsInRole("Admin") && !User.IsInRole("SuperAdmin")) || User.IsInRole("HR") || User.IsInRole("StoreManager"))
        {
            <a class="app-nav-link" asp-controller="Performance" asp-action="My" data-nav-controller="Performance" data-nav-actions="My,MyDetail"><i class="bi bi-person-check"></i><span>@PerformanceResource.Nav_MyPerformance</span></a>
        }
    </nav>
</aside>
