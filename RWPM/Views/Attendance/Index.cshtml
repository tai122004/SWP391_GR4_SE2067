@model IEnumerable<RWPM.Models.Entities.AttendanceRecord>
@using RWPM.Resources.Shared
@{
    ViewData["Title"] = SharedResource.ResourceManager.GetString("Attendance_Title");
    var todayRecord = ViewBag.TodayRecord as RWPM.Models.Entities.AttendanceRecord;
    bool isAdmin = ViewBag.IsAdmin ?? false;
    string searchQuery = ViewBag.SearchQuery as string;
    bool canCheckIn = todayRecord == null;
    bool canCheckOut = todayRecord != null && todayRecord.CheckInTime.HasValue && !todayRecord.CheckOutTime.HasValue;
    bool isCompleted = todayRecord != null && todayRecord.CheckOutTime.HasValue;
}

<div>
    <div class="row mt-3">
        <!-- Phần bấm giờ -->
        <div class="col-md-4 col-lg-3 mb-4">
            <div class="mb-3">
                <h4 class="fw-semibold text-dark d-flex align-items-center">
                    <i class="bi bi-clock me-2"></i>
                    @SharedResource.ResourceManager.GetString("Attendance_Today")
                </h4>
            </div>
            
            <div class="modern-card p-4 text-center">
                <h3 class="mb-4 text-primary fw-bold">@DateTime.Now.ToString("dd/MM/yyyy")</h3>
                
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success small py-2">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger small py-2">@TempData["ErrorMessage"]</div>
                }

                @if (!isAdmin)
                {
                    @if (isCompleted)
                    {
                        <div class="alert alert-info small text-start">
                            <i class="bi bi-check-circle-fill text-success me-1"></i> @SharedResource.ResourceManager.GetString("Attendance_Completed")
                            <hr class="my-2"/>
                            <strong>@SharedResource.ResourceManager.GetString("Attendance_CheckInTime")</strong> @todayRecord?.CheckInTime?.ToString(@"hh\:mm") <br />
                            <strong>@SharedResource.ResourceManager.GetString("Attendance_CheckOutTime")</strong> @todayRecord?.CheckOutTime?.ToString(@"hh\:mm")
                        </div>
                    }
                    else
                    {
                        var activeShifts = ViewBag.ActiveShifts as List<RWPM.Models.Entities.Shift>;
                        if (canCheckIn && (activeShifts == null || activeShifts.Count == 0))
                        {
                            <div class="alert alert-warning small py-2 text-start">
                                <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> Bạn chưa đăng ký ca làm.
                            </div>
                        }
                        else
                        {
                            <div id="gpsStatus" class="alert alert-info small py-1 mb-2 d-none">
                                <i class="bi bi-geo-alt spinner-grow spinner-grow-sm me-1"></i> Đang xác định vị trí GPS...
                            </div>

                        <form id="attendanceForm" method="post" enctype="multipart/form-data" class="d-grid gap-2">
                            <input type="hidden" name="userLatitude" id="userLatitude" />
                            <input type="hidden" name="userLongitude" id="userLongitude" />
                            <div class="mb-3 text-center">
                                <label class="form-label small fw-semibold text-danger"><i class="bi bi-camera"></i> Chụp ảnh hiện trường (Bắt buộc)</label>
                                
                                <div id="camera-container" class="position-relative bg-dark rounded overflow-hidden mx-auto mb-2" style="width: 100%; max-width: 320px; aspect-ratio: 3/4; display: flex; align-items: center; justify-content: center;">
                                    <video id="camera-stream" autoplay playsinline style="width: 100%; height: 100%; object-fit: cover;"></video>
                                    <img id="camera-preview" style="width: 100%; height: 100%; object-fit: cover; display: none;" />
                                    <div id="camera-loading" class="text-white small position-absolute top-50 start-50 translate-middle">Đang bật Camera...</div>
                                </div>
                                
                                <div class="d-flex justify-content-center gap-2 mb-2">
                                    <button type="button" id="btnCapture" class="btn btn-sm btn-primary">
                                        <i class="bi bi-camera-fill"></i> Chụp ảnh
                                    </button>
                                    <button type="button" id="btnRetake" class="btn btn-sm btn-outline-secondary" style="display: none;">
                                        <i class="bi bi-arrow-counterclockwise"></i> Chụp lại
                                    </button>
                                </div>
                                
                                <input type="file" name="photo" id="photoInput" accept="image/jpeg" class="d-none" required />
                                <canvas id="camera-canvas" class="d-none"></canvas>
                                <div class="form-text" style="font-size: 0.75rem;">Hãy để khuôn mặt của bạn nằm trong khung hình.</div>
                            </div>


                            <button type="button" id="btnCheckIn" asp-action="CheckIn" class="btn btn-sm btn-outline-success" disabled="@(canCheckIn ? null : "disabled")">
                                <i class="bi bi-box-arrow-in-right me-1"></i> @SharedResource.ResourceManager.GetString("Attendance_BtnCheckIn")
                            </button>
                            <button type="button" id="btnCheckOut" asp-action="CheckOut" class="btn btn-sm btn-outline-danger" disabled="@(canCheckOut ? null : "disabled")">
                                <i class="bi bi-box-arrow-right me-1"></i> @SharedResource.ResourceManager.GetString("Attendance_BtnCheckOut")
                            </button>
                        </form>
                        }
                    }
                }
                else
                {
                    <div class="alert alert-secondary small py-2">
                        <i class="bi bi-info-circle me-1"></i> @SharedResource.ResourceManager.GetString("Attendance_AdminNoNeed")
                    </div>
                    
                    var employees = ViewBag.Employees as List<RWPM.Models.Entities.Acc>;
                    if (employees != null && employees.Count > 0)
                    {
                        <div class="mt-3 text-start">
                            <label class="form-label small fw-semibold">@SharedResource.ResourceManager.GetString("Attendance_EmployeeList")</label>
                            <div class="list-group list-group-flush border rounded small" style="max-height: 300px; overflow-y: auto;">
                                <a href="@Url.Action("Index", new { searchQuery = "" })" class="list-group-item list-group-item-action py-2 @(string.IsNullOrEmpty(searchQuery) ? "active" : "")">
                                    <i class="bi bi-people me-2"></i> <strong>@SharedResource.ResourceManager.GetString("Attendance_AllEmployees")</strong>
                                </a>
                                @foreach(var emp in employees)
                                {
                                    <a href="@Url.Action("Index", new { searchQuery = emp.Username })" class="list-group-item list-group-item-action py-2 @(searchQuery == emp.Username ? "active fw-bold" : "")">
                                        <i class="bi bi-person me-2"></i> @emp.FullName <span class="text-muted">(@emp.Username)</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Phần Lịch sử -->
        <div class="col-md-8 col-lg-9 mb-4">
            <div class="mb-3 d-flex justify-content-between align-items-center">
                <h4 class="fw-semibold text-dark d-flex align-items-center mb-0">
                    <i class="bi bi-clock-history me-2"></i>
                    @(isAdmin ? SharedResource.ResourceManager.GetString("Attendance_AllHistory") : SharedResource.ResourceManager.GetString("Attendance_MyHistory"))
                </h4>
            </div>

            @if (isAdmin)
            {
                <!-- Search form -->
                <div class="modern-card p-3 mb-3">
                    <form asp-action="Index" method="get" class="row g-2 align-items-center">
                        <div class="col-md-6 col-lg-4">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                                <input type="text" name="searchQuery" value="@searchQuery" class="form-control border-start-0 ps-0" placeholder="@SharedResource.ResourceManager.GetString("Attendance_SearchPlaceholder")" />
                            </div>
                        </div>
                        <div class="col-auto d-flex gap-2">
                            <button type="submit" class="btn btn-sm btn-primary">
                                <i class="bi bi-funnel me-1"></i> @SharedResource.ResourceManager.GetString("Search")
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-arrow-clockwise"></i> Xóa tìm kiếm
                            </a>
                        </div>
                    </form>
                </div>
            }

            <!-- Table Container -->
            <div class="modern-card overflow-hidden mb-3">
                <div class="table-responsive">
                    <table class="table modern-table align-middle mb-0">
                        <thead>
                            <tr>
                            <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Date")</th>
                            @if (isAdmin)
                            {
                                <th class="text-nowrap">@SharedResource.ResourceManager.GetString("Attendance_EmployeeCol")</th>
                            }
                            <th class="text-nowrap text-center">Ca làm việc</th>
                            <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_CheckInCol")</th>
                            <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_CheckOutCol")</th>
                            <th class="text-nowrap text-center"><i class="bi bi-image me-1"></i>Ảnh minh chứng</th>
                            <th class="text-nowrap text-center"><i class="bi bi-geo-alt me-1"></i>Khoảng cách GPS</th>
                            @if (isAdmin)
                            {
                                <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Button_Action")</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center"><strong>@item.Date.ToString("dd/MM/yyyy")</strong></td>
                                    @if (isAdmin)
                                    {
                                        <td>@item.Username</td>
                                    }
                                    <td class="text-center">@(item.Shift != null ? item.Shift.ShiftName : "-")</td>
                                    <td class="text-center text-success fw-bold">@(item.CheckInTime.HasValue ? item.CheckInTime.Value.ToString(@"hh\:mm") : "--:--")</td>
                                    <td class="text-center text-danger fw-bold">@(item.CheckOutTime.HasValue ? item.CheckOutTime.Value.ToString(@"hh\:mm") : "--:--")</td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.CheckInPhotoPath))
                                        {
                                            <a href="@item.CheckInPhotoPath" target="_blank" title="Ảnh Check-in">
                                                <img src="@item.CheckInPhotoPath" class="img-thumbnail" style="width: 40px; height: 40px; object-fit: cover;" />
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(item.CheckOutPhotoPath))
                                        {
                                            <a href="@item.CheckOutPhotoPath" target="_blank" title="Ảnh Check-out">
                                                <img src="@item.CheckOutPhotoPath" class="img-thumbnail ms-1" style="width: 40px; height: 40px; object-fit: cover;" />
                                            </a>
                                        }
                                    </td>
                                    <td class="text-center small">
                                        @if (item.DistanceMeters.HasValue)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle me-1"></i> @Math.Round(item.DistanceMeters.Value)m
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    @if (isAdmin)
                                    {
                                        <td class="text-center">
                                            <form method="post" asp-action="Delete" asp-route-id="@item.AttendanceId" onsubmit="return confirm('@SharedResource.ResourceManager.GetString("ConfirmDelete")');" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="@SharedResource.ResourceManager.GetString("Button_Delete")">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(isAdmin ? 7 : 5)" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                    @SharedResource.ResourceManager.GetString("Attendance_NoData")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var form = document.getElementById("attendanceForm");
        var btnCheckIn = document.getElementById("btnCheckIn");
        var btnCheckOut = document.getElementById("btnCheckOut");
        var latInput = document.getElementById("userLatitude");
        var lngInput = document.getElementById("userLongitude");
        var gpsStatus = document.getElementById("gpsStatus");

        function submitWithGPS(actionName) {
            if (!form) return;


            var photoInput = document.getElementById('photoInput');
            if (!photoInput.files || photoInput.files.length === 0) {
                alert("Vui lòng BẤM NÚT CHỤP ẢNH TRÊN MÀN HÌNH trước khi chấm công!");
                return;
            }

            if (gpsStatus) gpsStatus.classList.remove("d-none");

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function (position) {
                    if (latInput) latInput.value = position.coords.latitude;
                    if (lngInput) lngInput.value = position.coords.longitude;

                    form.action = "/Attendance/" + actionName;
                    form.submit();
                }, function (error) {
                    if (gpsStatus) gpsStatus.classList.add("d-none");
                    var errorMsg = "";
                    if (error.code === 1) { // PERMISSION_DENIED
                        errorMsg = "BẠN ĐÃ CHẶN QUYỀN VỊ TRÍ TRÊN TRÌNH DUYỆT!\n\nCách bật lại nhanh:\n1. Click vào biểu tượng ổ khóa 🔒 (hoặc 🎛️) góc trái thanh địa chỉ (localhost:7125).\n2. Chuyển mục 'Vị trí (Location)' từ 'Chặn (Block)' sang 'Cho phép (Allow)'.\n3. Nhấn F5 tải lại trang và bấm Check-in lại.";
                    } else {
                        errorMsg = "Không thể xác định vị trí GPS (" + error.message + "). Vui lòng bật vị trí thiết bị và thử lại.";
                    }
                    alert(errorMsg);
                }, {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 0
                });
            } else {
                if (gpsStatus) gpsStatus.classList.add("d-none");
                alert("Trình duyệt của bạn không hỗ trợ Geolocation GPS.");
            }
        }

        if (btnCheckIn && !btnCheckIn.disabled) {
            btnCheckIn.addEventListener("click", function () {
                submitWithGPS("CheckIn");
            });
        }

        if (btnCheckOut && !btnCheckOut.disabled) {
            btnCheckOut.addEventListener("click", function () {
                submitWithGPS("CheckOut");
            });
        }

        // --- CAMERA WEBRTC LOGIC ---
        var video = document.getElementById('camera-stream');
        var preview = document.getElementById('camera-preview');
        var canvas = document.getElementById('camera-canvas');
        var btnCapture = document.getElementById('btnCapture');
        var btnRetake = document.getElementById('btnRetake');
        var photoInput = document.getElementById('photoInput');
        var cameraLoading = document.getElementById('camera-loading');

        if (video) {
            navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } })
                .then(function (stream) {
                    video.srcObject = stream;
                    cameraLoading.style.display = 'none';
                })
                .catch(function (err) {
                    console.error("Lỗi Camera:", err);
                    cameraLoading.innerHTML = "Không thể bật Camera. Hãy cho phép quyền truy cập!";
                });

            if (btnCapture) {
                btnCapture.addEventListener('click', function () {
                    var context = canvas.getContext('2d');
                    canvas.width = video.videoWidth;
                    canvas.height = video.videoHeight;
                    context.drawImage(video, 0, 0, canvas.width, canvas.height);
                    
                    var dataUrl = canvas.toDataURL('image/jpeg');
                    preview.src = dataUrl;
                    
                    video.style.display = 'none';
                    preview.style.display = 'block';
                    btnCapture.style.display = 'none';
                    btnRetake.style.display = 'block';
                    
                    fetch(dataUrl)
                        .then(res => res.blob())
                        .then(blob => {
                            var file = new File([blob], "capture.jpg", { type: "image/jpeg" });
                            var dataTransfer = new DataTransfer();
                            dataTransfer.items.add(file);
                            photoInput.files = dataTransfer.files;
                        });
                });
            }

            if (btnRetake) {
                btnRetake.addEventListener('click', function () {
                    video.style.display = 'block';
                    preview.style.display = 'none';
                    btnCapture.style.display = 'block';
                    btnRetake.style.display = 'none';
                    photoInput.value = ""; 
                });
            }
        }
    });
</script>
