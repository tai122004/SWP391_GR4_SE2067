@model IEnumerable<RWPM.Models.Entities.AttendanceRecord>
@using RWPM.Resources.Shared
@{
    ViewData["Title"] = SharedResource.ResourceManager.GetString("Attendance_Title");
    var todayRecord = ViewBag.TodayRecord as RWPM.Models.Entities.AttendanceRecord;
    bool canManage = ViewBag.CanManage ?? false;
    string? searchQuery = ViewBag.SearchQuery as string;
    
    var myHistory = ViewBag.MyHistory as List<RWPM.Models.Entities.AttendanceRecord> ?? (Model?.ToList() ?? new List<RWPM.Models.Entities.AttendanceRecord>());
    var employeeHistory = ViewBag.EmployeeHistory as List<RWPM.Models.Entities.AttendanceRecord> ?? new List<RWPM.Models.Entities.AttendanceRecord>();
    string scopeTitle = ViewBag.ScopeTitle as string ?? "";
    string activeTab = ViewBag.ActiveTab as string ?? "my";
    bool isEmpTabActive = activeTab == "employees";
    
    var activeShifts = ViewBag.ActiveShifts as List<RWPM.Models.Entities.Shift>;
    var todayRecords = myHistory?.Where(x => x.Date.Date == DateTime.Today.Date).ToList();
    bool hasCompletedShiftToday = todayRecords != null && todayRecords.Any(x => x.CheckOutTime.HasValue);
    
    bool canCheckOut = todayRecord != null && todayRecord.CheckInTime.HasValue && !todayRecord.CheckOutTime.HasValue;
    bool canCheckIn = !canCheckOut && activeShifts != null && activeShifts.Count > 0;
    bool isFullyCompleted = !canCheckOut && !canCheckIn && hasCompletedShiftToday;
    
    var empList = ViewBag.Employees as List<RWPM.Models.Entities.Acc>;
}

<style>
    /* Attendance — scoped on top of the global design system (site.css v2) */
    .att-tabs { display: flex; gap: 1.5rem; border-bottom: 1px solid var(--app-border); margin-bottom: 1rem; flex-wrap: nowrap; overflow-x: auto; }
    .att-tabs .nav-link { display: inline-flex; align-items: center; gap: .45rem; padding: .55rem 0; margin-bottom: -1px; border: 0; border-bottom: 2px solid transparent;
                          border-radius: 0 !important; background: none; color: var(--app-text-2); font-weight: 500; white-space: nowrap; }
    .att-tabs .nav-link:hover { color: var(--app-text); }
    .att-tabs .nav-link.active { color: var(--app-blue); border-bottom-color: var(--app-blue); background: none; }
    .att-tab-count { display: inline-flex; align-items: center; justify-content: center; min-width: 22px; height: 20px; padding: 0 6px; border-radius: var(--app-radius);
                     background: var(--app-neutral-soft); color: var(--app-neutral-text); font-size: .78rem; font-variant-numeric: tabular-nums; }
    .att-tabs .nav-link.active .att-tab-count { background: var(--app-blue-soft); color: var(--app-blue); }
    .att-section-title { font-size: 1.07rem; font-weight: 600; margin: 0 0 .75rem; color: var(--app-text); }
    .att-today-date { font-size: 1.35rem; font-weight: 600; color: var(--app-text); font-variant-numeric: tabular-nums; }
    .att-time { font-variant-numeric: tabular-nums; }
    .att-adjusted-btn { color: var(--app-blue); font-size: .95rem; text-decoration: none; cursor: pointer; }
    .table-pagination .pagination { margin-bottom: 0; }
    .attendance-page .list-group-item.active { background: var(--app-blue-soft); color: var(--app-blue); border-color: var(--app-border); }
</style>

<div class="attendance-page">
    <div class="app-page-header">
        <div>
            <h4>@SharedResource.Attendance_Title</h4>
            <p class="text-muted">@RequestResource.Att_PageSubtitle</p>
        </div>
    </div>
    <div class="row">
        <!-- Phần bấm giờ -->
        <div class="col-md-4 col-lg-3 mb-4">
            <h5 class="att-section-title" id="leftPanelHeader">@(canManage && isEmpTabActive ? SharedResource.Attendance_EmployeeList : SharedResource.Attendance_Today)</h5>

            <div class="modern-card p-4 text-center">
                <div class="att-today-date mb-3">@DateTime.Now.ToString("dd/MM/yyyy")</div>
                
                <div id="personalClockInArea" class="@(canManage && isEmpTabActive ? "d-none" : "")">
                    @if (isFullyCompleted)
                    {
                        var completedList = todayRecords?
                            .Where(x => x.CheckOutTime.HasValue)
                            .OrderBy(x => x.CheckInTime)
                            .ToList();

                        <div class="alert alert-success small text-start mb-3 p-3">
                            <div class="d-flex align-items-center fw-medium mb-2">
                                <i class="bi bi-check-circle me-2"></i>
                                <span>@SharedResource.ResourceManager.GetString("Attendance_AllCompletedToday")</span>
                            </div>

                            @if (completedList != null && completedList.Any())
                            {
                                <div class="d-flex flex-column gap-2 mt-2">
                                    @foreach (var rec in completedList)
                                    {
                                        <div class="bg-white p-2 rounded border" style="font-size: 0.85rem;">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fw-medium text-dark">@(rec.Shift?.ShiftName ?? SharedResource.Attendance_DefaultShiftName)</span>
                                                @if (rec.WorkHours.HasValue)
                                                {
                                                    <span class="app-badge app-badge-success">@string.Format(RequestResource.Att_HoursUnit, rec.WorkHours.Value.ToString("0.##"))</span>
                                                }
                                            </div>
                                            <div class="row g-1 text-muted" style="font-size: 0.8rem;">
                                                <div class="col-6">
                                                    <span>@SharedResource.ResourceManager.GetString("Attendance_CheckInTime")</span> 
                                                    <strong class="text-dark att-time">@(rec.CheckInTime?.ToString(@"hh\:mm") ?? "--:--")</strong>
                                                </div>
                                                <div class="col-6">
                                                    <span>@SharedResource.ResourceManager.GetString("Attendance_CheckOutTime")</span> 
                                                    <strong class="text-dark att-time">@(rec.CheckOutTime?.ToString(@"hh\:mm") ?? "--:--")</strong>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (canCheckIn || canCheckOut)
                    {
                        <div id="gpsStatus" class="alert alert-info small py-1 mb-2 d-none">
                            <i class="bi bi-geo-alt spinner-grow spinner-grow-sm me-1"></i> @SharedResource.ResourceManager.GetString("Attendance_GPSLoading")
                        </div>

                        <form id="attendanceForm" method="post" enctype="multipart/form-data" class="d-grid gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userLatitude" id="userLatitude" />
                            <input type="hidden" name="userLongitude" id="userLongitude" />
                            <div class="mb-3 text-center">
                                <label class="form-label small required">@SharedResource.ResourceManager.GetString("Attendance_PhotoTitle")</label>
                                
                                <div id="camera-container" class="position-relative bg-dark rounded overflow-hidden mx-auto mb-2" style="width: 100%; max-width: 320px; aspect-ratio: 3/4; display: flex; align-items: center; justify-content: center;">
                                    <video id="camera-stream" autoplay playsinline style="width: 100%; height: 100%; object-fit: cover;"></video>
                                    <img id="camera-preview" style="width: 100%; height: 100%; object-fit: cover; display: none;" />
                                    <div id="camera-loading" class="text-white small position-absolute top-50 start-50 translate-middle">@SharedResource.ResourceManager.GetString("Attendance_CamLoading")</div>
                                </div>
                                
                                <div class="d-flex justify-content-center gap-2 mb-2">
                                    <button type="button" id="btnCapture" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-camera-fill"></i> @SharedResource.ResourceManager.GetString("Attendance_BtnCapture")
                                    </button>
                                    <button type="button" id="btnRetake" class="btn btn-sm btn-outline-secondary" style="display: none;">
                                        <i class="bi bi-arrow-counterclockwise"></i> @SharedResource.ResourceManager.GetString("Attendance_BtnRetake")
                                    </button>
                                </div>
                                
                                <input type="file" name="photo" id="photoInput" accept="image/jpeg" class="d-none" required />
                                <canvas id="camera-canvas" class="d-none"></canvas>
                                <div class="form-text" style="font-size: 0.75rem;">@SharedResource.ResourceManager.GetString("Attendance_PhotoGuide")</div>
                            </div>

                            <button type="button" id="btnCheckIn" asp-action="CheckIn" class="btn @(canCheckIn ? "btn-primary" : "btn-outline-secondary")" disabled="@(canCheckIn ? null : "disabled")">
                                <i class="bi bi-box-arrow-in-right me-1"></i> @SharedResource.ResourceManager.GetString("Attendance_BtnCheckIn")
                            </button>
                            <button type="button" id="btnCheckOut" asp-action="CheckOut" class="btn @(canCheckOut ? "btn-primary" : "btn-outline-secondary")" disabled="@(canCheckOut ? null : "disabled")">
                                <i class="bi bi-box-arrow-right me-1"></i> @SharedResource.ResourceManager.GetString("Attendance_BtnCheckOut")
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning small py-2 text-start">
                            <i class="bi bi-exclamation-triangle me-1"></i> @SharedResource.ResourceManager.GetString("Attendance_WarningNoShift")
                        </div>
                    }
                </div>

                @if (canManage && empList != null && empList.Count > 0)
                {
                    <div id="managerEmpListContainer" class="text-start @(isEmpTabActive ? "" : "d-none")">
                        <label class="form-label small fw-semibold text-secondary d-flex justify-content-between align-items-center mb-2">
                            <span><i class="bi bi-people me-1"></i> @SharedResource.ResourceManager.GetString("Attendance_EmployeeList")</span>
                            <span class="app-badge app-badge-neutral">@empList.Count</span>
                        </label>
                        <div class="list-group list-group-flush border rounded small" style="max-height: 380px; overflow-y: auto;">
                            <a href="@Url.Action("Index", new { searchQuery = "", view = "employees" })" class="list-group-item list-group-item-action py-2 @(isEmpTabActive && string.IsNullOrEmpty(searchQuery) ? "active fw-bold" : "")">
                                <i class="bi bi-people-fill me-2"></i> <strong>@SharedResource.ResourceManager.GetString("Attendance_AllEmployees")</strong>
                            </a>
                            @foreach(var emp in empList)
                            {
                                <a href="@Url.Action("Index", new { searchQuery = emp.Username, view = "employees" })" class="list-group-item list-group-item-action py-2 @(searchQuery == emp.Username ? "active fw-bold" : "")">
                                    <i class="bi bi-person me-2"></i> @emp.FullName <span class="text-muted small">(@emp.Username)</span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Phần Lịch sử -->
        <div class="col-md-8 col-lg-9 mb-4">
            @if (canManage)
            {
                <!-- 1. DÀNH CHO HR & QUẢN LÝ CỬA HÀNG: Có 2 Tab chuyển đổi giữa cá nhân và nhân viên -->
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div class="nav att-tabs w-100" id="attendanceTabs" role="tablist">
                        <button class="nav-link @(isEmpTabActive ? "" : "active") " 
                                id="my-history-tab" 
                                data-bs-toggle="pill" 
                                data-bs-target="#my-history-pane" 
                                type="button" 
                                role="tab" 
                                aria-controls="my-history-pane" 
                                aria-selected="@(isEmpTabActive ? "false" : "true")">
                            @SharedResource.ResourceManager.GetString("Attendance_MyHistory")
                            <span class="att-tab-count">@myHistory.Count</span>
                        </button>
                        <button class="nav-link @(isEmpTabActive ? "active" : "") " 
                                id="emp-history-tab" 
                                data-bs-toggle="pill" 
                                data-bs-target="#emp-history-pane" 
                                type="button" 
                                role="tab" 
                                aria-controls="emp-history-pane" 
                                aria-selected="@(isEmpTabActive ? "true" : "false")">
                            @SharedResource.Attendance_EmployeeHistory @(!string.IsNullOrEmpty(scopeTitle) ? $"({scopeTitle})" : "")
                            <span class="att-tab-count">@employeeHistory.Count</span>
                        </button>
                    </div>
                </div>

                <div class="tab-content" id="attendanceTabsContent">
                    <!-- Tab 1: Lịch sử của tôi -->
                    <div class="tab-pane fade @(isEmpTabActive ? "" : "show active")" id="my-history-pane" role="tabpanel" aria-labelledby="my-history-tab" tabindex="0">
                        <div class="modern-card overflow-hidden mb-3">
                            <div class="table-responsive">
                                <table class="table modern-table align-middle mb-0" id="myAttendanceTable">
                                    <thead>
                                        <tr>
                                            <th class="text-nowrap">@SharedResource.ResourceManager.GetString("Date")</th>
                                            <th class="text-nowrap">@SharedResource.ResourceManager.GetString("Attendance_ShiftCol")</th>
                                            <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_CheckInCol")</th>
                                            <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_CheckOutCol")</th>
                                            <th class="text-nowrap text-end">@RWPM.Resources.Shared.Shift.ResourceManager.GetString("HoursWorked")</th>
                                            <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_PhotoCol")</th>
                                            <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_DistanceCol")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (myHistory != null && myHistory.Any())
                                        {
                                            foreach (var item in myHistory)
                                            {
                                                <tr>
                                                    <td class="text-nowrap att-time">@item.Date.ToString("dd/MM/yyyy")</td>
                                                    <td>@(item.Shift != null ? item.Shift.ShiftName : "-")</td>
                                                    <td class="text-center text-nowrap att-time">
                                                        @(item.CheckInTime.HasValue ? item.CheckInTime.Value.ToString(@"hh\:mm") : "--:--")
                                                        @if (item.IsAdjusted)
                                                        {
                                                            <button type="button" 
                                                                    class="btn btn-link p-0 ms-1 align-baseline border-0 bg-transparent att-adjusted-btn" 
                                                                    data-bs-toggle="modal" 
                                                                    data-bs-target="#historyModal_@item.AttendanceId" 
                                                                    title="@SharedResource.ResourceManager.GetString("Attendance_AdjustedTooltip")" aria-label="@SharedResource.ResourceManager.GetString("Attendance_AdjustedTooltip")">
                                                                <i class="bi bi-info-circle"></i>
                                                            </button>
                                                        }
                                                    </td>
                                                    <td class="text-center text-nowrap att-time">
                                                        @(item.CheckOutTime.HasValue ? item.CheckOutTime.Value.ToString(@"hh\:mm") : "--:--")
                                                        @if (item.IsAdjusted)
                                                        {
                                                            <button type="button" 
                                                                    class="btn btn-link p-0 ms-1 align-baseline border-0 bg-transparent att-adjusted-btn" 
                                                                    data-bs-toggle="modal" 
                                                                    data-bs-target="#historyModal_@item.AttendanceId" 
                                                                    title="@SharedResource.ResourceManager.GetString("Attendance_AdjustedTooltip")" aria-label="@SharedResource.ResourceManager.GetString("Attendance_AdjustedTooltip")">
                                                                <i class="bi bi-info-circle"></i>
                                                            </button>
                                                        }
                                                    </td>
                                                    <td class="text-end att-time">@(item.WorkHours?.ToString("0.##") ?? "—")</td>
                                                    <td class="text-center">
                                                        @if (!string.IsNullOrEmpty(item.CheckInPhotoPath))
                                                        {
                                                            <a href="@Url.Action("Photo", "Attendance", new { id = item.AttendanceId, type = "in" })" target="_blank" title="@SharedResource.ResourceManager.GetString("Attendance_PhotoCheckIn")">
                                                                <img src="@Url.Action("Photo", "Attendance", new { id = item.AttendanceId, type = "in" })" alt="@SharedResource.ResourceManager.GetString("Attendance_PhotoCheckIn")" class="img-thumbnail" style="width: 40px; height: 40px; object-fit: cover;" />
                                                            </a>
                                                        }
                                                        @if (!string.IsNullOrEmpty(item.CheckOutPhotoPath))
                                                        {
                                                            <a href="@Url.Action("Photo", "Attendance", new { id = item.AttendanceId, type = "out" })" target="_blank" title="@SharedResource.ResourceManager.GetString("Attendance_PhotoCheckOut")">
                                                                <img src="@Url.Action("Photo", "Attendance", new { id = item.AttendanceId, type = "out" })" alt="@SharedResource.ResourceManager.GetString("Attendance_PhotoCheckOut")" class="img-thumbnail ms-1" style="width: 40px; height: 40px; object-fit: cover;" />
                                                            </a>
                                                        }
                                                    </td>
                                                    <td class="text-center text-nowrap small">
                                                        @if (item.DistanceMeters.HasValue)
                                                        {
                                                            <span class="app-status"><span class="app-dot app-dot-success"></span>@Math.Round(item.DistanceMeters.Value) m</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center text-muted py-4">
                                                    <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                                    @SharedResource.ResourceManager.GetString("Attendance_NoData")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div id="myAttendancePagination" class="px-3 py-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-2 d-none"></div>
                        </div>
                    </div>

                    <!-- Tab 2: Lịch sử nhân viên -->
                    <div class="tab-pane fade @(isEmpTabActive ? "show active" : "")" id="emp-history-pane" role="tabpanel" aria-labelledby="emp-history-tab" tabindex="0">
                        <!-- Search form -->
                        <div class="app-filter-panel p-3 mb-3">
                            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                                <input type="hidden" name="view" value="employees" />
                                <div class="col-md-6 col-lg-5">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                                        <input type="text" name="searchQuery" value="@searchQuery" class="form-control" placeholder="@SharedResource.ResourceManager.GetString("Attendance_SearchPlaceholder")" aria-label="@SharedResource.ResourceManager.GetString("Attendance_SearchPlaceholder")" />
                                    </div>
                                </div>
                                <div class="col-auto d-flex gap-2">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-search me-1"></i> @SharedResource.ResourceManager.GetString("Search")
                                    </button>
                                    <a href="@Url.Action("Index", new { view = "employees" })" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-arrow-clockwise"></i> @SharedResource.ResourceManager.GetString("Attendance_ClearSearch")
                                    </a>
                                </div>
                            </form>
                        </div>

                        <div class="modern-card overflow-hidden mb-3">
                            <div class="table-responsive">
                                <table class="table modern-table align-middle mb-0" id="empAttendanceTable">
                                    <thead>
                                        <tr>
                                            <th class="text-nowrap">@SharedResource.ResourceManager.GetString("Date")</th>
                                            <th class="text-nowrap">@SharedResource.ResourceManager.GetString("Attendance_EmployeeCol")</th>
                                            <th class="text-nowrap">@SharedResource.ResourceManager.GetString("Attendance_ShiftCol")</th>
                                            <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_CheckInCol")</th>
                                            <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_CheckOutCol")</th>
                                            <th class="text-nowrap text-end">@RWPM.Resources.Shared.Shift.ResourceManager.GetString("HoursWorked")</th>
                                            <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_PhotoCol")</th>
                                            <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_DistanceCol")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (employeeHistory != null && employeeHistory.Any())
                                        {
                                            foreach (var item in employeeHistory)
                                            {
                                                <tr>
                                                    <td class="text-nowrap att-time">@item.Date.ToString("dd/MM/yyyy")</td>
                                                    <td>
                                                        <div class="d-flex flex-column">
                                                            <span class="fw-semibold text-dark">@(item.Account?.FullName ?? item.Username)</span>
                                                            @if (item.Account != null && !string.IsNullOrEmpty(item.Account.FullName) && item.Account.FullName != item.Username)
                                                            {
                                                                <span class="text-muted small" style="font-size: 0.8rem;">@@@item.Username</span>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td>@(item.Shift != null ? item.Shift.ShiftName : "-")</td>
                                                    <td class="text-center text-nowrap att-time">
                                                        @(item.CheckInTime.HasValue ? item.CheckInTime.Value.ToString(@"hh\:mm") : "--:--")
                                                        @if (item.IsAdjusted)
                                                        {
                                                            <button type="button" 
                                                                    class="btn btn-link p-0 ms-1 align-baseline border-0 bg-transparent att-adjusted-btn" 
                                                                    data-bs-toggle="modal" 
                                                                    data-bs-target="#historyModal_@item.AttendanceId" 
                                                                    title="@SharedResource.ResourceManager.GetString("Attendance_AdjustedTooltip")" aria-label="@SharedResource.ResourceManager.GetString("Attendance_AdjustedTooltip")">
                                                                <i class="bi bi-info-circle"></i>
                                                            </button>
                                                        }
                                                    </td>
                                                    <td class="text-center text-nowrap att-time">
                                                        @(item.CheckOutTime.HasValue ? item.CheckOutTime.Value.ToString(@"hh\:mm") : "--:--")
                                                        @if (item.IsAdjusted)
                                                        {
                                                            <button type="button" 
                                                                    class="btn btn-link p-0 ms-1 align-baseline border-0 bg-transparent att-adjusted-btn" 
                                                                    data-bs-toggle="modal" 
                                                                    data-bs-target="#historyModal_@item.AttendanceId" 
                                                                    title="@SharedResource.ResourceManager.GetString("Attendance_AdjustedTooltip")" aria-label="@SharedResource.ResourceManager.GetString("Attendance_AdjustedTooltip")">
                                                                <i class="bi bi-info-circle"></i>
                                                            </button>
                                                        }
                                                    </td>
                                                    <td class="text-end att-time">@(item.WorkHours?.ToString("0.##") ?? "—")</td>
                                                    <td class="text-center">
                                                        @if (!string.IsNullOrEmpty(item.CheckInPhotoPath))
                                                        {
                                                            <a href="@Url.Action("Photo", "Attendance", new { id = item.AttendanceId, type = "in" })" target="_blank" title="@SharedResource.ResourceManager.GetString("Attendance_PhotoCheckIn")">
                                                                <img src="@Url.Action("Photo", "Attendance", new { id = item.AttendanceId, type = "in" })" alt="@SharedResource.ResourceManager.GetString("Attendance_PhotoCheckIn")" class="img-thumbnail" style="width: 40px; height: 40px; object-fit: cover;" />
                                                            </a>
                                                        }
                                                        @if (!string.IsNullOrEmpty(item.CheckOutPhotoPath))
                                                        {
                                                            <a href="@Url.Action("Photo", "Attendance", new { id = item.AttendanceId, type = "out" })" target="_blank" title="@SharedResource.ResourceManager.GetString("Attendance_PhotoCheckOut")">
                                                                <img src="@Url.Action("Photo", "Attendance", new { id = item.AttendanceId, type = "out" })" alt="@SharedResource.ResourceManager.GetString("Attendance_PhotoCheckOut")" class="img-thumbnail ms-1" style="width: 40px; height: 40px; object-fit: cover;" />
                                                            </a>
                                                        }
                                                    </td>
                                                    <td class="text-center text-nowrap small">
                                                        @if (item.DistanceMeters.HasValue)
                                                        {
                                                            <span class="app-status"><span class="app-dot app-dot-success"></span>@Math.Round(item.DistanceMeters.Value) m</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="8" class="text-center text-muted py-4">
                                                    <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                                    @SharedResource.ResourceManager.GetString("Attendance_NoData")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div id="empAttendancePagination" class="px-3 py-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-2 d-none"></div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- 2. DÀNH CHO NHÂN VIÊN: Chỉ xem lịch sử của mình -->
                <h5 class="att-section-title">@SharedResource.ResourceManager.GetString("Attendance_MyHistory")</h5>

                <div class="modern-card overflow-hidden mb-3">
                    <div class="table-responsive">
                        <table class="table modern-table align-middle mb-0" id="employeeSelfAttendanceTable">
                            <thead>
                                <tr>
                                    <th class="text-nowrap">@SharedResource.ResourceManager.GetString("Date")</th>
                                    <th class="text-nowrap">@SharedResource.ResourceManager.GetString("Attendance_ShiftCol")</th>
                                    <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_CheckInCol")</th>
                                    <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_CheckOutCol")</th>
                                    <th class="text-nowrap text-end">@RWPM.Resources.Shared.Shift.ResourceManager.GetString("HoursWorked")</th>
                                    <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_PhotoCol")</th>
                                    <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_DistanceCol")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (myHistory != null && myHistory.Any())
                                {
                                    foreach (var item in myHistory)
                                    {
                                        <tr>
                                            <td class="text-nowrap att-time">@item.Date.ToString("dd/MM/yyyy")</td>
                                            <td>@(item.Shift != null ? item.Shift.ShiftName : "-")</td>
                                            <td class="text-center text-nowrap att-time">
                                                @(item.CheckInTime.HasValue ? item.CheckInTime.Value.ToString(@"hh\:mm") : "--:--")
                                                @if (item.IsAdjusted)
                                                {
                                                    <button type="button" 
                                                            class="btn btn-link p-0 ms-1 align-baseline border-0 bg-transparent att-adjusted-btn" 
                                                            data-bs-toggle="modal" 
                                                            data-bs-target="#historyModal_@item.AttendanceId" 
                                                            title="@SharedResource.ResourceManager.GetString("Attendance_AdjustedTooltip")" aria-label="@SharedResource.ResourceManager.GetString("Attendance_AdjustedTooltip")">
                                                        <i class="bi bi-info-circle"></i>
                                                    </button>
                                                }
                                            </td>
                                            <td class="text-center text-nowrap att-time">
                                                @(item.CheckOutTime.HasValue ? item.CheckOutTime.Value.ToString(@"hh\:mm") : "--:--")
                                                @if (item.IsAdjusted)
                                                {
                                                    <button type="button" 
                                                            class="btn btn-link p-0 ms-1 align-baseline border-0 bg-transparent att-adjusted-btn" 
                                                            data-bs-toggle="modal" 
                                                            data-bs-target="#historyModal_@item.AttendanceId" 
                                                            title="@SharedResource.ResourceManager.GetString("Attendance_AdjustedTooltip")" aria-label="@SharedResource.ResourceManager.GetString("Attendance_AdjustedTooltip")">
                                                        <i class="bi bi-info-circle"></i>
                                                    </button>
                                                }
                                            </td>
                                            <td class="text-end att-time">@(item.WorkHours?.ToString("0.##") ?? "—")</td>
                                            <td class="text-center">
                                                @if (!string.IsNullOrEmpty(item.CheckInPhotoPath))
                                                {
                                                    <a href="@Url.Action("Photo", "Attendance", new { id = item.AttendanceId, type = "in" })" target="_blank" title="@SharedResource.ResourceManager.GetString("Attendance_PhotoCheckIn")">
                                                        <img src="@Url.Action("Photo", "Attendance", new { id = item.AttendanceId, type = "in" })" alt="@SharedResource.ResourceManager.GetString("Attendance_PhotoCheckIn")" class="img-thumbnail" style="width: 40px; height: 40px; object-fit: cover;" />
                                                    </a>
                                                }
                                                @if (!string.IsNullOrEmpty(item.CheckOutPhotoPath))
                                                {
                                                    <a href="@Url.Action("Photo", "Attendance", new { id = item.AttendanceId, type = "out" })" target="_blank" title="@SharedResource.ResourceManager.GetString("Attendance_PhotoCheckOut")">
                                                        <img src="@Url.Action("Photo", "Attendance", new { id = item.AttendanceId, type = "out" })" alt="@SharedResource.ResourceManager.GetString("Attendance_PhotoCheckOut")" class="img-thumbnail ms-1" style="width: 40px; height: 40px; object-fit: cover;" />
                                                    </a>
                                                }
                                            </td>
                                            <td class="text-center text-nowrap small">
                                                @if (item.DistanceMeters.HasValue)
                                                {
                                                    <span class="app-status"><span class="app-dot app-dot-success"></span>@Math.Round(item.DistanceMeters.Value) m</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">
                                            <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                            @SharedResource.ResourceManager.GetString("Attendance_NoData")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div id="employeeSelfAttendancePagination" class="px-3 py-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-2 d-none"></div>
                </div>
            }
        </div>
    </div>
</div>

@{
    var allModalRecords = new List<RWPM.Models.Entities.AttendanceRecord>();
    if (myHistory != null) allModalRecords.AddRange(myHistory);
    if (employeeHistory != null) allModalRecords.AddRange(employeeHistory);
    var distinctModalRecords = allModalRecords.GroupBy(x => x.AttendanceId).Select(g => g.First()).Where(x => x.IsAdjusted).ToList();
}
@if (distinctModalRecords.Any())
{
    foreach (var item in distinctModalRecords)
    {
        <div class="modal fade" id="historyModal_@item.AttendanceId" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@SharedResource.Attendance_AdjDetail_Title</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedResource.Button_Close"></button>
                    </div>
                    <div class="modal-body p-4 text-start">
                        <div class="p-3 mb-3 bg-light border rounded">
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <span class="text-muted small d-block">@SharedResource.Attendance_AdjDetail_Employee</span>
                                    <span class="fw-bold text-dark">@(item.Account?.FullName ?? item.Username)</span>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted small d-block">@SharedResource.Attendance_AdjDetail_WorkDate</span>
                                    <span class="fw-bold text-dark">@item.Date.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <span class="text-muted small d-block">@SharedResource.Attendance_AdjDetail_Shift</span>
                                    <span class="fw-bold text-dark">@(item.Shift?.ShiftName ?? SharedResource.Attendance_DefaultShiftName)</span>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <span class="text-muted small d-block">@SharedResource.Attendance_AdjDetail_CurrentIn</span>
                                    <span class="fw-medium text-dark att-time">@(item.CheckInTime.HasValue ? item.CheckInTime.Value.ToString(@"hh\:mm") : "--:--")</span>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted small d-block">@SharedResource.Attendance_AdjDetail_CurrentOut</span>
                                    <span class="fw-medium text-dark att-time">@(item.CheckOutTime.HasValue ? item.CheckOutTime.Value.ToString(@"hh\:mm") : "--:--")</span>
                                </div>
                            </div>
                        </div>

                        @if (item.AdjustmentHistories != null && item.AdjustmentHistories.Any())
                        {
                            <h6 class="small text-muted mb-2">@SharedResource.Attendance_AdjDetail_History</h6>
                            <div class="list-group list-group-flush border rounded overflow-hidden">
                                @foreach (var hist in item.AdjustmentHistories.OrderByDescending(h => h.ModifiedAt))
                                {
                                    <div class="list-group-item p-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="app-badge app-badge-info">@SharedResource.Attendance_AdjDetail_ModifiedBy @hist.ModifiedBy</span>
                                            <span class="small text-muted">
                                                @hist.ModifiedAt.ToString("HH:mm dd/MM/yyyy")
                                            </span>
                                        </div>
                                        <div class="row g-2 small mb-2 bg-light p-2 rounded">
                                            <div class="col-6">
                                                <span class="text-muted">@SharedResource.Attendance_AdjDetail_Before</span>
                                                <div class="fw-medium text-secondary att-time">
                                                    @(hist.OldCheckInTime.HasValue ? hist.OldCheckInTime.Value.ToString(@"hh\:mm") : "--:--")
                                                    ~
                                                    @(hist.OldCheckOutTime.HasValue ? hist.OldCheckOutTime.Value.ToString(@"hh\:mm") : "--:--")
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <span class="text-muted">@SharedResource.Attendance_AdjDetail_After</span>
                                                <div class="fw-medium text-dark att-time">
                                                    @(hist.NewCheckInTime.HasValue ? hist.NewCheckInTime.Value.ToString(@"hh\:mm") : "--:--")
                                                    ~
                                                    @(hist.NewCheckOutTime.HasValue ? hist.NewCheckOutTime.Value.ToString(@"hh\:mm") : "--:--")
                                                </div>
                                            </div>
                                        </div>
                                        <div class="small">
                                            <span class="text-muted">@SharedResource.Attendance_AdjDetail_Reason</span>
                                            <div class="text-dark mt-1 fst-italic">@RWPM.Services.Implementation.AttendanceAdjustmentService.LocalizeAuditReason(hist.Reason)</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info py-2 small mb-0">
                                <i class="bi bi-info-circle me-1"></i> @SharedResource.Attendance_AdjDetail_ApprovedNote
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">@SharedResource.Button_Close</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        window.RWPM = window.RWPM || {};
        RWPM.attendanceIndex = {
            urls: {
                checkIn: '@Url.Action("CheckIn", "Attendance")',
                checkOut: '@Url.Action("CheckOut", "Attendance")'
            },
            // Localized strings for the attendance scripts (follow the current UI language)
            i18n: {
                photoRequired: @Json.Serialize(SharedResource.ResourceManager.GetString("Attendance_PhotoCheckInRequired")),
                gpsLoading: @Json.Serialize(SharedResource.ResourceManager.GetString("Attendance_GPSLoading")),
                gpsDenied: @Json.Serialize(SharedResource.ResourceManager.GetString("Attendance_GPSPermissionDenied")),
                gpsUnknown: @Json.Serialize(SharedResource.ResourceManager.GetString("Attendance_GPSUnknownError")),
                gpsNotSupported: @Json.Serialize(SharedResource.ResourceManager.GetString("Attendance_GPSNotSupported")),
                camError: @Json.Serialize(SharedResource.ResourceManager.GetString("Attendance_CamError")),
                processing: @Json.Serialize(SharedResource.Processing),
                locateFailed: @Json.Serialize(SharedResource.Attendance_Err_LocateFailed),
                employeeList: @Json.Serialize(SharedResource.Attendance_EmployeeList),
                today: @Json.Serialize(SharedResource.Attendance_Today),
                totalRecordBar: @Json.Serialize(SharedResource.TotalRecordBar),
                paginationPrevious: @Json.Serialize(SharedResource.Pagination_Previous),
                paginationNext: @Json.Serialize(SharedResource.Pagination_Next)
            }
        };
    </script>
    <script src="~/js/attendance/index.js" asp-append-version="true"></script>
}
