@model IEnumerable<RWPM.Models.Entities.AttendanceRecord>
@using RWPM.Resources.Shared
@{
    ViewData["Title"] = SharedResource.ResourceManager.GetString("Attendance_Title");
    var todayRecord = ViewBag.TodayRecord as RWPM.Models.Entities.AttendanceRecord;
    bool isAdmin = ViewBag.IsAdmin ?? false;
    bool canManage = ViewBag.CanManage ?? false;
    string searchQuery = ViewBag.SearchQuery as string;
    
    var myHistory = ViewBag.MyHistory as List<RWPM.Models.Entities.AttendanceRecord> ?? (Model != null && !isAdmin ? Model.ToList() : new List<RWPM.Models.Entities.AttendanceRecord>());
    var employeeHistory = ViewBag.EmployeeHistory as List<RWPM.Models.Entities.AttendanceRecord> ?? (isAdmin && Model != null ? Model.ToList() : new List<RWPM.Models.Entities.AttendanceRecord>());
    string scopeTitle = ViewBag.ScopeTitle as string ?? (isAdmin ? SharedResource.Attendance_Scope_Company : "");
    bool hasSearch = !string.IsNullOrWhiteSpace(searchQuery);
    string activeTab = ViewBag.ActiveTab as string ?? "my";
    bool isEmpTabActive = activeTab == "employees";
    
    var activeShifts = ViewBag.ActiveShifts as List<RWPM.Models.Entities.Shift>;
    var todayRecords = myHistory?.Where(x => x.Date.Date == DateTime.Today.Date).ToList();
    bool hasCompletedShiftToday = todayRecords != null && todayRecords.Any(x => x.CheckOutTime.HasValue);
    
    bool canCheckOut = todayRecord != null && todayRecord.CheckInTime.HasValue && !todayRecord.CheckOutTime.HasValue;
    bool canCheckIn = !canCheckOut && activeShifts != null && activeShifts.Count > 0;
    bool isFullyCompleted = !canCheckOut && !canCheckIn && hasCompletedShiftToday;
    
    var empList = ViewBag.Employees as List<RWPM.Models.Entities.Acc>;
}

<style>
    .nav-pills .nav-link {
        color: #495057;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        transition: all 0.2s ease-in-out;
    }
    .nav-pills .nav-link:hover {
        background-color: #e9ecef;
        color: #212529;
    }
    .nav-pills .nav-link.active {
        color: #fff !important;
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
    }
    .nav-pills .nav-link.active .badge {
        background-color: rgba(255, 255, 255, 0.25) !important;
        color: #fff !important;
    }
    .table-pagination .pagination {
        margin-bottom: 0;
    }
    .table-pagination .page-link {
        color: #495057;
        border: 1px solid #dee2e6;
        padding: 0.35rem 0.75rem;
        font-size: 0.85rem;
        border-radius: 6px;
        margin: 0 2px;
        transition: all 0.15s ease-in-out;
    }
    .table-pagination .page-link:hover {
        background-color: #e9ecef;
        color: #0d6efd;
    }
    .table-pagination .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
        color: #fff;
        font-weight: 600;
        box-shadow: 0 2px 4px rgba(13, 110, 253, 0.25);
    }
    .table-pagination .page-item.disabled .page-link {
        color: #adb5bd;
        background-color: #f8f9fa;
        border-color: #dee2e6;
        cursor: not-allowed;
    }
</style>

<div class="attendance-page">
    <div class="row mt-3">
        <!-- Phần bấm giờ -->
        <div class="col-md-4 col-lg-3 mb-4">
            <div class="mb-3">
                <h4 class="fw-semibold text-dark d-flex align-items-center">
                    <i id="leftPanelIcon" class="bi @(canManage && isEmpTabActive ? "bi-people" : "bi-clock") me-2"></i>
                    <span id="leftPanelHeader">@(canManage && isEmpTabActive ? SharedResource.Attendance_EmployeeList : SharedResource.Attendance_Today)</span>
                </h4>
            </div>
            
            <div class="modern-card p-4 text-center">
                <h3 class="mb-4 text-primary fw-bold">@DateTime.Now.ToString("dd/MM/yyyy")</h3>
                
                @if (!isAdmin)
                {
                    <div id="personalClockInArea" class="@(canManage && isEmpTabActive ? "d-none" : "")">
                        @if (isFullyCompleted)
                        {
                            var completedList = todayRecords?
                                .Where(x => x.CheckOutTime.HasValue)
                                .OrderBy(x => x.CheckInTime)
                                .ToList();

                            <div class="alert alert-info small text-start mb-3 p-3" style="border-radius: 10px;">
                                <div class="d-flex align-items-center fw-bold text-success mb-2">
                                    <i class="bi bi-check-circle-fill fs-6 me-2"></i>
                                    <span>@SharedResource.ResourceManager.GetString("Attendance_AllCompletedToday")</span>
                                </div>

                                @if (completedList != null && completedList.Any())
                                {
                                    <div class="d-flex flex-column gap-2 mt-2">
                                        @foreach (var rec in completedList)
                                        {
                                            <div class="bg-white bg-opacity-75 p-2 rounded border" style="font-size: 0.85rem;">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="fw-bold text-dark">
                                                        <i class="bi bi-clock-history text-primary me-1"></i>@(rec.Shift?.ShiftName ?? SharedResource.Attendance_DefaultShiftName)
                                                    </span>
                                                    @if (rec.WorkHours.HasValue)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle">@rec.WorkHours.Value.ToString("0.##")h</span>
                                                    }
                                                </div>
                                                <div class="row g-1 text-muted" style="font-size: 0.8rem;">
                                                    <div class="col-6">
                                                        <span>@SharedResource.ResourceManager.GetString("Attendance_CheckInTime")</span> 
                                                        <strong class="text-dark">@(rec.CheckInTime?.ToString(@"hh\:mm") ?? "--:--")</strong>
                                                    </div>
                                                    <div class="col-6">
                                                        <span>@SharedResource.ResourceManager.GetString("Attendance_CheckOutTime")</span> 
                                                        <strong class="text-dark">@(rec.CheckOutTime?.ToString(@"hh\:mm") ?? "--:--")</strong>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (canCheckIn || canCheckOut)
                        {
                            <div id="gpsStatus" class="alert alert-info small py-1 mb-2 d-none">
                                <i class="bi bi-geo-alt spinner-grow spinner-grow-sm me-1"></i> @SharedResource.ResourceManager.GetString("Attendance_GPSLoading")
                            </div>

                            <form id="attendanceForm" method="post" enctype="multipart/form-data" class="d-grid gap-2">
                                <input type="hidden" name="userLatitude" id="userLatitude" />
                                <input type="hidden" name="userLongitude" id="userLongitude" />
                                <div class="mb-3 text-center">
                                    <label class="form-label small fw-semibold text-danger"><i class="bi bi-camera"></i> @SharedResource.ResourceManager.GetString("Attendance_PhotoTitle")</label>
                                    
                                    <div id="camera-container" class="position-relative bg-dark rounded overflow-hidden mx-auto mb-2" style="width: 100%; max-width: 320px; aspect-ratio: 3/4; display: flex; align-items: center; justify-content: center;">
                                        <video id="camera-stream" autoplay playsinline style="width: 100%; height: 100%; object-fit: cover;"></video>
                                        <img id="camera-preview" style="width: 100%; height: 100%; object-fit: cover; display: none;" />
                                        <div id="camera-loading" class="text-white small position-absolute top-50 start-50 translate-middle">@SharedResource.ResourceManager.GetString("Attendance_CamLoading")</div>
                                    </div>
                                    
                                    <div class="d-flex justify-content-center gap-2 mb-2">
                                        <button type="button" id="btnCapture" class="btn btn-sm btn-primary">
                                            <i class="bi bi-camera-fill"></i> @SharedResource.ResourceManager.GetString("Attendance_BtnCapture")
                                        </button>
                                        <button type="button" id="btnRetake" class="btn btn-sm btn-outline-secondary" style="display: none;">
                                            <i class="bi bi-arrow-counterclockwise"></i> @SharedResource.ResourceManager.GetString("Attendance_BtnRetake")
                                        </button>
                                    </div>
                                    
                                    <input type="file" name="photo" id="photoInput" accept="image/jpeg" class="d-none" required />
                                    <canvas id="camera-canvas" class="d-none"></canvas>
                                    <div class="form-text" style="font-size: 0.75rem;">@SharedResource.ResourceManager.GetString("Attendance_PhotoGuide")</div>
                                </div>

                                <button type="button" id="btnCheckIn" asp-action="CheckIn" class="btn btn-sm btn-outline-success" disabled="@(canCheckIn ? null : "disabled")">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> @SharedResource.ResourceManager.GetString("Attendance_BtnCheckIn")
                                </button>
                                <button type="button" id="btnCheckOut" asp-action="CheckOut" class="btn btn-sm btn-outline-danger" disabled="@(canCheckOut ? null : "disabled")">
                                    <i class="bi bi-box-arrow-right me-1"></i> @SharedResource.ResourceManager.GetString("Attendance_BtnCheckOut")
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-warning small py-2 text-start">
                                <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> @SharedResource.ResourceManager.GetString("Attendance_WarningNoShift")
                            </div>
                        }
                    </div>

                    @if (canManage && empList != null && empList.Count > 0)
                    {
                        <div id="managerEmpListContainer" class="text-start @(isEmpTabActive ? "" : "d-none")">
                            <label class="form-label small fw-semibold text-secondary d-flex justify-content-between align-items-center mb-2">
                                <span><i class="bi bi-people me-1"></i> @SharedResource.ResourceManager.GetString("Attendance_EmployeeList")</span>
                                <span class="badge bg-secondary-subtle text-dark">@empList.Count</span>
                            </label>
                            <div class="list-group list-group-flush border rounded small" style="max-height: 380px; overflow-y: auto;">
                                <a href="@Url.Action("Index", new { searchQuery = "", view = "employees" })" class="list-group-item list-group-item-action py-2 @(isEmpTabActive && string.IsNullOrEmpty(searchQuery) ? "active fw-bold" : "")">
                                    <i class="bi bi-people-fill me-2"></i> <strong>@SharedResource.ResourceManager.GetString("Attendance_AllEmployees")</strong>
                                </a>
                                @foreach(var emp in empList)
                                {
                                    <a href="@Url.Action("Index", new { searchQuery = emp.Username, view = "employees" })" class="list-group-item list-group-item-action py-2 @(searchQuery == emp.Username ? "active fw-bold" : "")">
                                        <i class="bi bi-person me-2"></i> @emp.FullName <span class="text-muted small">(@emp.Username)</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-secondary small py-2 mb-3">
                        <i class="bi bi-info-circle me-1"></i> @SharedResource.ResourceManager.GetString("Attendance_AdminNoNeed")
                    </div>
                    
                    @if (empList != null && empList.Count > 0)
                    {
                        <div class="text-start">
                            <label class="form-label small fw-semibold text-secondary d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-people me-1"></i> @SharedResource.ResourceManager.GetString("Attendance_EmployeeList")</span>
                                <span class="badge bg-secondary-subtle text-dark">@empList.Count</span>
                            </label>
                            <div class="list-group list-group-flush border rounded small" style="max-height: 380px; overflow-y: auto;">
                                <a href="@Url.Action("Index", new { searchQuery = "" })" class="list-group-item list-group-item-action py-2 @(string.IsNullOrEmpty(searchQuery) ? "active fw-bold" : "")">
                                    <i class="bi bi-people-fill me-2"></i> <strong>@SharedResource.ResourceManager.GetString("Attendance_AllEmployees")</strong>
                                </a>
                                @foreach(var emp in empList)
                                {
                                    <a href="@Url.Action("Index", new { searchQuery = emp.Username })" class="list-group-item list-group-item-action py-2 @(searchQuery == emp.Username ? "active fw-bold" : "")">
                                        <i class="bi bi-person me-2"></i> @emp.FullName <span class="text-muted small">(@emp.Username)</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Phần Lịch sử -->
        <div class="col-md-8 col-lg-9 mb-4">
            @if (isAdmin)
            {
                <!-- 1. DÀNH CHO ADMIN: Chỉ hiển thị Lịch sử nhân viên toàn công ty, không hiện tab chấm công cá nhân -->
                <div class="mb-3 d-flex justify-content-between align-items-center">
                    <h4 class="fw-semibold text-dark d-flex align-items-center mb-0">
                        <i class="bi bi-people me-2 text-primary"></i> @SharedResource.Attendance_EmployeeHistory @(!string.IsNullOrEmpty(scopeTitle) ? $"({scopeTitle})" : "")
                        <span class="badge rounded-pill bg-primary ms-2 fs-6">@employeeHistory.Count</span>
                    </h4>
                </div>

                <!-- Search form -->
                <div class="modern-card p-3 mb-3">
                    <form asp-action="Index" method="get" class="row g-2 align-items-center">
                        <div class="col-md-6 col-lg-5">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                                <input type="text" name="searchQuery" value="@searchQuery" class="form-control border-start-0 ps-0" placeholder="@SharedResource.ResourceManager.GetString("Attendance_SearchPlaceholder")" />
                            </div>
                        </div>
                        <div class="col-auto d-flex gap-2">
                            <button type="submit" class="btn btn-sm btn-primary">
                                <i class="bi bi-funnel me-1"></i> @SharedResource.ResourceManager.GetString("Search")
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-arrow-clockwise"></i> @SharedResource.ResourceManager.GetString("Attendance_ClearSearch")
                            </a>
                        </div>
                    </form>
                </div>

                <div class="modern-card overflow-hidden mb-3">
                    <div class="table-responsive">
                        <table class="table modern-table align-middle mb-0" id="adminAttendanceTable">
                            <thead>
                                <tr>
                                    <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Date")</th>
                                    <th class="text-nowrap">@SharedResource.ResourceManager.GetString("Attendance_EmployeeCol")</th>
                                    <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_ShiftCol")</th>
                                    <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_CheckInCol")</th>
                                    <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_CheckOutCol")</th>
                                    <th class="text-nowrap text-center">@RWPM.Resources.Shared.Shift.ResourceManager.GetString("HoursWorked")</th>
                                    <th class="text-nowrap text-center"><i class="bi bi-image me-1"></i>@SharedResource.ResourceManager.GetString("Attendance_PhotoCol")</th>
                                    <th class="text-nowrap text-center"><i class="bi bi-geo-alt me-1"></i>@SharedResource.ResourceManager.GetString("Attendance_DistanceCol")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (employeeHistory != null && employeeHistory.Any())
                                {
                                    foreach (var item in employeeHistory)
                                    {
                                        <tr>
                                            <td class="text-center"><strong>@item.Date.ToString("dd/MM/yyyy")</strong></td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span class="fw-semibold text-dark">@(item.Account?.FullName ?? item.Username)</span>
                                                    @if (item.Account != null && !string.IsNullOrEmpty(item.Account.FullName) && item.Account.FullName != item.Username)
                                                    {
                                                        <span class="text-muted small" style="font-size: 0.8rem;">@@@item.Username</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="text-center">@(item.Shift != null ? item.Shift.ShiftName : "-")</td>
                                            <td class="text-center text-success fw-bold">
                                                @(item.CheckInTime.HasValue ? item.CheckInTime.Value.ToString(@"hh\:mm") : "--:--")
                                                @if (item.IsAdjusted)
                                                {
                                                    <button type="button" 
                                                            class="btn btn-link p-0 text-primary ms-1 align-baseline border-0 bg-transparent" 
                                                            data-bs-toggle="modal" 
                                                            data-bs-target="#historyModal_@item.AttendanceId" 
                                                            title="@SharedResource.ResourceManager.GetString("Attendance_AdjustedTooltip")"
                                                            style="cursor: pointer; font-size: 0.95rem; text-decoration: none;">
                                                        <i class="bi bi-info-circle"></i>
                                                    </button>
                                                }
                                            </td>
                                            <td class="text-center text-danger fw-bold">
                                                @(item.CheckOutTime.HasValue ? item.CheckOutTime.Value.ToString(@"hh\:mm") : "--:--")
                                                @if (item.IsAdjusted)
                                                {
                                                    <button type="button" 
                                                            class="btn btn-link p-0 text-primary ms-1 align-baseline border-0 bg-transparent" 
                                                            data-bs-toggle="modal" 
                                                            data-bs-target="#historyModal_@item.AttendanceId" 
                                                            title="@SharedResource.ResourceManager.GetString("Attendance_AdjustedTooltip")"
                                                            style="cursor: pointer; font-size: 0.95rem; text-decoration: none;">
                                                        <i class="bi bi-info-circle"></i>
                                                    </button>
                                                }
                                            </td>
                                            <td class="text-center">@(item.WorkHours?.ToString("0.##") ?? "—")</td>
                                            <td class="text-center">
                                                @if (!string.IsNullOrEmpty(item.CheckInPhotoPath))
                                                {
                                                    <a href="@item.CheckInPhotoPath" target="_blank" title="@SharedResource.ResourceManager.GetString("Attendance_PhotoCheckIn")">
                                                        <img src="@item.CheckInPhotoPath" class="img-thumbnail" style="width: 40px; height: 40px; object-fit: cover;" />
                                                    </a>
                                                }
                                                @if (!string.IsNullOrEmpty(item.CheckOutPhotoPath))
                                                {
                                                    <a href="@item.CheckOutPhotoPath" target="_blank" title="@SharedResource.ResourceManager.GetString("Attendance_PhotoCheckOut")">
                                                        <img src="@item.CheckOutPhotoPath" class="img-thumbnail ms-1" style="width: 40px; height: 40px; object-fit: cover;" />
                                                    </a>
                                                }
                                            </td>
                                            <td class="text-center small">
                                                @if (item.DistanceMeters.HasValue)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                        <i class="bi bi-check-circle me-1"></i> @Math.Round(item.DistanceMeters.Value)m
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-4">
                                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                            @SharedResource.ResourceManager.GetString("Attendance_NoData")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div id="adminAttendancePagination" class="px-3 py-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-2 d-none"></div>
                </div>
            }
            else if (canManage)
            {
                <!-- 2. DÀNH CHO HR & QUẢN LÝ CỬA HÀNG: Có 2 Tab chuyển đổi giữa cá nhân và nhân viên -->
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div class="nav nav-pills gap-2" id="attendanceTabs" role="tablist">
                        <button class="nav-link @(isEmpTabActive ? "" : "active") rounded-pill px-3 py-1 fw-semibold text-sm shadow-none" 
                                id="my-history-tab" 
                                data-bs-toggle="pill" 
                                data-bs-target="#my-history-pane" 
                                type="button" 
                                role="tab" 
                                aria-controls="my-history-pane" 
                                aria-selected="@(isEmpTabActive ? "false" : "true")">
                            <i class="bi bi-person-badge me-1"></i> @SharedResource.ResourceManager.GetString("Attendance_MyHistory")
                            <span class="badge rounded-pill bg-light text-dark ms-1">@myHistory.Count</span>
                        </button>
                        <button class="nav-link @(isEmpTabActive ? "active" : "") rounded-pill px-3 py-1 fw-semibold text-sm shadow-none" 
                                id="emp-history-tab" 
                                data-bs-toggle="pill" 
                                data-bs-target="#emp-history-pane" 
                                type="button" 
                                role="tab" 
                                aria-controls="emp-history-pane" 
                                aria-selected="@(isEmpTabActive ? "true" : "false")">
                            <i class="bi bi-people me-1"></i> @SharedResource.Attendance_EmployeeHistory @(!string.IsNullOrEmpty(scopeTitle) ? $"({scopeTitle})" : "")
                            <span class="badge rounded-pill bg-light text-dark ms-1">@employeeHistory.Count</span>
                        </button>
                    </div>
                </div>

                <div class="tab-content" id="attendanceTabsContent">
                    <!-- Tab 1: Lịch sử của tôi -->
                    <div class="tab-pane fade @(isEmpTabActive ? "" : "show active")" id="my-history-pane" role="tabpanel" aria-labelledby="my-history-tab" tabindex="0">
                        <div class="modern-card overflow-hidden mb-3">
                            <div class="table-responsive">
                                <table class="table modern-table align-middle mb-0" id="myAttendanceTable">
                                    <thead>
                                        <tr>
                                            <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Date")</th>
                                            <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_ShiftCol")</th>
                                            <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_CheckInCol")</th>
                                            <th class="text-nowrap text-center">@SharedResource.ResourceManager.GetString("Attendance_CheckOutCol")</th>
                                            <th class="text-nowrap text-center">@RWPM.Resources.Shared.Shift.ResourceManager.GetString("HoursWorked")</th>
                                            <th class="text-nowrap text-center"><i class="bi bi-image me-1"></i>@SharedResource.ResourceManager.GetString("Attendance_PhotoCol")</th>
                                            <th class="text-nowrap text-center"><i class="bi bi-geo-alt me-1"></i>@SharedResource.ResourceManager.GetString("Attendance_DistanceCol")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (myHistory != null && myHistory.Any())
                                        {
                                            foreach (var item in myHistory)
                                            {
                                                <tr>
                                                    <td class="text-center"><strong>@item.Date.ToString("dd/MM/yyyy")</strong></td>
                                                    <td class="text-center">@(item.Shift != null ? item.Shift.ShiftName : "-")</td>
                                                    <td class="text-center text-success fw-bold">
                                                        @(item.CheckInTime.HasValue ? item.CheckInTime.Value.ToString(@"hh\:mm") : "--:--")
                                                        @if (item.IsAdjusted)
                                                        {
                                                            <button type="button" 
                                                                    class="btn btn-link p-0 text-primary ms-1 align-baseline border-0 bg-transparent" 
                                                                    data-bs-toggle="modal" 
                                                                    data-bs-target="#historyModal_@item.AttendanceId" 
                                                                    title="@SharedResource.ResourceManager.GetString("Attendance_AdjustedTooltip")"
                                                                    style="cursor: pointer; font-size: 0.95rem; text-decoration: none;">
                                                                <i class="bi bi-info-circle"></i>
                                                            </button>
                                                        }
                                                    </td>
                                                    <td class="text-center text-danger fw-bold">
                                                        @(item.CheckOutTime.HasValue ? item.CheckOutTime.Value.ToString(@"hh\:mm") : "--:--")
                                                        @if (item.IsAdjusted)
                                                        {
                                                            <button type="button" 
                                                                    class="btn btn-link p-0 text-primary ms-1 align-baseline border-0 bg-transparent" 
                                                                    data-bs-toggle="modal" 
                                                                    data-bs-target="#historyModal_@item.AttendanceId" 
                                                                    title="@SharedResource.ResourceManager.GetString("Attendance_AdjustedTooltip")"
                                                                    style="cursor: pointer; font-size: 0.95rem; text-decoration: none;">
