@using System.Globalization
@using RWPM.Common.Helper
@using RWPM.Models.ViewModels.Dashboard
@using RWPM.Models.ViewModels.Payroll
@using RWPM.Resources.Shared
@using D = RWPM.Resources.Shared.DashboardResource
@model RWPM.Models.ViewModels.Dashboard.DashboardVM

@{
    ViewData["Title"] = D.Title;
    var today = Model.Now.Date;
    var dayName = Model.Now.ToString("dddd", CultureInfo.CurrentCulture);
    if (dayName.Length > 0) { dayName = char.ToUpper(dayName[0], CultureInfo.CurrentCulture) + dayName.Substring(1); }
    string subtitle = Model.Mode switch
    {
        DashboardMode.Chain => D.Subtitle_Chain,
        DashboardMode.Store => string.Format(D.Subtitle_Store, Model.Store?.StoreName),
        _ => D.Subtitle_Employee
    };

    string PendingUrl(PendingSummaryVM p) => Url.Action("Index", "Request", new
    {
        status = 0,
        start = p.RangeStart?.ToString("yyyy-MM-dd"),
        end = p.RangeEnd?.ToString("yyyy-MM-dd")
    }) ?? "#";

    string TimeRange(DateTime workDate, DateTime startAt, DateTime endAt)
    {
        var text = $"{startAt:HH:mm} - {endAt:HH:mm}";
        var days = (endAt.Date - workDate.Date).Days;
        return days > 0 ? $"{text} (+{days})" : text;
    }

    string FormatTime(TimeSpan? t) => t.HasValue ? t.Value.ToString(@"hh\:mm") : "--:--";

    string ShortageSub(ShortageSummaryVM sh) => sh.ShortShiftCount > 0
        ? string.Format(D.Card_ShortPeople, sh.MissingPeople)
        : (sh.HasDemand ? D.Card_ShortNone : D.Card_ShortNoDemand);

    // Trạng thái chấm công -> tông màu của design system (app-badge-* / app-dot-*)
    (string Tone, string Text) StateInfo(ShiftAttendanceState state, int lateMinutes) => state switch
    {
        ShiftAttendanceState.NotStarted => ("neutral", D.State_NotStarted),
        ShiftAttendanceState.AwaitingCheckIn => ("info", D.State_AwaitingCheckIn),
        ShiftAttendanceState.Late => ("warning", string.Format(D.State_Late, lateMinutes)),
        ShiftAttendanceState.CheckedIn => ("success", D.State_CheckedIn),
        ShiftAttendanceState.CheckedOut => ("neutral", D.State_CheckedOut),
        _ => ("danger", D.State_Absent)
    };
}

@functions {
    // Link tới màn hình độ phủ ca (ShiftDemand/Coverage) cho chi nhánh/tuần.
    string CoverageUrl(int? storeId, DateTime? weekStart) => Url.Action("Coverage", "ShiftDemand", new
    {
        storeId,
        weekStart = weekStart?.ToString("yyyy-MM-dd")
    }) ?? "#";

    // Thẻ KPI: thẻ trắng có viền, nhãn xám 13px phía trên, số lớn phía dưới.
    // Chỉ tô màu con số khi cần chú ý (color = "danger", hoặc "warning" khi giá trị khác 0); link biến cả thẻ thành liên kết.
    void StatCard(string color, string title, string value, string? sub, string icon, string? href)
    {
        var attention = color == "danger" || (color == "warning" && value != "0");
        <div class="col-12 col-sm-6 col-xl-3">
            @if (!string.IsNullOrEmpty(href))
            {
                @:<a href="@href" class="card dashboard-link h-100 text-decoration-none">
            }
            else
            {
                @:<div class="card h-100">
            }
                <div class="card-body">
                    <div class="text-muted" style="font-size: 13px;">@title</div>
                    <div class="fs-3 fw-semibold mt-1 tabular @(attention ? "text-" + color : "text-body")">@value</div>
                    @if (!string.IsNullOrEmpty(sub))
                    {
                        <div class="small text-muted mt-1">@sub</div>
                    }
                </div>
            @if (!string.IsNullOrEmpty(href))
            {
                @:</a>
            }
            else
            {
                @:</div>
            }
        </div>
    }

    void EmptyState(string icon, string text)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi @icon fs-3 d-block mb-2"></i>
            @text
        </div>
    }

    void PendingBreakdown(PendingSummaryVM p)
    {
        <ul class="list-group list-group-flush">
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span><i class="bi bi-calendar-plus text-muted me-2"></i>@D.Pending_Reg</span>
                <span class="app-badge @(p.ShiftRegistration > 0 ? "app-badge-warning" : "app-badge-neutral") tabular">@p.ShiftRegistration</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span><i class="bi bi-arrow-left-right text-muted me-2"></i>@D.Pending_Swap</span>
                <span class="app-badge @(p.Swap > 0 ? "app-badge-warning" : "app-badge-neutral") tabular">@p.Swap</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span><i class="bi bi-airplane text-muted me-2"></i>@D.Pending_Leave</span>
                <span class="app-badge @(p.Leave > 0 ? "app-badge-warning" : "app-badge-neutral") tabular">@p.Leave</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span><i class="bi bi-clock-history text-muted me-2"></i>@D.Pending_Adjustment</span>
                <span class="app-badge @(p.Adjustment > 0 ? "app-badge-warning" : "app-badge-neutral") tabular">@p.Adjustment</span>
            </li>
        </ul>
    }

    void ShortageCard(ShortageSummaryVM sh, bool showStore, string allUrl)
    {
        <div class="card">
            <div class="card-header py-3 d-flex justify-content-between align-items-center gap-2">
                <h5 class="card-title mb-0">@D.Section_ShortShifts</h5>
                <a href="@allUrl" class="small text-decoration-none text-nowrap">@D.Short_ViewCoverage</a>
            </div>
            @if (sh.Items.Count == 0)
            {
                EmptyState(sh.HasDemand ? "bi-emoji-smile" : "bi-sliders", sh.HasDemand ? D.Empty_ShortShifts : D.Card_ShortNoDemand);
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="text-nowrap">@D.Col_Date</th>
                                <th>@D.Col_Shift</th>
                                <th class="text-end text-nowrap">@D.Col_Coverage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var it in sh.Items)
                            {
                                <tr>
                                    <td class="text-nowrap"><small>@it.Date.ToString("ddd dd/MM", CultureInfo.CurrentCulture)</small></td>
                                    <td>
                                        <a href="@CoverageUrl(it.StoreId, it.WeekStart)" class="fw-medium text-decoration-none text-body">@it.ShiftName</a>
                                        <small class="d-block text-muted">@it.StartTime.ToString(@"hh\:mm") - @it.EndTime.ToString(@"hh\:mm")@(showStore ? " · " + it.StoreName : "")</small>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span class="app-badge app-badge-danger tabular">@it.Approved/@it.Required</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                if (sh.ShortShiftCount > sh.Items.Count)
                {
                    <div class="card-footer small text-muted text-end">@string.Format(D.List_Showing, sh.Items.Count, sh.ShortShiftCount)</div>
                }
            }
        </div>
    }

    void LeaveTable(List<LeaveTodayVM> items, int total, bool showStore)
    {
        if (items.Count == 0)
        {
            EmptyState("bi-emoji-smile", D.Empty_OnLeave);
            return;
        }
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>@D.Col_Employee</th>
                        @if (showStore)
                        {
                            <th>@D.Col_Store</th>
                        }
                        <th>@D.Col_LeaveType</th>
                        <th class="text-nowrap">@D.Col_Period</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in items)
                    {
                        <tr>
                            <td>
                                <div class="fw-medium">@l.FullName</div>
                                <small class="text-muted">@l.EmployeeCode</small>
                            </td>
                            @if (showStore)
                            {
                                <td><small>@l.StoreName</small></td>
                            }
                            <td>
                                @if (l.LeaveType == RWPM.Common.Enums.LeaveType.Paid)
                                {
                                    <span class="app-badge app-badge-success">@UIHelper.GetDisplayName(l.LeaveType)</span>
                                }
                                else
                                {
                                    <span class="app-badge app-badge-neutral">@UIHelper.GetDisplayName(l.LeaveType)</span>
                                }
                            </td>
                            <td class="text-nowrap"><small class="text-muted">@l.StartDate.ToString("dd/MM") - @l.EndDate.ToString("dd/MM/yyyy")</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        if (total > items.Count)
        {
            <div class="card-footer small text-muted text-end">@string.Format(D.List_Showing, items.Count, total)</div>
        }
    }
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="app-page-header">
        <div>
            <h4 class="mb-1">@D.Title</h4>
            <div class="text-muted small">
                @string.Format(D.Greeting, Model.FullName) &middot; @dayName, @Model.Now.ToString("dd/MM/yyyy") &middot; @subtitle
            </div>
        </div>
        <div class="app-page-actions">
            <span class="small text-muted"><i class="bi bi-clock me-1"></i>@string.Format(D.UpdatedAt, Model.Now.ToString("HH:mm"))</span>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-arrow-clockwise"></i><span>@D.Refresh</span>
            </a>
        </div>
    </div>

    @* ============================ STORE MANAGER ============================ *@
    @if (Model.Mode == DashboardMode.Store && Model.Store != null)
    {
        var s = Model.Store;
        int assignments = s.Shifts.Sum(x => x.ApprovedCount);
        int checkedIn = s.Shifts.Sum(x => x.CheckedInCount);

        <div class="row g-3 mb-4">
            @{
                StatCard("primary", D.Card_ShiftsToday, s.Shifts.Count.ToString(), string.Format(D.Card_CheckedInRatio, checkedIn, assignments), "bi-calendar-week", null);
                StatCard("warning", D.Card_PendingRequests, s.Pending.Total.ToString(), s.Pending.Total > 0 ? D.Action_Review : D.Pending_None, "bi-inbox", PendingUrl(s.Pending));
                StatCard("info", D.Card_OnLeaveToday, s.OnLeave.Count.ToString(), null, "bi-airplane", null);
                StatCard("success", D.Card_ActiveHeadcount, s.ActiveHeadcount.ToString(), s.StoreName, "bi-people", null);
                StatCard(s.Shortage.ShortShiftCount > 0 ? "danger" : "secondary", D.Card_ShortShifts, s.Shortage.ShortShiftCount.ToString(),
                    ShortageSub(s.Shortage), "bi-person-exclamation", CoverageUrl(null, null));
                StatCard("info", D.Card_PendingAvailability, s.PendingAvailability.ToString(),
                    s.PendingAvailability > 0 ? D.Action_Review : D.Pending_None, "bi-clock-history", Url.Action("Review", "Availability"));
            }
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-xl-8">
                <div class="card h-100">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h5 class="card-title mb-0">@D.Section_TodayShifts</h5>
                        <span class="app-badge app-badge-neutral">@string.Format(D.Card_CheckedInRatio, checkedIn, assignments)</span>
                    </div>
                    @if (s.Shifts.Count == 0)
                    {
                        EmptyState("bi-calendar-x", D.Empty_TodayShifts);
                    }
                    else
                    {
                        <div class="card-body">
                            @foreach (var shift in s.Shifts)
                            {
                                <div class="border rounded mb-3 overflow-hidden">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2 border-bottom" style="background: var(--app-surface-2);">
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <span class="fw-semibold">@shift.ShiftName</span>
                                            <span class="small text-muted tabular">@TimeRange(shift.WorkDate, shift.StartAt, shift.EndAt)</span>
                                            @if (shift.IsCarryOver)
                                            {
                                                <span class="app-badge app-badge-neutral"><i class="bi bi-moon-stars"></i>@D.Shift_CarryOver</span>
                                            }
                                        </div>
                                        <div class="d-flex flex-wrap align-items-center gap-2 small">
                                            <span class="app-badge @(shift.CheckedInCount == shift.ApprovedCount ? "app-badge-success" : "app-badge-info")">@string.Format(D.Card_CheckedInRatio, shift.CheckedInCount, shift.ApprovedCount)</span>
                                            <span class="text-muted">@string.Format(D.Shift_Grace, shift.GraceMinutes)</span>
                                        </div>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th class="text-nowrap">@D.Col_Code</th>
                                                    <th>@D.Col_Employee</th>
                                                    <th>@D.Col_Status</th>
                                                    <th class="text-end text-nowrap">@D.Col_CheckIn</th>
                                                    <th class="text-end text-nowrap">@D.Col_CheckOut</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var e in shift.Employees)
                                                {
                                                    var st = StateInfo(e.State, e.LateMinutes);
                                                    <tr>
                                                        <td class="text-nowrap"><small class="text-muted">@e.EmployeeCode</small></td>
                                                        <td class="fw-medium">@e.FullName</td>
                                                        <td class="text-nowrap">
                                                            <span class="app-status"><span class="app-dot @(st.Tone == "neutral" ? "" : "app-dot-" + st.Tone)"></span>@st.Text</span>
                                                            @if ((e.State == ShiftAttendanceState.CheckedIn || e.State == ShiftAttendanceState.CheckedOut) && e.LateMinutes > 0)
                                                            {
                                                                <small class="text-warning-emphasis ms-1">@string.Format(D.State_CheckedInLate, e.LateMinutes)</small>
                                                            }
                                                        </td>
                                                        <td class="text-end">@FormatTime(e.CheckInTime)</td>
                                                        <td class="text-end">@FormatTime(e.CheckOutTime)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-12 col-xl-4 d-flex flex-column gap-3">
                <div class="card">
                    <div class="card-header py-3">
                        <h5 class="card-title mb-0">@D.Quick_Title</h5>
                    </div>
                    <div class="list-group list-group-flush">
                        <a href="@PendingUrl(s.Pending)" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2">
                            <i class="bi bi-inbox text-muted"></i>
                            <span>@D.Card_PendingRequests</span>
                            @if (s.Pending.Total > 0)
                            {
                                <span class="app-badge app-badge-warning ms-auto tabular">@s.Pending.Total</span>
                            }
                            else
                            {
                                <i class="bi bi-chevron-right ms-auto text-muted"></i>
                            }
                        </a>
                        <a asp-controller="ShiftRegistration" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2">
                            <i class="bi bi-calendar-week text-muted"></i>
                            <span>@ShiftRegistrationResource.ShiftRegistration</span>
                            <i class="bi bi-chevron-right ms-auto text-muted"></i>
                        </a>
                        <a asp-controller="Attendance" asp-action="Index" asp-route-view="employees" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2">
                            <i class="bi bi-calendar-check text-muted"></i>
                            <span>@NavigationBarResource.Attendance</span>
                            <i class="bi bi-chevron-right ms-auto text-muted"></i>
                        </a>
                    </div>
                </div>

                @{ ShortageCard(s.Shortage, false, CoverageUrl(null, null)); }

                <div class="card">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">@D.Card_PendingRequests</h5>
                        <a href="@PendingUrl(s.Pending)" class="small text-decoration-none">@D.ViewAll</a>
                    </div>
                    <div class="card-body py-1">
                        @{ PendingBreakdown(s.Pending); }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">@D.Section_OnLeave</h5>
                        <span class="app-badge app-badge-neutral">@s.OnLeave.Count</span>
                    </div>
                    @{ LeaveTable(s.OnLeave, s.OnLeave.Count, false); }
                </div>
            </div>
        </div>
    }

    @* ============================ HR / ADMIN ============================ *@
    @if (Model.Mode == DashboardMode.Chain && Model.Chain != null)
    {
        var c = Model.Chain;

        if (c.PreviousMonthMissing)
        {
            <div class="alert alert-warning mb-4 d-flex align-items-center flex-wrap gap-2">
                <i class="bi bi-exclamation-triangle me-1"></i>
                <strong class="flex-grow-1">@string.Format(D.Payroll_MissingPrevMonth, c.PreviousMonth.ToString("MM/yyyy"))</strong>
                <a asp-controller="Payroll" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-calculator me-1"></i>@D.Payroll_GoTo</a>
            </div>
        }

        <div class="row g-3 mb-4">
            @{
                StatCard("primary", D.Card_ActiveHeadcount, c.ActiveHeadcount.ToString(),
                    c.UnassignedHeadcount > 0 ? string.Format(D.Card_Unassigned, c.UnassignedHeadcount) : string.Format(D.Card_CheckedInNow, c.CheckedInNow),
                    "bi-people", Url.Action("Index", "Employee"));
                StatCard("warning", D.Card_PendingRequests, c.Pending.Total.ToString(), c.Pending.Total > 0 ? D.Action_Review : D.Pending_None, "bi-inbox", PendingUrl(c.Pending));
                StatCard("info", D.Card_OnLeaveToday, c.OnLeaveTotal.ToString(), null, "bi-airplane", null);
                StatCard("success", D.Card_NewHires, c.NewHiresTotal.ToString(), null, "bi-person-plus", null);
                StatCard(c.Shortage.ShortShiftCount > 0 ? "danger" : "secondary", D.Card_ShortShifts, c.Shortage.ShortShiftCount.ToString(),
                    ShortageSub(c.Shortage), "bi-person-exclamation", CoverageUrl(null, null));
                if (User.IsChainManager())
                {
                    StatCard("info", D.Card_PendingAvailability, c.PendingAvailability.ToString(),
                        c.PendingAvailability > 0 ? D.Action_Review : D.Pending_None, "bi-clock-history", Url.Action("Review", "Availability"));
                }
            }
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-xl-8">
                <div class="card h-100">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h5 class="card-title mb-0">@D.Section_Stores</h5>
                        <span class="app-badge app-badge-neutral">@string.Format(D.Card_CheckedInNow, c.CheckedInNow)</span>
                    </div>
                    @if (c.Stores.Count == 0)
                    {
                        EmptyState("bi-shop", D.Empty_Stores);
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>@D.Col_Store</th>
                                        <th class="text-end text-nowrap">@D.Col_Headcount</th>
                                        <th class="text-end text-nowrap">@D.Col_TodayShifts</th>
                                        <th class="text-end text-nowrap">@D.Col_CheckedInNow</th>
                                        <th class="text-end text-nowrap">@D.Col_Pending</th>
                                        <th class="text-end text-nowrap">@D.Col_Short7Days</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in c.Stores)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-controller="Store" asp-action="Details" asp-route-id="@row.StoreId" class="fw-medium text-decoration-none text-body">@row.StoreName</a>
                                                <small class="d-block text-muted">@row.StoreCode</small>
                                            </td>
                                            <td class="text-end fw-medium">@row.Headcount</td>
                                            <td class="text-end">@row.TodayAssignments</td>
                                            <td class="text-end">
                                                @if (row.CheckedInNow > 0)
                                                {
                                                    <span class="app-badge app-badge-success tabular">@row.CheckedInNow</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">0</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (row.PendingCount > 0)
                                                {
                                                    <span class="app-badge app-badge-warning tabular">@row.PendingCount</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">0</span>
                                                }
                                            </td>
                                            <td class="text-end text-nowrap">
                                                @if (row.ShortShifts > 0)
                                                {
                                                    <a href="@CoverageUrl(row.StoreId, null)" class="app-badge app-badge-danger text-decoration-none" title="@D.Short_ViewCoverage">@string.Format(D.Short_ShiftsPeople, row.ShortShifts, row.MissingPeople)</a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">0</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="fw-semibold">
                                        <td>@D.Total</td>
                                        <td class="text-end">@c.Stores.Sum(x => x.Headcount)</td>
                                        <td class="text-end">@c.Stores.Sum(x => x.TodayAssignments)</td>
                                        <td class="text-end">@c.Stores.Sum(x => x.CheckedInNow)</td>
                                        <td class="text-end">@c.Stores.Sum(x => x.PendingCount)</td>
                                        <td class="text-end text-nowrap">@string.Format(D.Short_ShiftsPeople, c.Stores.Sum(x => x.ShortShifts), c.Stores.Sum(x => x.MissingPeople))</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        @if (c.UnassignedHeadcount > 0)
                        {
                            <div class="card-footer small text-muted"><i class="bi bi-info-circle me-1"></i>@string.Format(D.Card_Unassigned, c.UnassignedHeadcount)</div>
                        }
                    }
                </div>
            </div>

            <div class="col-12 col-xl-4 d-flex flex-column gap-3">
                <div class="card">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">@D.Payroll_Latest</h5>
                        <a asp-controller="Payroll" asp-action="Index" class="small text-decoration-none">@D.ViewAll</a>
                    </div>
                    @if (c.Payroll == null)
                    {
                        EmptyState("bi-cash-stack", D.Payroll_Empty);
                    }
                    else
                    {
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <a asp-controller="Payroll" asp-action="Detail" asp-route-id="@c.Payroll.PayrollId" class="fw-semibold text-decoration-none">@PayrollDisplayText.Title(c.Payroll.Title)</a>
                                @if (c.Payroll.Status == RWPM.Common.Enums.PayrollStatus.Locked)
                                {
                                    <span class="app-badge app-badge-success">@PayrollResource.Status_Locked</span>
                                }
                                else
                                {
                                    <span class="app-badge app-badge-warning">@PayrollResource.Status_Draft</span>
                                }
                            </div>
                            <div class="small text-muted mb-3"><i class="bi bi-calendar3 me-1"></i>@c.Payroll.StartDate.ToString("dd/MM/yyyy") - @c.Payroll.EndDate.ToString("dd/MM/yyyy") &middot; @string.Format(D.Payroll_Employees, c.Payroll.TotalEmployees)</div>
                            <div class="text-muted" style="font-size: 13px;">@D.Payroll_TotalSalary</div>
                            <div class="fs-3 fw-semibold mb-3 mt-1 tabular">@c.Payroll.TotalGrossSalary.ToString("#,##0") <small class="fs-6 fw-normal text-muted">@PayrollResource.Unit_Vnd</small></div>
                            <a asp-controller="Payroll" asp-action="Detail" asp-route-id="@c.Payroll.PayrollId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye me-1"></i>@PayrollResource.Action_ViewDetail</a>
                        </div>
                    }
                </div>

                <div class="card">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">@D.Card_PendingRequests</h5>
                        <a href="@PendingUrl(c.Pending)" class="small text-decoration-none">@D.ViewAll</a>
                    </div>
                    <div class="card-body py-1">
                        @{ PendingBreakdown(c.Pending); }
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">@D.Section_OnLeave</h5>
                        <span class="app-badge app-badge-neutral">@c.OnLeaveTotal</span>
                    </div>
                    @{ LeaveTable(c.OnLeave, c.OnLeaveTotal, true); }
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">@D.Section_NewHires</h5>
                        <span class="app-badge app-badge-neutral">@c.NewHiresTotal</span>
                    </div>
                    @if (c.NewHires.Count == 0)
                    {
                        EmptyState("bi-person-plus", D.Empty_NewHires);
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>@D.Col_Employee</th>
                                        <th>@D.Col_Store</th>
                                        <th class="text-end text-nowrap">@D.Col_JoinDate</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var h in c.NewHires)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-medium">@h.FullName</div>
                                                <small class="text-muted">@h.EmployeeCode</small>
                                            </td>
                                            <td><small>@(string.IsNullOrEmpty(h.StoreName) ? D.NoStore : h.StoreName)</small></td>
                                            <td class="text-end text-nowrap"><small class="text-muted">@h.JoinDate.ToString("dd/MM/yyyy")</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (c.NewHiresTotal > c.NewHires.Count)
                        {
                            <div class="card-footer small text-muted text-end">@string.Format(D.List_Showing, c.NewHires.Count, c.NewHiresTotal)</div>
                        }
                    }
                </div>
            </div>
        </div>
    }

    @* ============================ CỦA TÔI / EMPLOYEE ============================ *@
    @if (Model.Mode == DashboardMode.Employee && User.IsStoreManager() && Model.HasProfile)
    {
        <div class="alert alert-info mb-4"><i class="bi bi-info-circle me-2"></i>@D.My_ManagerNoStore</div>
    }

    @if (Model.My == null)
    {
        if (Model.Mode == DashboardMode.Employee)
        {
            <div class="card">
                @{ EmptyState("bi-person-exclamation", D.My_NoProfile); }
            </div>
        }
    }
    else
    {
        var my = Model.My;

        if (Model.Mode != DashboardMode.Employee)
        {
            <div class="d-flex align-items-center gap-2 mb-3 mt-2">
                <h5 class="mb-0">@D.Section_My</h5>
                <span class="small text-muted">@(string.IsNullOrEmpty(my.StoreName) ? my.EmployeeCode : my.EmployeeCode + " · " + my.StoreName)</span>
                <hr class="flex-grow-1 my-0 ms-2" />
            </div>
        }

        <div class="row g-3 mb-4">
            @{
                StatCard("primary", D.My_TodayShifts, my.Today.Count.ToString(), null, "bi-calendar-day", null);
                StatCard("success", D.My_LeaveBalance, $"{my.AnnualLeaveBalance} {D.Unit_Days}", null, "bi-airplane", null);
                StatCard("warning", D.My_Pending, my.Pending.Total.ToString(), null, "bi-hourglass-split", PendingUrl(my.Pending));
                if (my.LatestPayslip != null)
                {
                    StatCard("info", D.My_LatestPayslip, $"{my.LatestPayslip.TotalSalary:#,##0} {PayrollResource.Unit_Vnd}",
                        PayrollDisplayText.Title(my.LatestPayslip.Title), "bi-receipt",
                        Url.Action("MyPayslipDetail", "Payroll", new { payrollId = my.LatestPayslip.PayrollId }));
                }
                else
                {
                    StatCard("info", D.My_LatestPayslip, "—", D.My_NoPayslip, "bi-receipt", Url.Action("MyPayslips", "Payroll"));
                }
            }
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h5 class="card-title mb-0">@D.My_TodayShifts</h5>
                        @if (Model.CanUseAttendance)
                        {
                            <a asp-controller="Attendance" asp-action="Index" class="btn btn-primary btn-sm d-flex align-items-center gap-1">
                                <i class="bi bi-fingerprint"></i><span>@D.My_GoAttendance</span>
                            </a>
                        }
                    </div>
                    @if (my.Today.Count == 0)
                    {
                        EmptyState("bi-calendar-x", D.My_EmptyToday);
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var t in my.Today)
                            {
                                var st = StateInfo(t.State, t.LateMinutes);
                                <li class="list-group-item py-2">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <div>
                                            <div class="fw-semibold">
                                                @t.ShiftName
                                                @if (t.IsCarryOver)
                                                {
                                                    <span class="app-badge app-badge-neutral ms-1"><i class="bi bi-moon-stars"></i>@D.Shift_CarryOver</span>
                                                }
                                            </div>
                                            <div class="small text-muted">@TimeRange(t.WorkDate, t.StartAt, t.EndAt) &middot; @t.StoreName</div>
                                        </div>
                                        <div class="text-end">
                                            <span class="app-badge app-badge-@st.Tone">@st.Text</span>
                                            <div class="small text-muted mt-1">
                                                @D.Col_CheckIn: @FormatTime(t.CheckInTime) &middot; @D.Col_CheckOut: @FormatTime(t.CheckOutTime)
                                                @if ((t.State == ShiftAttendanceState.CheckedIn || t.State == ShiftAttendanceState.CheckedOut) && t.LateMinutes > 0)
                                                {
                                                    <span class="text-warning-emphasis ms-1">(@string.Format(D.State_CheckedInLate, t.LateMinutes))</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">@D.My_Upcoming</h5>
                        <a asp-controller="ShiftRegistration" asp-action="Index" class="small text-decoration-none">@ShiftRegistrationResource.ShiftRegistration</a>
                    </div>
                    @if (my.Upcoming.Count == 0)
                    {
                        EmptyState("bi-calendar", D.My_EmptyUpcoming);
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-nowrap">@D.Col_Date</th>
                                        <th>@D.Col_Shift</th>
                                        <th class="text-nowrap">@D.Col_Period</th>
                                        <th>@D.Col_Store</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in my.Upcoming)
                                    {
                                        <tr>
                                            <td class="text-nowrap">
                                                <span class="fw-medium">@u.WorkDate.ToString("dd/MM")</span>
                                                <small class="text-muted ms-1">@u.WorkDate.ToString("ddd", CultureInfo.CurrentCulture)</small>
                                            </td>
                                            <td class="fw-medium">@u.ShiftName</td>
                                            <td class="text-nowrap"><small class="text-muted">@TimeRange(u.WorkDate, u.StartAt, u.EndAt)</small></td>
                                            <td><small>@u.StoreName</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        if (my.Pending.Total > 0)
        {
            <div class="row g-3 mb-4">
                <div class="col-12 col-lg-6">
                    <div class="card">
                        <div class="card-header py-3 d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">@D.My_Pending</h5>
                            <a href="@PendingUrl(my.Pending)" class="small text-decoration-none">@D.ViewAll</a>
                        </div>
                        <div class="card-body py-1">
                            @{ PendingBreakdown(my.Pending); }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
